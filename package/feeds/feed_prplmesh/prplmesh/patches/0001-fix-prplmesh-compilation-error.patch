 create mode 100644 package/feeds/feed_prplmesh/prplmesh/patches/0001-fix-prplmesh-compilation-error.patch

--- a/agent/src/beerocks/slave/beerocks_agent_main.cpp
+++ b/agent/src/beerocks/slave/beerocks_agent_main.cpp
@@ -420,7 +420,7 @@ static int run_beerocks_slave(beerocks::
