+/* Credential-only changes also need a hostapd sync, even when Enable/Role stay equal. */
+static void s_setDppConfig_pwf(void* priv _UNUSED, amxd_object_t* object,
+                               amxd_param_t* param _UNUSED, const amxc_var_t* const newValue _UNUSED) {
+    T_AccessPoint* pAP = wld_ap_fromObj(amxd_object_get_parent(object));
+    if(pAP != NULL) {
+        wld_ap_doSync(pAP);
+    }
+}
+
+amxd_status_t _wld_ap_validateDpp_ovf(amxd_object_t* object,
+                                      amxd_param_t* param _UNUSED,
+                                      amxd_action_t reason _UNUSED,
+                                      const amxc_var_t* const args _UNUSED,
+                                      amxc_var_t* const retval _UNUSED,
+                                      void* priv _UNUSED) {
+    if(amxd_object_get_type(amxd_object_get_parent(object)) != amxd_object_instance) {
+        return amxd_status_ok;
+    }
+    amxc_var_t params;
+    amxc_var_init(&params);
+    amxc_var_set_type(&params, AMXC_VAR_ID_HTABLE);
+    swla_object_paramsToMap(&params, object);
+    const char* mode = GET_CHAR(&params, "AKMMode");
+    const char* connector = GET_CHAR(&params, "Connector");
+    const char* csign = GET_CHAR(&params, "CSign");
+    const char* nak = GET_CHAR(&params, "NetAccessKey");
+    bool hasConnector = !swl_str_isEmpty(connector);
+    bool hasCsign = !swl_str_isEmpty(csign);
+    bool hasNak = !swl_str_isEmpty(nak);
+    bool complete = hasConnector && hasCsign && hasNak;
+    bool explicitAkm = swl_str_matches(mode, "DPPOnly") || swl_str_matches(mode, "Mixed");
+    bool valid = (!hasConnector && !hasCsign && !hasNak) || complete;
+    if(complete) {
+        valid = (strlen(connector) <= 8192) && (strpbrk(connector, "\r\n\t ") == NULL) &&
+                (strlen(csign) <= 8192) && (strlen(csign) % 2 == 0) &&
+                (strspn(csign, "0123456789abcdefABCDEF") == strlen(csign)) &&
+                (strlen(nak) <= 8192) && (strlen(nak) % 2 == 0) &&
+                (strspn(nak, "0123456789abcdefABCDEF") == strlen(nak));
+    }
+    if(explicitAkm) {
+        amxd_object_t* security = amxd_object_findf(amxd_object_get_parent(object), "Security");
+        char* baseMode = security ? amxd_object_get_cstring_t(security, "ModeEnabled", NULL) : NULL;
+        bool open = swl_str_matches(baseMode, "None");
+        valid = valid && complete && (baseMode != NULL) &&
+                (swl_str_matches(mode, "DPPOnly") ? open : !open);
+        free(baseMode);
+    }
+    amxc_var_clean(&params);
+    if(!valid) {
+        SAH_TRACEZ_ERROR(ME, "Reject incomplete/invalid DPP credentials or inconsistent AKM mode");
+    }
+    return valid ? amxd_status_ok : amxd_status_invalid_value;
+}
