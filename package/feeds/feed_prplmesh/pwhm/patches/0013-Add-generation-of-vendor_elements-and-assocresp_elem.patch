diff --git a/src/nl80211/wld_hostapd_cfgFile.c b/src/nl80211/wld_hostapd_cfgFile.c
index 083eea5..1b2cd36 100644
--- a/src/nl80211/wld_hostapd_cfgFile.c
+++ b/src/nl80211/wld_hostapd_cfgFile.c
@@ -780,6 +780,64 @@ static void s_setVapMultiApConf(T_AccessPoint* pAP, swl_mapChar_t* vapConfigMap,
     }
 }
 
+#define CFG_BEACON_PROBERESP_MASK (M_VENDOR_IE_BEACON | M_VENDOR_IE_PROBE_RESP)
+#define CFG_ASSOCRESP_MASK (M_VENDOR_IE_ASSOC_RESP)
+
+/**
+ * @brief Generate vendor-specific IE strings
+ *
+ * @param pAP Pointer to a vap
+ * @param vapConfigMap Char map with configuration
+ * @param mask Vendor IE frame mask
+ * @param string Configuration string that corresponds to a specific frame mask
+ */
+static void s_generateVendorIE(T_AccessPoint* pAP, swl_mapChar_t* vapConfigMap, wld_vendorIeFrame_m mask, char* string) {
+    if(!pAP->enableVendorIEs) {
+        return;
+    }
+
+    char* ieBuf = NULL;
+    int ieBufStrLen = 0;
+
+    amxc_llist_for_each(it, &pAP->vendorIEs) {
+        wld_vendorIe_t* vIE = amxc_llist_it_get_data(it, wld_vendorIe_t, it);
+        SAH_TRACEZ_INFO(ME, "%s: %s : %s : %u", pAP->alias, vIE->oui, vIE->data, vIE->frame_type);
+
+        if((vIE->frame_type & mask) == mask) {
+            swl_oui_t oui = {{0}};
+            swl_typeOui_fromChar(&oui, vIE->oui);
+            size_t payloadByteLen = SWL_OUI_BYTE_LEN + swl_str_len(vIE->data) / 2;
+            if(payloadByteLen > 255) {
+                SAH_TRACEZ_ERROR(ME, "%s: payload is too long = %zu", pAP->alias, payloadByteLen);
+                continue;
+            }
+
+            // tag (2 symbols) + length (2 symbols) + payload + terminating zero
+            size_t ieNewBufSize = 2 + 2 + payloadByteLen * 2 + 1;
+            char* newBuf = realloc(ieBuf, ieBufStrLen + ieNewBufSize);
+            if(newBuf == NULL) {
+                SAH_TRACEZ_ERROR(ME, "%s: realloc failed", pAP->alias);
+                continue;
+            }
+            ieBuf = newBuf;
+
+            int written = snprintf(ieBuf + ieBufStrLen, ieNewBufSize, "dd%02zx%06x%s", payloadByteLen, SWL_OUI_GET(oui.ouiBytes), vIE->data);
+            if(written < 0) {
+                SAH_TRACEZ_ERROR(ME, "%s: snprintf failed", pAP->alias);
+                continue;
+            }
+            ieBufStrLen += written;
+        }
+    }
+
+    if(swl_str_len(ieBuf) > 0) {
+        swl_mapChar_add(vapConfigMap, string, ieBuf);
+    }
+
+    free(ieBuf);
+}
+
+
 /**
  * @brief set the common parameters of a vap (ssid, secMode, keyPassphrase, bssid, ...)
  *
@@ -876,6 +934,9 @@ static bool s_setVapCommonConfig(T_AccessPoint* pAP, swl_mapChar_t* vapConfigMap
 
     s_writeMfConfig(pAP, vapConfigMap);
 
+    s_generateVendorIE(pAP, vapConfigMap, CFG_BEACON_PROBERESP_MASK, "vendor_elements");
+    s_generateVendorIE(pAP, vapConfigMap, CFG_ASSOCRESP_MASK, "assocresp_elements");
+
     if(pAP->cfg11u.qosMapSet[0] && pAP->WMMCapability) {
         swl_mapChar_add(vapConfigMap, "qos_map_set", pAP->cfg11u.qosMapSet);
     }
