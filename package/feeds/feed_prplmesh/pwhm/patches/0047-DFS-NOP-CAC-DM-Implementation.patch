+/* -------------------------------------------------------------------------
+ * RadarDetectCount (READ-ONLY) — NL80211 vendor command
+ * -------------------------------------------------------------------------
+*/
+typedef struct {
+    uint32_t* pRadarCount;
+    swl_rc_ne rc;
+} s_radarCountCtx_t;
+
+static swl_rc_ne s_getRadarDetectCountCb(swl_rc_ne rc, struct nlmsghdr* nlh, void* priv) {
+    s_radarCountCtx_t* pCtx = (s_radarCountCtx_t*)priv;
+
+    if(rc < SWL_RC_OK) {
+        pCtx->rc = rc;
+        return rc;
+    }
+
+    void* data = NULL;
+    size_t dataLen = 0;
+    rc = wld_nl80211_getVendorDataFromVendorMsg(rc, nlh, &data, &dataLen);
+    if(rc < SWL_RC_OK || data == NULL) {
+        SAH_TRACEZ_ERROR(ME, "Failed to get vendor data, rc=%d", rc);
+        pCtx->rc = rc;
+        return rc;
+    }
+
+    if(dataLen >= 8) {
+        uint32_t value = *((uint32_t*)((uint8_t*)data + 4));
+        *pCtx->pRadarCount = value;
+        SAH_TRACEZ_INFO(ME, "Radar count: dataLen=%zu, value=%u", dataLen, value);
+        pCtx->rc = SWL_RC_OK;
+        return SWL_RC_OK;
+    }
+
+    SAH_TRACEZ_ERROR(ME, "Invalid vendor data length: %zu (expected >= 12)", dataLen);
+    pCtx->rc = SWL_RC_ERROR;
+    return SWL_RC_ERROR;
+}
+swl_rc_ne wld_rad_nl80211_getRadarDetectCount(T_Radio* pRad, uint32_t* pRadarCount) {
+    swl_rc_ne rc = SWL_RC_INVALID_PARAM;
+    ASSERT_NOT_NULL(pRad, rc, ME, "NULL radio");
+    ASSERT_NOT_NULL(pRadarCount, rc, ME, "NULL output");
+
+    uint32_t radioIdx = wld_rad_nl80211_getRadioIdx(pRad);
+
+    SAH_TRACEZ_INFO(ME, "%s: getRadarDetectCount radioIdx=%u", pRad->Name, radioIdx);
+
+    if(pRad->index <= 0 && pRad->wDevId == 0) {
+        SAH_TRACEZ_WARNING(ME, "%s: radio not available", pRad->Name);
+        return SWL_RC_ERROR;
+    }
+
+    uint8_t radioIdxU8 = (uint8_t)radioIdx;
+    uint32_t dparam0Val = QCA_DPARAM0_WIFI_PARAMS;
+    uint32_t dparam1Val = QCA_DPARAM1_RADAR_DETECT_COUNT;
+
+    NL_ATTR_NESTED(vendorAttr, NL80211_ATTR_VENDOR_DATA);
+    NL_ATTRS_ADD(&vendorAttr.data.attribs, NL_ATTR_VAL(QCA_ATTR_RADIO_IDX, radioIdxU8));
+    NL_ATTRS_ADD(&vendorAttr.data.attribs, NL_ATTR_VAL(QCA_ATTR_DPARAM0, dparam0Val));
+    NL_ATTRS_ADD(&vendorAttr.data.attribs, NL_ATTR_VAL(QCA_ATTR_DPARAM1, dparam1Val));
+
+    s_radarCountCtx_t ctx = {
+        .pRadarCount = pRadarCount,
+        .rc = SWL_RC_ERROR
+    };
+
+    rc = wld_rad_nl80211_sendVendorSubCmdAttr(pRad, QCA_VENDOR_ID, QCA_VENDOR_SUBCMD_GET,
+                                              &vendorAttr, true, false, 0,
+                                              s_getRadarDetectCountCb, &ctx);
+
+    NL_ATTRS_CLEAR(&vendorAttr.data.attribs);
+
+    if(rc != SWL_RC_OK) {
+        SAH_TRACEZ_ERROR(ME, "%s: getRadarDetectCount failed rc=%d", pRad->Name, rc);
+        return rc;
+    }
+
+    return ctx.rc;
+}
+
+/* -------------------------------------------------------------------------
+ * SubChannelMarking (READ/WRITE) — NL80211 vendor command
+ * -------------------------------------------------------------------------
+*/
+swl_rc_ne wld_rad_nl80211_setSubChannelMarking(T_Radio* pRad, bool enable) {
+    swl_rc_ne rc = SWL_RC_INVALID_PARAM;
+    ASSERT_NOT_NULL(pRad, rc, ME, "NULL radio");
+
+    uint32_t radioIdx = wld_rad_nl80211_getRadioIdx(pRad);
+    uint32_t markVal = enable ? 1u : 0u;
+
+    SAH_TRACEZ_INFO(ME, "%s: setSubChannelMarking enable=%d radioIdx=%u",
+                    pRad->Name, enable, radioIdx);
+
+    if(pRad->index <= 0 && pRad->wDevId == 0) {
+        SAH_TRACEZ_WARNING(ME, "%s: radio not available", pRad->Name);
+        return SWL_RC_ERROR;
+    }
+
+    uint8_t radioIdxU8 = (uint8_t)radioIdx;
+    uint32_t dparam0Val = QCA_DPARAM0_WIFI_PARAMS;
+    uint32_t dparam1Val = QCA_DPARAM1_MARK_SUBCHAN;
+
+    NL_ATTR_NESTED(vendorAttr, NL80211_ATTR_VENDOR_DATA);
+    NL_ATTRS_ADD(&vendorAttr.data.attribs, NL_ATTR_VAL(QCA_ATTR_RADIO_IDX, radioIdxU8));
+    NL_ATTRS_ADD(&vendorAttr.data.attribs, NL_ATTR_VAL(QCA_ATTR_DPARAM0, dparam0Val));
+    NL_ATTRS_ADD(&vendorAttr.data.attribs, NL_ATTR_VAL(QCA_ATTR_DPARAM1, dparam1Val));
+    NL_ATTRS_ADD(&vendorAttr.data.attribs, NL_ATTR_VAL(QCA_ATTR_VALUE0, markVal));
+
+    uint32_t wiphy = pRad->wiphy;
+    uint32_t vendorId = QCA_VENDOR_ID;
+    uint32_t vendorSubcmd = QCA_VENDOR_SUBCMD_SET;
+
+    NL_ATTRS(attribs,
+             ARR(
+                 NL_ATTR_VAL(NL80211_ATTR_VENDOR_ID, vendorId),
+                 NL_ATTR_VAL(NL80211_ATTR_VENDOR_SUBCMD, vendorSubcmd),
+                 NL_ATTR_VAL(NL80211_ATTR_WIPHY, wiphy)
+                 )
+             );
+    swl_unLiList_add(&attribs, &vendorAttr);
+
+    rc = wld_nl80211_sendCmdSyncWithAck(wld_nl80211_getSharedState(),
+                                        NL80211_CMD_VENDOR,
+                                        0,
+                                        0,
+                                        &attribs);
+    NL_ATTRS_CLEAR(&attribs);
+    NL_ATTRS_CLEAR(&vendorAttr.data.attribs);
+
+    if(rc != SWL_RC_OK) {
+        SAH_TRACEZ_ERROR(ME, "%s: setSubChannelMarking failed rc=%d", pRad->Name, rc);
+    }
+    return rc;
+}
+
+typedef struct {
+    bool* pEnabled;
+    swl_rc_ne rc;
+} s_subChanMarkCtx_t;
+
+static swl_rc_ne s_getSubChannelMarkingCb(swl_rc_ne rc, struct nlmsghdr* nlh, void* priv) {
+    s_subChanMarkCtx_t* pCtx = (s_subChanMarkCtx_t*)priv;
+
+    if(rc < SWL_RC_OK) {
+        pCtx->rc = rc;
+        return rc;
+    }
+
+    void* data = NULL;
+    size_t dataLen = 0;
+   rc = wld_nl80211_getVendorDataFromVendorMsg(rc, nlh, &data, &dataLen);
+    if(rc < SWL_RC_OK || data == NULL) {
+        SAH_TRACEZ_ERROR(ME, "Failed to get vendor data, rc=%d", rc);
+        pCtx->rc = rc;
+        return rc;
+    }
+
+    if(dataLen >= 12) {  
+        uint32_t value = *((uint32_t*)((uint8_t*)data + 8));
+        *pCtx->pEnabled = (value != 0);
+        SAH_TRACEZ_INFO(ME, "SubChannelMarking: dataLen=%zu, value=%u, enabled=%d", dataLen, value, *pCtx->pEnabled);
+       pCtx->rc = SWL_RC_OK;
+        return SWL_RC_OK;
+    }
+
+    SAH_TRACEZ_ERROR(ME, "Invalid vendor data length: %zu (expected >= 12)", dataLen);
+    pCtx->rc = SWL_RC_ERROR;
+    return SWL_RC_ERROR;
+}
+
+swl_rc_ne wld_rad_nl80211_getSubChannelMarking(T_Radio* pRad, bool* pEnabled) {
+    swl_rc_ne rc = SWL_RC_INVALID_PARAM;
+    ASSERT_NOT_NULL(pRad, rc, ME, "NULL radio");
+    ASSERT_NOT_NULL(pEnabled, rc, ME, "NULL output");
+
+    uint32_t radioIdx = wld_rad_nl80211_getRadioIdx(pRad);
+
+    SAH_TRACEZ_INFO(ME, "%s: getSubChannelMarking radioIdx=%u", pRad->Name, radioIdx);
+
+    if(pRad->index <= 0 && pRad->wDevId == 0) {
+        SAH_TRACEZ_WARNING(ME, "%s: radio not available", pRad->Name);
+        return SWL_RC_ERROR;
+    }
+
+    uint8_t radioIdxU8 = (uint8_t)radioIdx;
+    uint32_t dparam0Val = QCA_DPARAM0_WIFI_PARAMS;
+    uint32_t dparam1Val = QCA_DPARAM1_MARK_SUBCHAN;
+
+    NL_ATTR_NESTED(vendorAttr, NL80211_ATTR_VENDOR_DATA);
+    NL_ATTRS_ADD(&vendorAttr.data.attribs, NL_ATTR_VAL(QCA_ATTR_RADIO_IDX, radioIdxU8));
+    NL_ATTRS_ADD(&vendorAttr.data.attribs, NL_ATTR_VAL(QCA_ATTR_DPARAM0, dparam0Val));
+    NL_ATTRS_ADD(&vendorAttr.data.attribs, NL_ATTR_VAL(QCA_ATTR_DPARAM1, dparam1Val));
+
+    s_subChanMarkCtx_t ctx = {
+        .pEnabled = pEnabled,
+        .rc = SWL_RC_ERROR
+    };
+
+    rc = wld_rad_nl80211_sendVendorSubCmdAttr(pRad, QCA_VENDOR_ID, QCA_VENDOR_SUBCMD_GET,
+                                              &vendorAttr, true, false, 0,
+                                              s_getSubChannelMarkingCb, &ctx);
+
+    NL_ATTRS_CLEAR(&vendorAttr.data.attribs);
+
+    if(rc != SWL_RC_OK) {
+        SAH_TRACEZ_ERROR(ME, "%s: getSubChannelMarking failed rc=%d", pRad->Name, rc);
+        return rc;
+    }
+
+    return ctx.rc;
+}
+
