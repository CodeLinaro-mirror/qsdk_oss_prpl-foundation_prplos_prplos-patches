Index: pwhm-v7.14.11/include/wld/wld.h
===================================================================
--- pwhm-v7.14.11.orig/include/wld/wld.h
+++ pwhm-v7.14.11/include/wld/wld.h
@@ -1985,6 +1985,18 @@ struct S_ACCESSPOINT {
     wld_extMod_dataList_t extDataList;        /* list of extention data for non-chipset vendor modules */
     amxc_llist_t llIntfWds;                   /* list of wds interface related to this VAP (wld_wds_intf_t) */
     wld_mldCfg_t mldCfg;                      /* MLD config options */
+
+    uint8_t dynamicVlan;
+    char vlanTaggedInterface[IFNAMSIZ];
+    char vlanBridge[IFNAMSIZ];
+    uint8_t vlanNaming;
+    char wpaPskFile[128];
+    char saePasswordFile[128];
+
+    char beaconRate[128];
+    char supportedRates[128];
+    char basicRates[128];
+    char probeResponseRate[128];
 };
 
 typedef struct SWL_PACKED {
Index: pwhm-v7.14.11/odl/wld_accesspoint.odl
===================================================================
--- pwhm-v7.14.11.orig/odl/wld_accesspoint.odl
+++ pwhm-v7.14.11/odl/wld_accesspoint.odl
@@ -2561,6 +2561,40 @@ define rrm_t{
 
 		htable debug(%in string op);
 
+                /*
+                 * MPSK/Dynamic VLAN related configuration
+                */
+                /* DynamicVlan
+                 * # 0 = disabled (default); only VLAN IDs from accept_mac_file will be used
+                 * # 1 = optional; use default interface if RADIUS server does not include VLAN ID
+                 * # 2 = required; reject authentication if RADIUS server does not include VLAN ID
+                */
+
+                %persistent uint8 DynamicVlan {
+			on action validate call check_range { min = 0, max = 2 };
+                       default 0;
+                }
+                %persistent string VlanTaggedInterface;
+                %persistent string VlanBridge;
+                /* VlanNaming
+                 * # 0 = vlan<XXX>, e.g., vlan1
+                 * # 1 = <vlan_tagged_interface>.<XXX>, e.g. eth0.1
+                */
+                %persistent uint8 VlanNaming {
+			on action validate call check_range { min = 0, max = 1 };
+                       default 0;
+                }
+                %persistent string WpaPskFile;
+                %persistent string SaePasswordFile;
+
+                /*
+                 * MLME MGMT Beacon Control
+                */
+                %persistent string BeaconRate;
+                %persistent string SupportedRates;
+                %persistent string BasicRates;
+                %persistent string ProbeResponseRate;
+
 	} /* object AccessPoint */
     }
 }
Index: pwhm-v7.14.11/src/nl80211/wld_hostapd_cfgFile.c
===================================================================
--- pwhm-v7.14.11.orig/src/nl80211/wld_hostapd_cfgFile.c
+++ pwhm-v7.14.11/src/nl80211/wld_hostapd_cfgFile.c
@@ -1161,6 +1161,29 @@ static bool s_setVapCommonConfig(T_Acces
         swl_mapCharFmt_addValInt32(vapConfigMap, "wpa_group_update_count", 8);
         swl_mapCharFmt_addValInt32(vapConfigMap, "wpa_pairwise_update_count", 8);
     }
+
+    if(pAP->dynamicVlan) {
+        swl_mapCharFmt_addValInt32(vapConfigMap, "dynamic_vlan", pAP->dynamicVlan);
+        swl_mapCharFmt_addValInt32(vapConfigMap, "vlan_naming", pAP->vlanNaming);
+        if(!swl_str_isEmpty(pAP->vlanTaggedInterface))
+             swl_mapCharFmt_addValStr(vapConfigMap, "vlan_tagged_interface", pAP->vlanTaggedInterface);
+         if(!swl_str_isEmpty(pAP->vlanBridge))
+             swl_mapCharFmt_addValStr(vapConfigMap, "vlan_bridge", pAP->vlanBridge);
+         if(!swl_str_isEmpty(pAP->wpaPskFile))
+             swl_mapCharFmt_addValStr(vapConfigMap, "wpa_psk_file", pAP->wpaPskFile);
+         if(!swl_str_isEmpty(pAP->saePasswordFile))
+             swl_mapCharFmt_addValStr(vapConfigMap, "sae_password_file", pAP->saePasswordFile);
+    }
+
+    if(!swl_str_isEmpty(pAP->beaconRate))
+         swl_mapCharFmt_addValStr(vapConfigMap, "beacon_rate", pAP->beaconRate);
+    if(!swl_str_isEmpty(pAP->supportedRates))
+         swl_mapCharFmt_addValStr(vapConfigMap, "supported_rates", pAP->supportedRates);
+    if(!swl_str_isEmpty(pAP->basicRates))
+         swl_mapCharFmt_addValStr(vapConfigMap, "basic_rates", pAP->basicRates);
+    if(!swl_str_isEmpty(pAP->probeResponseRate))
+         swl_mapCharFmt_addValStr(vapConfigMap, "probe_resp_rate", pAP->probeResponseRate);
+
     return true;
 }
 
