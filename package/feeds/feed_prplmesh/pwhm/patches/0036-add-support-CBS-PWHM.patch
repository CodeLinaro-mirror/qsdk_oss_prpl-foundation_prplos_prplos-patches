diff --git a/src/wld_radio.c b/src/wld_radio.c
index bf45ac2..96b608c 100644
--- a/src/wld_radio.c
+++ b/src/wld_radio.c
@@ -3793,11 +3793,246 @@ SWLA_DM_HDLRS(sRadioAcsDmHdlrs,
                   ));
 
 void _wld_rad_setAcsConf_ocf(const char* const sig_name,
-                              const amxc_var_t* const data,
-                              void* const priv) {
+                               const amxc_var_t* const data,
+                               void* const priv) {
     swla_dm_procObjEvtOfLocalDm(&sRadioAcsDmHdlrs, sig_name, data, priv);
 }
 
+/* ============================================================
+ * WiFi.Radio.{i}.CBS object implementation
+ *
+ * CBS (Continuous Background Scan) performs background scans on
+ * other channels while the AP continues serving clients on the
+ * current operating channel. Scan results identify the best
+ * candidate channel for a future Channel Switch (CSA).
+ *
+ * All parameters are per-radio in hostapd (stored in
+ * hostapd_iface->conf_extn.cbs_params, not per-BSS). Commands
+ * are sent via wpa_ctrl to the first active AP on the radio.
+ *
+ * Confirmed: CBS parameters set on wlan2.2 are visible on wlan2.1
+ * — both share the same hostapd_iface.
+ * ============================================================ */
+
+/**
+ * @brief Get the first active (or enabled) AP on a radio for CBS wpa_ctrl commands.
+ */
+static T_AccessPoint* s_getCbsAp(T_Radio* pRad) {
+    T_AccessPoint* pAP = wld_rad_getFirstActiveAp(pRad);
+    if(pAP == NULL) {
+        pAP = wld_rad_getFirstEnabledVap(pRad);
+    }
+    return pAP;
+}
+
+/* --- CBS parameter set handlers --- */
+
+/**
+ * @brief Handler for CBS.Enable write.
+ *
+ * Sends "CBS enable <val>" via wpa_ctrl to immediately enable/disable
+ * the CBS scan. NOT written to the config file — CBS scan should not
+ * auto-start on hostapd restart.
+ *
+ * val=0: disable CBS scan
+ * val=1: enable CBS scan once (scan all channels once, then stop)
+ * val=2: enable CBS scan continuously (keep scanning in background)
+ */
+static void s_setCbsEnable_pwf(void* priv _UNUSED, amxd_object_t* object,
+                                amxd_param_t* param _UNUSED,
+                                const amxc_var_t* const newValue) {
+    T_Radio* pRad = wld_rad_fromObj(amxd_object_get_parent(object));
+    ASSERTI_NOT_NULL(pRad, , ME, "NULL");
+    uint32_t val = amxc_var_dyncast(uint32_t, newValue);
+    ASSERTI_TRUE(wld_rad_isActive(pRad), , ME, "%s: CBS.Enable: radio not active", pRad->Name);
+    T_AccessPoint* pAP = s_getCbsAp(pRad);
+    ASSERTI_NOT_NULL(pAP, , ME, "%s: CBS.Enable: no AP available", pRad->Name);
+    SAH_TRACEZ_INFO(ME, "%s: CBS.Enable=%u via %s", pRad->Name, val, pAP->alias);
+    wld_wpaCtrl_sendCmdFmtCheckResponse(pAP->wpaCtrlInterface, "OK",
+                                        "CBS enable %u", val);
+}
+
+/**
+ * @brief Handler for CBS.RestTime write.
+ *
+ * Sends "CBS resttime <ms>" via wpa_ctrl for immediate effect.
+ * Also written to hostapd.conf (persistent) so it survives restarts.
+ */
+static void s_setCbsRestTime_pwf(void* priv _UNUSED, amxd_object_t* object,
+                                  amxd_param_t* param _UNUSED,
+                                  const amxc_var_t* const newValue) {
+    T_Radio* pRad = wld_rad_fromObj(amxd_object_get_parent(object));
+    ASSERTI_NOT_NULL(pRad, , ME, "NULL");
+    uint32_t val = amxc_var_dyncast(uint32_t, newValue);
+    /* Always rewrite config file so the new value persists across restarts. */
+    wld_hostapd_cfgFile_createExt(pRad);
+    if(!wld_rad_isActive(pRad)) return;
+    T_AccessPoint* pAP = s_getCbsAp(pRad);
+    ASSERTI_NOT_NULL(pAP, , ME, "%s: CBS.RestTime: no AP available", pRad->Name);
+    SAH_TRACEZ_INFO(ME, "%s: CBS.RestTime=%u via %s", pRad->Name, val, pAP->alias);
+    wld_wpaCtrl_sendCmdFmtCheckResponse(pAP->wpaCtrlInterface, "OK",
+                                        "CBS resttime %u", val);
+}
+
+/**
+ * @brief Handler for CBS.DwellRest write.
+ *
+ * Sends "CBS dwellrest <ms>" via wpa_ctrl for immediate effect.
+ * Also written to hostapd.conf (persistent) so it survives restarts.
+ */
+static void s_setCbsDwellRest_pwf(void* priv _UNUSED, amxd_object_t* object,
+                                   amxd_param_t* param _UNUSED,
+                                   const amxc_var_t* const newValue) {
+    T_Radio* pRad = wld_rad_fromObj(amxd_object_get_parent(object));
+    ASSERTI_NOT_NULL(pRad, , ME, "NULL");
+    uint32_t val = amxc_var_dyncast(uint32_t, newValue);
+    wld_hostapd_cfgFile_createExt(pRad);
+    if(!wld_rad_isActive(pRad)) return;
+    T_AccessPoint* pAP = s_getCbsAp(pRad);
+    ASSERTI_NOT_NULL(pAP, , ME, "%s: CBS.DwellRest: no AP available", pRad->Name);
+    SAH_TRACEZ_INFO(ME, "%s: CBS.DwellRest=%u via %s", pRad->Name, val, pAP->alias);
+    wld_wpaCtrl_sendCmdFmtCheckResponse(pAP->wpaCtrlInterface, "OK",
+                                        "CBS dwellrest %u", val);
+}
+
+/**
+ * @brief Handler for CBS.WaitTime write.
+ *
+ * Sends "CBS waittime <ms>" via wpa_ctrl for immediate effect.
+ * Also written to hostapd.conf (persistent) so it survives restarts.
+ */
+static void s_setCbsWaitTime_pwf(void* priv _UNUSED, amxd_object_t* object,
+                                  amxd_param_t* param _UNUSED,
+                                  const amxc_var_t* const newValue) {
+    T_Radio* pRad = wld_rad_fromObj(amxd_object_get_parent(object));
+    ASSERTI_NOT_NULL(pRad, , ME, "NULL");
+    uint32_t val = amxc_var_dyncast(uint32_t, newValue);
+    wld_hostapd_cfgFile_createExt(pRad);
+    if(!wld_rad_isActive(pRad)) return;
+    T_AccessPoint* pAP = s_getCbsAp(pRad);
+    ASSERTI_NOT_NULL(pAP, , ME, "%s: CBS.WaitTime: no AP available", pRad->Name);
+    SAH_TRACEZ_INFO(ME, "%s: CBS.WaitTime=%u via %s", pRad->Name, val, pAP->alias);
+    wld_wpaCtrl_sendCmdFmtCheckResponse(pAP->wpaCtrlInterface, "OK",
+                                        "CBS waittime %u", val);
+}
+
+/**
+ * @brief Handler for CBS.DwellSplit write.
+ *
+ * Sends "CBS dwellsplit <ms>" via wpa_ctrl for immediate effect.
+ * Also written to hostapd.conf (persistent) so it survives restarts.
+ */
+static void s_setCbsDwellSplit_pwf(void* priv _UNUSED, amxd_object_t* object,
+                                    amxd_param_t* param _UNUSED,
+                                    const amxc_var_t* const newValue) {
+    T_Radio* pRad = wld_rad_fromObj(amxd_object_get_parent(object));
+    ASSERTI_NOT_NULL(pRad, , ME, "NULL");
+    uint32_t val = amxc_var_dyncast(uint32_t, newValue);
+    wld_hostapd_cfgFile_createExt(pRad);
+    if(!wld_rad_isActive(pRad)) return;
+    T_AccessPoint* pAP = s_getCbsAp(pRad);
+    ASSERTI_NOT_NULL(pAP, , ME, "%s: CBS.DwellSplit: no AP available", pRad->Name);
+    SAH_TRACEZ_INFO(ME, "%s: CBS.DwellSplit=%u via %s", pRad->Name, val, pAP->alias);
+    wld_wpaCtrl_sendCmdFmtCheckResponse(pAP->wpaCtrlInterface, "OK",
+                                        "CBS dwellsplit %u", val);
+}
+
+/**
+ * @brief Handler for CBS.TotalDwell write.
+ *
+ * Sends "CBS totaldwell <ms>" via wpa_ctrl for immediate effect.
+ * Also written to hostapd.conf (persistent) so it survives restarts.
+ */
+static void s_setCbsTotalDwell_pwf(void* priv _UNUSED, amxd_object_t* object,
+                                    amxd_param_t* param _UNUSED,
+                                    const amxc_var_t* const newValue) {
+    T_Radio* pRad = wld_rad_fromObj(amxd_object_get_parent(object));
+    ASSERTI_NOT_NULL(pRad, , ME, "NULL");
+    uint32_t val = amxc_var_dyncast(uint32_t, newValue);
+    wld_hostapd_cfgFile_createExt(pRad);
+    if(!wld_rad_isActive(pRad)) return;
+    T_AccessPoint* pAP = s_getCbsAp(pRad);
+    ASSERTI_NOT_NULL(pAP, , ME, "%s: CBS.TotalDwell: no AP available", pRad->Name);
+    SAH_TRACEZ_INFO(ME, "%s: CBS.TotalDwell=%u via %s", pRad->Name, val, pAP->alias);
+    wld_wpaCtrl_sendCmdFmtCheckResponse(pAP->wpaCtrlInterface, "OK",
+                                        "CBS totaldwell %u", val);
+}
+
+/* --- CBS.Enable read action (active read from hostapd) --- */
+
+/**
+ * @brief Read action for CBS.Enable — queries "CBS g_enable" from hostapd.
+ *
+ * Returns the current CBS enable state as reported by hostapd.
+ * Falls back to the stored DM value if the radio is not active.
+ *
+ * hostapd response format: "CBS enable: <val>\n"
+ * where val is 0 (disabled), 1 (scan once), or 2 (continuous).
+ */
+amxd_status_t _wld_rad_getCbsEnable_prf(amxd_object_t* object,
+                                          amxd_param_t* param,
+                                          amxd_action_t reason,
+                                          const amxc_var_t* const args _UNUSED,
+                                          amxc_var_t* const retval,
+                                          void* priv _UNUSED) {
+    ASSERTS_NOT_NULL(param, amxd_status_unknown_error, ME, "NULL");
+    ASSERTS_EQUALS(reason, action_param_read, amxd_status_function_not_implemented,
+                   ME, "not impl");
+
+    /* CBS object is child of Radio instance */
+    T_Radio* pRad = wld_rad_fromObj(amxd_object_get_parent(object));
+    ASSERTS_NOT_NULL(pRad, amxd_status_ok, ME, "no radio mapped");
+
+    /* Default: return the stored/persisted value */
+    uint32_t value = amxc_var_dyncast(uint32_t, &param->value);
+
+    T_AccessPoint* pAP = s_getCbsAp(pRad);
+    if(pAP != NULL && wld_rad_isActive(pRad)) {
+        char reply[256] = {0};
+        swl_rc_ne rc = wld_wpaCtrl_sendCmdFmtGetResponse(
+            pAP->wpaCtrlInterface, reply, sizeof(reply), "CBS g_enable");
+        if(swl_rc_isOk(rc)) {
+            /*
+             * hostapd response format (from hostapd_cbs_get_enable):
+             * "CBS enable: <val>\n"
+             */
+            unsigned int cbsEnable = 0;
+            if(sscanf(reply, "CBS enable: %u", &cbsEnable) == 1) {
+                value = cbsEnable;
+                SAH_TRACEZ_INFO(ME, "%s: CBS.Enable read from hostapd: %u",
+                                pRad->Name, value);
+            }
+        }
+    }
+
+    amxc_var_set(uint32_t, retval, value);
+    return amxd_status_ok;
+}
+
+/* --- CBS SWLA_DM_HDLRS --- */
+
+SWLA_DM_HDLRS(sRadioCbsDmHdlrs,
+              ARR(SWLA_DM_PARAM_HDLR("Enable",     s_setCbsEnable_pwf),
+                  SWLA_DM_PARAM_HDLR("RestTime",   s_setCbsRestTime_pwf),
+                  SWLA_DM_PARAM_HDLR("DwellRest",  s_setCbsDwellRest_pwf),
+                  SWLA_DM_PARAM_HDLR("WaitTime",   s_setCbsWaitTime_pwf),
+                  SWLA_DM_PARAM_HDLR("DwellSplit", s_setCbsDwellSplit_pwf),
+                  SWLA_DM_PARAM_HDLR("TotalDwell", s_setCbsTotalDwell_pwf),
+                  ));
+
+/**
+ * @brief Event dispatcher for WiFi.Radio.{i}.CBS object changes.
+ *
+ * Called by the AMX data model framework when any parameter in the CBS
+ * sub-object changes. Dispatches to the appropriate per-parameter handler
+ * in sRadioCbsDmHdlrs.
+ */
+void _wld_rad_setCbsConf_ocf(const char* const sig_name,
+                               const amxc_var_t* const data,
+                               void* const priv) {
+    swla_dm_procObjEvtOfLocalDm(&sRadioCbsDmHdlrs, sig_name, data, priv);
+}
+
 amxd_status_t _startPlatformACS(amxd_object_t* object,
                                 amxd_function_t* func _UNUSED,
                                 const amxc_var_t* const args,
