diff --git a/odl/wld_radio.odl b/odl/wld_radio.odl
index 18d373c..56bdc56 100644
--- a/odl/wld_radio.odl
+++ b/odl/wld_radio.odl
@@ -1122,6 +1122,99 @@ define probelist_t{
 			string showNeighborReport();
 		}
 
+		/**
+		 * CBS (Continuous Background Scan) runtime configuration and control.
+		 *
+		 * CBS performs background scans on other channels while the AP continues
+		 * serving clients on the current operating channel. Scan results are used
+		 * to identify the best candidate channel for a future Channel Switch (CSA).
+		 *
+		 * All parameters are per-radio in hostapd (stored in
+		 * hostapd_iface->conf_extn.cbs_params, not per-BSS). Commands are sent
+		 * via wpa_ctrl to the first active AP on this radio.
+		 *
+		 * Persistence semantics — two categories:
+		 *
+		 * 1. Config-file parameters (%persistent): written to hostapd.conf so they
+		 *    survive hostapd restarts. Also applied at runtime via wpa_ctrl when
+		 *    changed while the radio is active.
+		 *    Parameters: RestTime, DwellRest, WaitTime, DwellSplit, TotalDwell.
+		 *
+		 * 2. Runtime-only parameter (non-persistent): Enable is NOT persisted
+		 *    because CBS scan should not auto-start on hostapd restart. It is
+		 *    applied at runtime via "CBS enable <val>" wpa_ctrl command only.
+		 */
+		%persistent object CBS {
+			on event "*" call wld_rad_setCbsConf_ocf;
+
+			/**
+			 * Enable/disable CBS scan.
+			 * 0 = disable CBS scan
+			 * 1 = enable CBS scan once (scan all channels once, then stop)
+			 * 2 = enable CBS scan continuously (keep scanning in background)
+			 * Sent as: CBS enable <0|1|2>
+			 * NOT persistent: CBS scan should not auto-start on hostapd restart.
+			 * Reading this parameter actively queries: CBS g_enable
+			 */
+			uint32 Enable {
+				on action validate call check_range { min = 0, max = 2 };
+				on action read call wld_rad_getCbsEnable_prf;
+				default 0;
+			}
+
+			/**
+			 * Time to wait between scans on different channels (milliseconds).
+			 * Sent as: CBS resttime <ms>
+			 * Written to hostapd config as: cbs_resttime <ms>
+			 * hostapd default: 500 ms
+			 */
+			%persistent uint32 RestTime {
+				default 500;
+			}
+
+			/**
+			 * Rest time before issuing the next consecutive scan on the same
+			 * channel (milliseconds).
+			 * Sent as: CBS dwellrest <ms>
+			 * Written to hostapd config as: cbs_dwellrest <ms>
+			 * hostapd default: 500 ms
+			 */
+			%persistent uint32 DwellRest {
+				default 500;
+			}
+
+			/**
+			 * Time to wait after scanning all channels before starting the next
+			 * scan cycle (milliseconds).
+			 * Sent as: CBS waittime <ms>
+			 * Written to hostapd config as: cbs_waittime <ms>
+			 * hostapd default: 1000 ms
+			 */
+			%persistent uint32 WaitTime {
+				default 1000;
+			}
+
+			/**
+			 * Dwell split time on a foreign channel for one scan (milliseconds).
+			 * Sent as: CBS dwellsplit <ms>
+			 * Written to hostapd config as: cbs_dwellsplit <ms>
+			 * hostapd default: 50 ms
+			 */
+			%persistent uint32 DwellSplit {
+				default 50;
+			}
+
+			/**
+			 * Total dwell time for scan on a single channel (milliseconds).
+			 * Sent as: CBS totaldwell <ms>
+			 * Written to hostapd config as: cbs_totaldwell <ms>
+			 * hostapd default: 200 ms
+			 */
+			%persistent uint32 TotalDwell {
+				default 200;
+			}
+		}
+
 		/** <p>The current radio channel used by the connection. To
 			 request automatic channel selection, set AutoChannelEnable
 			 to true. Whenever AutoChannelEnable is true, the value of
diff --git a/src/nl80211/wld_hostapd_cfgFile.c b/src/nl80211/wld_hostapd_cfgFile.c
index ff8f4d2..e478a90 100644
--- a/src/nl80211/wld_hostapd_cfgFile.c
+++ b/src/nl80211/wld_hostapd_cfgFile.c
@@ -803,6 +803,47 @@ void wld_hostapd_cfgFile_setRadioConfig(T_Radio* pRad, swl_mapChar_t* radConfigM
         SAH_TRACEZ_INFO(ME, "%s: Restore radio channel config due to external ACS mgmt enabled", pRad->Name);
         swl_mapCharFmt_addValInt32(radConfigMap, "channel", tgtChan);
     }
+
+    /*
+     * Write CBS (Continuous Background Scan) timing parameters to the
+     * hostapd config file.
+     *
+     * All timing parameters are written unconditionally so they persist
+     * across hostapd restarts and take effect on the next CBS scan trigger.
+     *
+     * Note: cbs_enable is intentionally NOT written to the config file.
+     * CBS scan should not auto-start on hostapd restart — it must be
+     * explicitly triggered at runtime via "CBS enable <val>" wpa_ctrl command.
+     *
+     * Cross-reference with hostapd ap_config_extn.c:
+     *   cbs_resttime   → conf_extn->cbs_params.resttime
+     *   cbs_dwellrest  → conf_extn->cbs_params.dwellrest
+     *   cbs_waittime   → conf_extn->cbs_params.waittime
+     *   cbs_dwellsplit → conf_extn->cbs_params.dwellsplit
+     *   cbs_totaldwell → conf_extn->cbs_params.totaldwell
+     */
+    if(pRad->pBus) {
+        amxd_object_t* cbsObj = amxd_object_findf(pRad->pBus, "CBS");
+        if(cbsObj != NULL) {
+            uint32_t restTime   = amxd_object_get_uint32_t(cbsObj, "RestTime",   NULL);
+            uint32_t dwellRest  = amxd_object_get_uint32_t(cbsObj, "DwellRest",  NULL);
+            uint32_t waitTime   = amxd_object_get_uint32_t(cbsObj, "WaitTime",   NULL);
+            uint32_t dwellSplit = amxd_object_get_uint32_t(cbsObj, "DwellSplit", NULL);
+            uint32_t totalDwell = amxd_object_get_uint32_t(cbsObj, "TotalDwell", NULL);
+
+            swl_mapCharFmt_addValInt32(radConfigMap, "cbs_resttime",   restTime);
+            swl_mapCharFmt_addValInt32(radConfigMap, "cbs_dwellrest",  dwellRest);
+            swl_mapCharFmt_addValInt32(radConfigMap, "cbs_waittime",   waitTime);
+            swl_mapCharFmt_addValInt32(radConfigMap, "cbs_dwellsplit", dwellSplit);
+            swl_mapCharFmt_addValInt32(radConfigMap, "cbs_totaldwell", totalDwell);
+
+            SAH_TRACEZ_INFO(ME, "%s: CBS config file params written "
+                            "(resttime=%u, dwellrest=%u, waittime=%u, "
+                            "dwellsplit=%u, totaldwell=%u)",
+                            pRad->Name, restTime, dwellRest, waitTime,
+                            dwellSplit, totalDwell);
+        }
+    }
 }
 
