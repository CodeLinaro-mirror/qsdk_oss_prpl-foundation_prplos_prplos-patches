+/* A permanent handover failure must not retain the shared FSM lock forever.
+ * Only cancel this AP's active link actions. Pending edits and other APs keep
+ * their actions; a subsequent request gets a fresh retry budget. */
+static bool s_retryMbssidRemoval(T_AccessPoint* pAP, T_Radio* pRad) {
+    if(++pAP->fsm.retryCount < 5) {
+        pRad->fsmRad.timeout_msec = 1000;
+        return false;
+    }
+    SAH_TRACEZ_ERROR(ME, "%s: MBSSID removal failed after 5 attempts; retaining BSS and releasing commit",
+                     pAP->alias);
+    pAP->fsm.retryCount = 0;
+    pAP->fsm.FSM_Error = 1;
+    clearBitLongArray(pAP->fsm.FSM_AC_BitActionArray, FSM_BW, GEN_FSM_ENABLE_AP);
+    clearBitLongArray(pAP->fsm.FSM_AC_BitActionArray, FSM_BW, GEN_FSM_REMOVE_LINK);
+    clearBitLongArray(pAP->fsm.FSM_AC_BitActionArray, FSM_BW, GEN_FSM_ADD_LINK);
+    setBitLongArray(pRad->fsmRad.FSM_AC_BitActionArray, FSM_BW, GEN_FSM_SYNC_STATE);
+    return true;
 }
 
 static bool s_hasForeignMldInDaemon(T_AccessPoint* pAP, T_Radio* pRad) {
