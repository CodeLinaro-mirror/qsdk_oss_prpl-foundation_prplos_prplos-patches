+     * before the first REMOVE, just as the ordinary VAP disable path does.
+     * A lost handover reply may have changed the role already: on retry,
+     * also verify recovery of groups whose transmitter now looks safe. */
+    bool retryHandover = (pAP->fsm.retryCount > 0);
+    bool preparedHandover = false;
+    for(size_t i = 0; i < count; i++) {
+        T_AccessPoint* pMember = members[i].ap;
+        T_Radio* pMemberRad = pMember->pRadio;
+        if(!s_isUnsafeMbssidRemoval(pMember, pMemberRad) &&
+           !(retryHandover && wld_rad_hasMbssidAds(pMemberRad) &&
+             s_hasForeignMldOnRadio(pMember, pMemberRad))) {
+            continue;
+        }
+        if(!swl_rc_isOk(wld_ap_hostapd_prepareMloRemoval(pMember)) ||
+           s_isUnsafeMbssidRemoval(pMember, pMemberRad)) {
+            SAH_TRACEZ_ERROR(ME, "%s: cannot prepare MBSSID member %s for MLD migration",
+                             pAP->alias, pMember->alias);
+            /* Once removal has begun, keep the existing rebuild barrier
+             * and recovery path. Preflight failure can safely end this
+             * request without leaving a shared FSM lock held forever. */
+            if(pSource->hostapdRebuildPending) {
