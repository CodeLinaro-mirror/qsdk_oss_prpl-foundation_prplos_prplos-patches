+                    return SWL_RC_INVALID_STATE;
+                }
+                return s_retryMbssidRemoval(pAP, pRad) ? SWL_RC_OK : SWL_RC_ERROR;
+            }
+        }
+    }
+    pAP->fsm.retryCount = 0;
+    pAP->fsm.FSM_Error = 0;
     pSource->hostapdRebuildPending = true;
