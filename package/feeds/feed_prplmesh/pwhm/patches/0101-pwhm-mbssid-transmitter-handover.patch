+static bool s_isLiveMbssidMloLink(T_AccessPoint* pAP) {
+    if((pAP->pSSID == NULL) || (pAP->pSSID->pMldLink == NULL) ||
+       !wld_wpaCtrlInterface_isReady(pAP->wpaCtrlInterface)) {
+        return false;
+    }
+    wld_nl80211_ifaceInfo_t info;
+    memset(&info, 0, sizeof(info));
+    char runIface[128] = {0};
+    int32_t linkId = NO_LINK_ID;
+    if(!swl_rc_isOk(wld_ap_nl80211_getInterfaceInfo(pAP, &info)) || !info.isAp ||
+       !swl_rc_isOk(wld_ap_hostapd_getRunIface(pAP, runIface, sizeof(runIface))) ||
+       !swl_str_matches(info.name, runIface) ||
+       !swl_rc_isOk(wld_ap_hostapd_getMldLinkId(pAP, &linkId))) {
+        return false;
+    }
+    const wld_nl80211_ifaceMloLinkInfo_t* link =
+        wld_nl80211_fetchIfaceMloLinkByFreqBand(&info, pAP->pRadio->operatingFrequencyBand);
+    return (link != NULL) && (linkId >= 0) && (link->link.linkId == linkId) &&
+           (link->chanSpec.ctrlFreq != 0) &&
+           swl_typeMacBin_equals(link->link.linkMac, *wld_ssid_getLinkMac(pAP->pSSID));
+}
+
+/* GET mbssid_attributes identifies the transmitting profile of each group.
+ * STATUS bssid[0] identifies the first radio BSS and need not be that profile
+ * after SET_MBSSID_TX rotates a multi-MBSSID group's list. Match link MACs,
+ * since the displayed interface names are MLD anchors shared across bands. */
+static swl_rc_ne s_getMbssidGroup(T_AccessPoint* pAP, T_AccessPoint** members,
+                                 size_t capacity, size_t* count, T_AccessPoint** tx) {
+    char reply[4096] = {0};
+    struct {
+        T_AccessPoint* ap;
+        char iface[128];
+        unsigned index;
+        unsigned group;
+        bool transmitting;
+    } rows[32];
+    size_t nRows = 0;
+    int target = -1;
+    *count = 0;
+    *tx = NULL;
+    swl_rc_ne rc = wld_wpaCtrl_sendCmdFmtGetResponse(pAP->wpaCtrlInterface, reply, sizeof(reply),
+                                                    "GET mbssid_attributes");
+    /* The configured mode may differ from the running radio during an edit.
+     * Only this explicit hostapd reply proves that no shared group exists. */
+    if(swl_rc_isOk(rc) && (swl_str_matches(reply, "MBSSID is disabled") ||
+                          swl_str_matches(reply, "MBSSID is disabled\n"))) {
+        return SWL_RC_OK;
+    }
+    ASSERT_TRUE(swl_rc_isOk(rc) && (strlen(reply) < sizeof(reply) - 2) &&
+                (strstr(reply, "BSSID_INDEX") != NULL), SWL_RC_ERROR, ME,
+                "%s: cannot read complete MBSSID membership", pAP->alias);
+    bool multiGroup = (strstr(reply, "GRP_ID") != NULL);
+    ASSERT_TRUE(strstr(reply, multiGroup ? "mbssid_group_size =" : "mbssid_idx_bmap =") != NULL,
+                SWL_RC_ERROR, ME, "%s: incomplete MBSSID table", pAP->alias);
+    unsigned groupMask = 0, reportedGroups = 0;
+    size_t completeGroups = 0;
+    bool complete = true, hasGroupCount = false;
+    char* save = NULL;
+    for(char* line = strtok_r(reply, "\n", &save); line != NULL; line = strtok_r(NULL, "\n", &save)) {
+        if(multiGroup && (strncmp(line, "mbssid_idx_bmap =", 16) == 0)) {
+            unsigned mask = 0;
+            char extra;
+            complete &= (sscanf(line, "mbssid_idx_bmap = %x %c", &mask, &extra) == 1) &&
+                        (mask == groupMask) && ((groupMask & 1) != 0);
+            groupMask = 0;
+            completeGroups++;
+            continue;
+        }
+        if(multiGroup && (strncmp(line, "current_active_ngroups =", 23) == 0)) {
+            char extra;
+            complete &= !hasGroupCount;
+            hasGroupCount = (sscanf(line, "current_active_ngroups = %u %c", &reportedGroups, &extra) == 1);
+            continue;
+        }
+        if((strncmp(line, "IFACE ", 6) == 0) || (strncmp(line, "==", 2) == 0) ||
+           (strncmp(line, "mbssid_idx_bmap =", 16) == 0) ||
+           (strncmp(line, "current_active_ngroups =", 23) == 0) ||
+           (strncmp(line, "max_ngroups =", 13) == 0) ||
+           (strncmp(line, "mbssid_group_size =", 19) == 0)) {
+            continue;
+        }
+        char iface[128], macStr[18];
+        int offset = 0;
+        ASSERT_TRUE(sscanf(line, "%127s %17s %n", iface, macStr, &offset) == 2,
+                    SWL_RC_ERROR, ME, "%s: malformed MBSSID row", pAP->alias);
+        swl_macBin_t mac;
+        ASSERT_TRUE(swl_typeMacBin_fromChar(&mac, macStr), SWL_RC_ERROR, ME, "Invalid MBSSID MAC");
+        char* rest = line + offset;
+        bool transmitting = (*rest == '*');
+        if(transmitting) {
+            rest++;
+        }
+        unsigned index = 0, group = 0;
+        char extra;
+        int fields = sscanf(rest, "%u %u %c", &index, &group, &extra);
+        ASSERT_TRUE((fields == (multiGroup ? 2 : 1)) && (index < 32) &&
+                    (transmitting == (index == 0)) && (nRows < SWL_ARRAY_SIZE(rows)),
+                    SWL_RC_ERROR, ME, "%s: invalid MBSSID row", pAP->alias);
+        T_AccessPoint* mapped = NULL;
+        T_AccessPoint* other = NULL;
+        wld_rad_forEachAp(other, pAP->pRadio) {
+            if((other->pSSID != NULL) &&
+               swl_typeMacBin_equals(mac, *wld_ssid_getLinkMac(other->pSSID))) {
+                ASSERT_TRUE(mapped == NULL, SWL_RC_ERROR, ME, "Ambiguous MBSSID MAC");
+                mapped = other;
+            }
+        }
+        for(size_t i = 0; i < nRows; i++) {
+            ASSERT_TRUE((mapped == NULL) || (rows[i].ap != mapped), SWL_RC_ERROR, ME, "Duplicate MBSSID row");
+            ASSERT_TRUE((rows[i].group != group) || (rows[i].index != index), SWL_RC_ERROR, ME, "Duplicate MBSSID index");
+        }
+        rows[nRows].ap = mapped;
+        swl_str_copy(rows[nRows].iface, sizeof(rows[nRows].iface), iface);
+        rows[nRows].index = index;
+        rows[nRows].group = group;
+        rows[nRows].transmitting = transmitting;
+        groupMask |= 1U << index;
+        if(mapped == pAP) {
+            target = (int) nRows;
+        }
+        nRows++;
+    }
+    if(target < 0) {
+        /* A dynamically added BSS can predate multi-MBSSID group setup.
+         * Hostapd omits such an ungrouped BSS from this table and its removal
+         * has no group cascade. Require complete group bitmaps/counts and a
+         * verified live target; an incomplete or wrong-radio reply is unsafe. */
+        ASSERT_TRUE(multiGroup && complete && hasGroupCount && (groupMask == 0) &&
+                    (reportedGroups == completeGroups) && s_isLiveMbssidMloLink(pAP),
+                    SWL_RC_ERROR, ME, "%s: link missing from unverified MBSSID table", pAP->alias);
+        for(size_t i = 0; i < nRows; i++) {
+            char runIface[128] = {0};
+            ASSERT_TRUE((rows[i].ap != NULL) &&
+                        swl_rc_isOk(wld_ap_hostapd_getRunIface(rows[i].ap, runIface, sizeof(runIface))) &&
+                        swl_str_matches(runIface, rows[i].iface), SWL_RC_ERROR, ME,
+                        "%s: unverified MBSSID table member", pAP->alias);
+        }
+        SAH_TRACEZ_WARNING(ME, "%s: live BSS has no multi-MBSSID group; no handover needed", pAP->alias);
+        return SWL_RC_OK;
+    }
+    for(size_t i = 0; i < nRows; i++) {
+        if(rows[i].group != rows[target].group) {
+            continue;
+        }
+        ASSERT_TRUE((rows[i].ap != NULL) && (*count < capacity), SWL_RC_ERROR, ME,
+                    "%s: unmapped MBSSID group member", pAP->alias);
+        char runIface[128] = {0};
+        ASSERT_TRUE(swl_rc_isOk(wld_ap_hostapd_getRunIface(rows[i].ap, runIface, sizeof(runIface))) &&
+                    swl_str_matches(runIface, rows[i].iface), SWL_RC_ERROR, ME, "MBSSID interface mismatch");
+        members[(*count)++] = rows[i].ap;
+        if(rows[i].transmitting) {
+            ASSERT_TRUE(*tx == NULL, SWL_RC_ERROR, ME, "Ambiguous MBSSID transmitter");
+            *tx = rows[i].ap;
+        }
+    }
+    ASSERT_NOT_NULL(*tx, SWL_RC_ERROR, ME, "Missing MBSSID transmitter");
+    return SWL_RC_OK;
+}
+
+swl_rc_ne wld_ap_hostapd_checkMbssidRemoval(T_AccessPoint* pAP) {
+    ASSERT_NOT_NULL(pAP, SWL_RC_INVALID_PARAM, ME, "NULL AP");
+    ASSERT_NOT_NULL(pAP->pRadio, SWL_RC_INVALID_PARAM, ME, "NULL radio");
+    T_AccessPoint* members[32];
+    size_t count = 0;
+    T_AccessPoint* tx = NULL;
+    swl_rc_ne rc = s_getMbssidGroup(pAP, members, SWL_ARRAY_SIZE(members), &count, &tx);
+    if(!swl_rc_isOk(rc)) {
+        return rc;
+    }
+    return ((tx != pAP) || (count == 1)) ? SWL_RC_OK : SWL_RC_INVALID_STATE;
+}
+
+
+/* Transfer the MBSSID transmitter before removing it, so hostapd's removal
+ * cascade cannot remove another MLD. The supported hostapd handover briefly
+ * stops/starts this band's group; it does not restart the radio or daemon.
+ * Only use auto_start when every other profile is enabled and live, since
+ * hostapd otherwise also starts administratively disabled profiles. */
+swl_rc_ne wld_ap_hostapd_prepareMloRemoval(T_AccessPoint* pAP) {
+    ASSERT_NOT_NULL(pAP, SWL_RC_INVALID_PARAM, ME, "NULL AP");
+    ASSERT_NOT_NULL(pAP->pRadio, SWL_RC_INVALID_PARAM, ME, "NULL radio");
+    ASSERT_TRUE(s_isLiveMbssidMloLink(pAP), SWL_RC_ERROR, ME, "%s: unverified MLO link", pAP->alias);
+    T_AccessPoint* members[32];
+    size_t count = 0;
+    T_AccessPoint* tx = NULL;
+    swl_rc_ne rc = s_getMbssidGroup(pAP, members, SWL_ARRAY_SIZE(members), &count, &tx);
+    ASSERT_TRUE(swl_rc_isOk(rc), rc, ME, "%s: unknown MBSSID membership", pAP->alias);
+    bool needsHandover = ((tx == pAP) && (count > 1));
+    T_AccessPoint* replacement = NULL;
+    for(size_t i = 0; i < count; i++) {
+        T_AccessPoint* peer = members[i];
+        ASSERT_TRUE(s_isLiveMbssidMloLink(peer), SWL_RC_ERROR, ME, "%s: MBSSID member not live", peer->alias);
+        if((peer == pAP) || !needsHandover) {
+            continue;
+        }
+        ASSERT_TRUE(wld_ap_isEnabledWithRef(peer), SWL_RC_ERROR, ME,
+                    "%s: do not restart a disabled MBSSID profile", peer->alias);
+        if(replacement == NULL) {
+            replacement = peer;
+        }
+    }
+    if(!needsHandover) {
+        /* Other ready WLD sockets can belong to different MBSSID groups
+         * or to an MLD whose link on this radio has already disappeared. */
+        return SWL_RC_OK;
+    }
+    ASSERT_NOT_NULL(replacement, SWL_RC_ERROR, ME, "%s: no replacement MBSSID transmitter", pAP->alias);
+    SAH_TRACEZ_WARNING(ME, "%s: hand over MBSSID transmitter to %s before link removal",
+                       pAP->alias, replacement->alias);
+    rc = wld_wpaCtrl_sendCmdFmtCheckResponseExt(replacement->wpaCtrlInterface, 10000, "OK",
+                                               "SET_MBSSID_TX auto_stop auto_start");
+    ASSERT_TRUE(swl_rc_isOk(rc), rc, ME, "%s: MBSSID handover failed", pAP->alias);
+    T_AccessPoint* after[32];
+    size_t afterCount = 0;
+    rc = s_getMbssidGroup(replacement, after, SWL_ARRAY_SIZE(after), &afterCount, &tx);
+    ASSERT_TRUE(swl_rc_isOk(rc) && (tx == replacement) && (afterCount == count),
+                SWL_RC_ERROR, ME, "%s: MBSSID handover not confirmed", pAP->alias);
+    for(size_t i = 0; i < count; i++) {
+        bool found = false;
+        for(size_t j = 0; j < afterCount; j++) {
+            found |= (after[j] == members[i]);
+        }
+        ASSERT_TRUE(found && s_isLiveMbssidMloLink(members[i]), SWL_RC_ERROR, ME,
+                    "%s: waiting for MBSSID member recovery", members[i]->alias);
+    }
+    return SWL_RC_OK;
+}
