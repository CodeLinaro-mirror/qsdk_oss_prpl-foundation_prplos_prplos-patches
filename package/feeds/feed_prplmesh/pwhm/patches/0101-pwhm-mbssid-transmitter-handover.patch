+/* Check the live MBSSID group; unknown membership is unsafe to remove. */
+swl_rc_ne wld_ap_hostapd_checkMbssidRemoval(T_AccessPoint* pAP);
+/* Hand over a dependent MBSSID transmitter before removing an MLO link. */
+swl_rc_ne wld_ap_hostapd_prepareMloRemoval(T_AccessPoint* pAP);
 
