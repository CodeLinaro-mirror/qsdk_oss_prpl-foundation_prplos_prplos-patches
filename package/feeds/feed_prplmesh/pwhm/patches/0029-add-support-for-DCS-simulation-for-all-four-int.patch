+/**
+ * @brief RPC handler for DCS.Simulation() function.
+ *
+ * Triggers a synthetic DCS interference event in hostapd for testing by sending:
+ *   DCS sim <type>
+ * via the AP's wpaCtrl interface, equivalent to:
+ *   hostapd_cli -i <wlanX> DCS sim <type>
+ *
+ * Input validation is performed here — no state is stored.
+ *
+ * @param type  Mandatory interference type (from hostapd enum hostapd_dcs_intf_type):
+ *   1  = DCS_CW_INTF   (Continuous Wave interference)
+ *   2  = DCS_WLAN_INTF (WLAN interference)
+ *   4  = DCS_AWGN_INTF (AWGN interference)
+ *   16 = DCS_OBSS_INTF (Overlapping BSS interference)
+ *
+ * @return amxd_status_ok on success
+ *         amxd_status_invalid_arg if type is not one of the valid values
+ *         amxd_status_invalid_action if the AP is not yet initialized
+ *         amxd_status_unknown_error if the hostapd command fails
+ */
+amxd_status_t _Simulation(amxd_object_t* obj,
+                           amxd_function_t* func _UNUSED,
+                           amxc_var_t* args,
+                           amxc_var_t* ret) {
+    SAH_TRACEZ_IN(ME);
+
+    const char* intf_name = "Unknown";
+    T_AccessPoint* pAP = wld_ap_fromObj(amxd_object_get_parent(obj));
+    ASSERT_NOT_NULL(pAP, amxd_status_unknown_error, ME, "No AP Ctx");
+
+    uint32_t type             = GET_UINT32(args, "type");
+    const char* bitmap_str    = GET_CHAR(args, "intf_bitmap");  /* optional string, e.g. "0xC0" or "192" */
+    uint32_t intf_bitmap      = 0;
+
+    /* Parse intf_bitmap string: accepts hex (0xC0), decimal (192), or octal (0300).
+     * strtoul with base 0 auto-detects the base from the prefix.
+     * An empty/NULL string means no intf_bitmap (value stays 0). */
+    if(!swl_str_isEmpty(bitmap_str)) {
+        char* end = NULL;
+        unsigned long parsed = strtoul(bitmap_str, &end, 0);
+        if(end != bitmap_str && *end == '\0') {
+            intf_bitmap = (uint32_t) parsed;
+        } else {
+            SAH_TRACEZ_ERROR(ME, "%s: DCS.Simulation: invalid intf_bitmap '%s' — expected hex (0xC0) or decimal (192)",
+                             pAP->alias, bitmap_str);
+            amxc_var_set_type(ret, AMXC_VAR_ID_HTABLE);
+            amxc_var_add_key(cstring_t, ret, "status", "FAIL");
+            amxc_var_add_key(uint32_t,  ret, "type",   type);
+            amxc_var_add_key(cstring_t, ret, "error",  "Invalid intf_bitmap: expected hex (e.g. 0xC0) or decimal (e.g. 192)");
+            SAH_TRACEZ_OUT(ME);
+            return amxd_status_invalid_arg;
+        }
+    }
+
+    /* Map type to human-readable name */
+    switch(type) {
+    case 1:  intf_name = "CW_INTF (Continuous Wave)";    break;
+    case 2:  intf_name = "WLAN_INTF (WLAN interference)"; break;
+    case 4:  intf_name = "AWGN_INTF (AWGN interference)"; break;
+    case 16: intf_name = "OBSS_INTF (Overlapping BSS)";   break;
+    default: break;
+    }
+
+    amxc_var_set_type(ret, AMXC_VAR_ID_HTABLE);
+
+    /* Validate: only 1 (CW), 2 (WLAN), 4 (AWGN), 16 (OBSS) are valid interference types */
+    if(type != 1 && type != 2 && type != 4 && type != 16) {
+        SAH_TRACEZ_ERROR(ME,
+                         "%s: DCS.Simulation: invalid type %u - valid: 1=CW, 2=WLAN, 4=AWGN, 16=OBSS",
+                         pAP->alias, type);
+        amxc_var_add_key(cstring_t, ret, "status",    "FAIL");
+        amxc_var_add_key(uint32_t,  ret, "type",      type);
+        amxc_var_add_key(cstring_t, ret, "error",     "Invalid type: valid values are 1(CW), 2(WLAN), 4(AWGN), 16(OBSS)");
+        SAH_TRACEZ_OUT(ME);
+        return amxd_status_invalid_arg;
+    }
+
+    if(!pAP->initDone) {
+        SAH_TRACEZ_ERROR(ME, "%s: DCS.Simulation: AP not yet initialized", pAP->alias);
+        amxc_var_add_key(cstring_t, ret, "status",    "FAIL");
+        amxc_var_add_key(uint32_t,  ret, "type",      type);
+        amxc_var_add_key(cstring_t, ret, "error",     "AP not yet initialized");
+        SAH_TRACEZ_OUT(ME);
+        return amxd_status_invalid_action;
+    }
+
+    /* Build the hostapd command:
+     *   Without intf_bitmap: "DCS sim <type>"
+     *   With    intf_bitmap: "DCS sim <type> intf_bitmap=0x<hex>"
+     *
+     * intf_bitmap specifies which 20 MHz sub-channels are affected (enum hostapd_dcs_chan_seg):
+     *   0x0001 = DCS_SEG_PRI20  (primary 20 MHz)
+     *   0x0002 = DCS_SEG_SEC20  (secondary 20 MHz)
+     *   0x000C = DCS_SEG_SEC40  (secondary 40 MHz = SEC40_L | SEC40_U)
+     *   0x00F0 = DCS_SEG_SEC80  (secondary 80 MHz)
+     *   0xFF00 = DCS_SEG_SEC160 (secondary 160 MHz)
+     * Used primarily with OBSS (type=16) to specify which sub-channels to puncture.
+     */
+    bool ok;
+    char cmd[256] = {0};
+    char reply[256] = {0};
+
+    if(intf_bitmap != 0) {
+        snprintf(cmd, sizeof(cmd), "DCS sim %u intf_bitmap=0x%x", type, intf_bitmap);
+        SAH_TRACEZ_INFO(ME, "%s: DCS Simulation type=%u (%s) intf_bitmap=0x%x",
+                        pAP->alias, type, intf_name, intf_bitmap);
+    } else {
+        snprintf(cmd, sizeof(cmd), "DCS sim %u", type);
+        SAH_TRACEZ_INFO(ME, "%s: DCS Simulation type=%u (%s)", pAP->alias, type, intf_name);
+    }
+
+    swl_rc_ne rc = wld_wpaCtrl_sendCmdFmtGetResponse(pAP->wpaCtrlInterface, reply, sizeof(reply), "%s", cmd);
+    ok = (rc == SWL_RC_OK) && !swl_str_matches(reply, "FAIL") && !swl_str_matches(reply, "UNKNOWN COMMAND");
+    if(!ok) {
+        SAH_TRACEZ_ERROR(ME, "%s: DCS Simulation failed: cmd='%s' rc=%d reply='%s'",
+                         pAP->alias, cmd, rc, reply);
+    }
+
+    amxc_var_add_key(cstring_t, ret, "status",        ok ? "OK" : "FAIL");
+    amxc_var_add_key(uint32_t,  ret, "type",          type);
+    amxc_var_add_key(cstring_t, ret, "interference",  intf_name);
+    amxc_var_add_key(cstring_t, ret, "interface",     pAP->alias);
+    amxc_var_add_key(uint32_t,  ret, "intf_bitmap",   intf_bitmap);
+    amxc_var_add_key(cstring_t, ret, "command",       ok ? "DCS sim sent successfully" : "DCS sim command failed");
+
+    SAH_TRACEZ_OUT(ME);
+    return ok ? amxd_status_ok : amxd_status_unknown_error;
+}
