+/**
+ * @brief Handler for AllowScanDfsChan parameter change.
+ *
+ * When enabled, sends: allow_scan_on_dfs_chan 1
+ * When disabled, sends: allow_scan_on_dfs_chan 0
+ *
+ * This fixes ACS scan failures when DCS is enabled with WLAN/CW interference
+ * and a DCS-triggered channel change occurs on a 5G radio with ACS enabled.
+ * Without this, hostapd rejects ACS scan requests on DFS channels.
+ *
+ * Equivalent to: hostapd_cli -i <wlanX> allow_scan_on_dfs_chan <0|1>
+ */
+static void s_setAllowScanDfsChan_pwf(void* priv _UNUSED, amxd_object_t* object,
+                                       amxd_param_t* param _UNUSED,
+                                       const amxc_var_t* const newValue) {
+    SAH_TRACEZ_IN(ME);
+
+    T_AccessPoint* pAP = wld_ap_fromObj(object);
+    ASSERT_NOT_NULL(pAP, , ME, "INVALID");
+
+    bool enable = amxc_var_dyncast(bool, newValue);
+    SAH_TRACEZ_INFO(ME, "%s: set AllowScanDfsChan %d", pAP->alias, enable);
+    pAP->AllowScanDfsChan = enable;
+
+    if(pAP->initDone) {
+        char cmd[64] = {0};
+        snprintf(cmd, sizeof(cmd), "allow_scan_on_dfs_chan %d", enable ? 1 : 0);
+        bool ok = wld_wpaCtrl_sendCmdCheckResponse(pAP->wpaCtrlInterface, cmd, "OK");
+        if(!ok) {
+            SAH_TRACEZ_ERROR(ME, "%s: allow_scan_on_dfs_chan command failed", pAP->alias);
+        }
+    }
+
+    SAH_TRACEZ_OUT(ME);
+}
