--- a/odl/wld_accesspoint.odl
+++ b/odl/wld_accesspoint.odl
@@ -366,6 +366,25 @@ define rrm_t{
 		}
 
 		/**
+		 * Allow ACS scan on DFS channels when DCS triggers a channel change.
+		 *
+		 * When DCS is enabled (e.g. WLAN or CW interference detection) on a 5G radio
+		 * with ACS enabled, a DCS-triggered channel change causes hostapd to reject
+		 * subsequent ACS scan requests on DFS channels, resulting in ACS scan failure.
+		 * Setting this to true sends:
+		 *   hostapd_cli -i <wlanX> allow_scan_on_dfs_chan 1
+		 * which allows hostapd to include DFS channels in ACS scans.
+		 *
+		 * false = DFS channels excluded from ACS scan (default, hostapd default behaviour)
+		 * true  = DFS channels included in ACS scan (workaround for DCS + ACS coexistence)
+		 *
+		 * Not persistent: applied dynamically via hostapd_cli at runtime.
+		 */
+		%persistent bool AllowScanDfsChan {
+			default false;
+		}
+
+		/**
 		 * Add MBO Assoc Disallow Reason in the MBO IE
 		 * Possible options are : "Off", "Unspecified", "MaxAssocSTA",
 		 * "AirInterfaceOverload", "AuthServOverload", "InsufficientRSSI"
@@ -1204,6 +1223,32 @@ define rrm_t{
 				on action validate call check_range { min = 0, max = 19 };
 			}
 
+			/**
+			 * Trigger a DCS interference simulation for testing.
+			 *
+			 * Sends: hostapd_cli -i <wlanX> DCS sim <type>
+			 * to trigger a synthetic DCS interference event in hostapd.
+			 *
+			 * No state is stored — this is a pure action with input validation only.
+			 *
+			 * @param type  Mandatory interference type:
+			 *   1  = CW_INTF   (Continuous Wave interference)
+			 *   2  = WLAN_INTF (WLAN interference)
+			 *   4  = AWGN_INTF (AWGN interference)
+			 *   16 = OBSS_INTF (Overlapping BSS interference)
+			 *
+			 * Note: The -l <linkid> flag is NOT used because hostapd's DCS handler
+			 * does not support the LINK_ID=X prefix. The command is sent directly to
+			 * the AP's own wpaCtrl socket (e.g. wlan1.1_link0), which is already
+			 * bound to the correct link.
+			 *
+			 * @return amxd_status_ok on success
+			 *         amxd_status_invalid_arg if type is not 1, 2, 4, or 16
+			 *         amxd_status_invalid_action if the AP is not yet initialized
+			 *         amxd_status_unknown_error if the hostapd command fails
+			 */
+			void Simulation(%in %mandatory uint32 type, %in string intf_bitmap);
+
 		}
 
 		/** This object contains parameters related to Wi-Fi Protected
