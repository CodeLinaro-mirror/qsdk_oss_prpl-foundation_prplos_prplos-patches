From b70c1d15de139b67c594a157461412281a44599c Mon Sep 17 00:00:00 2001
From: Nikhil Gurram <nikhgurr@qti.qualcomm.com>
Date: Wed, 09 Jul 2026 00:00:00 +0530
Subject: [PATCH] pwhm: RepAP 6G FH VAPs fail to come up after association with RootAP

wld_mld_firstUsableNeighLinkByFreq() used'> tgtFreq' 
which always elected the highest-frequency (6GHz) radio as
BH STA MLO primary anchor. On IPQ the 6GHz pdev is firmware-
designated as a scan radio (WMI_SCAN_RADIO_CAP_SCAN_RADIO), limited to
one vdev at a time. With the BH STA vdev already occupying that slot,
NL80211_CMD_ADD_LINK for wlan0.1 (6G FH AP) returned -EINVAL from the
ath12k single-vdev guard in mac.c. with this change lowest-frequency
(2.4GHz) radio is elected primary; 6GHz becomes an
AUXILIARY MLO link and its vdev slot is free for the FH AP.

Crash loop fix (wifiGen_hapd.c, wifiGen_fsm.c, wld.h): when the 6G FH
AP warm-add (ADD bss_config) fails, the old code called
s_schedNextAction(NEED_RESTART) which restarted the shared hostapd
group, killing the working 2G/5G FH VAPs in a crash loop. Replace with
a per-radio hapdWarmAddFailed flag: defer the retry via a 5-second
timer, exclude the failed radio from the cold-start conf aggregation,
and skip the "already started" early-return so the retry actually
re-attempts the warm-add.

Signed-off-by: Nikhil Gurram <nikhgurr@qti.qualcomm.com>
---
--- a/include/wld/wld.h
+++ b/include/wld/wld.h
@@ -1741,6 +1741,7 @@
     swl_channel_t disabledSubchannels[SWL_BW_CHANNELS_MAX]; /* Disabled Subchannel list, for 11be static channel puncturing */
     uint32_t nrDisabledSubChannels;                         /* Nr of disabled sub channels */
     uint8_t mLReconfigurationCount;                         /** Number of beacons with ML Reconfiguration IE before link removal */
+    bool hapdWarmAddFailed;                                 /* When true, last ADD bss_config warm-add failed - defer retry, skip cold-start */
     bool discardAwgnEvent;                                  /* When true, add discard_6g_awgn_event=1 to hostapd config (6GHz only) */
 };

 typedef struct {
--- a/src/Plugin/wifiGen_fsm.c
+++ b/src/Plugin/wifiGen_fsm.c
@@ -1163,7 +1163,8 @@
         SAH_TRACEZ_INFO(ME, "%s: hostapd already is restarting: no need to force immediate start", pRad->Name);
         return true;
     }
-    if(wifiGen_hapd_isStarted(pRad) && wld_secDmn_hasAvailableCtrlIface(pRad->hostapd)) {
+    if(!pRad->hapdWarmAddFailed &&
+       wifiGen_hapd_isStarted(pRad) && wld_secDmn_hasAvailableCtrlIface(pRad->hostapd)) {
         SAH_TRACEZ_INFO(ME, "%s: hostapd already started", pRad->Name);
         return true;
     }
@@ -1244,10 +1245,13 @@
     wifiGen_hapd_enableWpaCtrlIfaces(pRad);
     SAH_TRACEZ_INFO(ME, "%s: add config to hostapd", pRad->Name);
     if(wld_rad_hostapd_addConf(pRad) < 0) {
-        SAH_TRACEZ_ERROR(ME, "%s: warm apply failed to add iface conf => restart to recover", pRad->Name);
-        s_schedNextAction(SECDMN_ACTION_OK_NEED_RESTART, NULL, pRad);
+        SAH_TRACEZ_ERROR(ME, "%s: warm apply failed to add iface conf => defer warm-add retry", pRad->Name);
+        pRad->hapdWarmAddFailed = true;
+        setBitLongArray(pRad->fsmRad.FSM_BitActionArray, FSM_BW, GEN_FSM_START_HOSTAPD);
+        pRad->fsmRad.timeout_msec = 5000;
         return true;
     }
+    pRad->hapdWarmAddFailed = false;
     wld_wpaCtrlMngr_connect(wld_secDmn_getWpaCtrlMgr(pRad->hostapd));
     pRad->fsmRad.timeout_msec = 100;
     return true;
--- a/src/Plugin/wifiGen_hapd.c
+++ b/src/Plugin/wifiGen_hapd.c
@@ -272,11 +272,42 @@
     return mainIface;
 }

+/* Forward declaration: defined later in this file */
+static T_Radio* s_getGrpMemberRadObj(wld_secDmn_t* pGmb);
+
 static void s_restartHapdCb(wld_secDmn_t* pSecDmn, void* userdata) {
     T_Radio* pRad = (T_Radio*) userdata;
     ASSERT_NOT_NULL(pRad, , ME, "NULL");
     const char* mainIface = s_getMainIface(pRad);
-    ASSERTW_TRUE(wifiGen_hapd_isStartable(pRad), , ME, "%s: hostapd iface %s is not startable", pRad->Name, mainIface);
+    if(wifiGen_hapd_isStartable(pRad) && !pRad->hapdWarmAddFailed) {
+        wld_deamonExitInfo_t* pExitInfo = &pSecDmn->dmnProcess->lastExitInfo;
+        if((pExitInfo != NULL) && (pExitInfo->isExited) &&
+           (pExitInfo->exitStatus == HOSTAPD_EXIT_REASON_LOAD_FAIL)) {
+            bool isOnlyStartable = true;
+            wld_secDmnGrp_t* pGrp = wld_secDmn_getGrp(pSecDmn);
+            for(uint32_t i = 0; pGrp && i < wld_secDmnGrp_getMembersCount(pGrp); i++) {
+                wld_secDmn_t* pMember = (wld_secDmn_t*) wld_secDmnGrp_getMemberByPos(pGrp, i);
+                T_Radio* pOther = s_getGrpMemberRadObj(pMember);
+                if(pOther && pOther != pRad && wifiGen_hapd_isStartable(pOther) && !pOther->hapdWarmAddFailed) {
+                    isOnlyStartable = false; break;
+                }
+            }
+            if(isOnlyStartable) {
+                SAH_TRACEZ_WARNING(ME, "%s: hostapd iface %s: sole startable radio exited with LOAD_FAIL, setting warm-add-failed", pRad->Name, mainIface);
+                pRad->hapdWarmAddFailed = true;
+            }
+        }
+    }
+    if(!wifiGen_hapd_isStartable(pRad) || pRad->hapdWarmAddFailed) {
+        if(pRad->hapdWarmAddFailed) {
+            SAH_TRACEZ_WARNING(ME, "%s: hostapd iface %s: warm-add failed, skipping cold-start, queuing start for warm-add retry", pRad->Name, mainIface);
+            setBitLongArray(pRad->fsmRad.FSM_BitActionArray, FSM_BW, GEN_FSM_START_HOSTAPD);
+            if(pRad->fsmRad.timer) { pRad->fsmRad.timeout_msec = 5000; amxp_timer_start(pRad->fsmRad.timer, 5000); }
+        } else {
+            SAH_TRACEZ_WARNING(ME, "%s: hostapd iface %s is not startable", pRad->Name, mainIface);
+        }
+        return;
+    }
     ASSERTW_FALSE(wifiGen_hapd_isRunning(pRad), , ME, "%s: hostapd running", mainIface);
     SAH_TRACEZ_WARNING(ME, "%s: restarting hostapd", mainIface);
     wld_secDmn_restartCb(pSecDmn);
@@ -746,7 +777,7 @@
     }
     for(uint32_t i = 0; i < nGrpMembers; i++) {
         T_Radio* pR = s_getGrpMemberRadObj(grpMembers[i]);
-        if(!pR || !wifiGen_hapd_isStartable(pR)) {
+        if(!pR || !wifiGen_hapd_isStartable(pR) || pR->hapdWarmAddFailed) {
             continue;
         }
         //concat all startable radio ifaces conf files
@@ -761,7 +792,7 @@
     T_Radio* pRad = (T_Radio*) pSecDmn->userData;
     ASSERT_TRUE(debugIsRadPointer(pRad), false, ME, "INVALID");
     wifiGen_hapd_enableWpaCtrlIfaces(pRad);
-    return wifiGen_hapd_isStartable(pRad);
+    return wifiGen_hapd_isStartable(pRad) && !pRad->hapdWarmAddFailed;
 }

 static bool s_hasRtmSchedState(T_Radio* pRad, wifiGen_fsmStates_e fsmAc) {
--- a/src/wld_mld.c
+++ b/src/wld_mld.c
@@ -762,9 +762,11 @@
         if(pRad == NULL) {
             continue;
         }
         if(wld_mld_isLinkUsable(pLink) &&
            (pRad->operatingFrequencyBand < SWL_FREQ_BAND_EXT_NONE) &&
-           ((tgtFreq == SWL_FREQ_BAND_EXT_NONE) || (pRad->operatingFrequencyBand > tgtFreq))) {
+           /* Prefer lowest-frequency band as BH STA primary anchor so 6GHz stays
+            * AUXILIARY and wlan0.1 remains free for 6G FH AP ADD_LINK. */
+           ((tgtFreq == SWL_FREQ_BAND_EXT_NONE) || (pRad->operatingFrequencyBand < tgtFreq))) {
             tgtLink = pLink;
             tgtFreq = pRad->operatingFrequencyBand;
         }
