+/**
+ * @brief Helper to send an AFC command (no dcs prefix, no link ID) via wpaCtrl.
+ *
+ * Equivalent to: hostapd_cli -i wlanX afc <cmd> <value>
+ */
+static bool s_sendAfcCmd(T_AccessPoint* pAP, const char* afc_cmd, uint32_t value) {
+    ASSERTS_NOT_NULL(pAP, false, ME, "NULL");
+    char cmd[256] = {0};
+    snprintf(cmd, sizeof(cmd), "afc %s %u", afc_cmd, value);
+    bool bRet = wld_wpaCtrl_sendCmdCheckResponse(pAP->wpaCtrlInterface, cmd, "OK");
+    if(!bRet) {
+        SAH_TRACEZ_ERROR(ME, "%s: AFC command failed: %s", pAP->alias, cmd);
+    }
+    return bRet;
+}
