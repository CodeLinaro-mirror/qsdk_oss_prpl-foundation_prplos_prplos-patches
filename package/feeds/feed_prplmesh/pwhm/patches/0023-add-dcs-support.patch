+		/** This object contains parameters related to Dynamic Channel Selection (DCS)
+		 *  for this access point. */
+		%persistent object DCS {
+			on event "*" call wld_ap_setDcsConf_ocf;
+
+			/**
+			 * DCS enable bitmask written to the hostapd configuration file as dcs_enable.
+			 * Only the following bits are valid (ALLOWED_DCS_MASK = 0x0013):
+			 *   Bit 0 (0x0001): CW (Continuous Wave) interference detection
+			 *   Bit 1 (0x0002): WLAN interference detection
+			 *   Bit 4 (0x0010): OBSS (Overlapping BSS) interference detection
+			 * A value of 0 disables DCS.
+			 * Valid range: 0 to 19 (0x0013)
+			 */
+			%persistent uint32 Enable {
+				default 0;
+				on action validate call check_range { min = 0, max = 19 };
+			}
+
+			/**
+			 * WLAN interference detection threshold.
+			 * When changed, automatically sends:
+			 *   hostapd_cli -i wlanX [-l Y] DCS set_wlan_intr_params intr_detection_threshold <value>
+			 * Not persistent: applied dynamically via hostapd_cli.
+			 * hostapd default: 6 (DCS_INTR_DETECTION_THR)
+			 * Valid range: 0 to 6
+			 */
+			uint32 WlanIntrDetectionThreshold {
+				default 6;
+				on action validate call check_range { min = 0, max = 6 };
+			}
+
+			/**
+			 * WLAN TX error threshold.
+			 * When changed, automatically sends:
+			 *   hostapd_cli -i wlanX [-l Y] DCS set_wlan_intr_params txerr_threshold <value>
+			 * Not persistent: applied dynamically via hostapd_cli.
+			 * hostapd default: 30 (DCS_TXERR_THRESHOLD)
+			 * Valid range: 0 to 300
+			 */
+			uint32 WlanIntrTxErrThreshold {
+				default 30;
+				on action validate call check_range { min = 0, max = 300 };
+			}
+
+			/**
+			 * WLAN PHY error threshold.
+			 * When changed, automatically sends:
+			 *   hostapd_cli -i wlanX [-l Y] DCS set_wlan_intr_params phyerr_threshold <value>
+			 * Not persistent: applied dynamically via hostapd_cli.
+			 * hostapd default: 300 (DCS_PHYERR_THRESHOLD)
+			 * Valid range: 0 to 300
+			 */
+			uint32 WlanIntrPhyErrThreshold {
+				default 300;
+				on action validate call check_range { min = 0, max = 300 };
+			}
+
+			/**
+			 * Co-channel interference threshold.
+			 * When changed, automatically sends:
+			 *   hostapd_cli -i wlanX [-l Y] DCS set_wlan_intr_params coch_intr_threshold <value>
+			 * Not persistent: applied dynamically via hostapd_cli.
+			 * hostapd default: 30 (DCS_COCH_INTR_THRESHOLD)
+			 * Valid range: 0 to 30
+			 */
+			uint32 WlanIntrCochIntrThreshold {
+				default 30;
+				on action validate call check_range { min = 0, max = 30 };
+			}
+
+			/**
+			 * Maximum channel utilization value.
+			 * When changed, automatically sends:
+			 *   hostapd_cli -i wlanX [-l Y] DCS set_wlan_intr_params user_max_cu <value>
+			 * Not persistent: applied dynamically via hostapd_cli.
+			 * hostapd default: 50 (DCS_USER_MAX_CU)
+			 * Valid range: 0 to 50
+			 */
+			uint32 MaxcuValue {
+				default 50;
+				on action validate call check_range { min = 0, max = 50 };
+			}
+
+			/**
+			 * BW reduction control bitmask.
+			 * Set dynamically at runtime via hostapd_cli:
+			 *   hostapd_cli -i wlanX [-l Y] DCS bw_reduction_ctrl <value>
+			 * Not persistent: runtime only, not saved across reboots.
+			 * Only bits 0-4 are valid (0x001F):
+			 *   Bit 0 (0x0001): CW, Bit 1 (0x0002): WLAN,
+			 *   Bit 2 (0x0004): AWGN, Bit 4 (0x0010): OBSS
+			 * Valid range: 0 to 31 (0x001F)
+			 */
+			uint32 BwReductionCtrl {
+				default 0;
+				on action validate call check_range { min = 0, max = 31 };
+			}
+
+			/**
+			 * AFC channel selection configuration.
+			 * Set dynamically at runtime via hostapd_cli:
+			 *   hostapd_cli -i wlanX AFC set_afc_chan_sel_config <value>
+			 * Not persistent: runtime only, not saved across reboots.
+			 * Note: uses 'AFC' command prefix (no -l Y link ID).
+			 */
+			uint32 SetAfcChanSelConfig {
+				default 0;
+			}
+
+			/**
+			 * DCS random channel bitmap.
+			 * Set dynamically at runtime via hostapd_cli:
+			 *   hostapd_cli -i wlanX [-l Y] DCS random_chan_bitmap <value>
+			 * Not persistent: runtime only, not saved across reboots.
+			 * Only bits 0-4 are valid (0x001F):
+			 *   Bit 0 (0x0001): CW, Bit 1 (0x0002): WLAN,
+			 *   Bit 2 (0x0004): AWGN, Bit 4 (0x0010): OBSS
+			 * Valid range: 0 to 31 (0x001F)
+			 */
+			uint32 RandomChanBitmap {
+				default 0;
+				on action validate call check_range { min = 0, max = 31 };
+			}
+
+			/**
+			 * DCS CSA TBTT value.
+			 * Set dynamically at runtime via hostapd_cli:
+			 *   hostapd_cli -i wlanX [-l Y] DCS csa_tbtt <value>
+			 * Not persistent: runtime only, not saved across reboots.
+			 * hostapd range: DCS_CSA_TBTT_MIN=1 to DCS_CSA_TBTT_MAX=30
+			 * hostapd default: DCS_CSA_TBTT_DEFAULT=5
+			 * Valid range: 1 to 30
+			 */
+			uint32 CsaTbtt {
+				default 5;
+				on action validate call check_range { min = 1, max = 30 };
+			}
+
+			/**
+			 * DCS re-enable timer in seconds.
+			 * Set dynamically at runtime via hostapd_cli:
+			 *   hostapd_cli -i wlanX [-l Y] DCS set_dcs_enable_timer <value>
+			 * Not persistent: runtime only, not saved across reboots.
+			 * hostapd range: DCS_ENABLE_TIME_MIN=300s to DCS_ENABLE_TIME_MAX=3600s
+			 * hostapd default: DCS_ENABLE_TIME=1800s (30 minutes)
+			 * Reading this parameter returns the value last set via this DM parameter.
+			 * Valid range: 300 to 3600 seconds
+			 */
+			uint32 EnableTimer {
+				default 1800;
+				on action validate call check_range { min = 300, max = 3600 };
+			}
+
+			/**
+			 * DCS event action bitmask.
+			 * Set dynamically at runtime via hostapd_cli:
+			 *   hostapd_cli -i wlanX [-l Y] DCS event_action <mask>
+			 * Not persistent: runtime only, not saved across reboots.
+			 * Only bits 0, 1, 4 are valid (ALLOWED_DCS_EVENT_ACTION_MASK = 0x0013):
+			 *   Bit 0 (0x0001): process CW, Bit 1 (0x0002): process WLAN,
+			 *   Bit 4 (0x0010): process OBSS
+			 * hostapd default: 0x0013 (all interference types processed)
+			 * Valid range: 0 to 19 (0x0013)
+			 */
+			uint32 EventAction {
+				default 19;
+				on action validate call check_range { min = 0, max = 19 };
+			}
+
+			/**
+			 * DCS event notify bitmask.
+			 * Set dynamically at runtime via hostapd_cli:
+			 *   hostapd_cli -i wlanX [-l Y] DCS event_notify <mask>
+			 * Not persistent: runtime only, not saved across reboots.
+			 * Only bits 0, 1, 4 are valid (ALLOWED_DCS_EVENT_ACTION_MASK = 0x0013):
+			 *   Bit 0 (0x0001): notify CW, Bit 1 (0x0002): notify WLAN,
+			 *   Bit 4 (0x0010): notify OBSS
+			 * hostapd default: 0 (no notifications)
+			 * Valid range: 0 to 19 (0x0013)
+			 */
+			uint32 EventNotify {
+				default 0;
+				on action validate call check_range { min = 0, max = 19 };
+			}
+
+		}
