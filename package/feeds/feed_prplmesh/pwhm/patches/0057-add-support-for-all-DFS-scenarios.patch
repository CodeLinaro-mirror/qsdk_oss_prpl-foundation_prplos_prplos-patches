+/**
+ * @brief Set the rolling CAC (rCAC) frequency.
+ *
+ * Sends: SET_RCAC_FREQ channel <chan> [<bw>] via hostapd wpa_ctrl.
+ * Equivalent to: hostapd_cli -i <ifname> set_rcac_freq channel <chan> <bw>
+ *
+ * PRD constraint: "Simultaneous use of hostapd_cli and iw dev for starting
+ * Background CAC is not supported. If Background CAC is started using iw dev,
+ * it must be stopped using iw dev before initiating it again via hostapd_cli."
+ *
+ * If a BgDfs clear is currently running via iw dev (bgdfs_config.channel != 0),
+ * it is stopped first before sending the hostapd_cli command.
+ *
+ * @param channel: target channel number (mandatory)
+ * @param bw: bandwidth in MHz (optional, 0 = omit from command)
+ * @return true on success, false on failure
+ */
+amxd_status_t _setRcacFreq(amxd_object_t* object,
+                            amxd_function_t* func _UNUSED,
+                            amxc_var_t* args,
+                            amxc_var_t* retval) {
+    SAH_TRACEZ_IN(ME);
+
+    T_Radio* pR = wld_rad_fromObj(amxd_object_get_parent(amxd_object_get_parent(object)));
+    ASSERT_NOT_NULL(pR, amxd_status_ok, ME, "No mapped radio ctx");
+
+    uint32_t channel = GET_UINT32(args, "channel");
+    uint32_t bw = GET_UINT32(args, "bw");
+
+    /*
+     * PRD constraint: if BgDfs is currently running via iw dev (ZWDFS/NL80211),
+     * stop it first before using hostapd_cli. Mixing the two mechanisms
+     * simultaneously is not supported.
+     */
+    if(wld_bgdfs_isRunning(pR)) {
+        SAH_TRACEZ_WARNING(ME, "%s: setRcacFreq: iw dev BgDfs is running (ch=%u), "
+                           "stopping it first before using hostapd_cli",
+                           pR->Name, pR->bgdfs_config.channel);
+        pR->pFA->mfn_wrad_bgdfs_stop(pR);
+        pR->bgdfs_stats.nrClearStopChange[pR->bgdfs_config.type]++;
+        pR->bgdfs_config.channel = 0;
+        pR->bgdfs_config.bandwidth = SWL_BW_AUTO;
+        s_resetStatus(pR);
+    }
+
+    T_AccessPoint* pAP = s_bgdfs_getAp(pR);
+    if(pAP == NULL) {
+        SAH_TRACEZ_ERROR(ME, "%s: setRcacFreq: no AP available", pR->Name);
+        amxc_var_set(bool, retval, false);
+        SAH_TRACEZ_OUT(ME);
+        return amxd_status_ok;
+    }
+
+    SAH_TRACEZ_INFO(ME, "%s: setRcacFreq channel=%u bw=%u", pR->Name, channel, bw);
+    swl_rc_ne rc;
+    if(bw > 0) {
+        rc = wld_wpaCtrl_sendCmdFmtCheckResponse(pAP->wpaCtrlInterface, "OK",
+                                                  "SET rcac_freq %u %u", channel, bw);
+    } else {
+        rc = wld_wpaCtrl_sendCmdFmtCheckResponse(pAP->wpaCtrlInterface, "OK",
+                                                  "SET rcac_freq %u", channel);
+    }
+
+    if(!swl_rc_isOk(rc)) {
+        SAH_TRACEZ_ERROR(ME, "%s: setRcacFreq channel=%u failed rc=%d (hostapd returned FAIL — rCAC not supported or unavailable)",
+                         pR->Name, channel, rc);
+    }
+    amxc_var_set(bool, retval, swl_rc_isOk(rc));
+    SAH_TRACEZ_OUT(ME);
+    return amxd_status_ok;
+}
