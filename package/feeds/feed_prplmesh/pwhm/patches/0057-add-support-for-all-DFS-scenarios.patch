+/*
+ * @brief Set DFS CAC timeout via NL80211 vendor command.
+ *
+ * Sends vendor SET command (subcmd=505) with dparam1=QCA_WLAN_VENDOR_RADIO_PARAM_CAC_TIMEOUT
+ * to override the CAC duration for the current radio / frequency range.
+ * Range: 1–86400 seconds (0 is rejected).
+ */
+
+swl_rc_ne wld_rad_nl80211_setCacTimeout(T_Radio* pRad, uint32_t timeoutSec);
+
+/*
+ * @brief List per-channel information for all 5GHz channels via NL80211 vendor command.
+ *
+ * Sends vendor GET command (subcmd=506) with dparam1=QCA_WLAN_VENDOR_RADIO_PARAM_LIST_5GHZ_CHAN_INFO (88).
+ * Returns raw response data as a hex string in buf.
+ * For each 5GHz channel the response contains:
+ *   channel number, operating class, DFS state, remaining CAC time,
+ *   CAC completion time, remaining NOP time.
+ *
+ * @param pRad pointer to radio context
+ * @param buf output buffer to store the hex-encoded response
+ * @param bufSize size of the output buffer
+ *
+ * @return SWL_RC_OK in case of success
+ *         <= SWL_RC_ERROR otherwise
+ */
+swl_rc_ne wld_rad_nl80211_list5GhzChanInfo(T_Radio* pRad, char* buf, size_t bufSize);
+
+/*
+ * @brief Set Background CAC timeout multiplier via NL80211 vendor command.
+ *
+ * Sends vendor SET command (subcmd=505) with dparam1=QCA_WLAN_VENDOR_RADIO_PARAM_BGCAC_TIMEOUT (89).
+ * The multiplier is applied to the background CAC timer duration.
+ * Value 0 means use the standard timer.
+ *
+ * @param pRad pointer to radio context
+ * @param multiplier background CAC timeout multiplier (0 = use default)
+ *
+ * @return SWL_RC_OK in case of success
+ *         <= SWL_RC_ERROR otherwise
+ */
+swl_rc_ne wld_rad_nl80211_setBgCacTimeout(T_Radio* pRad, uint32_t multiplier);
+
+/*
+ * @brief Set BlockDfsList (block/unblock DFS channels) via NL80211 vendor command.
+ *
+ * Sends vendor SET command (subcmd=505) with dparam1=QCA_WLAN_VENDOR_RADIO_PARAM_BLOCK_DFS_LIST (90).
+ * When block=1, DFS channels are blocked from ACS and manual configuration.
+ * When block=0, DFS channels are allowed.
+ *
+ * @param pRad pointer to radio context
+ * @param block 1 to block DFS channels, 0 to allow
+ *
+ * @return SWL_RC_OK in case of success
+ *         <= SWL_RC_ERROR otherwise
+ */
+
+swl_rc_ne wld_rad_nl80211_setBlockDfsList(T_Radio* pRad, uint32_t block);
+
 swl_rc_ne wld_rad_nl80211_displayBandChans(T_Radio* pRad);
 swl_rc_ne wld_rad_nl80211_displaySuperChanList(T_Radio* pRad);
 #endif /* INCLUDE_WLD_WLD_RAD_NL80211_H_ */
