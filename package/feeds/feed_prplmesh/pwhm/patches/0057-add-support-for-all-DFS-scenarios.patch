+/*
+ * QCA vendor OUI and subcmd for channel switch reason notification.
+ * QCA_NL80211_VENDOR_SUBCMD_CH_SWITCH_REASON = 74 (0x4A)
+ * This event is sent by the driver when a channel switch occurs,
+ * carrying the reason for the switch (radar, user request, AWGN, etc.).
+ *
+ * Vendor data attributes (QCA_WLAN_VENDOR_ATTR_CH_SWITCH_REASON):
+ *   Attribute 1 = reason code (uint32)
+ *
+ * Reason codes (QCA_WLAN_VENDOR_ATTR_CH_SWITCH_REASON values):
+ *   0 = RADAR
+ *   1 = USER_REQUEST
+ *   2 = AWGN
+ */
+#define QCA_OUI                             0x001374
+#define QCA_NL80211_VENDOR_SUBCMD_CH_SWITCH_REASON  74
+#define QCA_WLAN_VENDOR_ATTR_CH_SWITCH_REASON       1
+
+static const char* s_chSwitchReasonToStr(uint32_t reason) {
+    switch(reason) {
+    case 0: return "RADAR";
+    case 1: return "USER_REQUEST";
+    case 2: return "AWGN";
+    default: return "UNKNOWN";
+    }
+}
