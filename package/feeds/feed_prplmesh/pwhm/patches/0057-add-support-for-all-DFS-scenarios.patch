+/* ---- list5GhzChanInfo ----
+ *
+ * Queries the driver for per-channel information for all 5GHz channels.
+ * Uses the QCA_WLAN_VENDOR_RADIO_PARAM_GET_5GHZ_CHAN_INFO vendor parameter.
+ *
+ * For each 5GHz channel the output contains:
+ *   - Channel number
+ *   - Operating class
+ *   - DFS state
+ *   - Remaining CAC time
+ *   - CAC completion time
+ *   - Remaining NOP time
+ *
+ * The driver writes the channel info to the kernel log (dmesg), not to stdout.
+ * This function:
+ *   1. Triggers the driver via cfg80211tool list_5ghz_chan_info
+ *   2. Reads the kernel log (dmesg) to capture the output
+ *
+ * Equivalent to:
+ *   cfg80211tool <phyX> radio_idx 0 list_5ghz_chan_info
+ *   dmesg | tail -50
+ *
+ * @return kernel log lines containing 5GHz channel info, or empty string on failure.
+ */
+amxd_status_t _list5GhzChanInfo(amxd_object_t* object,
+                                 amxd_function_t* func _UNUSED,
+                                 amxc_var_t* args _UNUSED,
+                                 amxc_var_t* retval) {
+    T_Radio* pR = wld_rad_fromObj(object);
+    ASSERT_NOT_NULL(pR, amxd_status_unknown_error, ME, "NULL");
+
+    /*
+     * Step 1: trigger the driver via NL80211 vendor command
+     * QCA_NL80211_VENDOR_SUBCMD_GET_WIPHY_CONFIGURATION (506)
+     * → QCA_WLAN_VENDOR_RADIO_PARAM_LIST_5GHZ_CHAN_INFO (dparam1=88)
+     *
+     * This causes the driver to write per-channel info to the kernel log.
+     * The NL80211 response also contains raw binary data (returned as hex).
+     */
+    char hexBuf[4096] = {0};
+    swl_rc_ne rc = wld_rad_nl80211_list5GhzChanInfo(pR, hexBuf, sizeof(hexBuf));
+    if(rc != SWL_RC_OK) {
+        SAH_TRACEZ_WARNING(ME, "%s: list5GhzChanInfo NL80211 command failed rc=%d, falling back to dmesg",
+                           pR->Name, rc);
+    } else {
+        SAH_TRACEZ_INFO(ME, "%s: list5GhzChanInfo NL80211 response: %s", pR->Name, hexBuf);
+    }
+
+    /*
+     * Step 2: read the kernel log to get the human-readable channel info.
+     * The driver writes lines starting with "5GHz channel info" to dmesg
+     * when the vendor command is processed.
+     */
+    char out[QCA_POPEN_OUT_MAX];
+    char dmesg_cmd[256];
+    snprintf(dmesg_cmd, sizeof(dmesg_cmd),
+             "dmesg | grep -A 200 '5GHz channel info' | tail -200 2>&1");
+    SAH_TRACEZ_INFO(ME, "%s: list5GhzChanInfo reading dmesg", pR->Name);
+    if(s_cfg80211tool_run(dmesg_cmd, out, sizeof(out)) != SWL_RC_OK) {
+        SAH_TRACEZ_ERROR(ME, "%s: list5GhzChanInfo: dmesg read failed", pR->Name);
+        amxc_var_set(cstring_t, retval, "");
+        return amxd_status_unknown_error;
+    }
+    amxc_var_set(cstring_t, retval, out);
+    return amxd_status_ok;
+}
+
 
