+amxd_status_t _switchToRcac(amxd_object_t* object,
+                             amxd_function_t* func _UNUSED,
+                             amxc_var_t* args _UNUSED,
+                             amxc_var_t* retval) {
+    SAH_TRACEZ_IN(ME);
+
+    T_Radio* pR = wld_rad_fromObj(amxd_object_get_parent(amxd_object_get_parent(object)));
+    ASSERT_NOT_NULL(pR, amxd_status_ok, ME, "No mapped radio ctx");
+
+    /*
+     * PRD constraint: if BgDfs is currently running via iw dev (ZWDFS/NL80211),
+     * stop it first before using hostapd_cli. Mixing the two mechanisms
+     * simultaneously is not supported.
+     */
+    if(wld_bgdfs_isRunning(pR)) {
+        SAH_TRACEZ_WARNING(ME, "%s: switchToRcac: iw dev BgDfs is running (ch=%u), "
+                           "stopping it first before using hostapd_cli",
+                           pR->Name, pR->bgdfs_config.channel);
+        pR->pFA->mfn_wrad_bgdfs_stop(pR);
+        pR->bgdfs_stats.nrClearStopChange[pR->bgdfs_config.type]++;
+        pR->bgdfs_config.channel = 0;
+        pR->bgdfs_config.bandwidth = SWL_BW_AUTO;
+        s_resetStatus(pR);
+    }
+
+    T_AccessPoint* pAP = s_bgdfs_getAp(pR);
+    if(pAP == NULL) {
+        SAH_TRACEZ_ERROR(ME, "%s: switchToRcac: no AP available", pR->Name);
+        amxc_var_set(bool, retval, false);
+        SAH_TRACEZ_OUT(ME);
+        return amxd_status_ok;
+    }
+
+    SAH_TRACEZ_INFO(ME, "%s: switchToRcac", pR->Name);
+    /* hostapd uses lowercase "switch_to_rcac" (os_strcmp, case-sensitive) */
+    swl_rc_ne rc = wld_wpaCtrl_sendCmdFmtCheckResponse(pAP->wpaCtrlInterface, "OK",
+                                                        "switch_to_rcac");
+
+    amxc_var_set(bool, retval, swl_rc_isOk(rc));
+    SAH_TRACEZ_OUT(ME);
+    return amxd_status_ok;
+}
