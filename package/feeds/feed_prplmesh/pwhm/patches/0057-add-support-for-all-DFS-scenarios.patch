+/**
+ * @brief Helper: get the first active (or enabled) AP on a radio for wpa_ctrl commands.
+ */
+static T_AccessPoint* s_bgdfs_getAp(T_Radio* pRad) {
+    T_AccessPoint* pAP = wld_rad_getFirstActiveAp(pRad);
+    if(pAP == NULL) {
+        pAP = wld_rad_getFirstEnabledVap(pRad);
+    }
+    return pAP;
+}
