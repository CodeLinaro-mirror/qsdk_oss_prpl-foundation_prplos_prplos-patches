+/**
+ * @brief Handle QCA_NL80211_VENDOR_SUBCMD_CH_SWITCH_REASON vendor event.
+ *
+ * This event is sent by the QCA driver when a channel switch occurs.
+ * It carries the reason for the channel switch (radar detection, user
+ * request, AWGN noise, etc.).
+ *
+ * When received, this function:
+ * 1. Parses the vendor subcmd and reason from the nl80211 message
+ * 2. Emits a 'ChannelSwitchReason!' event on the Radio data model object
+ *    with the reason string as event data
+ */
+static void s_vendorEvtCb(void* pRef, void* pData _UNUSED, struct nlmsghdr* nlh, struct nlattr* tb[]) {
+    T_Radio* pRad = (T_Radio*) pRef;
+    ASSERT_NOT_NULL(pRad, , ME, "NULL");
+    ASSERT_NOT_NULL(nlh, , ME, "NULL");
+    ASSERT_NOT_NULL(tb, , ME, "NULL");
+
+    /* Extract vendor OUI and subcmd from nl80211 attributes */
+    if(!tb[NL80211_ATTR_VENDOR_ID] || !tb[NL80211_ATTR_VENDOR_SUBCMD]) {
+        return;
+    }
+
+    uint32_t vendorId = nla_get_u32(tb[NL80211_ATTR_VENDOR_ID]);
+    uint32_t subcmd   = nla_get_u32(tb[NL80211_ATTR_VENDOR_SUBCMD]);
+
+    /* Only handle QCA CH_SWITCH_REASON events */
+    if((vendorId != QCA_OUI) || (subcmd != QCA_NL80211_VENDOR_SUBCMD_CH_SWITCH_REASON)) {
+        return;
+    }
+
+    uint32_t reason = 0;
+
+    /* Parse vendor data to extract the reason attribute */
+    if(tb[NL80211_ATTR_VENDOR_DATA]) {
+        struct nlattr* vendorData = tb[NL80211_ATTR_VENDOR_DATA];
+        struct nlattr* attr;
+        int rem;
+        nla_for_each_nested(attr, vendorData, rem) {
+            if(nla_type(attr) == QCA_WLAN_VENDOR_ATTR_CH_SWITCH_REASON) {
+                reason = nla_get_u32(attr);
+                break;
+            }
+        }
+    }
+
+    const char* reasonStr = s_chSwitchReasonToStr(reason);
+    SAH_TRACEZ_WARNING(ME, "%s: QCA CH_SWITCH_REASON event: reason=%u (%s)",
+                       pRad->Name, reason, reasonStr);
+
+    /*
+     * For AWGN (reason=2): set targetChanspec.reason = CHAN_REASON_AWGN so that
+     * when the subsequent channel switch event fires, s_chanSwitchCb uses
+     * CHAN_REASON_AWGN and wld_rad_chan_update_model() writes "AWGN"
+     */
+    if(reason == 2 /* AWGN */) {
+        pRad->targetChanspec.reason = CHAN_REASON_AWGN;
+        SAH_TRACEZ_INFO(ME, "%s: AWGN detected — set targetChanspec.reason=CHAN_REASON_AWGN",
+                        pRad->Name);
+    }
+
+    /* Emit ChannelSwitchReason! event on the Radio data model object
+     * and update ChannelChangeReason DM parameter with the vendor reason string.
+     * ChannelChangeReason is set here immediately so it is visible before the
+     * channel switch completes. For AWGN it will persist because targetChanspec.reason
+     * is now CHAN_REASON_AWGN, so wld_rad_chan_update_model() will also write "AWGN". */
+    if(pRad->pBus != NULL) {
+        amxc_var_t evtData;
+        amxc_var_init(&evtData);
+        amxc_var_set_type(&evtData, AMXC_VAR_ID_HTABLE);
+        amxc_var_add_key(uint32_t, &evtData, "reason", reason);
+        amxc_var_add_key(cstring_t, &evtData, "reason_str", reasonStr);
+        amxd_object_emit_signal(pRad->pBus, "ChannelSwitchReason!", &evtData);
+        amxc_var_clean(&evtData);
+
+        /* Update ChannelChangeReason DM parameter with the vendor reason string */
+        swl_typeCharPtr_commitObjectParam(pRad->pBus, "ChannelChangeReason", (char*) reasonStr);
+    }
+}
