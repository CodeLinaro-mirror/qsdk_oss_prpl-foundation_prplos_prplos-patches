+/**
+ * @brief Write handler for ChannelMgt.BgDfs.BgCacTimeout
+ *
+ * Sets the background CAC timeout via NL80211 vendor command.
+ * Sends: QCA_NL80211_VENDOR_SUBCMD_SET_WIPHY_CONFIGURATION (505)
+ *        → QCA_WLAN_VENDOR_RADIO_PARAM_BGCAC_TIMEOUT (dparam1=89)
+ * Value 0 = use default timer.
+ *
+ * Test: ubus-cli Device.WiFi.Radio.2.ChannelMgt.BgDfs.BgCacTimeout=65
+ */
+static void s_setBgCacTimeout_pwf(void* priv _UNUSED, amxd_object_t* object,
+                                   amxd_param_t* param _UNUSED,
+                                   const amxc_var_t* const newValue) {
+    SAH_TRACEZ_IN(ME);
+
+    T_Radio* pR = wld_rad_fromObj(amxd_object_get_parent(amxd_object_get_parent(object)));
+    ASSERT_NOT_NULL(pR, , ME, "NULL");
+
+    uint32_t timeout = amxc_var_dyncast(uint32_t, newValue);
+    SAH_TRACEZ_INFO(ME, "%s: set BgCacTimeout %u", pR->Name, timeout);
+
+    int ret = wld_rad_nl80211_setBgCacTimeout(pR, timeout);
+    if(ret != 0) {
+        SAH_TRACEZ_ERROR(ME, "%s: setBgCacTimeout(%u) failed ret=%d", pR->Name, timeout, ret);
+    }
+
+    SAH_TRACEZ_OUT(ME);
+}
+
+/** Runtime write handler for BgCacEnable.
+ * Sends: SET bgcac_en <0|1> via wpa_ctrl for immediate effect.
+ * Config file also updated via wld_hostapd_cfgFile_createExt for persistence.
+ */
+static void s_setBgCacEnable_pwf(void* priv _UNUSED, amxd_object_t* object,
+                                  amxd_param_t* param _UNUSED,
+                                  const amxc_var_t* const newValue) {
+    SAH_TRACEZ_IN(ME);
+
+    T_Radio* pR = wld_rad_fromObj(amxd_object_get_parent(amxd_object_get_parent(object)));
+    ASSERT_NOT_NULL(pR, , ME, "NULL");
+
+    bool enable = amxc_var_dyncast(bool, newValue);
+    SAH_TRACEZ_INFO(ME, "%s: BgCacEnable=%d", pR->Name, enable);
+
+    /* Update hostapd config file for persistence across restarts */
+    wld_hostapd_cfgFile_createExt(pR);
+
+    /* Apply immediately at runtime via wpa_ctrl if radio is active */
+    if(!wld_rad_isActive(pR)) {
+        SAH_TRACEZ_INFO(ME, "%s: BgCacEnable: radio not active, config file updated only", pR->Name);
+        SAH_TRACEZ_OUT(ME);
+        return;
+    }
+
+    T_AccessPoint* pAP = wld_rad_getFirstActiveAp(pR);
+    if(pAP == NULL) {
+        SAH_TRACEZ_WARNING(ME, "%s: BgCacEnable: no active AP, config file updated only", pR->Name);
+        SAH_TRACEZ_OUT(ME);
+        return;
+    }
+
+    swl_rc_ne rc = wld_wpaCtrl_sendCmdFmtCheckResponse(pAP->wpaCtrlInterface, "OK",
+                                                        "SET bgcac_en %d", enable ? 1 : 0);
+    if(!swl_rc_isOk(rc)) {
+        SAH_TRACEZ_ERROR(ME, "%s: BgCacEnable: SET bgcac_en %d failed rc=%d", pR->Name, enable, rc);
+    }
+
+    SAH_TRACEZ_OUT(ME);
+}
