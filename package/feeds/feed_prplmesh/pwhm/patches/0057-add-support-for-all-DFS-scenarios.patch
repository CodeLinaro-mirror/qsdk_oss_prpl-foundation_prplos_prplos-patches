+    }
+
+    char reply[256] = {0};
+    swl_rc_ne rc = wld_wpaCtrl_sendCmdFmtGetResponse(pAP->wpaCtrlInterface, reply,
+                                                      sizeof(reply), "GET bgcac_status");
+    if(swl_rc_isOk(rc)) {
+        size_t len = strlen(reply);
