+/* -------------------------------------------------------------------------
+ * CacTimeout (READ/WRITE) — NL80211 vendor command
+ *
+ * SET: QCA_NL80211_VENDOR_SUBCMD_SET_WIPHY_CONFIGURATION (505)
+ *      → QCA_NL80211_VENDOR_SUBCMD_WIFI_PARAMS (dparam0=200)
+ *      → QCA_WLAN_VENDOR_RADIO_PARAM_CAC_TIMEOUT (dparam1=76)
+ *      → value in seconds (1–86400)
+ *
+ * GET: QCA_NL80211_VENDOR_SUBCMD_GET_WIPHY_CONFIGURATION (506)
+ *      → QCA_WLAN_VENDOR_RADIO_PARAM_CAC_TIMEOUT (dparam1=76)
+ * -------------------------------------------------------------------------
+ */
+swl_rc_ne wld_rad_nl80211_setCacTimeout(T_Radio* pRad, uint32_t timeoutSec) {
+    swl_rc_ne rc = SWL_RC_INVALID_PARAM;
+    ASSERT_NOT_NULL(pRad, rc, ME, "NULL radio");
+
+    if(timeoutSec == 0 || timeoutSec > 86400) {
+        SAH_TRACEZ_ERROR(ME, "%s: setCacTimeout: invalid value %u (range 1-86400)", pRad->Name, timeoutSec);
+        return SWL_RC_INVALID_PARAM;
+    }
+
+    uint32_t radioIdx = wld_rad_nl80211_getRadioIdx(pRad);
+    SAH_TRACEZ_INFO(ME, "%s: setCacTimeout timeoutSec=%u radioIdx=%u", pRad->Name, timeoutSec, radioIdx);
+
+    if(pRad->index <= 0 && pRad->wDevId == 0) {
+        SAH_TRACEZ_WARNING(ME, "%s: radio not available", pRad->Name);
+        return SWL_RC_ERROR;
+    }
+
+    uint8_t radioIdxU8 = (uint8_t)radioIdx;
+    uint32_t dparam0Val = QCA_DPARAM0_WIFI_PARAMS;
+    uint32_t dparam1Val = QCA_DPARAM1_CAC_TIMEOUT;
+
+    NL_ATTR_NESTED(vendorAttr, NL80211_ATTR_VENDOR_DATA);
+    NL_ATTRS_ADD(&vendorAttr.data.attribs, NL_ATTR_VAL(QCA_ATTR_RADIO_IDX, radioIdxU8));
+    NL_ATTRS_ADD(&vendorAttr.data.attribs, NL_ATTR_VAL(QCA_ATTR_DPARAM0, dparam0Val));
+    NL_ATTRS_ADD(&vendorAttr.data.attribs, NL_ATTR_VAL(QCA_ATTR_DPARAM1, dparam1Val));
+    NL_ATTRS_ADD(&vendorAttr.data.attribs, NL_ATTR_VAL(QCA_ATTR_VALUE0, timeoutSec));
+
+    uint32_t wiphy = pRad->wiphy;
+    uint32_t vendorId = QCA_VENDOR_ID;
+    uint32_t vendorSubcmd = QCA_VENDOR_SUBCMD_SET;
+
+    NL_ATTRS(attribs,
+             ARR(
+                 NL_ATTR_VAL(NL80211_ATTR_VENDOR_ID, vendorId),
+                 NL_ATTR_VAL(NL80211_ATTR_VENDOR_SUBCMD, vendorSubcmd),
+                 NL_ATTR_VAL(NL80211_ATTR_WIPHY, wiphy)
+                 )
+             );
+    swl_unLiList_add(&attribs, &vendorAttr);
+
+    rc = wld_nl80211_sendCmdSyncWithAck(wld_nl80211_getSharedState(),
+                                        NL80211_CMD_VENDOR,
+                                        0,
+                                        0,
+                                        &attribs);
+    NL_ATTRS_CLEAR(&attribs);
+    NL_ATTRS_CLEAR(&vendorAttr.data.attribs);
+
+    if(rc != SWL_RC_OK) {
+        SAH_TRACEZ_ERROR(ME, "%s: setCacTimeout failed rc=%d", pRad->Name, rc);
+    }
+    return rc;
+}
+
+/* -------------------------------------------------------------------------
+ * List5GhzChanInfo (READ-ONLY) — NL80211 vendor command
+ *
+ * GET: QCA_NL80211_VENDOR_SUBCMD_GET_WIPHY_CONFIGURATION (506)
+ *      → QCA_WLAN_VENDOR_RADIO_PARAM_LIST_5GHZ_CHAN_INFO (dparam1=88)
+ *
+ * Returns per-channel info: channel, opclass, DFS state, CAC time,
+ * CAC completion time, NOP time.
+ * Corresponds to: QCA_WLAN_VENDOR_RADIO_PARAM_GET_5GHZ_CHAN_INFO
+ * -------------------------------------------------------------------------
+ */
+#define LIST_5GHZ_CHAN_INFO_BUF_SIZE 4096
+
+typedef struct {
+    char* buf;
+    size_t bufSize;
+    swl_rc_ne rc;
+} s_list5GhzChanInfoCtx_t;
+
+static swl_rc_ne s_list5GhzChanInfoCb(swl_rc_ne rc, struct nlmsghdr* nlh, void* priv) {
+    s_list5GhzChanInfoCtx_t* pCtx = (s_list5GhzChanInfoCtx_t*)priv;
+
+    if(rc < SWL_RC_OK) {
+        pCtx->rc = rc;
+        return rc;
+    }
+
+    void* data = NULL;
+    size_t dataLen = 0;
+    rc = wld_nl80211_getVendorDataFromVendorMsg(rc, nlh, &data, &dataLen);
+    if(rc < SWL_RC_OK || data == NULL) {
+        SAH_TRACEZ_ERROR(ME, "list5GhzChanInfo: failed to get vendor data, rc=%d", rc);
+        pCtx->rc = rc;
+        return rc;
+    }
+
+    SAH_TRACEZ_INFO(ME, "list5GhzChanInfo: dataLen=%zu", dataLen);
+
+    /* Format raw data as hex string for caller to parse */
+    size_t hexLen = dataLen * 3 + 1;
+    if(hexLen > pCtx->bufSize) {
+        hexLen = pCtx->bufSize;
+    }
+    size_t pos = 0;
+    for(size_t i = 0; i < dataLen && pos + 3 < pCtx->bufSize; i++) {
+        pos += snprintf(pCtx->buf + pos, pCtx->bufSize - pos,
+                        "%02x ", ((uint8_t*)data)[i]);
+    }
+    if(pos > 0 && pCtx->buf[pos - 1] == ' ') {
+        pCtx->buf[pos - 1] = '\0';
+    }
+
+    pCtx->rc = SWL_RC_OK;
+    return SWL_RC_OK;
+}
+
+swl_rc_ne wld_rad_nl80211_list5GhzChanInfo(T_Radio* pRad, char* buf, size_t bufSize) {
+    swl_rc_ne rc = SWL_RC_INVALID_PARAM;
+    ASSERT_NOT_NULL(pRad, rc, ME, "NULL radio");
+    ASSERT_NOT_NULL(buf, rc, ME, "NULL output");
+
+    if(bufSize > 0) {
+        buf[0] = '\0';
+    }
+
+    uint32_t radioIdx = wld_rad_nl80211_getRadioIdx(pRad);
+    SAH_TRACEZ_INFO(ME, "%s: list5GhzChanInfo radioIdx=%u", pRad->Name, radioIdx);
+
+    if(pRad->index <= 0 && pRad->wDevId == 0) {
+        SAH_TRACEZ_WARNING(ME, "%s: radio not available", pRad->Name);
+        return SWL_RC_ERROR;
+    }
+
+    uint8_t radioIdxU8 = (uint8_t)radioIdx;
+    uint32_t dparam0Val = QCA_DPARAM0_WIFI_PARAMS;
+    uint32_t dparam1Val = QCA_DPARAM1_LIST_5GHZ_CHAN_INFO;
+
+    NL_ATTR_NESTED(vendorAttr, NL80211_ATTR_VENDOR_DATA);
+    NL_ATTRS_ADD(&vendorAttr.data.attribs, NL_ATTR_VAL(QCA_ATTR_RADIO_IDX, radioIdxU8));
+    NL_ATTRS_ADD(&vendorAttr.data.attribs, NL_ATTR_VAL(QCA_ATTR_DPARAM0, dparam0Val));
+    NL_ATTRS_ADD(&vendorAttr.data.attribs, NL_ATTR_VAL(QCA_ATTR_DPARAM1, dparam1Val));
+
+    s_list5GhzChanInfoCtx_t ctx = {
+        .buf = buf,
+        .bufSize = bufSize,
+        .rc = SWL_RC_ERROR
+    };
+
+    rc = wld_rad_nl80211_sendVendorSubCmdAttr(pRad, QCA_VENDOR_ID, QCA_VENDOR_SUBCMD_GET,
+                                              &vendorAttr, true, false, 0,
+                                              s_list5GhzChanInfoCb, &ctx);
+
+    NL_ATTRS_CLEAR(&vendorAttr.data.attribs);
+
+    if(rc != SWL_RC_OK) {
+        SAH_TRACEZ_ERROR(ME, "%s: list5GhzChanInfo failed rc=%d", pRad->Name, rc);
+        return rc;
+    }
+
+    return ctx.rc;
+}
