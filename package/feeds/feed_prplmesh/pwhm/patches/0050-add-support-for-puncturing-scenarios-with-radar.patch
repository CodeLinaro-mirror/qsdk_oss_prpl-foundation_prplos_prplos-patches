From 3086766ed62b014a0038507c40f73d22155db657 Mon Sep 17 00:00:00 2001
From: Atchaya R <ratchaya@qti.qualcomm.com>
Date: Sun, 19 Jul 2026 22:58:31 +0530
Subject: [PATCH] pwhm: add support for puncturing scenarios with radar

Signed-off-by: Atchaya R <ratchaya@qti.qualcomm.com>
---
 include/wld/wld.h                   |   4 +
 include/wld/wld_chanmgt.h           |  15 ++
 include/wld/wld_radio.h             |   1 +
 src/ChannelManagement/wld_chanmgt.c |  34 ++++
 src/Plugin/wifiGen_eventHandlers.c  |  14 ++
 src/wld_radio.c                     | 280 +++++++++++++++++++++++-----
 6 files changed, 299 insertions(+), 49 deletions(-)

diff --git a/include/wld/wld.h b/include/wld/wld.h
index 7523103..7b704d2 100644
--- a/include/wld/wld.h
+++ b/include/wld/wld.h
@@ -1743,6 +1743,10 @@ struct WLD_RADIO {
     uint8_t mLReconfigurationCount;                         /** Number of beacons with ML Reconfiguration IE before link removal */
     bool discardAwgnEvent;                                  /* When true, add discard_6g_awgn_event=1 to hostapd config (6GHz only) */
     bool useRuPunctureDfs;                                  /* When true, add use_ru_puncture_dfs=1 to hostapd config (11be only) */
+   swl_channel_t userPuncturedSubchannels[SWL_BW_CHANNELS_MAX]; /* User-punctured sub-channels (set by user, not by radar) */
+   uint32_t nrUserPuncturedSubChannels;                         /* Nr of user-punctured sub channels */
+   bool radarUpdatingDisabledSubChannels;                       /* True while radar path is updating DisabledSubChannels DM */
+   bool pendingUserPuncturingReapply;                           /* True when a re-apply CSA for user puncturing is pending (deferred until current CSA completes) */
 };
 
 typedef struct {
diff --git a/include/wld/wld_chanmgt.h b/include/wld/wld_chanmgt.h
index 3959c59..7fead4e 100644
--- a/include/wld/wld_chanmgt.h
+++ b/include/wld/wld_chanmgt.h
@@ -114,4 +114,19 @@ swl_radBw_e wld_chanmgt_getHighestApplicableRadBw(T_Radio* pRad);
 swl_bandwidth_e wld_chanmgt_getHighestApplicableBw(T_Radio* pRad);
 void wld_chanmgt_setNOPPeriod_pwf(void* priv, amxd_object_t* object, amxd_param_t* param, const amxc_var_t* const newValue);
 
+/**
+ * @brief Called when a CSA has fully completed (AP-CSA-FINISHED / CTRL-EVENT-CHANNEL-SWITCH).
+ *
+ * At this point the hardware has been updated to the new chanspec (without puncturing).
+ * If the user had punctured channels and the bitmap was cleared by the CAC-completion CSA,
+ * this function triggers a new direct CSA to re-apply the user puncturing.
+ *
+ * Must be called from s_chanSwitchCb (not s_chanSwitchStartedCb) so that the hardware
+ * state reflects the completed CSA before we attempt the re-apply.
+ *
+ * @param pR pointer to radio context
+ * @param chanspec the chanspec reported by the completed CSA
+ */
+void wld_chanmgt_onCsaCompleted(T_Radio* pR, swl_chanspec_t chanspec);
+
 #endif /* _WLD_CHANMGT_PCB_H_ */
diff --git a/include/wld/wld_radio.h b/include/wld/wld_radio.h
index 14a37ce..8f5e20c 100644
--- a/include/wld/wld_radio.h
+++ b/include/wld/wld_radio.h
@@ -396,6 +396,7 @@ amxd_status_t wld_rad_validateDisabledSubChannels(T_Radio* pRad, swl_channel_t*
  *                        amxd_status_unknown_error otherwise
  */
 amxd_status_t wld_rad_validateDisabledSubChannelsList(T_Radio* pRad, const char* newValue);
+void wld_rad_captureUserPuncturedSubChannels(T_Radio* pRad);
 
 /**
  * @brief update EHT Operation IE in the datamodel
diff --git a/src/ChannelManagement/wld_chanmgt.c b/src/ChannelManagement/wld_chanmgt.c
index ad3fb30..f7bde3b 100644
--- a/src/ChannelManagement/wld_chanmgt.c
+++ b/src/ChannelManagement/wld_chanmgt.c
@@ -418,6 +418,19 @@ static swl_rc_ne s_refreshCurrentChanspec(T_Radio* pR, swl_chanspec_t chanspec,
     pR->channel = chanspec.channel;
     pR->runningChannelBandwidth = swl_chanspec_toRadBw(&chanspec);
 
+    /* When UseRuPunctureDfs is enabled and the punctBitmap changes, update DisabledSubChannels.
+     * This handles the case where s_dfsRadarDetectedCb fires BEFORE the chanspec bitmap is
+     * available (bitmap=0 at that point), so wld_rad_addDisabledSubChannel cannot determine
+     * the correct sub-channel. Here pR->channel and pR->runningChannelBandwidth are already
+     * updated, so wld_rad_getSwlChanspec() returns the correct chanspec (e.g. 5_100/80#0x2)
+     * and wld_rad_updateDisabledSubChannelsFromPunctBitmap correctly maps bit1 → channel 104. */
+    if(pR->useRuPunctureDfs && (chanspec.punctBitmap != oldSpec.punctBitmap)) {
+        wld_rad_updateDisabledSubChannelsFromPunctBitmap(pR, &chanspec);
+        if((chanspec.punctBitmap == 0) && (pR->nrUserPuncturedSubChannels > 0)) {
+            pR->pendingUserPuncturingReapply = true;
+        }
+    }
+
     if((reason == pR->targetChanspec.reason) && swl_typeChanspec_equals(pR->targetChanspec.chanspec, pR->currentChanspec.chanspec)) {
         swl_str_cat(pR->currentChanspec.reasonExt, sizeof(pR->currentChanspec.reasonExt), pR->targetChanspec.reasonExt);
     } else {
@@ -1366,3 +1379,24 @@ void wld_chanmgt_setNOPPeriod_pwf(void* priv,
         SAH_TRACEZ_INFO(ME, "NOPPeriod: SET handler failed to write value %u", timeout);
     }
 }
+
+void wld_chanmgt_onCsaCompleted(T_Radio* pR, swl_chanspec_t chanspec) {
+    ASSERT_NOT_NULL(pR, , ME, "NULL");
+    if(!pR->useRuPunctureDfs) {
+        return;
+    }
+    if(!pR->pendingUserPuncturingReapply) {
+        return;
+    }
+    if((chanspec.punctBitmap != 0) || (pR->nrUserPuncturedSubChannels == 0)) {
+        pR->pendingUserPuncturingReapply = false;
+        return;
+    }
+    /* CSA completed without puncturing but user has punctured channels.
+     * The hardware now has the unpunctured chanspec, so mfn_wrad_setChanspec will
+     * see the mismatch and send a new CSA with the puncturing bitmap. */
+    SAH_TRACEZ_INFO(ME, "%s: CSA completed: re-applying user puncturing (%u channels)",
+                    pR->Name, pR->nrUserPuncturedSubChannels);
+    pR->pendingUserPuncturingReapply = false;
+    wld_chanmgt_setTargetChanspec(pR, chanspec, true, CHAN_REASON_MANUAL, NULL);
+}
diff --git a/src/Plugin/wifiGen_eventHandlers.c b/src/Plugin/wifiGen_eventHandlers.c
index a1aa060..fe12963 100644
--- a/src/Plugin/wifiGen_eventHandlers.c
+++ b/src/Plugin/wifiGen_eventHandlers.c
@@ -385,6 +385,11 @@ static void s_chanSwitchCb(void* userData, char* ifName _UNUSED, swl_chanspec_t*
     }
 
     s_saveChanChanged(pRad, chanSpec, reason);
+    /* Notify chanmgt that the CSA has fully completed so it can re-apply user puncturing
+     * if the bitmap was cleared by the CAC-completion CSA (UseRuPunctureDfs scenario).
+     * Must be called AFTER s_saveChanChanged so the pendingUserPuncturingReapply flag
+     * (set in s_refreshCurrentChanspec during s_chanSwitchStartedCb) is already set. */
+    wld_chanmgt_onCsaCompleted(pRad, *chanSpec);
 }
 
 /*
@@ -747,6 +752,15 @@ static void s_dfsNopFinishedCb(void* userData _UNUSED, char* ifName, swl_chanspe
     wld_channel_mark_passive_channel(*chanSpec);
     T_Radio* pRad = (T_Radio*) userData;
     ASSERT_NOT_NULL(pRad, , ME, "NULL");
+
+    /* At NOP expiry, re-sync userPuncturedSubchannels from the DM value.
+     * If no user puncturing happened (nrUserPuncturedSubChannels == 0), the function
+     * returns early without capturing, so radar-only puncturing is correctly cleared
+     * after NOP+CAC. */
+    if(pRad->useRuPunctureDfs) {
+        wld_rad_captureUserPuncturedSubChannels(pRad);
+    }
+
     wld_chanmgt_writeDfsChannels(pRad);
 }
 
diff --git a/src/wld_radio.c b/src/wld_radio.c
index 9abdce8..030df1d 100644
--- a/src/wld_radio.c
+++ b/src/wld_radio.c
@@ -6850,21 +6850,6 @@ static void s_saveDisabledSubChannels(T_Radio* pRad, swl_channel_t* pPunctChans,
