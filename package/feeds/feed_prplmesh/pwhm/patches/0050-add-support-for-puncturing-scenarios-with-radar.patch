  * @param pChanSpec chanspec carrying the new punctBitmap
  */
@@ -6884,36 +6872,61 @@ void wld_rad_updateDisabledSubChannelsFromPunctBitmap(T_Radio* pRad, swl_chanspe
     ASSERTS_NOT_NULL(pChanSpec, , ME, "NULL");
     ASSERTS_NOT_NULL(pRad->pBus, , ME, "NULL");
 
-    /* Convert punctBitmap to list of disabled sub-channels */
+    SAH_TRACEZ_INFO(ME, "%s: updateDisabledSubChannelsFromPunctBitmap: ch=%d bw=%d bitmap=0x%x radCh=%d userPunct=%u",
