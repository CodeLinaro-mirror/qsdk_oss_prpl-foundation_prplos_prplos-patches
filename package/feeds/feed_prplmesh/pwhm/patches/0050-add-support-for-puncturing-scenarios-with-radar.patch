         }
     }
+    if(nMergedChans > 1) {
+        qsort(mergedChans, nMergedChans, sizeof(swl_channel_t), s_cmpChanUInt8);
+    }
 
     /* No-op if value hasn't changed */
-    if((nNewPunctChans == pRad->nrDisabledSubChannels) &&
+    if((nMergedChans == pRad->nrDisabledSubChannels) &&
        swl_typeUInt8_arrayMatches(pRad->disabledSubchannels, pRad->nrDisabledSubChannels,
-                                   newPunctChans, nNewPunctChans)) {
-        SAH_TRACEZ_INFO(ME, "%s: DisabledSubChannels unchanged from punctBitmap 0x%x",
-                        pRad->Name, pChanSpec->punctBitmap);
+                                   mergedChans, nMergedChans)) {
+        SAH_TRACEZ_INFO(ME, "%s: DisabledSubChannels unchanged (bitmap=0x%x userPunct=%u)",
+                        pRad->Name, pChanSpec->punctBitmap, pRad->nrUserPuncturedSubChannels);
         return;
     }
 
     /* Update internal state FIRST (prevents re-entrant s_setChannelSpec call) */
-    s_saveDisabledSubChannels(pRad, newPunctChans, nNewPunctChans);
+    s_saveDisabledSubChannels(pRad, mergedChans, nMergedChans);
 
-    /* Build comma-separated string for data model */
     char disabledStr[256] = {0};
-    swl_typeUInt8_arrayToChar(disabledStr, sizeof(disabledStr), newPunctChans, nNewPunctChans);
-    SAH_TRACEZ_INFO(ME, "%s: UseRuPunctureDfs: updating DisabledSubChannels to (%s) from punctBitmap 0x%x",
-                    pRad->Name, disabledStr, pChanSpec->punctBitmap);
-
-    /* Commit to data model via transaction */
+    swl_typeUInt8_arrayToChar(disabledStr, sizeof(disabledStr), mergedChans, nMergedChans);
+    SAH_TRACEZ_INFO(ME, "%s: UseRuPunctureDfs: updating DisabledSubChannels to (%s) from bitmap=0x%x userPunct=%u",
+                    pRad->Name, disabledStr, pChanSpec->punctBitmap, pRad->nrUserPuncturedSubChannels);
+
+    /* Set flag so s_setDisabledSubChannels_pwf knows this is a radar-initiated update
+     * and must NOT update userPuncturedSubchannels.
+     * NOTE: do NOT clear the flag here — the write handler fires asynchronously (next
