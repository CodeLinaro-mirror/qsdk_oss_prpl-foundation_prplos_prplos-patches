+    pRad->radarUpdatingDisabledSubChannels = true;
     amxd_object_t* staticPuncObj = amxd_object_get(pRad->pBus, "StaticPuncturing");
     if(staticPuncObj != NULL) {
         amxd_trans_t trans;
@@ -6923,35 +6936,114 @@ void wld_rad_updateDisabledSubChannelsFromPunctBitmap(T_Radio* pRad, swl_chanspe
     }
 }
 
+/**
+ * @brief Add a single sub-channel to the DisabledSubChannels list (radar puncturing path).
+ *
+ * Called from s_dfsRadarDetectedCb when UseRuPunctureDfs is enabled.
+ * Updates the internal pRad->disabledSubchannels[] array FIRST, then commits
+ * the new value to the DisabledSubChannels data model parameter via transaction.
+ *
+ * @param pRad  radio context
+ * @param channel  20MHz sub-channel number that was hit by radar
+ */
 void wld_rad_addDisabledSubChannel(T_Radio* pRad, swl_channel_t channel) {
     ASSERTS_NOT_NULL(pRad, , ME, "NULL");
 
-    /* Skip if channel is already in the disabled list */
-    if(swl_typeUInt8_arrayContains(pRad->disabledSubchannels, pRad->nrDisabledSubChannels, channel)) {
-        SAH_TRACEZ_INFO(ME, "%s: sub-channel %d already in DisabledSubChannels, skipping", pRad->Name, channel);
+    SAH_TRACEZ_INFO(ME, "%s: addDisabledSubChannel called with channel=%d", pRad->Name, channel);
+
+    /* Try the current chanspec bitmap first (set by driver after channel switch) */
+    swl_chanspec_t curChspec = wld_rad_getSwlChanspec(pRad);
+    SAH_TRACEZ_INFO(ME, "%s: curChspec: ch=%d bw=%d bitmap=0x%x lastRadarAdded=%u",
+                    pRad->Name, curChspec.channel, curChspec.bandwidth, curChspec.punctBitmap,
+                    pRad->nrLastRadarChannelsAdded);
+
+    if(curChspec.punctBitmap != 0) {
+        /* Bitmap already updated by driver — use it to map bits → sub-channels */
+        wld_rad_updateDisabledSubChannelsFromPunctBitmap(pRad, &curChspec);
         return;
     }
 
-    /* Update internal state first (prevents re-entrant s_setChannelSpec call) */
-    if(pRad->nrDisabledSubChannels < SWL_BW_CHANNELS_MAX) {
-        pRad->disabledSubchannels[pRad->nrDisabledSubChannels++] = channel;
-    } else {
-        SAH_TRACEZ_WARNING(ME, "%s: DisabledSubChannels array full, cannot add channel %d", pRad->Name, channel);
+    /* Bitmap not yet updated (s_dfsRadarDetectedCb fires before the channel-switch
+     * event that carries the new punctBitmap).  Fall back to lastRadarChannelsAdded
+     * which wld_chanmgt_radarDetected() already computed correctly via
+     * wld_channel_get_radartriggered_channels() — e.g. [104] not [100]. */
+    if(pRad->nrLastRadarChannelsAdded > 0) {
+        SAH_TRACEZ_INFO(ME, "%s: bitmap=0, using lastRadarChannelsAdded (nr=%u)",
+                        pRad->Name, pRad->nrLastRadarChannelsAdded);
+        for(uint32_t i = 0; i < pRad->nrLastRadarChannelsAdded; i++) {
+            swl_channel_t radarChan = pRad->lastRadarChannelsAdded[i];
+            SAH_TRACEZ_INFO(ME, "%s: adding radar channel %d", pRad->Name, radarChan);
+            if(!swl_typeUInt8_arrayContains(pRad->disabledSubchannels, pRad->nrDisabledSubChannels, radarChan)) {
+                if(pRad->nrDisabledSubChannels < SWL_BW_CHANNELS_MAX) {
+                    pRad->disabledSubchannels[pRad->nrDisabledSubChannels++] = radarChan;
+                }
+            }
+        }
+        char disabledStr[256] = {0};
+        swl_typeUInt8_arrayToChar(disabledStr, sizeof(disabledStr), pRad->disabledSubchannels, pRad->nrDisabledSubChannels);
+        SAH_TRACEZ_INFO(ME, "%s: DisabledSubChannels -> (%s)", pRad->Name, disabledStr);
+        /* Same async-flag rule: do NOT clear here; write handler clears it. */
+        pRad->radarUpdatingDisabledSubChannels = true;
+        amxd_object_t* staticPuncObj = amxd_object_get(pRad->pBus, "StaticPuncturing");
+        if(staticPuncObj != NULL) {
+            amxd_trans_t trans;
+            ASSERT_TRANSACTION_INIT(staticPuncObj, &trans, , ME, "%s: trans init failure", pRad->Name);
+            amxd_trans_set_cstring_t(&trans, "DisabledSubChannels", disabledStr);
+            ASSERT_TRANSACTION_LOCAL_DM_END(&trans, , ME, "%s: trans apply failure", pRad->Name);
+        }
         return;
     }
 
-    /* Build the comma-separated string for the data model */
-    char disabledStr[256] = {0};
-    swl_typeUInt8_arrayToChar(disabledStr, sizeof(disabledStr), pRad->disabledSubchannels, pRad->nrDisabledSubChannels);
-    SAH_TRACEZ_INFO(ME, "%s: UseRuPunctureDfs: updating DisabledSubChannels to (%s)", pRad->Name, disabledStr);
+    SAH_TRACEZ_WARNING(ME, "%s: bitmap=0 and no lastRadarChannelsAdded, cannot determine punctured channel",
+                       pRad->Name);
+}
+
+/**
+ * @brief Capture the current DisabledSubChannels DM value as userPuncturedSubchannels.
+ *
+ * Called at NOP expiry (s_dfsNopFinishedCb) to capture any user intent that was set
+ * during NOP.  The AMX DM framework skips the ENTIRE action chain (validate + write
+ * handler) when the new value equals the current value, so if radar set "104" and the
+ * user also sets "104" during NOP, the write handler is never called and
+ * userPuncturedSubchannels is never updated.
+ *
+ * Reading the DM value at NOP expiry is the only reliable way to capture this intent.
+ */
+void wld_rad_captureUserPuncturedSubChannels(T_Radio* pRad) {
+    ASSERTS_NOT_NULL(pRad, , ME, "NULL");
+    ASSERTS_NOT_NULL(pRad->pBus, , ME, "NULL");
+
+    /* Only capture if the user explicitly set DisabledSubChannels (nrUserPuncturedSubChannels > 0).
+     * If the user never set it during NOP (only radar set it), nrUserPuncturedSubChannels stays 0
+     * and we should NOT capture — otherwise radar-set values would be incorrectly treated as
+     * user intent and re-applied after NOP+CAC even when no user puncturing happened.
+     *
+     * Note: nrUserPuncturedSubChannels is reset to 0 when radar sets DisabledSubChannels
+     * (in wld_rad_updateDisabledSubChannelsFromPunctBitmap via the write handler's radar path).
+     * It is only set > 0 when the user explicitly writes DisabledSubChannels. */
+    if(pRad->nrUserPuncturedSubChannels == 0) {
+        SAH_TRACEZ_INFO(ME, "%s: NOP finished: no user puncturing during NOP (userPunct=0), skipping capture",
+                        pRad->Name);
+        return;
+    }
 
-    /* Commit to data model via transaction */
     amxd_object_t* staticPuncObj = amxd_object_get(pRad->pBus, "StaticPuncturing");
-    if(staticPuncObj != NULL) {
-        amxd_trans_t trans;
-        ASSERT_TRANSACTION_INIT(staticPuncObj, &trans, , ME, "%s: trans init failure", pRad->Name);
-        amxd_trans_set_cstring_t(&trans, "DisabledSubChannels", disabledStr);
-        ASSERT_TRANSACTION_LOCAL_DM_END(&trans, , ME, "%s: trans apply failure", pRad->Name);
+    ASSERTI_NOT_NULL(staticPuncObj, , ME, "%s: no StaticPuncturing object", pRad->Name);
+
+    const char* dmVal = amxc_var_constcast(cstring_t,
+        amxd_object_get_param_value(staticPuncObj, "DisabledSubChannels"));
+    ASSERTI_NOT_NULL(dmVal, , ME, "%s: no DisabledSubChannels param", pRad->Name);
+
+    swl_channel_t aPunctChans[SWL_BW_CHANNELS_MAX] = {0};
+    size_t nPunctChans = 0;
+    if(s_parseDisabledSubChannels(dmVal, SWL_BW_CHANNELS_MAX, aPunctChans, &nPunctChans)) {
+        pRad->nrUserPuncturedSubChannels = nPunctChans;
+        memset(pRad->userPuncturedSubchannels, 0, sizeof(pRad->userPuncturedSubchannels));
+        if(nPunctChans > 0) {
+            memcpy(pRad->userPuncturedSubchannels, aPunctChans, nPunctChans * sizeof(swl_channel_t));
+        }
+        SAH_TRACEZ_INFO(ME, "%s: NOP finished: captured userPuncturedSubchannels from DM (nr=%zu val=%s)",
+                        pRad->Name, nPunctChans, dmVal);
     }
 }
 
@@ -6961,6 +7053,38 @@ amxd_status_t wld_rad_validateDisabledSubChannels(T_Radio* pRad, swl_channel_t*
     char punctChansStr[256] = {0};
     swl_typeUInt8_arrayToChar(punctChansStr, sizeof(punctChansStr), pPunctChans, nPunctChans);
     swl_chanspec_t baseChspec = SWL_CHANSPEC_EMPTY;
+
+    /* Scenario 4: reject unpuncturing a radar-triggered channel during NOP.
+     * When UseRuPunctureDfs is enabled and the current chanspec has a non-zero punctBitmap,
+     * the user must not remove any currently-punctured (radar-triggered) channel from
+     * DisabledSubChannels while the NOP is still active.
+     *
+     * IMPORTANT: after NOP expires and CAC completes without a new radar detection, the
+     * hardware still has punctBitmap != 0 because the user-requested puncturing was
+     * re-applied by wld_chanmgt_onCsaCompleted.  In that case the channel is no longer
+     * radar-detected, so the user MUST be allowed to unpuncture.
+     * Only block when the sub-channel is CURRENTLY radar-detected (i.e. NOP is active). */
+    if(pRad->useRuPunctureDfs) {
+        swl_chanspec_t curChspec = wld_rad_getSwlChanspec(pRad);
+        if(curChspec.punctBitmap != 0) {
+            swl_channel_t chanList[SWL_BW_CHANNELS_MAX] = {0};
+            int nChans = swl_chanspec_getChannelsInChanspec(&curChspec, chanList, SWL_BW_CHANNELS_MAX);
+            for(int i = 0; i < nChans; i++) {
+                if(curChspec.punctBitmap & (1u << i)) {
+                    swl_channel_t punctChan = chanList[i];
+                    if(!swl_typeUInt8_arrayContains(pPunctChans, nPunctChans, punctChan)) {
+                        swl_chanspec_t subChanSpec = SWL_CHANSPEC_NEW(punctChan, SWL_BW_20MHZ, pRad->operatingFrequencyBand);
