+static void s_clearPendingDppCredentials(T_AccessPoint* pAP) {
+    ASSERTS_NOT_NULL(pAP, , ME, "NULL");
+    W_SWL_FREE(pAP->dppPendingConnector);
+    W_SWL_FREE(pAP->dppPendingCSign);
+    W_SWL_FREE(pAP->dppPendingNetAccessKey);
+}
+
+static const char* s_getDppEventPayload(const char* msgData, const char* eventName) {
+    ASSERTS_NOT_NULL(msgData, "", ME, "NULL");
+    ASSERTS_NOT_NULL(eventName, msgData, ME, "NULL");
+
+    const char* payload = msgData;
+    if(payload[0] == '<') {
+        const char* end = strchr(payload, '>');
+        if(end) {
+            payload = end + 1;
+        }
+    }
+
+    size_t eventLen = strlen(eventName);
+    if(strncmp(payload, eventName, eventLen) == 0) {
+        payload += eventLen;
+        if(payload[0] == ' ') {
+            payload++;
+        }
+    }
+
+    return payload;
+}
+
+static bool s_isDppWhitespace(char c) {
+    return (c == ' ') || (c == '\t') || (c == '\r') || (c == '\n');
+}
+
+static void s_storePendingDppCredential(char** field, const char* value, bool firstTokenOnly) {
+    ASSERTS_NOT_NULL(field, , ME, "NULL");
+    ASSERTS_NOT_NULL(value, , ME, "NULL");
+    if(swl_str_isEmpty(value)) {
+        return;
+    }
+
+    size_t len = strlen(value);
+    while((len > 0) && s_isDppWhitespace(value[len - 1])) {
+        len--;
+    }
+    if(firstTokenOnly) {
+        for(size_t i = 0; i < len; i++) {
+            if(s_isDppWhitespace(value[i])) {
+                len = i;
+                break;
+            }
+        }
+    }
+    if(len == 0) {
+        return;
+    }
+
+    char* copy = calloc(1, len + 1);
+    ASSERTS_NOT_NULL(copy, , ME, "NULL");
+    memcpy(copy, value, len);
+
+    W_SWL_FREE(*field);
+    *field = copy;
+}
+
+static void s_persistCompleteDppCredentials(T_AccessPoint* pAP) {
+    ASSERTS_NOT_NULL(pAP, , ME, "NULL");
+    ASSERTS_NOT_NULL(pAP->pBus, , ME, "%s: missing AP object", pAP->alias);
+    ASSERTS_TRUE(!swl_str_isEmpty(pAP->dppPendingConnector) &&
+                 !swl_str_isEmpty(pAP->dppPendingCSign) &&
+                 !swl_str_isEmpty(pAP->dppPendingNetAccessKey),
+                 , ME, "%s: DPP credential set is incomplete", pAP->alias);
+
+    amxd_object_t* dppObj = amxd_object_findf(pAP->pBus, "DPP");
+    ASSERTS_NOT_NULL(dppObj, , ME, "%s: DPP object not found", pAP->alias);
+
+    amxd_trans_t trans;
+    ASSERT_TRANSACTION_INIT(dppObj, &trans, , ME, "%s: trans init failure", pAP->alias);
+    amxd_trans_set_cstring_t(&trans, "Connector", pAP->dppPendingConnector);
+    amxd_trans_set_cstring_t(&trans, "CSign", pAP->dppPendingCSign);
+    amxd_trans_set_cstring_t(&trans, "NetAccessKey", pAP->dppPendingNetAccessKey);
+    ASSERT_TRANSACTION_LOCAL_DM_END(&trans, , ME, "%s: DPP credential persist failure", pAP->alias);
+
+    SAH_TRACEZ_INFO(ME, "%s: persisted complete DPP credential set", pAP->alias);
+    s_clearPendingDppCredentials(pAP);
+}
+
+static void s_handleDppCredentialEvent(T_AccessPoint* pAP, char* eventName, char* msgData) {
+    ASSERTS_NOT_NULL(pAP, , ME, "NULL");
+    ASSERTS_NOT_NULL(eventName, , ME, "NULL");
+    ASSERTS_NOT_NULL(msgData, , ME, "NULL");
+
+    bool updated = false;
+    if(swl_str_matches(eventName, "DPP-CONNECTOR")) {
+        s_storePendingDppCredential(&pAP->dppPendingConnector, s_getDppEventPayload(msgData, eventName), false);
+        updated = true;
+    } else if(swl_str_matches(eventName, "DPP-C-SIGN-KEY")) {
+        s_storePendingDppCredential(&pAP->dppPendingCSign, s_getDppEventPayload(msgData, eventName), false);
+        updated = true;
+    } else if(swl_str_matches(eventName, "DPP-NET-ACCESS-KEY")) {
+        s_storePendingDppCredential(&pAP->dppPendingNetAccessKey, s_getDppEventPayload(msgData, eventName), true);
+        updated = true;
+    } else if(swl_str_matches(eventName, "DPP-AUTH-SUCCESS") ||
+              swl_str_matches(eventName, "DPP-FAIL") ||
+              swl_str_matches(eventName, "DPP-CONF-FAILED")) {
+        s_clearPendingDppCredentials(pAP);
+        return;
+    }
+
+    if(updated) {
+        s_persistCompleteDppCredentials(pAP);
+    }
+}
