--- a/src/nl80211/wld_hostapd_cfgFile.c
+++ b/src/nl80211/wld_hostapd_cfgFile.c
@@ -2207,6 +2207,40 @@
         swl_mapChar_add(vapConfigMap, "dpp_configurator_connectivity", "1");
     }
 
+    /* DPP credentials are per-BSS and must be replayed after hostapd restart. */
+    if(pAP->DPP_Enable && pAP->pBus) {
+        amxd_object_t* dppObj = amxd_object_findf(pAP->pBus, "DPP");
+        if(dppObj) {
+            char* connector = amxd_object_get_cstring_t(dppObj, "Connector", NULL);
+            char* csign = amxd_object_get_cstring_t(dppObj, "CSign", NULL);
+            char* netAccessKey = amxd_object_get_cstring_t(dppObj, "NetAccessKey", NULL);
+            bool hasConnector = (connector && connector[0]);
+            bool hasCSign = (csign && csign[0]);
+            bool hasNetAccessKey = (netAccessKey && netAccessKey[0]);
+            if(hasConnector && hasCSign && hasNetAccessKey) {
+                swl_mapChar_add(vapConfigMap, "dpp_connector", connector);
+                swl_mapChar_add(vapConfigMap, "dpp_csign", csign);
+                swl_mapChar_add(vapConfigMap, "dpp_netaccesskey", netAccessKey);
+
+                /* A BSS holding a DPP Connector must also advertise the DPP AKM in its
+                 * RSN IE, or a peer using that Connector can never associate. */
+                char* curKeyMgmt = swl_mapChar_get(vapConfigMap, "wpa_key_mgmt");
+                if(!swl_str_isEmpty(curKeyMgmt)) {
+                    char keyMgmtBuf[128] = {0};
+                    swl_str_copy(keyMgmtBuf, sizeof(keyMgmtBuf), curKeyMgmt);
+                    swl_mapCharFmt_addValStr(vapConfigMap, "wpa_key_mgmt", "%s DPP", keyMgmtBuf);
+                }
+            } else if(hasConnector || hasCSign || hasNetAccessKey) {
+                SAH_TRACEZ_WARNING(ME,
+                                   "%s: incomplete persistent DPP credential set, skipping replay",
+                                   pAP->alias);
+            }
+            free(connector);
+            free(csign);
+            free(netAccessKey);
+        }
+    }
+
     /* DCS: write dcs_enable bitmask to hostapd config when non-zero.
      * Bit 0 = CW, Bit 1 = WLAN, Bit 2 = AWGN, Bit 4 = OBSS */
     if(pAP->DCS_Enable) {
