+static bool s_dppCtrlReady(T_EndPoint* pEP) {
+    return (pEP != NULL) && wld_wpaCtrlInterface_isReady(pEP->wpaCtrlInterface);
+}
+
+amxd_status_t _dpp_bootstrap_gen_info(amxd_object_t* obj,
+                                       amxd_function_t* func _UNUSED,
+                                       amxc_var_t* args,
+                                       amxc_var_t* retMap) {
+    T_EndPoint* pEP = wld_ep_fromObj(amxd_object_get_parent(obj));
+    ASSERTS_TRUE(s_dppCtrlReady(pEP), amxd_status_not_supported, ME,
+                 "DPP wpa_ctrl is not ready");
+
+    const char* curve = GET_CHAR(args, "curve");
+    uint32_t chan = GET_UINT32(args, "chan");
+    uint32_t operatingclass = GET_UINT32(args, "operatingclass");
+    const char* key = GET_CHAR(args, "key");
+
+    if(swl_str_isEmpty(curve)) {
+        curve = "P-256";
+    }
+
+    char cmd[1024] = {0};
+    char idReply[64] = {0};
+    int len = snprintf(cmd, sizeof(cmd), "DPP_BOOTSTRAP_GEN type=qrcode curve=%s", curve);
+    if((chan != 0) && (operatingclass != 0)) {
+        len += snprintf(cmd + len, sizeof(cmd) - len, " chan=%u/%u", operatingclass, chan);
+    }
+    if(!swl_str_isEmpty(key)) {
+        snprintf(cmd + len, sizeof(cmd) - len, " key=%s", key);
+    }
+
+    swl_rc_ne ret = wld_wpaCtrl_sendCmdFmtGetResponse(pEP->wpaCtrlInterface, idReply,
+                                                      sizeof(idReply), "%s", cmd);
+    if((ret != SWL_RC_OK) || swl_str_isEmpty(idReply) || swl_str_matches(idReply, "FAIL")) {
+        SAH_TRACEZ_ERROR(ME, "DPP_BOOTSTRAP_GEN failed");
+        return amxd_status_unknown_error;
+    }
+
+    uint32_t id = atoi(idReply);
+    if(id == 0) {
+        SAH_TRACEZ_ERROR(ME, "DPP_BOOTSTRAP_GEN returned invalid id: %s", idReply);
+        return amxd_status_unknown_error;
+    }
+
+    char uriReply[1024] = {0};
+    snprintf(cmd, sizeof(cmd), "DPP_BOOTSTRAP_GET_URI %u", id);
+    ret = wld_wpaCtrl_sendCmdFmtGetResponse(pEP->wpaCtrlInterface, uriReply,
+                                            sizeof(uriReply), "%s", cmd);
+    if((ret != SWL_RC_OK) || swl_str_isEmpty(uriReply) || swl_str_matches(uriReply, "FAIL")) {
+        SAH_TRACEZ_ERROR(ME, "DPP_BOOTSTRAP_GET_URI failed");
+        return amxd_status_unknown_error;
+    }
+
+    char result[1200] = {0};
+    snprintf(result, sizeof(result), "id=%u\nuri=%s", id, uriReply);
+    amxc_var_set(cstring_t, retMap, result);
+    return amxd_status_ok;
+}
+
+amxd_status_t _setDppExtraConfReq(amxd_object_t* obj,
+                                   amxd_function_t* func _UNUSED,
+                                   amxc_var_t* args,
+                                   amxc_var_t* retMap) {
+    T_EndPoint* pEP = wld_ep_fromObj(amxd_object_get_parent(obj));
+    ASSERTS_TRUE(s_dppCtrlReady(pEP), amxd_status_not_supported, ME,
+                 "DPP wpa_ctrl is not ready");
+
+    const char* name = GET_CHAR(args, "name");
+    const char* value = GET_CHAR(args, "value");
+    ASSERTS_TRUE(swl_str_matches(name, "bSTAList"), amxd_status_invalid_arg, ME,
+                 "unsupported DPP extra request name");
+    ASSERT_NOT_NULL(value, amxd_status_invalid_arg, ME, "missing DPP extra request value");
+
+    bool ok = wld_wpaCtrl_sendCmdCheckResponse(pEP->wpaCtrlInterface,
+                                               "SET dpp_extra_conf_req_name bSTAList", "OK");
+    if(ok) {
+        ok = wld_wpaCtrl_sendCmdFmtCheckResponse(pEP->wpaCtrlInterface, "OK",
+                                                  "SET dpp_extra_conf_req_value %s", value);
+    }
+    amxc_var_set(bool, retMap, ok);
+    return ok ? amxd_status_ok : amxd_status_unknown_error;
+}
+
+static amxd_status_t s_dppGetReply(T_EndPoint* pEP, const char* cmd, amxc_var_t* retMap) {
+    char reply[8192] = {0};
+    swl_rc_ne ret = wld_wpaCtrl_sendCmdFmtGetResponse(pEP->wpaCtrlInterface,
+                                                      reply, sizeof(reply), "%s", cmd);
+    if((ret != SWL_RC_OK) || swl_str_isEmpty(reply) || swl_str_matches(reply, "FAIL")) {
+        return amxd_status_unknown_error;
+    }
+    amxc_var_set(cstring_t, retMap, reply);
+    return amxd_status_ok;
+}
+
+amxd_status_t _listDppNetworks(amxd_object_t* obj,
+                               amxd_function_t* func _UNUSED,
+                               amxc_var_t* args _UNUSED,
+                               amxc_var_t* retMap) {
+    T_EndPoint* pEP = wld_ep_fromObj(amxd_object_get_parent(obj));
+    ASSERTS_TRUE(s_dppCtrlReady(pEP), amxd_status_not_supported, ME,
+                 "DPP wpa_ctrl is not ready");
+    return s_dppGetReply(pEP, "LIST_NETWORKS", retMap);
+}
+
+amxd_status_t _getDppNetworkValue(amxd_object_t* obj,
+                                  amxd_function_t* func _UNUSED,
+                                  amxc_var_t* args,
+                                  amxc_var_t* retMap) {
+    T_EndPoint* pEP = wld_ep_fromObj(amxd_object_get_parent(obj));
+    ASSERTS_TRUE(s_dppCtrlReady(pEP), amxd_status_not_supported, ME,
+                 "DPP wpa_ctrl is not ready");
+
+    uint32_t id = GET_UINT32(args, "id");
+    const char* field = GET_CHAR(args, "field");
+    ASSERTS_TRUE(swl_str_matches(field, "dpp_connector") ||
+                 swl_str_matches(field, "dpp_netaccesskey") ||
+                 swl_str_matches(field, "dpp_csign"),
+                 amxd_status_invalid_arg, ME, "unsupported DPP network field");
+
+    char cmd[128] = {0};
+    snprintf(cmd, sizeof(cmd), "GET_NETWORK %u %s", id, field);
+    return s_dppGetReply(pEP, cmd, retMap);
+}
+
+amxd_status_t _getDpp1905Connector(amxd_object_t* obj,
+                                   amxd_function_t* func _UNUSED,
+                                   amxc_var_t* args _UNUSED,
+                                   amxc_var_t* retMap) {
+    T_EndPoint* pEP = wld_ep_fromObj(amxd_object_get_parent(obj));
+    ASSERTS_TRUE(s_dppCtrlReady(pEP), amxd_status_not_supported, ME,
+                 "DPP wpa_ctrl is not ready");
+    return s_dppGetReply(pEP, "GET dpp_1905_connector", retMap);
+}
