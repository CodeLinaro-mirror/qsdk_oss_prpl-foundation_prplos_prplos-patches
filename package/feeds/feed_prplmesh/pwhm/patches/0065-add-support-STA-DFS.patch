--- a/src/ChannelManagement/wld_channel.c
+++ b/src/ChannelManagement/wld_channel.c
@@ -115,6 +115,12 @@
  * Flag indicating that a radar is detected on this channel, and thus currently unusable.
  */
 #define WLD_CHAN_RADAR_DETECTED 0x08
+/**
+ * Flag indicating this channel has ever had radar detected on it (NOL history).
+ * Unlike WLD_CHAN_RADAR_DETECTED, this flag is never cleared by NOP expiry.
+ * It is persisted via the NolHistory DM parameter and restored on startup.
+ */
+#define WLD_CHAN_NOL_HISTORY 0x10
 
 
 typedef struct {
@@ -231,9 +237,10 @@ static inline bool chandata_has_flag(wld
 }
 
 static inline void chandata_add_flag(wld_channel_data* data, uint32_t flag) {
-    /* Do not mark CAC needed or RADAR detected flags on non-DFS channels */
+    /* Do not mark DFS-only flags on non-DFS channels */
     if((!chandata_has_flag(data, WLD_CHAN_RADAR_REQUIRED)) &&
-       ((flag == WLD_CHAN_PASSIVE) || (flag == WLD_CHAN_RADAR_DETECTED))) {
+       ((flag == WLD_CHAN_PASSIVE) || (flag == WLD_CHAN_RADAR_DETECTED) ||
+        (flag == WLD_CHAN_NOL_HISTORY))) {
         return;
     }
     data->flags = data->flags | flag;
@@ -402,9 +409,18 @@ size_t wld_channel_get_radartriggered_ch
     for(i = 0; (i < band->nr_channels) && (nr_cleared_channels < list_size); i++) {
         ASSERTS_NOT_NULL(band->channels, 0, ME, "null channel list");
         channel = &(band->channels[i]);
+        /* Only include channels that are actively in NOP (WLD_CHAN_RADAR_DETECTED set).
+         * If WLD_CHAN_AVAILABLE_FLAG is also set, the NOP has expired (channel is now
+         * in 'usable' state) but DFS-NOP-FINISHED was not received to clear the flag.
+         * Auto-clear the stale WLD_CHAN_RADAR_DETECTED flag in that case. */
         if(chandata_has_flag(channel, WLD_CHAN_RADAR_DETECTED)) {
-            list[nr_cleared_channels] = channel->channel;
-            nr_cleared_channels++;
+            if(chandata_has_flag(channel, WLD_CHAN_AVAILABLE_FLAG)) {
+                /* NOP expired but flag not cleared — clear it now */
+                chan_remove_flag(channel->channel, pRad->operatingFrequencyBand, WLD_CHAN_RADAR_DETECTED);
+            } else {
+                list[nr_cleared_channels] = channel->channel;
+                nr_cleared_channels++;
+            }
         }
     }
     if(i < band->nr_channels) {
@@ -517,6 +533,32 @@ void wld_channel_clear_radar_detected_ba
 }
 
 /**
+ * Mark a single channel as NOL history (radar was ever detected here).
+ * Only effective on DFS channels (WLD_CHAN_RADAR_REQUIRED must be set).
+ */
+void wld_channel_mark_nol_history_channel(swl_chanspec_t chanspec) {
+    chan_add_flag(chanspec.channel, chanspec.band, WLD_CHAN_NOL_HISTORY);
+}
+
+/**
+ * Get all channels that have NOL history (radar ever detected).
+ * Returns the number of channels written to list[].
+ */
+size_t wld_channel_get_nol_history_channels(T_Radio* pRad, swl_channel_t* list, size_t list_size) {
+    wld_band_data* band = get_band(pRad->operatingFrequencyBand);
+    ASSERTS_NOT_NULL(band, 0, ME, "null freqband");
+    size_t nr = 0;
+    for(size_t i = 0; (i < band->nr_channels) && (nr < list_size); i++) {
+        ASSERTS_NOT_NULL(band->channels, 0, ME, "null channel list");
+        wld_channel_data* ch = &(band->channels[i]);
+        if(chandata_has_flag(ch, WLD_CHAN_NOL_HISTORY)) {
+            list[nr++] = ch->channel;
+        }
+    }
+    return nr;
+}
+
