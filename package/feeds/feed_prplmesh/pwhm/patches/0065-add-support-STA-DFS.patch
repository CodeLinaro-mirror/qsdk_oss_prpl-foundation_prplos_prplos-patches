+/**
+ * Load NOL history from the persistent DM parameter and mark the channels
+ * in the internal channel data structure.  Must be called AFTER
+ * wld_channel_init_channels() + s_readChanInfo() so that WLD_CHAN_RADAR_REQUIRED
+ * is already set on DFS channels (required by chandata_add_flag guard).
+ */
+void wld_chanmgt_loadNolHistory(T_Radio* pRad) {
+    ASSERTI_NOT_NULL(pRad, , ME, "Radio null");
+    ASSERTI_NOT_NULL(pRad->pBus, , ME, "Radio pBus null");
+    amxd_object_t* chanObject = amxd_object_findf(pRad->pBus, "ChannelMgt");
+    ASSERTI_NOT_NULL(chanObject, , ME, "ChannelMgt null");
+    const amxc_var_t* nolHistVar = amxd_object_get_param_value(chanObject, "NolHistory");
+    if(!nolHistVar) {
+        return;
+    }
+    const char* nolHistStr = amxc_var_constcast(cstring_t, nolHistVar);
+    if(!nolHistStr || !nolHistStr[0]) {
+        return;
+    }
+    /* Parse comma-separated channel list and mark each channel in NOL history */
+    char buf[256] = {0};
+    swl_str_copy(buf, sizeof(buf), nolHistStr);
+    char* token = strtok(buf, ",");
+    while(token) {
+        int chan = atoi(token);
+        if(chan > 0) {
+            swl_chanspec_t chanSpec = SWL_CHANSPEC_NEW(chan, SWL_BW_20MHZ, pRad->operatingFrequencyBand);
+            wld_channel_mark_nol_history_channel(chanSpec);
+        }
+        token = strtok(NULL, ",");
+    }
+    SAH_TRACEZ_INFO(ME, "%s: restored NOL history: %s", pRad->Name, nolHistStr);
+}
