-     * Fall back to marking the entire band when no bitmap is provided (legacy drivers).
-     */
+    /* STA-side radar detection: only update NolHistory on Endpoint.
+     * Do NOT mark radar-detected channels or call wld_chanmgt_writeDfsChannels —
+     * that would overwrite RadarTriggeredDfsChannels (an AP-side concern). */
+    if(wld_vep_from_name(ifName) != NULL) {
+        swl_channel_t nolList[SWL_BW_CHANNELS_MAX] = {0};
+        int nNol = swl_chanspec_getChannelsInChanspec(chanSpec, nolList, SWL_BW_CHANNELS_MAX);
+        for(int i = 0; i < nNol; i++) {
+            swl_chanspec_t sub = SWL_CHANSPEC_NEW(nolList[i], SWL_BW_20MHZ, chanSpec->band);
+            wld_channel_mark_nol_history_channel(sub);
+        }
+        wld_chanmgt_saveNolHistoryToEndpoints(pRad);
+        SAH_TRACEZ_INFO(ME, "%s: STA side: updated NolHistory for ch=%d", ifName, chanSpec->channel);
+        return;
+    }
+
+    /* AP-side radar detection: mark channels and trigger channel switch.
