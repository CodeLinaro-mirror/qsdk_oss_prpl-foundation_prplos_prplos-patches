+		 *
+		 * Written to wpa_supplicant.conf as: cswopts=<value>
+		 * Applied at runtime via wpa_ctrl: SET CSwOpts <value>
+		 *
+		 * Controls channel-switch-handler behaviour when the STA detects radar:
+		 *   Bit 4 (0x10): Send RCSA to uplink AP on radar detection
+		 *   Bit 5 (0x20): Process received RCSA from downstream
+		 *   (other bits: see hostapd CSwOpts documentation)
+		 *
+		 * Only written when non-zero. Writing cswopts=0 causes wpa_supplicant
+		 * to fail config parsing on builds that do not support this parameter.
+		 *
+		 * Runtime write handler: applies CSwOpts immediately via wpa_ctrl
+		 * (SET CSwOpts <value>) in addition to updating the config file.
+		 */
+		%persistent uint32 CSwOpts {
+			on action validate call check_maximum 127;
+			on action write call wld_ep_setCSwOpts_pwf;
+			default 0;
 		}
 
