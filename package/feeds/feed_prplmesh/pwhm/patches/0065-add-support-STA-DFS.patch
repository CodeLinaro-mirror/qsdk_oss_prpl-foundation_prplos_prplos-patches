+
+/**
+ * @brief wld_ep_setSTADfsEnable_pwf - AMX action write handler for STADfsEnable.
+ *
+ * Called when STADfsEnable is written via the AMX data model.
+ * Applies the change immediately at runtime:
+ *   1. Regenerates wpa_supplicant config file (persists cswopts across restarts)
+ *   2. Sends "SET cswopts <value>" to wpa_supplicant via wpa_ctrl if running
+ *      (value = Radio.CSwOpts when enable=true, 0 when enable=false)
+ *   3. Sets sta_dfs_en in the kernel driver via NL80211
+ */
+amxd_status_t wld_ep_setSTADfsEnable_pwf(amxd_object_t* object,
+                                          amxd_param_t* param _UNUSED,
+                                          amxd_action_t reason _UNUSED,
+                                          const amxc_var_t* const args,
+                                          amxc_var_t* const retval _UNUSED,
+                                          void* priv _UNUSED) {
+    ASSERTS_FALSE(amxc_var_is_null(args), amxd_status_invalid_value, ME, "invalid args");
+    T_EndPoint* pEP = wld_ep_fromObj(object);
+    ASSERTI_NOT_NULL(pEP, amxd_status_ok, ME, "No endpoint mapped");
+
+    bool enable = amxc_var_dyncast(bool, args);
+    T_Radio* pRad = pEP->pRadio;
+    SAH_TRACEZ_WARNING(ME, "%s: STADfsEnable write handler: enable=%d", pEP->Name, enable);
+
+    /* Regenerate config file so cswopts persists across restarts */
+    if(pEP->wpaSupp && !swl_str_isEmpty(pEP->wpaSupp->cfgFile)) {
+        wld_wpaSupp_cfgFile_createExt(pEP);
+        /* Write cswopts to config file (only when enable=true and CSwOpts > 0) */
+        if(enable && pRad && pRad->pBus) {
+            uint32_t cswopts = amxd_object_get_uint32_t(pRad->pBus, "CSwOpts", NULL);
+            if(cswopts > 0) {
+                char cswopts_str[16] = {0};
+                snprintf(cswopts_str, sizeof(cswopts_str), "%u", cswopts);
+                wld_wpaSupp_cfgFile_globalConfigUpdate(pEP->wpaSupp->cfgFile, "cswopts", cswopts_str);
+                SAH_TRACEZ_WARNING(ME, "%s: wrote cswopts=%u to wpa_supplicant config (STADfsEnable=true)",
+                                   pEP->Name, cswopts);
+            }
+        }
+    }
+
+    /* Send SET cswopts to wpa_supplicant via wpa_ctrl if running */
+    if(pEP->wpaCtrlInterface && wld_wpaCtrlInterface_isReady(pEP->wpaCtrlInterface)) {
+        uint32_t cswopts = 0;
+        if(enable && pRad && pRad->pBus) {
+            cswopts = amxd_object_get_uint32_t(pRad->pBus, "CSwOpts", NULL);
+        }
+        char cmd[64] = {0};
+        snprintf(cmd, sizeof(cmd), "SET cswopts %u", cswopts);
+        wld_wpaCtrl_sendCmdCheckResponse(pEP->wpaCtrlInterface, cmd, "OK");
+        SAH_TRACEZ_WARNING(ME, "%s: cswopts=%u applied via wpa_supplicant wpa_ctrl (STADfsEnable=%d)",
+                           pEP->Name, cswopts, enable);
+    }
+
+    /* Set sta_dfs_en in the kernel driver via NL80211 */
+    if(pRad && pEP->wpaSupp && !swl_str_isEmpty(pEP->wpaSupp->cfgFile)) {
+        swl_rc_ne rc = wld_rad_nl80211_setStaDfsEn(pRad, enable);
+        SAH_TRACEZ_INFO(ME, "%s: sta_dfs_en=%d set via NL80211 rc=%d", pEP->Name, enable, rc);
+    }
+
+    return amxd_status_ok;
+}
