--- a/src/Plugin/wifiGen_eventHandlers.c
+++ b/src/Plugin/wifiGen_eventHandlers.c
@@ -595,6 +595,25 @@ static void s_mainApSetupCompletedCb(voi
         CALL_SECDMN_MGR_EXT(pRad->hostapd, fSyncOnRadioUp, ifName, true);
     }
     wld_rad_updateState(pRad, true);
+
+    /* Re-apply CSwOpts to running hostapd via wpa_ctrl after AP setup completes.
+     * When SSID.*.Enable=0 and then SSID.*.Enable=1, hostapd restarts and the
+     * config file is regenerated (wifiGen_hapd_writeConfig writes CSwOpts to the
+     * file), but the running hostapd instance does not receive the SET CSwOpts
+     * command. Re-send it here so the value is active immediately. */
+    if(pRad->pBus) {
+        uint32_t cswopts = amxd_object_get_uint32_t(pRad->pBus, "CSwOpts", NULL);
+        if(cswopts > 0) {
+            T_AccessPoint* pAP = wld_rad_vap_from_name(pRad, ifName);
+            if(pAP && wld_wpaCtrlInterface_isReady(pAP->wpaCtrlInterface)) {
+                char cmd[64] = {0};
+                snprintf(cmd, sizeof(cmd), "SET CSwOpts %u", cswopts);
+                wld_wpaCtrl_sendCmdCheckResponse(pAP->wpaCtrlInterface, cmd, "OK");
+                SAH_TRACEZ_WARNING(ME, "%s: re-applied CSwOpts=0x%02x to hostapd after AP setup",
+                                   pRad->Name, cswopts);
+            }
+        }
+    }
 }
 
