+/**
+ * Save the current in-memory NOL history to all STA endpoints on this radio.
+ * NolHistory is non-persistent (cleared on reboot) and lives on EndPoint.{i},
+ * not on Radio.ChannelMgt.  Called after STA-side radar detection.
+ */
+void wld_chanmgt_saveNolHistoryToEndpoints(T_Radio* pRad) {
+    ASSERTI_NOT_NULL(pRad, , ME, "Radio null");
+    swl_channel_t nolHistList[WLD_MAX_POSSIBLE_CHANNELS];
+    memset(nolHistList, 0, sizeof(nolHistList));
+    size_t nr = wld_channel_get_nol_history_channels(pRad, nolHistList, WLD_MAX_POSSIBLE_CHANNELS);
+    char buf[256] = {0};
+    swl_conv_uint8ArrayToChar(buf, sizeof(buf), nolHistList, nr);
+    T_EndPoint* pEP = NULL;
+    wld_rad_forEachEp(pEP, pRad) {
+        if(pEP && pEP->pBus) {
+            amxd_trans_t trans;
+            ASSERT_TRANSACTION_INIT(pEP->pBus, &trans, , ME, "%s: trans init failure", pEP->Name);
+            amxd_trans_set_value(cstring_t, &trans, "NolHistory", buf);
+            ASSERT_TRANSACTION_LOCAL_DM_END(&trans, , ME, "%s: trans apply failure", pEP->Name);
+        }
+    }
+    SAH_TRACEZ_INFO(ME, "%s: saved NolHistory to endpoints: %s", pRad->Name, buf);
+}
