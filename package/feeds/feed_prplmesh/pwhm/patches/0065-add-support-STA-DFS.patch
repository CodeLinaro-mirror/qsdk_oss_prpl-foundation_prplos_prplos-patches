+
+    uint32_t cswopts = amxc_var_dyncast(uint32_t, args);
+    SAH_TRACEZ_WARNING(ME, "%s: Endpoint.CSwOpts write handler: value=%u", pEP->Name, cswopts);
+
+    /* Find the highest CSwOpts value across all endpoints.
+     * In MLO, multiple endpoints share the same wpa_supplicant instance. */
+    uint32_t maxCswOpts = 0;
+    T_Radio* pRadIter = NULL;
+    wld_for_eachRad(pRadIter) {
+        T_EndPoint* pEPIter = NULL;
+        wld_rad_forEachEp(pEPIter, pRadIter) {
+            if(pEPIter->pBus) {
+                uint32_t epCswOpts = amxd_object_get_uint32_t(pEPIter->pBus, "CSwOpts", NULL);
+                if(epCswOpts > maxCswOpts) {
+                    maxCswOpts = epCswOpts;
+                }
+            }
+        }
+    }
+
+    /* Update all running wpa_supplicant instances with the highest CSwOpts value */
+    pRadIter = NULL;
+    wld_for_eachRad(pRadIter) {
+        T_EndPoint* pEPIter = NULL;
+        wld_rad_forEachEp(pEPIter, pRadIter) {
+            /* Write CSwOpts to wpa_supplicant config file so it persists across restarts */
+            if(pEPIter->wpaSupp && !swl_str_isEmpty(pEPIter->wpaSupp->cfgFile)) {
+                wld_wpaSupp_cfgFile_createExt(pEPIter);
+                if(maxCswOpts > 0) {
+                    char cswopts_str[16] = {0};
+                    snprintf(cswopts_str, sizeof(cswopts_str), "0x%x", maxCswOpts); /* write hex format as expected by wpa_supplicant */
+                    wld_wpaSupp_cfgFile_globalConfigUpdate(pEPIter->wpaSupp->cfgFile, "CSwOpts", cswopts_str);
+                    SAH_TRACEZ_WARNING(ME, "%s: CSwOpts=%u written to wpa_supplicant config",
+                                       pEPIter->Name, maxCswOpts);
+                }
+            }
+            /* Send SET CSwOpts to wpa_supplicant via wpa_ctrl if running */
+            if(pEPIter->wpaCtrlInterface && wld_wpaCtrlInterface_isReady(pEPIter->wpaCtrlInterface)) {
+                char cmd[64] = {0};
+                snprintf(cmd, sizeof(cmd), "SET CSwOpts %u", maxCswOpts);
+                wld_wpaCtrl_sendCmdCheckResponse(pEPIter->wpaCtrlInterface, cmd, "OK");
+                SAH_TRACEZ_WARNING(ME, "%s: CSwOpts=%u applied via wpa_supplicant wpa_ctrl",
+                                   pEPIter->Name, maxCswOpts);
+            }
+        }
+    }
+
+    return amxd_status_ok;
+}
