+/**
+ * @brief Write handler for Radio.{i}.CSwOpts (SWLA_DM_HDLRS pattern).
+ *
+ * Applies CSwOpts immediately without requiring a hostapd/wpa_supplicant restart:
+ *   AP side  : sends "SET CSwOpts <value>" to hostapd via wpa_ctrl
+ *   STA side : sends "SET cswopts <value>" to wpa_supplicant via wpa_ctrl
+ *              (only when EndPoint.STADfsEnable is true; otherwise sends 0)
+ *
+ * Also regenerates the config file so the value persists across restarts.
+ */
+static void s_setCSwOpts_pwf(void* priv _UNUSED, amxd_object_t* object,
+                              amxd_param_t* param _UNUSED,
+                              const amxc_var_t* const newValue) {
+    T_Radio* pRad = wld_rad_fromObj(object);
+    ASSERTI_NOT_NULL(pRad, , ME, "No radio mapped");
+
+    uint32_t cswopts = amxc_var_dyncast(uint32_t, newValue);
+    SAH_TRACEZ_WARNING(ME, "%s: CSwOpts write handler: value=0x%02x", pRad->Name, cswopts);
+
+    /* Regenerate config file so value persists across restarts.
+     * Direct call (same pattern as BlockChanList): the handler is invoked after the
+     * DM commit, so the DM already holds the new CSwOpts value at this point. */
+    wld_hostapd_cfgFile_createExt(pRad);
+
+    /* AP side: add CSwOpts to the generated hostapd config file.
+     * wld_hostapd_cfgFile_createExt regenerates the file from scratch (without CSwOpts),
+     * so wld_hostapd_cfgFile_update must be called afterwards to inject the value. */
+    if(cswopts > 0 && pRad->hostapd && pRad->hostapd->cfgFile) {
+        T_AccessPoint* pCfgAP = wld_rad_getFirstActiveAp(pRad);
+        if(pCfgAP == NULL) {
+            pCfgAP = wld_rad_getFirstEnabledVap(pRad);
+        }
+        if(pCfgAP != NULL) {
+            char cswopts_str[16] = {0};
+            snprintf(cswopts_str, sizeof(cswopts_str), "%u", cswopts);
+            wld_hostapd_cfgFile_update(pRad->hostapd->cfgFile, pCfgAP->alias, "CSwOpts", cswopts_str);
+            SAH_TRACEZ_WARNING(ME, "%s: CSwOpts=0x%02x written to hostapd config file (%s)",
+                               pRad->Name, cswopts, pRad->hostapd->cfgFile);
+        }
+    }
+
+    /* AP side: send SET CSwOpts <value> to hostapd via wpa_ctrl if running */
+    if(wld_rad_isActive(pRad)) {
+        T_AccessPoint* pAP = wld_rad_getFirstActiveAp(pRad);
+        if(pAP && pAP->wpaCtrlInterface && wld_wpaCtrlInterface_isReady(pAP->wpaCtrlInterface)) {
+            char cmd[64] = {0};
+            snprintf(cmd, sizeof(cmd), "SET CSwOpts %u", cswopts);
+            wld_wpaCtrl_sendCmdCheckResponse(pAP->wpaCtrlInterface, cmd, "OK");
+            SAH_TRACEZ_WARNING(ME, "%s: CSwOpts=0x%02x applied via hostapd wpa_ctrl", pRad->Name, cswopts);
+        }
+    }
+
+    /* STA side: send SET cswopts <value> to wpa_supplicant via wpa_ctrl if running.
+     * Iterate over ALL radios' endpoints — cswopts is a global wpa_supplicant setting
+     * and the STA endpoint may be on a different radio than the one whose CSwOpts changed
+     * (e.g. CSwOpts set on Radio.2/wlan1 but STA endpoint is on Radio.3/wlan2). */
+    T_Radio* pRadIter = NULL;
+    wld_for_eachRad(pRadIter) {
+        T_EndPoint* pEP = NULL;
+        wld_rad_forEachEp(pEP, pRadIter) {
+            bool ctrlReady = pEP && pEP->wpaCtrlInterface && wld_wpaCtrlInterface_isReady(pEP->wpaCtrlInterface);
+            bool staDfsEnable = (pEP && pEP->pBus) ? amxd_object_get_bool(pEP->pBus, "STADfsEnable", NULL) : false;
+            if(!ctrlReady) {
+                continue;
+            }
+            if(staDfsEnable) {
+                char cmd[64] = {0};
+                snprintf(cmd, sizeof(cmd), "SET cswopts %u", cswopts);
+                wld_wpaCtrl_sendCmdCheckResponse(pEP->wpaCtrlInterface, cmd, "OK");
+                SAH_TRACEZ_WARNING(ME, "%s: cswopts=0x%02x applied via wpa_supplicant wpa_ctrl",
+                                   pEP->Name, cswopts);
+            }
+        }
+    }
+
+    /* STA side: also update wpa_supplicant config file so new CSwOpts persists across restarts. */
+    T_Radio* pRadIter2 = NULL;
+    wld_for_eachRad(pRadIter2) {
+        T_EndPoint* pEP2 = NULL;
+        wld_rad_forEachEp(pEP2, pRadIter2) {
+            if(pEP2 && pEP2->pBus && amxd_object_get_bool(pEP2->pBus, "STADfsEnable", NULL)) {
+                wld_wpaSupp_cfgFile_createExt(pEP2);
+            }
+        }
+    }
+}
