+static void s_saveNolHistory(T_Radio* pRad, amxd_trans_t* pTrans) {
+    swl_channel_t nolHistList[WLD_MAX_POSSIBLE_CHANNELS];
+    memset(nolHistList, 0, sizeof(nolHistList));
+    size_t nr = wld_channel_get_nol_history_channels(pRad, nolHistList, WLD_MAX_POSSIBLE_CHANNELS);
+    char buf[256] = {0};
+    swl_conv_uint8ArrayToChar(buf, sizeof(buf), nolHistList, nr);
+    amxd_trans_set_value(cstring_t, pTrans, "NolHistory", buf);
+}
