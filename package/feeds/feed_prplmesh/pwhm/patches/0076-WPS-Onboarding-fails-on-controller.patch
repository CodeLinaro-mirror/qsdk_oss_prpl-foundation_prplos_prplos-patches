diff --git a/include/wld/wld_hostapd_ap_api.h b/include/wld/wld_hostapd_ap_api.h
index 8be815e..5d28518 100644
--- a/include/wld/wld_hostapd_ap_api.h
+++ b/include/wld/wld_hostapd_ap_api.h
@@ -72,6 +72,8 @@ typedef enum {
     SECDMN_ACTION_OK_DONE = 0,
     SECDMN_ACTION_OK_NEED_UPDATE_BEACON,
     SECDMN_ACTION_OK_NEED_RELOAD_SECKEY, // Only WPA-PSK Security key params on specific AP
+    SECDMN_ACTION_OK_NEED_RELOAD_BSS,    // Reload BSS config (already SET) from memory
+    SECDMN_ACTION_OK_NEED_RELOAD,        // Reload interface and child BSSs configs (already SET) from memory
     SECDMN_ACTION_OK_NEED_SIGHUP,
     SECDMN_ACTION_OK_NEED_TOGGLE,        // Like a restart, but keeps available wpactrl sockets
     SECDMN_ACTION_OK_NEED_RE_ADD_LINK,   // gets specific link iface conf be removed and added again
@@ -102,6 +104,24 @@ wld_secDmn_action_rc_ne wld_ap_hostapd_setMldParams(T_AccessPoint* pAP);
 wld_secDmn_action_rc_ne wld_ap_hostapd_setEnableVap(T_AccessPoint* pAP, bool enable);
 wld_secDmn_action_rc_ne wld_ap_hostapd_enableVap(T_AccessPoint* pAP, bool enable);
 
+/**
+ * @brief reload hostapd bss config from memory
+ *
+ * @param pAP AccessPoint context
+ * @return SWL_RC_OK when the Hostapd bss memory config is reloaded. Otherwise error code.
+ */
+swl_rc_ne wld_ap_hostapd_reloadBss(T_AccessPoint* pAP);
+
+/**
+ * @brief set the backhaul SSID of AccessPoint
+ *
+ * @param pAP accesspoint context
+ * @param bhSsid the new backhaul ssid
+ * @return - action > SECDMN_ACTION_DONE when bh ssid is SET
+ *         - Otherwise SECDMN_ACTION_ERROR in case of error
+ */
+wld_secDmn_action_rc_ne wld_ap_hostapd_setBhSsid(T_AccessPoint* pAP, const char* bhSsid);
+
 swl_rc_ne wld_ap_hostapd_kickStation(T_AccessPoint* pAP, swl_macBin_t* mac, swl_IEEE80211deauthReason_ne reason);
 swl_rc_ne wld_ap_hostapd_cleanStation(T_AccessPoint* pAP, swl_macBin_t* mac);
