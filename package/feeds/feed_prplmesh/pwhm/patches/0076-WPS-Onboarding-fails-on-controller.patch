+/**
+ * @brief handler of multi-ap fronthaul bss
+ *
+ * @param pAP vap ctx
+ * @param vapInfo hostapd bss info
+ * @param userData
+ *
+ * @return void
+ */
+typedef void (* wld_hostapd_procMultiApDep_f)(T_AccessPoint* pAP, wld_hostapdVapInfo_t* vapInfo, void* userData);
+
+/**
+ * @brief match FH BSSs referring to given multi ap backhaul ssid, in hostapd config map,
+ * and call handler to take reconf action
+ *
+ * @param hapdCfg hostapd configuration context including all VAP configs for one radio
+ * @param bhSsid multi ap backhaul ssid we look for in another VAPs config
+ * @param userData data passed to handler
+ * @param hdlr optional handler called for each fh VAP matching multi-ap bh ssid
+ *
+ * @return count of co-located fh BSSs matching same backhaul ssid, swl_rc_ne error code otherwise
+ */
+int32_t wld_hostapd_forEachMultiApDep(wld_hostapd_config_t* hapdCfg, const char* bhSsid, void* userData, wld_hostapd_procMultiApDep_f hdlr);
+
 /**
  * @brief Create a per-BSS configuration structure for a single access point
  *
diff --git a/include_priv/Plugin/wifiGen_fsm.h b/include_priv/Plugin/wifiGen_fsm.h
