+static void s_syncMultiApDepsOnBhAdd(T_AccessPoint* pAP, T_Radio* pRad);
+
 /*
  * List of actions that can be used to apply hostapd configuration,
  * starting from the most global (most critical)
@@ -107,6 +110,8 @@ static const wifiGen_fsmStates_e sApplyActions[] = {
     GEN_FSM_ADD_HOSTAPD,      // leads to re-adding hostapd iface config
     GEN_FSM_UPDATE_HOSTAPD,   // leads to refreshing hostpad with SIGHUP (reloads conf file)
     GEN_FSM_ENABLE_HOSTAPD,   // leads to enabling (usually toggling) hostapd main interface
+    GEN_FSM_RELOAD_HOSTAPD,   // leads to reloading hostpad conf from memory
+    GEN_FSM_RELOAD_AP,        // leads to reloading AP conf from memory
     GEN_FSM_RELOAD_AP_SECKEY, // leads to reloading AP secret key conf from memory
     GEN_FSM_UPDATE_BEACON,    // leads to refresh AP beacon frame from mem conf
 };
@@ -533,6 +538,19 @@ static void s_schedNextAction(wld_secDmn_action_rc_ne action, T_AccessPoint* pAP
     case SECDMN_ACTION_OK_NEED_SIGHUP:
         s_setApplyAction(pRad->fsmRad.FSM_AC_BitActionArray, FSM_BW, GEN_FSM_UPDATE_HOSTAPD, radFsmBit);
         break;
+    case SECDMN_ACTION_OK_NEED_RELOAD:
+        s_setApplyAction(pRad->fsmRad.FSM_AC_BitActionArray, FSM_BW, GEN_FSM_RELOAD_HOSTAPD, radFsmBit);
+        break;
+    case SECDMN_ACTION_OK_NEED_RELOAD_BSS:
+        if(s_fetchHigherApplyAction(pRad->fsmRad.FSM_AC_BitActionArray, FSM_BW, GEN_FSM_RELOAD_AP, radFsmBit) >= 0) {
+            return;
+        }
+        if(s_setApplyAction(pAP->fsm.FSM_AC_BitActionArray, FSM_BW, GEN_FSM_RELOAD_AP, vapFsmBit)) {
+            setBitLongArray(pRad->fsmRad.FSM_AC_BitActionArray, FSM_BW, GEN_FSM_RELOAD_AP);
+            setBitLongArray(pAP->fsm.FSM_AC_BitActionArray, FSM_BW, GEN_FSM_UPDATE_BEACON);
+            setBitLongArray(pRad->fsmRad.FSM_AC_BitActionArray, FSM_BW, GEN_FSM_UPDATE_BEACON);
+        }
+        break;
     case SECDMN_ACTION_OK_NEED_RELOAD_SECKEY:
         if(s_fetchHigherApplyAction(pRad->fsmRad.FSM_AC_BitActionArray, FSM_BW, GEN_FSM_RELOAD_AP_SECKEY, radFsmBit) >= 0) {
             return;
@@ -697,6 +715,7 @@ static bool s_doAddLink(T_AccessPoint* pAP, T_Radio* pRad) {
     }
 
     SAH_TRACEZ_INFO(ME, "%s: BSS config for AP %s added successfully", pRad->Name, pAP->alias);
+    s_syncMultiApDepsOnBhAdd(pAP, pRad);
     wld_wpaCtrlMngr_checkAllIfaces(wld_secDmn_getWpaCtrlMgr(pRad->hostapd));
     setBitLongArray(pRad->fsmRad.FSM_AC_BitActionArray, FSM_BW, GEN_FSM_SYNC_STATE);
     wld_vap_updateState(pAP);
@@ -1359,6 +1378,14 @@ static bool s_doSetBssid(T_AccessPoint* pAP, T_Radio* pRad _UNUSED) {
     return true;
 }
 
+static void s_setMultiApBhSsid(T_AccessPoint* pAP, wld_hostapdVapInfo_t* vapInfo _UNUSED, void* userData) {
+    const char* bhSsid = (const char*) userData;
+    ASSERTI_STR(bhSsid, , ME, "empty bhSsid");
+    wld_secDmn_action_rc_ne rc = wld_ap_hostapd_setBhSsid(pAP, bhSsid);
+    ASSERT_FALSE(rc < SECDMN_ACTION_OK_DONE, , ME, "%s: fail to set bh ssid", pAP->alias);
+    s_schedNextAction(rc, pAP, pAP->pRadio);
+}
+
 static bool s_doSetSsid(T_AccessPoint* pAP, T_Radio* pRad _UNUSED) {
     ASSERTS_NOT_NULL(pAP, true, ME, "NULL");
     ASSERTI_TRUE(wld_wpaCtrlInterface_isReady(pAP->wpaCtrlInterface), true, ME, "%s: wpaCtrl disconnected", pAP->alias);
@@ -1374,6 +1401,17 @@ static bool s_doSetSsid(T_AccessPoint* pAP, T_Radio* pRad _UNUSED) {
     }
 
     s_schedNextAction(rc, pAP, pRad);
+    if((rc > SECDMN_ACTION_OK_DONE) && (rc < SECDMN_ACTION_OK_NEED_SIGHUP) &&
+       SWL_BIT_IS_SET(pAP->multiAPType, MULTIAP_BACKHAUL_BSS)) {
+        wld_hostapd_config_t* config = NULL;
+        if(wld_hostapd_loadConfig(&config, pRad->hostapd->cfgFile)) {
+            const char* savedSsid = wld_hostapd_getConfigParamByBssidValStr(config, (swl_macBin_t*) pAP->pSSID->BSSID, "ssid");
+            if(swl_str_len(savedSsid) > 0) {
+                wld_hostapd_forEachMultiApDep(config, savedSsid, pSSID->SSID, s_setMultiApBhSsid);
+            }
+            wld_hostapd_deleteConfig(config);
+        }
+    }
     return true;
 }
 
@@ -1385,6 +1423,43 @@ static bool s_doSetMfList(T_AccessPoint* pAP, T_Radio* pRad _UNUSED) {
     return true;
 }
 
+static void s_setMultiApBhCreds(T_AccessPoint* pAP, wld_hostapdVapInfo_t* vapInfo _UNUSED, void* userData) {
+    T_AccessPoint* pBhAP = (T_AccessPoint*) userData;
+    ASSERTS_NOT_NULL(pAP, , ME, "NULL");
+    ASSERTS_NOT_NULL(pBhAP, , ME, "NULL");
+
+    bool ret = false;
+    if(!swl_str_isEmpty(pBhAP->keyPassPhrase)) {
+        const char* keyParam = ((swl_str_len(pBhAP->keyPassPhrase) + 1) == PSK_KEY_SIZE_LEN) ?
+            "multi_ap_backhaul_wpa_psk" : "multi_ap_backhaul_wpa_passphrase";
+        ret = wld_ap_hostapd_setParamValue(pAP, keyParam, pBhAP->keyPassPhrase, "multiApBhCreds");
+    } else if(!swl_str_isEmpty(pBhAP->preSharedKey)) {
+        ret = wld_ap_hostapd_setParamValue(pAP, "multi_ap_backhaul_wpa_psk", pBhAP->preSharedKey, "multiApBhCreds");
+    }
+
+    ASSERT_TRUE(ret, , ME, "%s: fail to set bh creds from %s", pAP->alias, pBhAP->alias);
+    s_schedNextAction(SECDMN_ACTION_OK_NEED_RELOAD_BSS, pAP, pAP->pRadio);
+}
+
+static void s_syncMultiApDepsOnBhAdd(T_AccessPoint* pAP, T_Radio* pRad) {
+    ASSERTS_NOT_NULL(pAP, , ME, "NULL");
+    ASSERTS_NOT_NULL(pRad, , ME, "NULL");
+    ASSERTI_TRUE(SWL_BIT_IS_ONLY_SET(pAP->multiAPType, MULTIAP_BACKHAUL_BSS), , ME, "%s: not a pure backhaul BSS", pAP->alias);
+    ASSERTS_NOT_NULL(pAP->pSSID, , ME, "%s: no ssid ctx", pAP->alias);
+
+    wld_hostapd_config_t* config = NULL;
+    if(wld_hostapd_createConfig(&config, pRad)) {
+        int32_t nDeps = wld_hostapd_forEachMultiApDep(config, pAP->pSSID->SSID, pAP->pSSID->SSID, s_setMultiApBhSsid);
+        if(nDeps > 0) {
+            wld_hostapd_forEachMultiApDep(config, pAP->pSSID->SSID, pAP, s_setMultiApBhCreds);
+        }
+        if(nDeps > 0) {
+            SAH_TRACEZ_INFO(ME, "%s: scheduled Multi-AP BH config refresh for %d fronthaul BSSs", pAP->alias, nDeps);
+        }
+        wld_hostapd_deleteConfig(config);
+    }
+}
+
 static bool s_doSetApSec(T_AccessPoint* pAP, T_Radio* pRad) {
     ASSERTS_NOT_NULL(pAP, true, ME, "NULL");
     ASSERTI_TRUE(wld_wpaCtrlInterface_isReady(pAP->wpaCtrlInterface), true, ME, "%s: wpaCtrl disconnected", pAP->alias);
@@ -1396,6 +1471,14 @@ static bool s_doSetApSec(T_AccessPoint* pAP, T_Radio* pRad) {
         rc = SECDMN_ACTION_OK_NEED_RE_ADD_LINK;
     }
     s_schedNextAction(rc, pAP, pRad);
+    if((rc > SECDMN_ACTION_OK_DONE) && (rc < SECDMN_ACTION_OK_NEED_SIGHUP) &&
+       SWL_BIT_IS_SET(pAP->multiAPType, MULTIAP_BACKHAUL_BSS)) {
+        wld_hostapd_config_t* config = NULL;
+        if(wld_hostapd_createConfig(&config, pRad)) {
+            wld_hostapd_forEachMultiApDep(config, pAP->pSSID->SSID, pAP, s_setMultiApBhCreds);
+            wld_hostapd_deleteConfig(config);
+        }
+    }
     return true;
 }
 
@@ -2072,7 +2155,7 @@ static bool s_doConfWpaSupp(T_EndPoint* pEP, T_Radio* pRad _UNUSED) {
     return true;
 }
 
-static bool s_doReloadWpaSupp(T_EndPoint* pEP, T_Radio* pRad _UNUSED) {
+static bool s_doUpdateWpaSupp(T_EndPoint* pEP, T_Radio* pRad _UNUSED) {
     ASSERTS_TRUE(wifiGen_wpaSupp_isRunning(pEP), true, ME, "%s: wpa_supplicant stopped", pEP->Name);
     SAH_TRACEZ_INFO(ME, "%s: try to reconfigure wpa_supplicant", pEP->Name);
     if((!wifiGen_wpaSupp_isAlive(pEP)) || (wld_wpaSupp_ep_reconfigure(pEP) < SWL_RC_OK)) {
@@ -2082,6 +2165,28 @@ static bool s_doReloadWpaSupp(T_EndPoint* pEP, T_Radio* pRad _UNUSED) {
     pRad->fsmRad.timeout_msec = 500;
     return true;
 }
+
+static bool s_doReloadAp(T_AccessPoint* pAP, T_Radio* pRad _UNUSED) {
+    ASSERTS_NOT_NULL(pAP, true, ME, "NULL");
+    ASSERTI_TRUE(wld_wpaCtrlInterface_isReady(pAP->wpaCtrlInterface), true, ME, "%s: wpaCtrl disconnected", pAP->alias);
+    swl_rc_ne rc = wld_ap_hostapd_reloadBss(pAP);
+    if(rc == SWL_RC_NOT_IMPLEMENTED) {
+        s_schedNextAction(SECDMN_ACTION_OK_NEED_RELOAD, pAP, pRad);
+    }
+    return true;
+}
+
+static bool s_doReloadHostapd(T_Radio* pRad) {
+    ASSERTI_TRUE(wifiGen_hapd_isRunning(pRad), true, ME, "%s: hostapd stopped", pRad->Name);
+    ASSERTI_TRUE(wifiGen_hapd_isStarted(pRad), true, ME, "%s: hostapd instance not started", pRad->Name);
+    if(wld_secDmn_isGrpRestarting(pRad->hostapd)) {
+        SAH_TRACEZ_WARNING(ME, "%s: hostapd group is restarting: skip immediate reload", pRad->Name);
+        return true;
+    }
+    wld_rad_hostapd_reload(pRad);
+    return true;
+}
+
 /*
  * Check if we need to do radio up down actions. Need to happen if it's first interface that goes up.
  */
@@ -2253,9 +2358,11 @@ wld_fsmMngr_action_t actions[GEN_FSM_MAX] = {
     {FSM_ACTION(GEN_FSM_MOD_HOSTAPD), .doRadFsmAction = s_doConfHostapd},
     {FSM_ACTION(GEN_FSM_MOD_WPASUPP), .doEpFsmAction = s_doConfWpaSupp},
     {FSM_ACTION(GEN_FSM_RELOAD_AP_SECKEY), .doVapFsmAction = s_doReloadApSecKey},
+    {FSM_ACTION(GEN_FSM_RELOAD_AP), .doVapFsmAction = s_doReloadAp},
+    {FSM_ACTION(GEN_FSM_RELOAD_HOSTAPD), .doRadFsmAction = s_doReloadHostapd},
     {FSM_ACTION(GEN_FSM_MOD_EP_MACADDR), .doEpFsmAction = s_doSetEpMAC},
     {FSM_ACTION(GEN_FSM_UPDATE_BEACON), .doVapFsmAction = s_doUpdateBeacon},
-    {FSM_ACTION(GEN_FSM_UPDATE_WPASUPP), .doEpFsmAction = s_doReloadWpaSupp},
+    {FSM_ACTION(GEN_FSM_UPDATE_WPASUPP), .doEpFsmAction = s_doUpdateWpaSupp},
     {FSM_ACTION(GEN_FSM_ENABLE_HOSTAPD), .doRadFsmAction = s_doEnableHostapd},
     {FSM_ACTION(GEN_FSM_ENABLE_RAD), .doRadFsmAction = s_doRadEnable},
     {FSM_ACTION(GEN_FSM_ENABLE_AP), .doVapFsmAction = s_doEnableAp},
diff --git a/src/Plugin/wifiGen_hapd.c b/src/Plugin/wifiGen_hapd.c
index e00e657..32c7c5e 100644
--- a/src/Plugin/wifiGen_hapd.c
+++ b/src/Plugin/wifiGen_hapd.c
@@ -391,6 +391,12 @@ void wifiGen_hapd_initDynCfgParamSupp(T_Radio* pRad) {
     wld_secDmn_detectCfgParamsSupp(pRad->hostapd, (const char* []) {"mld_addr"}, 1, NULL);
     wld_secDmn_detectCfgParamsSupp(pRad->hostapd, (const char* []) {"mbssid_max", "mbssid_index"}, 2, "mbssid_");
     wld_secDmn_detectCfgParamsSupp(pRad->hostapd, (const char* []) {"ttlm_enable"}, 1, NULL);
+    swl_trl_e supp = wld_secDmn_getCmdSupp(pRad->hostapd, "RELOAD_BSS");
