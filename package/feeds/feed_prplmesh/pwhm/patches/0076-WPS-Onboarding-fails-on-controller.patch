+int32_t wld_hostapd_forEachMultiApDep(wld_hostapd_config_t* hapdCfg, const char* bhSsid, void* userData, wld_hostapd_procMultiApDep_f hdlr) {
+    ASSERTS_NOT_NULL(hapdCfg, SWL_RC_INVALID_PARAM, ME, "NULL");
+    ASSERTS_FALSE(swl_str_isEmpty(bhSsid), SWL_RC_INVALID_PARAM, ME, "EMPTY");
+    uint32_t cntDeps = 0;
+    amxc_llist_for_each(it, &hapdCfg->vaps) {
+        wld_hostapdVapInfo_t* vapInfo = amxc_llist_it_get_data(it, wld_hostapdVapInfo_t, it);
+        swl_mapChar_t* currCfg = &(vapInfo->vapParams);
+        char* multiAp = swl_mapChar_get(currCfg, "multi_ap");
+        uint32_t hapdMultiApType = swl_typeUInt32_fromCharDef(multiAp, 0);
+        if(!(hapdMultiApType & M_HOSTAPD_MULTI_AP_FBSS)) {
+            continue;
+        }
+        char* wpsState = swl_mapChar_get(currCfg, "wps_state");
+        bool vapWpsEnable = (swl_typeUInt8_fromCharDef(wpsState, 0) > 0);
+        if(!vapWpsEnable) {
+            continue;
+        }
+        // hostapd requires backhaul_ssid included in double quotes
+        char bhSsidQuoted[swl_str_len(bhSsid) + 3];
+        snprintf(bhSsidQuoted, sizeof(bhSsidQuoted), "\"%s\"", bhSsid);
+        const char* currBhSsidQuoted = swl_mapChar_get(currCfg, "multi_ap_backhaul_ssid");
+        if(!currBhSsidQuoted || !swl_str_matches(currBhSsidQuoted, bhSsidQuoted)) {
+            continue;
+        }
+        swl_macBin_t bssid = SWL_MAC_BIN_NEW();
+        T_AccessPoint* pAP = NULL;
+        if(!swl_typeMacBin_fromChar(&bssid, swl_mapChar_get(currCfg, "bssid")) ||
+           swl_mac_binIsNull(&bssid) || ((pAP = wld_ap_getVapByBssid(&bssid)) == NULL)) {
+            continue;
+        }
+        SWL_CALL(hdlr, pAP, vapInfo, userData);
+        cntDeps++;
+    }
+    return cntDeps;
+}
