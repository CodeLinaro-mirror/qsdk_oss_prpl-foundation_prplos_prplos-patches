From 48060ed90949e05765316ca97136161c9126f30b Mon Sep 17 00:00:00 2001
From: Vinu Bharath R <vinubhar@qti.qualcomm.com>
Date: Wed, 15 Oct 2025 10:42:28 +0530
Subject: [PATCH] Remove MLD Primary Link in legacy PWHM way instead of
 WPA_CTRL command

Signed-off-by: Vinu Bharath R <vinubhar@qti.qualcomm.com>
---
 include/wld/wld_mld.h |  1 +
 src/wld_mld.c         | 12 ++++++++++++
 2 files changed, 13 insertions(+)

diff --git a/include/wld/wld_mld.h b/include/wld/wld_mld.h
index 6c890b7..5443573 100644
--- a/include/wld/wld_mld.h
+++ b/include/wld/wld_mld.h
@@ -93,6 +93,7 @@ wld_mldLink_t* wld_mld_registerLink(T_SSID* pSSID, int32_t unit);
 swl_rc_ne wld_mld_unregisterLink(T_SSID* pSSID);
 T_SSID* wld_mld_getLinkSsid(wld_mldLink_t* pLink);
 T_SSID* wld_mld_getLinkSsidByLinkId(wld_mldLink_t* pLink, int8_t linkId);
+bool wld_mld_isPrimaryLink(wld_mldLink_t* pLink);
 const char* wld_mld_getLinkName(wld_mldLink_t* pLink);
 swl_rc_ne wld_mld_setPrimaryLink(wld_mldLink_t* pLink);
 wld_mldLink_t* wld_mld_getPrimaryLink(wld_mldLink_t* pLink);
diff --git a/src/wld_mld.c b/src/wld_mld.c
index 3a60965..3e0ecac 100644
--- a/src/wld_mld.c
+++ b/src/wld_mld.c
@@ -456,6 +456,17 @@ bool wld_mld_isLinkEnabled(wld_mldLink_t* pLink) {
     return (pSSID->enable && pRad->enable);
 }
 
+bool wld_mld_isPrimaryLink(wld_mldLink_t* pLink) {
+    ASSERTS_NOT_NULL(pLink, false, ME, "NULL");
+    ASSERTI_TRUE(s_isTypedLink(pLink), false, ME, "untyped link %s has no primary link", s_getLinkName(pLink));
+    wld_mld_t* pMld = pLink->pMld;
+    ASSERT_NOT_NULL(pMld, false, ME, "NULL");
+    if(pMld->pPrimLink == pLink) {
+        return true;
+    }
+    return false;
+}
+
 uint32_t wld_mld_countNeighLinks(wld_mldLink_t* pLink) {
     ASSERTS_NOT_NULL(pLink, 0, ME, "NULL");
     ASSERTS_TRUE(amxc_llist_it_is_in_list(&pLink->it), 0, ME, "Not a list item");
@@ -619,6 +630,7 @@ bool wld_reconfig_remove_link(wld_mldLink_t* pLink) {
     ASSERT_NOT_NULL(pLink->pSSID, false, ME, "SSID is NULL");
     ASSERT_NOT_NULL(pLink->pSSID->AP_HOOK, false, ME, "AP is NULL");
     ASSERT_TRUE(wld_mld_isLinkEnabled(pLink), false, ME, "Link is disabled");
+    ASSERT_FALSE(wld_mld_isPrimaryLink(pLink), false, ME, "Link is Primary");
     // Hostapd - Remove link
     SAH_TRACEZ_INFO(ME, "Remove link from Hostapd");
     if (wld_hostapd_ap_remove_link(pLink->pSSID->AP_HOOK)) {
-- 
2.34.1

