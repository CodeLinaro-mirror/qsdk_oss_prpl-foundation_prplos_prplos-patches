diff --git a/src/wld_radio.c b/src/wld_radio.c
index 6667b6d..9b401de 100644
--- a/src/wld_radio.c
+++ b/src/wld_radio.c
@@ -5608,6 +5608,42 @@ static void s_setDiscardAwgnEvent_pwf(void* priv _UNUSED, amxd_object_t* object,
     SAH_TRACEZ_OUT(ME);
 }
 
+/**
+ * @brief Handler for AllowScanDfsChan parameter change on the Radio object.
+ *
+ * When enabled, sends: ALLOW_SCAN_ON_DFS_CHAN 1
+ * When disabled, sends: ALLOW_SCAN_ON_DFS_CHAN 0
+ *
+ * This fixes ACS scan failures when DCS is enabled with WLAN/CW interference
+ * and a DCS-triggered channel change occurs on a 5G radio with ACS enabled.
+ * Without this, hostapd rejects ACS scan requests on DFS channels.
+ *
+ * The command is sent to the radio's first active AP (always available),
+ * which routes it to the correct hostapd_iface (per-radio setting).
+ *
+ * Equivalent to: hostapd_cli -i <wlanX> ALLOW_SCAN_ON_DFS_CHAN <0|1>
+ */
+static void s_setAllowScanDfsChan_pwf(void* priv _UNUSED, amxd_object_t* object,
+                                       amxd_param_t* param _UNUSED,
+                                       const amxc_var_t* const newValue) {
+    SAH_TRACEZ_IN(ME);
+
+    T_Radio* pRad = wld_rad_fromObj(object);
+    ASSERTS_NOT_NULL(pRad, , ME, "NULL");
+
+    bool enable = amxc_var_dyncast(bool, newValue);
+    SAH_TRACEZ_INFO(ME, "%s: set AllowScanDfsChan %d", pRad->Name, enable);
+    pRad->AllowScanDfsChan = enable;
+
+    ASSERTI_TRUE(wld_rad_isActive(pRad), , ME, "%s: AllowScanDfsChan: radio not active", pRad->Name);
+    T_AccessPoint* pAP = s_getAcsAp(pRad);
+    ASSERTI_NOT_NULL(pAP, , ME, "%s: AllowScanDfsChan: no AP available", pRad->Name);
+    wld_wpaCtrl_sendCmdFmtCheckResponse(pAP->wpaCtrlInterface, "OK",
+                                        "ALLOW_SCAN_ON_DFS_CHAN %d", enable ? 1 : 0);
+
+    SAH_TRACEZ_OUT(ME);
+}
+
 SWLA_DM_HDLRS(sRadioDmHdlrs,
               ARR(SWLA_DM_PARAM_HDLR("RegulatoryDomain", s_setCountryCode_pwf),
                   SWLA_DM_PARAM_HDLR("IEEE80211hEnabled", s_set80211hEnable_pwf),
@@ -5658,6 +5694,7 @@ SWLA_DM_HDLRS(sRadioDmHdlrs,
                   SWLA_DM_PARAM_HDLR("BasicDataTransmitRates", s_setBasicDataTransmitRates_pwf),
                   SWLA_DM_PARAM_HDLR("PowerType", s_setPowerType_pwf),
                   SWLA_DM_PARAM_HDLR("DiscardAwgnEvent", s_setDiscardAwgnEvent_pwf),
+                  SWLA_DM_PARAM_HDLR("AllowScanDfsChan", s_setAllowScanDfsChan_pwf),
                   ),
               .instAddedCb = s_addInstance_oaf);
 
