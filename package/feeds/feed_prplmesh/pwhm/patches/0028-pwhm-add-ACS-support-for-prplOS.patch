             if(SWL_BIT_IS_SET(pRad->bfCapsSupported[COM_DIR_RECEIVE], RAD_BF_CAP_EHT_SU) &&
diff --git a/src/wld_accesspoint.c b/src/wld_accesspoint.c
index a40fc64..3693d23 100644
--- a/src/wld_accesspoint.c
+++ b/src/wld_accesspoint.c
@@ -1674,9 +1674,9 @@ void _wld_ap_setDppConf_ocf(const char* const sig_name,
  *
  * Equivalent to: hostapd_cli -i wlanX [-l linkId] dcs set_wlan_intr_params <param_name> <value>
  *
- * When the AP is part of an MLD the MLD link ID (pAP->pSSID->mldLinkId) is
- * prepended as "LINK_ID=<id> " to the command, matching the behaviour of
- * hostapd_cli's -l flag.
+ * For MLO: send to the primary link interface socket with LINK_ID=<id> prefix,
+ * equivalent to: hostapd_cli -i wlan2.1 -l <linkId> dcs set_wlan_intr_params ...
+ * For SLO: send directly to the AP's own socket.
  *
  * @param pAP        AccessPoint context
  * @param param_name DCS parameter name (e.g. "intr_detection_threshold")
@@ -1688,50 +1688,26 @@ static bool s_sendDcsWlanIntrParams(T_AccessPoint* pAP, const char* param_name,
     char cmd[256] = {0};
     char reply[256] = {0};
 
-    /* DCS commands must be sent directly to the AP's own socket file (e.g., wlan1.1)
-     * using wld_wpaCtrl_queryToSock — equivalent to hostapd_cli -i wlan1.1 dcs ...
-     *
-     * We CANNOT use pAP->wpaCtrlInterface because it may be connected to wlan1.1_link0
-     * (the MLD link socket) which does NOT support 'dcs' commands.
-     *
-     * For MLO: send to the primary link interface socket with LINK_ID=<id> prefix,
-     * equivalent to: hostapd_cli -i wlan2.1 -l <linkId> dcs ...
-     */
-    const char* serverPath = wld_wpaCtrlInterface_getConnectionDirPath(pAP->wpaCtrlInterface);
-    ASSERTS_STR(serverPath, false, ME, "%s: no server path", pAP->alias);
-
-    const char* primLinkIfaceName = wld_hostapd_ap_selectApLinkIface(pAP);
-    int16_t linkId = (pAP->pSSID != NULL) ? pAP->pSSID->mldLinkId : -1;
-
-    if(!swl_str_matches(primLinkIfaceName, pAP->alias) && (linkId >= 0)) {
-        /* MLO: send to primary link interface socket with LINK_ID prefix
-         * NOTE: hostapd ctrl interface expects uppercase "DCS" command */
-        snprintf(cmd, sizeof(cmd), "LINK_ID=%d DCS set_wlan_intr_params %s %u", (int) linkId, param_name, value);
-        SAH_TRACEZ_INFO(ME, "%s: DCS cmd='%s' via sock='%s'", pAP->alias, cmd, primLinkIfaceName);
-        swl_rc_ne rc = wld_wpaCtrl_queryToSock(serverPath, primLinkIfaceName, cmd, reply, sizeof(reply));
-        /* DCS set commands return 0 with no reply text on success — empty reply is OK */
-        bool bRet = (rc == SWL_RC_OK) && !swl_str_matches(reply, "FAIL");
-        if(!bRet) {
-            SAH_TRACEZ_ERROR(ME, "%s: DCS command failed: cmd='%s' rc=%d reply='%s'",
-                             pAP->alias, cmd, rc, reply);
-        }
-        return bRet;
-    } else {
-        /* SLO: send directly to AP's own socket (pAP->alias = e.g. "wlan1.1")
-         * NOTE: hostapd ctrl interface expects uppercase "DCS" command */
-        snprintf(cmd, sizeof(cmd), "DCS set_wlan_intr_params %s %u", param_name, value);
-        SAH_TRACEZ_INFO(ME, "%s: DCS cmd='%s' via sock='%s'", pAP->alias, cmd, pAP->alias);
-        swl_rc_ne rc = wld_wpaCtrl_queryToSock(serverPath, pAP->alias, cmd, reply, sizeof(reply));
-        /* DCS set commands return 0 with no reply text on success — empty reply is OK */
-        bool bRet = (rc == SWL_RC_OK) && !swl_str_matches(reply, "FAIL");
-        if(!bRet) {
-            SAH_TRACEZ_ERROR(ME, "%s: DCS command failed: cmd='%s' rc=%d reply='%s'",
-                             pAP->alias, cmd, rc, reply);
-        }
-        return bRet;
+    /* DCS commands are sent directly to the AP's wpaCtrl interface (e.g. wlan1.1_link0).
+     * The LINK_ID=X prefix is NOT used because hostapd returns UNKNOWN COMMAND for
+     * "LINK_ID=X DCS ..." — the DCS command handler does not support the LINK_ID prefix.
+     * The wpaCtrl interface is already connected to the correct link socket so no
+     * prefix is needed. */
+    snprintf(cmd, sizeof(cmd), "DCS set_wlan_intr_params %s %u", param_name, value);
+    SAH_TRACEZ_INFO(ME, "%s: DCS cmd='%s' via wpaCtrlInterface", pAP->alias, cmd);
+    swl_rc_ne rc = wld_wpaCtrl_sendCmdFmtGetResponse(pAP->wpaCtrlInterface, reply, sizeof(reply), "%s", cmd);
+    /* DCS set commands return 0 with no reply text on success — empty reply is OK */
+    bool bRet = (rc == SWL_RC_OK) && !swl_str_matches(reply, "FAIL") && !swl_str_matches(reply, "UNKNOWN COMMAND");
+    if(!bRet) {
+        SAH_TRACEZ_ERROR(ME, "%s: DCS command failed: cmd='%s' rc=%d reply='%s'",
+                         pAP->alias, cmd, rc, reply);
     }
+    return bRet;
 }
 
