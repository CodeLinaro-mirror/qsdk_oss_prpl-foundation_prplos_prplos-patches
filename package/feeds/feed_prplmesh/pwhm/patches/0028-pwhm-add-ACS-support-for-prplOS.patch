+static uint8_t s_get6GhzAcsOpClass(T_Radio* pRad) {
+    swl_radBw_e bw = pRad->operatingChannelBandwidth;
+    if(bw == SWL_RAD_BW_AUTO) {
+        bw = wld_chanmgt_getHighestApplicableRadBw(pRad);
+    }
+    switch(bw) {
+    case SWL_RAD_BW_40MHZ:   return 132;
+    case SWL_RAD_BW_80MHZ:   return 133;
+    case SWL_RAD_BW_160MHZ:  return 134;
+    case SWL_RAD_BW_320MHZ1:
+    case SWL_RAD_BW_320MHZ2: return 137;
+    default:                  return 131; /* 20 MHz */
+    }
+}
+
 void wifiGen_hapd_writeConfig(T_Radio* pRad) {
     wld_hostapd_cfgFile_createExt(pRad);
+
+    /*
+     * For 6GHz ACS (channel=acs_survey / channel=0), hostapd's skip_mode()
+     * uses is_6ghz_op_class(op_class) to distinguish the 6GHz hw_mode from
+     * the 5GHz hw_mode — both share hw_mode=a (HOSTAPD_MODE_IEEE80211A).
+     * Without op_class set to a 6GHz operating class, skip_mode() returns
+     * false for both modes and hostapd selects the 5GHz mode (listed first
+     * in hw_features[]), causing ACS to scan only 5GHz channels.
+     * This is not needed for 2.4GHz (hw_mode=g is unique) or 5GHz (5GHz
+     * mode is listed first so it is picked correctly without op_class).
+     *
+     * In MLO mode the global hostapd instance orders config files by datamodel
+     * index (e.g. wlan2→wlan1→wlan0), so the primary link interface may be the
+     * 2.4GHz AP (wlan2.1) rather than the 6GHz AP (wlan0.1). hostapd triggers
+     * ACS on the primary link interface and uses its op_class. Therefore we must
+     * also write op_class into every neighbor MLO link's config file so that
+     * whichever interface ends up as primary, the 6GHz op_class is present.
+     */
+    if(pRad->autoChannelEnable && wld_rad_is_6ghz(pRad)) {
+        uint8_t op_class = s_get6GhzAcsOpClass(pRad);
+        char op_class_str[8] = {0};
+        snprintf(op_class_str, sizeof(op_class_str), "%u", op_class);
+
+        /* Apply op_class to the 6GHz radio's own config */
+        char confFilePath[128] = {0};
+        swl_str_catFormat(confFilePath, sizeof(confFilePath),
+                          HOSTAPD_CONF_FILE_PATH_FORMAT, pRad->Name);
+        const char* mainIface = s_getMainIface(pRad);
+        wld_hostapd_cfgFile_update(confFilePath, mainIface, "op_class", op_class_str);
+        SAH_TRACEZ_WARNING(ME, "%s: 6GHz ACS: added op_class=%u to hostapd config",
+                           pRad->Name, op_class);
+
+        /* Also apply op_class to all neighbor MLO link interfaces */
+        T_AccessPoint* pAP = NULL;
+        wld_rad_forEachAp(pAP, pRad) {
+            if((pAP == NULL) || (pAP->pSSID == NULL) || (pAP->pSSID->pMldLink == NULL)) {
+                continue;
+            }
+            wld_mldLink_t* pNeighLink = NULL;
+            wld_for_eachNeighMldLink(pNeighLink, pAP->pSSID->pMldLink) {
+                T_SSID* pNeighSSID = wld_mld_getLinkSsid(pNeighLink);
+                if((pNeighSSID == NULL) || (pNeighSSID->RADIO_PARENT == NULL) ||
+                   (pNeighSSID->AP_HOOK == NULL)) {
+                    continue;
+                }
+                T_Radio* pNeighRad = pNeighSSID->RADIO_PARENT;
+                T_AccessPoint* pNeighAP = pNeighSSID->AP_HOOK;
+                char neighConfFilePath[128] = {0};
+                swl_str_catFormat(neighConfFilePath, sizeof(neighConfFilePath),
+                                  HOSTAPD_CONF_FILE_PATH_FORMAT, pNeighRad->Name);
+                wld_hostapd_cfgFile_update(neighConfFilePath, pNeighAP->alias,
+                                           "op_class", op_class_str);
+                SAH_TRACEZ_WARNING(ME, "%s: 6GHz ACS MLO: added op_class=%u to %s hostapd config",
+                                   pRad->Name, op_class, pNeighAP->alias);
+            }
+        }
+    }
 }
 
