 src/Plugin/wifiGen_fsm.c          |  12 ++
 src/nl80211/wld_hostapd_cfgFile.c |  45 +++++--
 src/wld_accesspoint.c             | 187 ++++++++++++++----------------
 src/wld_radio.c                   |  18 ++-
 4 files changed, 142 insertions(+), 120 deletions(-)

diff --git a/src/Plugin/wifiGen_fsm.c b/src/Plugin/wifiGen_fsm.c
index 10f6592..7f64e2e 100644
--- a/src/Plugin/wifiGen_fsm.c
+++ b/src/Plugin/wifiGen_fsm.c
@@ -849,6 +849,18 @@ static bool s_doAddHostapd(T_Radio* pRad) {
         SAH_TRACEZ_WARNING(ME, "%s: hostapd group is restarting: skip immediate adding conf", pRad->Name);
         return true;
     }
+    /* If this radio has ACS enabled and is not yet up, ACS is likely in progress.
+     * Attempting a warm apply (ADD bss_config) while hostapd is in ACS state causes
+     * hostapd to reject the command, which triggers a full restart and aborts ACS.
+     * Defer the warm apply by re-scheduling it for the next FSM commit (2s later).
+     * The AP-ENABLED event after ACS completes will trigger a new commit. */
+    if(pRad->autoChannelEnable && !wld_rad_isUpExt(pRad)) {
+        SAH_TRACEZ_WARNING(ME, "%s: ACS in progress (autoChannelEnable=1, radio not up) — defer warm apply",
+                           pRad->Name);
+        setBitLongArray(pRad->fsmRad.FSM_BitActionArray, FSM_BW, GEN_FSM_ADD_HOSTAPD);
+        pRad->fsmRad.timeout_msec = 2000;
+        return true;
+    }
     wld_wpaCtrlInterface_t* pgIface = wld_secDmn_getGlobalCtrlIface(pRad->hostapd);
     ASSERTW_TRUE(wld_wpaCtrlInterface_isReady(pgIface), true, ME, "%s: gsock disconnected", pRad->Name);
     wifiGen_hapd_restoreMainIface(pRad);
diff --git a/src/nl80211/wld_hostapd_cfgFile.c b/src/nl80211/wld_hostapd_cfgFile.c
index d5090da..049977c 100644
--- a/src/nl80211/wld_hostapd_cfgFile.c
+++ b/src/nl80211/wld_hostapd_cfgFile.c
@@ -280,14 +280,25 @@ void wld_hostapd_cfgFile_setRadioConfig(T_Radio* pRad, swl_mapChar_t* radConfigM
 
     swl_channel_t tgtChan = tgtChspec.channel;
     /* When auto channel selection is enabled (and not managed externally),
-     * write channel=0 to hostapd config to indicate auto channel selection.
-     * This is equivalent to: uci set wireless.wifiX.channel=auto */
-    if(pRad->autoChannelEnable && !pRad->externalAcsMgmt) {
-        swl_mapCharFmt_addValInt32(radConfigMap, "channel", 0);
+     * write channel=acs_survey to hostapd config to indicate auto channel selection.
+     * This is the standard OpenWrt/prplOS convention, equivalent to:
+     * uci set wireless.wifiX.channel=auto
+     * hostapd parses "acs_survey" and sets conf->acs=1, conf->channel=0.
+     *
+     * When using acs_survey:
+     * - Do NOT write op_class: a stale value restricts which channels ACS scans.
+     * - Do NOT write centr_freq_seg0_idx: a stale center frequency conflicts with
+     *   the ACS-selected channel and prevents the radio from coming up.
+     * - DO write vht/he/eht_oper_chwidth: ACS uses this to determine how many
+     *   channels to scan (e.g., CONF_OPER_CHWIDTH_80MHZ → n_chans=4 for 80MHz).
+     *   Without it, ACS defaults to 20/40 MHz and the radio never comes up on 80MHz. */
+    bool useAcs = (pRad->autoChannelEnable && !pRad->externalAcsMgmt);
+    if(useAcs) {
+        swl_mapChar_add(radConfigMap, "channel", "acs_survey");
     } else {
         swl_mapCharFmt_addValInt32(radConfigMap, "channel", tgtChan);
+        swl_mapCharFmt_addValInt32(radConfigMap, "op_class", swl_chanspec_getOperClass(&tgtChspec));
     }
-    swl_mapCharFmt_addValInt32(radConfigMap, "op_class", swl_chanspec_getOperClass(&tgtChspec));
     swl_mapChar_add(radConfigMap, "country_code", pRad->regulatoryDomain);
     swl_mapChar_add(radConfigMap, "ieee80211d", "1");
     swl_mapCharFmt_addValInt32(radConfigMap, "ieee80211h", pRad->IEEE80211hSupported && pRad->setRadio80211hEnable);
@@ -372,9 +383,13 @@ void wld_hostapd_cfgFile_setRadioConfig(T_Radio* pRad, swl_mapChar_t* radConfigM
             if(pEhtChWId && (*pChWId != *pEhtChWId)) {
                 tgtChspec.bandwidth = *(uint32_t*) swl_table_getMatchingValue(&sChWidthIDsMaps, 2, 0, pChWId);
             }
-            swl_channel_t centerChan = swl_chanspec_getCentreChannel(&tgtChspec);
+            /* Always write vht_oper_chwidth — ACS uses it to determine scan bandwidth.
+             * Only write centr_freq_seg0_idx when NOT using ACS (stale value conflicts). */
             swl_mapCharFmt_addValInt32(radConfigMap, "vht_oper_chwidth", *pChWId);
-            swl_mapCharFmt_addValInt32(radConfigMap, "vht_oper_centr_freq_seg0_idx", centerChan);
+            if(!useAcs) {
+                swl_channel_t centerChan = swl_chanspec_getCentreChannel(&tgtChspec);
+                swl_mapCharFmt_addValInt32(radConfigMap, "vht_oper_centr_freq_seg0_idx", centerChan);
+            }
         }
         char vhtCaps[256] = {0};
         if(wld_channel_hasChannelWidthCovered(tgtChspec, SWL_BW_160MHZ)) {
@@ -466,9 +481,13 @@ void wld_hostapd_cfgFile_setRadioConfig(T_Radio* pRad, swl_mapChar_t* radConfigM
             if(pEhtChWId && (*pChWId != *pEhtChWId)) {
                 tgtChspec.bandwidth = *(uint32_t*) swl_table_getMatchingValue(&sChWidthIDsMaps, 2, 0, pChWId);
             }
-            swl_channel_t centerChan = swl_chanspec_getCentreChannel(&tgtChspec);
+            /* Always write he_oper_chwidth — ACS uses it to determine scan bandwidth.
+             * Only write centr_freq_seg0_idx when NOT using ACS (stale value conflicts). */
             swl_mapCharFmt_addValInt32(radConfigMap, "he_oper_chwidth", *pChWId);
-            swl_mapCharFmt_addValInt32(radConfigMap, "he_oper_centr_freq_seg0_idx", centerChan);
+            if(!useAcs) {
+                swl_channel_t centerChan = swl_chanspec_getCentreChannel(&tgtChspec);
+                swl_mapCharFmt_addValInt32(radConfigMap, "he_oper_centr_freq_seg0_idx", centerChan);
+            }
         }
         if(implicitBf) {
             if(SWL_BIT_IS_SET(pRad->bfCapsSupported[COM_DIR_RECEIVE], RAD_BF_CAP_HE_SU) &&
@@ -557,9 +576,13 @@ void wld_hostapd_cfgFile_setRadioConfig(T_Radio* pRad, swl_mapChar_t* radConfigM
             if(pChWId && (*pChWId != *pEhtChWId)) {
                 tgtChspec.bandwidth = *(uint32_t*) swl_table_getMatchingValue(&sChWidthIDsMaps, 2, 1, pEhtChWId);
             }
-            swl_channel_t centerChan = swl_chanspec_getCentreChannel(&tgtChspec);
+            /* Always write eht_oper_chwidth — ACS uses it to determine scan bandwidth.
+             * Only write centr_freq_seg0_idx when NOT using ACS (stale value conflicts). */
             swl_mapCharFmt_addValInt32(radConfigMap, "eht_oper_chwidth", *pEhtChWId);
-            swl_mapCharFmt_addValInt32(radConfigMap, "eht_oper_centr_freq_seg0_idx", centerChan);
+            if(!useAcs) {
