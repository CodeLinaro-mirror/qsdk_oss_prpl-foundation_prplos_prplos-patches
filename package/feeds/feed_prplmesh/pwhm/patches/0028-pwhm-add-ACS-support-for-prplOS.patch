 /**
+ * Allowed DCS enable bitmask: only bits 0 (CW), 1 (WLAN), 4 (OBSS) are valid.
+ * Matches ALLOWED_DCS_MASK in hostapd qcn_extns/dcs.c.
+ */
+#define DCS_ALLOWED_ENABLE_MASK 0x0013U
+
+/**
+ * @brief Validator for DCS.Enable parameter.
+ *
+ * Rejects any value that has bits set outside the allowed mask
+ * (bits 0=CW, 1=WLAN, 4=OBSS). For example:
+ *   - 4 (0x04 = AWGN bit) is rejected
+ *   - 16 (0x10 = OBSS) is accepted
+ *   - 2 (0x02 = WLAN) is accepted
+ */
+amxd_status_t _wld_ap_validateDcsEnable_pvf(amxd_object_t* object _UNUSED,
+                                             amxd_param_t* param _UNUSED,
+                                             amxd_action_t reason _UNUSED,
+                                             const amxc_var_t* const args,
+                                             amxc_var_t* const retval _UNUSED,
+                                             void* priv _UNUSED) {
+    ASSERTS_FALSE(amxc_var_is_null(args), amxd_status_invalid_value, ME, "invalid");
+    uint32_t value = amxc_var_dyncast(uint32_t, args);
+    if(value & ~DCS_ALLOWED_ENABLE_MASK) {
+        SAH_TRACEZ_ERROR(ME,
+                         "DCS.Enable: invalid value 0x%x — only bits 0(CW=1), 1(WLAN=2), 4(OBSS=16) are allowed",
+                         value);
+        return amxd_status_invalid_value;
+    }
+    return amxd_status_ok;
+}
