@@ -1750,7 +1726,22 @@ static void s_setDcsEnable_pwf(void* priv _UNUSED, amxd_object_t* object,
     SAH_TRACEZ_INFO(ME, "%s: set DCS Enable 0x%x", pAP->alias, enable);
     ASSERTI_NOT_EQUALS(pAP->DCS_Enable, enable, , ME, "EQUALS");
     pAP->DCS_Enable = enable;
-    wld_ap_doSync(pAP);
+
+    /* Only apply at runtime (not during initial DM loading).
+     * During initialization, the dcs_enable value is written to the hostapd
+     * config file by wld_hostapd_cfgFile_setVapConfig and applied when
+     * hostapd starts. Calling wld_ap_doSync too early causes regression
+     * (VAP interfaces not created). */
+    if(pAP->initDone) {
+        /* Write dcs_enable to hostapd config file (for persistence across restarts) */
+        wld_ap_doSync(pAP);
+
+        /* Also send DCS enable command via ctrl interface to apply immediately.
+         * hostapd SIGHUP reload does NOT re-apply dcs_enable from config —
+         * dcs_enable_init() is only called during hostapd initialization.
+         * Sending "DCS enable <bitmap>" updates the runtime state immediately. */
+        s_sendDcsCmd(pAP, "enable", enable);
+    }
 
     SAH_TRACEZ_OUT(ME);
 }
