+bool wld_hostapd_ap_remove_link(T_AccessPoint* pAP) {
+    // Remove Link
+    char cmd[256] = {'\0'};
+    uint8_t tbtt_cnt = 10;
+    snprintf(cmd, sizeof(cmd), "LINK_REMOVE %u", tbtt_cnt);
+    // Send WPA_CTRL message to remove link
+    return s_sendHostapdCommand(pAP, cmd, "Reconfig APMLD remove link");
+}
