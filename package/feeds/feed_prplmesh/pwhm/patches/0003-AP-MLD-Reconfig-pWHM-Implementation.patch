diff --git a/src/wld_mld.c b/src/wld_mld.c
index bd8a9df..3a60965 100644
--- a/src/wld_mld.c
+++ b/src/wld_mld.c
@@ -61,8 +61,11 @@
 ****************************************************************************/
 
 #include "wld.h"
+#include "wld_hostapd_ap_api.h"
 #include "wld_mld.h"
 #include "wld_ssid.h"
+#include "wld_radio.h"
+#include "wld_accesspoint.h"
 #include "wld_util.h"
 #include "wld_radioOperatingStandards.h"
 #include "wld_chanmgt.h"
@@ -610,3 +613,23 @@ wld_mldLink_t* wld_mld_nextNeighLink(wld_mldLink_t* pLink) {
     return s_linkFromIt(it);
 }
 
+bool wld_reconfig_remove_link(wld_mldLink_t* pLink) {
+    ASSERT_NOT_NULL(pLink, false, ME, "Link is NULL");
+    ASSERT_NOT_NULL(pLink->pMld, false, ME, "MLD is NULL");
+    ASSERT_NOT_NULL(pLink->pSSID, false, ME, "SSID is NULL");
+    ASSERT_NOT_NULL(pLink->pSSID->AP_HOOK, false, ME, "AP is NULL");
+    ASSERT_TRUE(wld_mld_isLinkEnabled(pLink), false, ME, "Link is disabled");
+    // Hostapd - Remove link
+    SAH_TRACEZ_INFO(ME, "Remove link from Hostapd");
+    if (wld_hostapd_ap_remove_link(pLink->pSSID->AP_HOOK)) {
+        wld_rad_notify_ReconfigComplete(pLink->pSSID->RADIO_PARENT, true);
+        SAH_TRACEZ_INFO(ME, "Link removed successfully");
+        T_AccessPoint* pAP = pLink->pSSID->AP_HOOK;
+        wld_ssid_destroy(pLink->pSSID);
+        wld_ap_destroy(pAP, false);
+        return true;
+    }
+    wld_rad_notify_ReconfigComplete(pLink->pSSID->RADIO_PARENT, false);
+    SAH_TRACEZ_INFO(ME, "Failed to Remove Link");
+    return false;
+}
diff --git a/src/wld_radio.c b/src/wld_radio.c
index 2ecb68c..cde8300 100644
--- a/src/wld_radio.c
+++ b/src/wld_radio.c
@@ -3234,6 +3234,19 @@ bool wld_radio_notify_scanresults(amxd_object_t* obj) {
     return true;
 }
 
+bool wld_rad_notify_ReconfigComplete(T_Radio *pR, bool success) {
+    ASSERT_NOT_NULL(pR, , ME, "NULL");
+    char* path = amxd_object_get_path(pR->pBus, AMXD_OBJECT_NAMED);
+    amxc_var_t ret;
+    amxc_var_init(&ret);
+    amxc_var_set_type(&ret, AMXC_VAR_ID_HTABLE);
+    amxc_var_add_key(bool, &ret, "Result", success);
+    SAH_TRACEZ_INFO(ME, "%s: notif reconfig complete @ path=%s %s, Result=%s}", pR->Name, path, "ReconfigComplete", success ? "done" : "error");
+    amxd_object_trigger_signal(pR->pBus, "ReconfigComplete", &ret);
+    amxc_var_clean(&ret);
+    free(path);
+}
+
 amxd_status_t _getRadioAirStats(amxd_object_t* object,
                                 amxd_function_t* func _UNUSED,
                                 amxc_var_t* args _UNUSED,
diff --git a/src/wld_ssid.c b/src/wld_ssid.c
index e7e007a..c668a18 100644
--- a/src/wld_ssid.c
+++ b/src/wld_ssid.c
@@ -293,6 +293,10 @@ static void s_cleanSSID(T_SSID* pSSID, bool direct) {
     free(pSSID);
 }
 
+void wld_ssid_destroy(T_SSID* pSSID) {
+    s_cleanSSID(pSSID, false);
+}
+
 /* Be sure that our attached memory structure is cleared */
 static void s_destroySsid(amxd_object_t* object) {
     T_SSID* pSSID = wld_ssid_fromObj(object);
@@ -697,12 +701,33 @@ static void s_setEnable_pwf(void* priv _UNUSED, amxd_object_t* object, amxd_para
 static void s_checkMLDUnit(T_SSID* pSSID, int32_t newMldUnit) {
     SAH_TRACEZ_IN(ME);
     ASSERT_NOT_NULL(pSSID, , ME, "INVALID");
-    if(pSSID->mldUnit == newMldUnit) {
+
+    int32_t oldMldUnit = pSSID->mldUnit;
+
+    // No change
+    if(oldMldUnit == newMldUnit) {
         return;
     }
     SAH_TRACEZ_INFO(ME, "%s: SET MLD_UNIT %d %d", pSSID->Name, pSSID->mldUnit, newMldUnit);
 
     pSSID->mldUnit = newMldUnit;
+
+    // Remove Link
+    if((oldMldUnit != -1) && (newMldUnit == -1)) {
+        // MLD Reconfig - Remove Link
+        if(pSSID->pMldLink != NULL){
+            SAH_TRACEZ_INFO(ME, "Triggered MLD Reconfig Remove Link");
+            if(wld_reconfig_remove_link(pSSID->pMldLink)) {
+                return;
+	    } else {
+                // Link Remove failed
+                SAH_TRACEZ_INFO(ME, "MLD Reconfig Remove Link Failed. Remove the link in legacy way");
+            }
+        } else {
+            SAH_TRACEZ_INFO(ME, "MLD Link not present but MLDUnit >= 0");
+	}
+    }
+
     wld_mld_setLinkConfigured(pSSID->pMldLink, false);
     if(pSSID->AP_HOOK != NULL) {
         T_AccessPoint* pAP = pSSID->AP_HOOK;
@@ -711,6 +736,19 @@ static void s_checkMLDUnit(T_SSID* pSSID, int32_t newMldUnit) {
     }
     wld_mld_registerLink(pSSID, pSSID->mldUnit);
 
+    // Add Link
+    if((oldMldUnit == -1) && (newMldUnit != -1)) {
+        // Add Link. Could be reconfig or new MLD
+        if(pSSID->pMldLink != NULL) {
+            // Target could be new MLD or existing MLD
+            uint32_t count = wld_mld_countNeighLinks(pSSID->pMldLink);
+            if ((count > 1)) {
+                // MLD Reconfig - Add Link
+                wld_rad_notify_ReconfigComplete(pSSID->RADIO_PARENT, true);
+            }
+        }
+    }
+
     SAH_TRACEZ_OUT(ME);
 }
 
