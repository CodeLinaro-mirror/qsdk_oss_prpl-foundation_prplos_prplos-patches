From 3b41e6c042c77ffe3741f703fe4d8521cb94cc41 Mon Sep 17 00:00:00 2001
From: Atchaya R <ratchaya@qti.qualcomm.com>
Date: Thu, 5 Dec 2024 18:25:00 +0530
Subject: [PATCH] Added fix to change the bandwidth(40Mhz) for 2Ghz by enabling
 params ht_coex,noscan in hostapd cfg via pwhm

Signed-off-by: Atchaya R <ratchaya@qti.qualcomm.com>
---
 src/nl80211/wld_hostapd_cfgFile.c | 4 ++++
 1 file changed, 4 insertions(+)

--- a/src/nl80211/wld_hostapd_cfgFile.c
+++ b/src/nl80211/wld_hostapd_cfgFile.c
@@ -305,6 +305,14 @@ void wld_hostapd_cfgFile_setRadioConfig(
             }
         }
     }
+    if (wld_rad_is_24ghz(pRad) && pRad->obssCoexistenceActive == 0  && pRad->obssCoexistenceEnabled == 0) {
+	    swl_mapChar_add(radConfigMap, "ht_coex", "0");
+	    swl_mapChar_add(radConfigMap, "noscan", "1");
+    }
+    else if (wld_rad_is_24ghz(pRad) && pRad->obssCoexistenceEnabled == 1) {
+	    swl_mapChar_add(radConfigMap, "ht_coex", "1");
+	    swl_mapChar_add(radConfigMap, "noscan", "0");
+    }
     if(enableRad11n) {
         if(wld_channel_hasChannelWidthCovered(tgtChspec, SWL_BW_40MHZ)) {
             if(s_checkSGI(pRad, SWL_SGI_400)) {
