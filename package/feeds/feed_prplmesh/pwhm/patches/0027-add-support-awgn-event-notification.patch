+static void s_setDiscardAwgnEvent_pwf(void* priv _UNUSED, amxd_object_t* object, amxd_param_t* param _UNUSED, const amxc_var_t* const newValue) {
+    SAH_TRACEZ_IN(ME);
+
+    T_Radio* pRad = wld_rad_fromObj(object);
+    ASSERTS_NOT_NULL(pRad, , ME, "NULL");
+    uint32_t val = amxc_var_dyncast(uint32_t, newValue);
+    SAH_TRACEZ_INFO(ME, "%s: set DiscardAwgnEvent %u", pRad->Name, val);
+    pRad->discardAwgnEvent = (val != 0);
+    wld_rad_doSync(pRad);
+
+    SAH_TRACEZ_OUT(ME);
+}
