--- a/src/nl80211/wld_wpaCtrl_events.c
+++ b/src/nl80211/wld_wpaCtrl_events.c
@@ -541,6 +541,24 @@ static void s_uplinkCsaTimeoutEvtCb(wld_
     CALL_MGR_I(pInterface, fUplinkCsaTimeoutCb, params);
 }
 
+static void s_acsCompletedEvt(wld_wpaCtrlInterface_t* pInterface, char* event _UNUSED, char* params) {
+    // Example: ACS-COMPLETED freq=5180 channel=36
+    // Log the ACS-selected channel. The AP-ENABLED event that follows will
+    // trigger the radio state update and channel sync in pWHM.
+    swl_chanspec_t chanSpec = SWL_CHANSPEC_EMPTY;
+    if(s_freqParamToChanSpec(params, "freq", &chanSpec) >= SWL_RC_OK) {
+        SAH_TRACEZ_INFO(ME, "%s: ACS completed, selected channel=%d",
+                        pInterface->name, chanSpec.channel);
+    } else {
+        SAH_TRACEZ_INFO(ME, "%s: ACS completed (%s)", pInterface->name, params);
+    }
+    /* Use fChanSwitchCb to notify the radio layer of the ACS-selected channel,
+     * reusing the existing channel-change callback infrastructure. */
+    CALL_MGR_I(pInterface, fChanSwitchCb, &chanSpec);
+    /* Notify DCS handler so it can reconnect wpa_supplicant after ACS */
+    CALL_MGR_I(pInterface, fAcsCompletedCb, &chanSpec);
+}
+
 static void s_apEnabledEvt(wld_wpaCtrlInterface_t* pInterface, char* event, char* params _UNUSED) {
     // Example: AP-ENABLED
     // This event notifies that hapd main interface has setup completed
@@ -646,6 +664,13 @@ static void s_radDfsNewChannelEvt(wld_wp
     CALL_MGR_I(pInterface, fDfsNewChannelCb, &chanSpec);
 }
 
+static void s_awgnInterferenceDetectedEvt(wld_wpaCtrlInterface_t* pInterface, char* event, char* params) {
+    // Example: INTERFERENCE-DETECTED type=AWGN freq=6135 chan_width=5 cf1=6105 cf2=0 bitmap=0x01
+    // Example: INTERFERENCE-DETECTED type=WLAN freq=5805 chan_width=3 cf1=5775 cf2=0 bitmap=0x00000000
+    SAH_TRACEZ_ERROR(ME, "%s: pwhm received wpaCtrlEvent: %s %s", pInterface->name, event, params);
+    CALL_MGR_I(pInterface, fAwgnInterferenceDetectedCb, params);
+}
+
