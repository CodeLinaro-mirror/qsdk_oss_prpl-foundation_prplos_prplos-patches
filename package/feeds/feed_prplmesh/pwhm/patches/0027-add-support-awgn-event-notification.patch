+static void s_awgnInterferenceDetectedCb(void* userData, char* ifName, char* params) {
+    /*
+     * Interference detected event from hostapd (type=AWGN, WLAN, CW, or OBSS).
+     * hostapd already handles the channel switch or ACS internally.
+     * For WLAN/CW interference: hostapd triggers dynamic ACS which needs wpa_supplicant
+     * scans to be stopped first. Send DISCONNECT to ALL EP interfaces on ALL radios
+     * so that wpa_supplicant stops scanning and stays disconnected until ACS completes.
+     *
+     * In the WiFi 7 MLO setup, the INTERFERENCE-DETECTED event may be received on a
+     * different radio than the one running ACS (e.g., event on wlan1.1/5GHz radio but
+     * ACS runs on wlan2.1/MLO AP which shares the physical radio with wlan2/6GHz STA).
+     * Sending DISCONNECT to all radios' endpoints ensures all wpa_supplicant interfaces
+     * on the same physical chip stop scanning.
+     *
+     * After ACS completes (ACS-COMPLETED event), s_acsCompletedCb sends RECONNECT.
+     * This mirrors what the OpenWrt ucode notify_acs_start / disconnect_backhaul does.
+     * The event is also forwarded to prplmesh and other subscribers via the AMX
+     * wpaCtrlEvents signal on the Radio object (see s_fwdRadioStdWpaCtrlEventsList).
+     * Event format: INTERFERENCE-DETECTED type=<WLAN|AWGN|CW|OBSS> freq=<MHz>
+     *               chan_width=<id> cf1=<MHz> cf2=<MHz> bitmap=0x<hex>
+     */
+    SAH_TRACEZ_ERROR(ME, "%s: Interference detected: %s", ifName, params);
+    T_Radio* pRad = (T_Radio*) userData;
+    ASSERT_NOT_NULL(pRad, , ME, "NULL");
+
+    /* Check if this is a WLAN/CW interference event that will trigger ACS */
+    char typeStr[32] = {0};
+    if(wld_wpaCtrl_getValueStr(params, "type", typeStr, sizeof(typeStr)) > 0 &&
+       (swl_str_matches(typeStr, "WLAN") || swl_str_matches(typeStr, "CW"))) {
+        /*
+         * Send DISCONNECT to ALL wpa_supplicant endpoints on ALL radios.
+         * DISCONNECT stops any ongoing scan and prevents wpa_supplicant from
+         * starting new scans (it waits for RECONNECT). This ensures acs_init()
+         * can request its scan without getting EBUSY from the kernel.
+         * RECONNECT will be sent in s_acsCompletedCb when ACS-COMPLETED is received.
+         */
+        T_Radio* pRadIter;
+        wld_for_eachRad(pRadIter) {
+            T_EndPoint* pEP = NULL;
+            wld_rad_forEachEp(pEP, pRadIter) {
+                if((pEP == NULL) || (pEP->wpaCtrlInterface == NULL)) {
+                    continue;
+                }
+                if(!wld_wpaCtrlInterface_isReady(pEP->wpaCtrlInterface)) {
+                    SAH_TRACEZ_WARNING(ME, "%s: wpa_supplicant interface not ready, skip DISCONNECT for %s interference",
+                                       pEP->Name, typeStr);
+                    continue;
+                }
+                SAH_TRACEZ_ERROR(ME, "%s: sending DISCONNECT to wpa_supplicant for %s interference (DCS-triggered ACS)",
+                                 pEP->Name, typeStr);
+                wld_wpaCtrl_sendCmdCheckResponse(pEP->wpaCtrlInterface, "DISCONNECT", "OK");
+            }
+        }
+    }
+}
+
+static void s_acsCompletedCb(void* userData, char* ifName _UNUSED, swl_chanspec_t* chanSpec) {
+    /*
+     * ACS-COMPLETED event: hostapd has finished automatic channel selection.
+     * Send RECONNECT to ALL wpa_supplicant endpoints on ALL radios so the backhaul
+     * STA can reconnect on the new channel. This pairs with the DISCONNECT sent in
+     * s_awgnInterferenceDetectedCb when WLAN/CW interference triggered ACS.
+     * All radios are reconnected because DISCONNECT was sent to all of them.
+     */
+    T_Radio* pRad = (T_Radio*) userData;
+    ASSERT_NOT_NULL(pRad, , ME, "NULL");
+    SAH_TRACEZ_ERROR(ME, "%s: ACS completed on channel=%d, sending RECONNECT to all wpa_supplicant endpoints",
+                     pRad->Name, chanSpec ? chanSpec->channel : 0);
+    T_Radio* pRadIter;
+    wld_for_eachRad(pRadIter) {
+        T_EndPoint* pEP = NULL;
+        wld_rad_forEachEp(pEP, pRadIter) {
+            if((pEP == NULL) || (pEP->wpaCtrlInterface == NULL)) {
+                continue;
+            }
+            if(!wld_wpaCtrlInterface_isReady(pEP->wpaCtrlInterface)) {
+                SAH_TRACEZ_WARNING(ME, "%s: wpa_supplicant interface not ready, skip RECONNECT after ACS",
+                                   pEP->Name);
+                continue;
+            }
+            SAH_TRACEZ_ERROR(ME, "%s: sending RECONNECT to wpa_supplicant after ACS completion (channel=%d)",
+                             pEP->Name, chanSpec ? chanSpec->channel : 0);
+            wld_wpaCtrl_sendCmdCheckResponse(pEP->wpaCtrlInterface, "RECONNECT", "OK");
+        }
+    }
+}
+
 static void s_uplinkCsaTimeoutCb(void* userData, char* ifName _UNUSED, char* params _UNUSED) {
     T_Radio* pRad = (T_Radio*) userData;
     ASSERT_NOT_NULL(pRad, , ME, "NULL");
@@ -615,6 +703,8 @@ static swl_rc_ne s_setWpaCtrlRadEvtHandl
     SET_HDLR(wpaCtrlRadEvthandlers.fFetchSockLinkIface, s_fetchSockLinkIface);
     SET_HDLR(wpaCtrlRadEvthandlers.fUplinkCsaCb, s_uplinkCsaCb);
     SET_HDLR(wpaCtrlRadEvthandlers.fUplinkCsaTimeoutCb, s_uplinkCsaTimeoutCb);
+    SET_HDLR(wpaCtrlRadEvthandlers.fAwgnInterferenceDetectedCb, s_awgnInterferenceDetectedCb);
+    SET_HDLR(wpaCtrlRadEvthandlers.fAcsCompletedCb, s_acsCompletedCb);
     wld_wpaCtrlMngr_setEvtHandlers(wpaCtrlMngr, pRad, &wpaCtrlRadEvthandlers);
     return SWL_RC_OK;
 }
@@ -1666,4 +1756,3 @@ swl_rc_ne wifiGen_setEpEvtHandlers(T_End
 
     return SWL_RC_OK;
 }
