From ef1bc2a7bc993c903c1ca3d20daa078e3934807e Mon Sep 17 00:00:00 2001
From: Kartheek E <karte@qti.qualcomm.com>
Date: Tue, 28 Jul 2026 14:44:15 +0530
Subject: [PATCH 1/1] pwhm: Reject chan_switch CLI when uhr flag is missing on
 UHR VAP

Signed-off-by: Kartheek E <karte@qti.qualcomm.com>
---
 src/nl80211/wld_rad_hostapd_api.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/nl80211/wld_rad_hostapd_api.c b/src/nl80211/wld_rad_hostapd_api.c
index 09dbb65..5a0a42b 100644
--- a/src/nl80211/wld_rad_hostapd_api.c
+++ b/src/nl80211/wld_rad_hostapd_api.c
@@ -234,6 +234,9 @@ swl_rc_ne wld_rad_hostapd_switchChannel(T_Radio* pR) {
             swl_strlst_catFormat(cmd, sizeof(cmd), " ", "punct_bitmap=%d", chanspec.punctBitmap);
         }
     }
+    if(SWL_BIT_IS_SET(operStd, SWL_RADSTD_BN)) {
+        swl_strlst_catFormat(cmd, sizeof(cmd), " ", "uhr");
+    }
 
     /* TODO: blocktx */
 
