     SAH_TRACEZ_OUT(ME);
 }
 
+/**
+ * @brief Write handler for Radio.{i}.StrictPassiveScan
+ *
+ * Enables or disables strict passive scan on PCH (Primary Channel) channels.
+ * Uses cfg80211tool directly (not NL80211 vendor command):
+ *   cfg80211tool <phy> radio_idx <idx> wifi_params 81 <0|1>
+ *   param 81 = QCA_WLAN_VENDOR_RADIO_PARAM_SCAN_STRICT_PASSIVE_PCH
+ *
+ * Test:  ubus-cli Device.WiFi.Radio.1.StrictPassiveScan=1
+ */
+static void s_setStrictPassiveScan_pwf(void* priv _UNUSED, amxd_object_t* object, amxd_param_t* param _UNUSED, const amxc_var_t* const newValue) {
+    SAH_TRACEZ_IN(ME);
+
+    T_Radio* pRad = wld_rad_fromObj(object);
+    ASSERTS_NOT_NULL(pRad, , ME, "NULL");
+
+    bool enable = amxc_var_dyncast(bool, newValue);
+    SAH_TRACEZ_INFO(ME, "%s: set StrictPassiveScan %d", pRad->Name, enable);
+
+    /* Resolve phy name (e.g. "phy0") from wlan interface name */
+    char phyName[IFNAMSIZ] = {0};
+    s_get_phy_name(pRad->wiphyName, phyName, sizeof(phyName));
+
+    /* Derive radio_idx from frequency band: 0=2.4GHz, 1=5GHz, 2=6GHz */
+    uint32_t radio_idx = s_band_to_radio_idx(pRad->operatingFrequencyBand);
+
+    /* Build cfg80211tool command:
+     *   cfg80211tool <phy> radio_idx <idx> wifi_params 81 <0|1>
+     *   param 81 = QCA_WLAN_VENDOR_RADIO_PARAM_SCAN_STRICT_PASSIVE_PCH
+     */
+    char cmd[256] = {0};
+    char out[256] = {0};
+    snprintf(cmd, sizeof(cmd),
+             "cfg80211tool %s radio_idx %u strict_passive_scan %u 2>&1",
+             phyName, radio_idx, enable ? 1u : 0u);
+
+    SAH_TRACEZ_INFO(ME, "%s: StrictPassiveScan cmd='%s'", pRad->Name, cmd);
+
+    swl_rc_ne rc = s_cfg80211tool_run(cmd, out, sizeof(out));
+
+    /* Strip trailing newline for clean logging */
+    size_t outLen = strlen(out);
+    while(outLen > 0 && (out[outLen - 1] == '\n' || out[outLen - 1] == '\r')) {
+        out[--outLen] = '\0';
+    }
+
+    if(rc != SWL_RC_OK) {
+        SAH_TRACEZ_ERROR(ME, "%s: StrictPassiveScan cfg80211tool FAILED rc=%d cmd='%s' out='%s'",
+                         pRad->Name, rc, cmd, out);
+    } else {
+        SAH_TRACEZ_INFO(ME, "%s: StrictPassiveScan cfg80211tool SUCCESS enable=%d out='%s'",
+                        pRad->Name, enable, out);
+    }
+
+    SAH_TRACEZ_OUT(ME);
+}
+
 /**
  * @brief Write handler for Radio.{i}.PowerSaveEnable
  *
@@ -6463,6 +6520,7 @@ SWLA_DM_HDLRS(sRadioDmHdlrs,
                   SWLA_DM_PARAM_HDLR("AntennaGain2G", s_setAntennaGain2G_pwf),
                   SWLA_DM_PARAM_HDLR("AntennaGain5G", s_setAntennaGain5G_pwf),
                   SWLA_DM_PARAM_HDLR("PowerSaveEnable", s_setPowerSaveEnable_pwf),
+                  SWLA_DM_PARAM_HDLR("StrictPassiveScan", s_setStrictPassiveScan_pwf),
                   ),
