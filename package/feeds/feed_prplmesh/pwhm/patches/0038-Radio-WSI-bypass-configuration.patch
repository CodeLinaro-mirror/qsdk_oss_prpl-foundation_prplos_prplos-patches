 		 * Static puncturing feature
diff --git a/src/nl80211/wld_rad_nl80211.c b/src/nl80211/wld_rad_nl80211.c
index c7ae922..55f7fa7 100644
--- a/src/nl80211/wld_rad_nl80211.c
+++ b/src/nl80211/wld_rad_nl80211.c
@@ -69,6 +69,7 @@
 #include "wld_ep_nl80211.h"
 #include "wld_ssid_nl80211_priv.h"
 #include "wld_nl80211_utils.h"
+#include "wld_nl80211_api_priv.h"
 #include "wld_linuxIfUtils.h"
 #include "swl/swl_common.h"
 #include "swl/swl_common_time.h"
@@ -821,3 +822,90 @@ swl_rc_ne wld_rad_nl80211_sendVendorSubCmdAttr(T_Radio* pRadio, uint32_t oui, in
 
     return rc;
 }
+
+/* -------------------------------------------------------------------------
+ * WSI Bypass Device (PowerSaveEnable) — NL80211 vendor command
+ * -------------------------------------------------------------------------
+*/
+#define WSI_QCA_VENDOR_ID       0x001374u
+#define WSI_BYPASS_SUBCMD       505
+
+/* Vendor data attribute IDs */
+#define WSI_ATTR_RADIO_IDX      150u  /* QCA_WLAN_VENDOR_ATTR_CONFIG_RADIO_INDEX */
+#define WSI_ATTR_DPARAM0        17u   /* QCA_NL80211_VENDOR_SUBCMD_WIFI_PARAMS */
+#define WSI_ATTR_DPARAM1        18u   /* QCA_WLAN_VENDOR_RADIO_PARAM_WSI_BYPASS */
+#define WSI_ATTR_VALUE0         19u   /* bypass value */
+
+/* Vendor data attribute values */
+#define WSI_DPARAM0_WIFI_PARAMS 200u
+#define WSI_DPARAM1_WSI_BYPASS  80u
+#define WSI_VALUE0_BYPASS       1u    /* bypass / remove device (Power Save ON) */
+#define WSI_VALUE0_READD        2u    /* re-add device (Power Save OFF) */
+
+static uint32_t s_wsiGetRadioIdx(T_Radio* pRad) {
+    if(pRad->pBus == NULL) {
+        return 0;
+    }
+    char* freqBand = amxd_object_get_cstring_t(pRad->pBus, "OperatingFrequencyBand", NULL);
+    SAH_TRACEZ_WARNING(ME, "Radio idx value=%s",freqBand);
+    uint32_t idx = 0;
+    if(freqBand != NULL) {
+        if(swl_str_matches(freqBand, "5GHz")) {
+            idx = 1;
+        } else if(swl_str_matches(freqBand, "6GHz")) {
+            idx = 2;
+        }
+        free(freqBand);
+    }
+    return idx;
+}
+
+swl_rc_ne wld_rad_nl80211_setWsiBypassDevice(T_Radio* pRad, bool enable) {
+    swl_rc_ne rc = SWL_RC_INVALID_PARAM;
+    ASSERT_NOT_NULL(pRad, rc, ME, "NULL radio");
+
+    uint32_t radioIdx = s_wsiGetRadioIdx(pRad);
+    uint32_t bypassVal = enable ? WSI_VALUE0_BYPASS : WSI_VALUE0_READD;
+
+    SAH_TRACEZ_WARNING(ME, "%s: setWsiBypassDevice enable=%d radioIdx=%u bypassVal=%u",
+                    pRad->Name, enable, radioIdx, bypassVal);
+
+    if(pRad->index <= 0 && pRad->wDevId == 0) {
+        SAH_TRACEZ_WARNING(ME, "%s: radio not available, skip bypass", pRad->Name);
+        return SWL_RC_OK;
+    }
+
+    uint8_t radioIdxU8 = (uint8_t)radioIdx;
+    uint32_t dparam0Val = WSI_DPARAM0_WIFI_PARAMS;
+    uint32_t dparam1Val = WSI_DPARAM1_WSI_BYPASS;
+    NL_ATTR_NESTED(vendorAttr, NL80211_ATTR_VENDOR_DATA);
+    NL_ATTRS_ADD(&vendorAttr.data.attribs, NL_ATTR_VAL(WSI_ATTR_RADIO_IDX, radioIdxU8));
+    NL_ATTRS_ADD(&vendorAttr.data.attribs, NL_ATTR_VAL(WSI_ATTR_DPARAM0, dparam0Val));
+    NL_ATTRS_ADD(&vendorAttr.data.attribs, NL_ATTR_VAL(WSI_ATTR_DPARAM1, dparam1Val));
+    NL_ATTRS_ADD(&vendorAttr.data.attribs, NL_ATTR_VAL(WSI_ATTR_VALUE0, bypassVal));
+
+    uint32_t wiphy = pRad->wiphy;
+    uint32_t vendorId = WSI_QCA_VENDOR_ID;
+    uint32_t vendorSubcmd = WSI_BYPASS_SUBCMD;
+    NL_ATTRS(attribs,
+             ARR(
+                 NL_ATTR_VAL(NL80211_ATTR_VENDOR_ID, vendorId),
+                 NL_ATTR_VAL(NL80211_ATTR_VENDOR_SUBCMD, vendorSubcmd),
+                 NL_ATTR_VAL(NL80211_ATTR_WIPHY, wiphy)
+                 )
+             );
+    swl_unLiList_add(&attribs, &vendorAttr);
+
+    rc = wld_nl80211_sendCmdSyncWithAck(wld_nl80211_getSharedState(),
+                                        NL80211_CMD_VENDOR,
+                                        0,    
+                                        0,    
+                                        &attribs);
+    NL_ATTRS_CLEAR(&attribs);
+    NL_ATTRS_CLEAR(&vendorAttr.data.attribs);
+
+    if(rc != SWL_RC_OK) {
+        SAH_TRACEZ_ERROR(ME, "%s: setWsiBypassDevice failed rc=%d", pRad->Name, rc);
+    }
+    return rc;
+}
diff --git a/src/wld_radio.c b/src/wld_radio.c
index bf45ac2..6b28198 100644
--- a/src/wld_radio.c
+++ b/src/wld_radio.c
@@ -6072,6 +6072,31 @@ static void s_setAllowScanDfsChan_pwf(void* priv _UNUSED, amxd_object_t* object,
     SAH_TRACEZ_OUT(ME);
 }
 
+/**
+ * @brief Write handler for Radio.{i}.PowerSaveEnable
+ *
+ * Controls the WSI (Wireless Switch Interface) bypass state via NL80211
+ * vendor command (bypass_device, subcmd=505):
+ *   true  -> value0=1  (bypass/remove device, Power Save ON)
+ *   false -> value0=2  (re-add device,         Power Save OFF)
+ */
+static void s_setPowerSaveEnable_pwf(void* priv _UNUSED, amxd_object_t* object, amxd_param_t* param _UNUSED, const amxc_var_t* const newValue) {
+    SAH_TRACEZ_IN(ME);
+
+    T_Radio* pRad = wld_rad_fromObj(object);
+    ASSERTS_NOT_NULL(pRad, , ME, "NULL");
+    bool enable = amxc_var_dyncast(bool, newValue);
+    SAH_TRACEZ_INFO(ME, "%s: set PowerSaveEnable %d", pRad->Name, enable);
+
+    swl_rc_ne rc = wld_rad_nl80211_setWsiBypassDevice(pRad, enable);
+    if(rc != SWL_RC_OK) {
+        SAH_TRACEZ_WARNING(ME, "%s: setWsiBypassDevice(enable=%d) failed rc=%d",
+                           pRad->Name, enable, rc);
+    }
+
+    SAH_TRACEZ_OUT(ME);
+}
+
 SWLA_DM_HDLRS(sRadioDmHdlrs,
               ARR(SWLA_DM_PARAM_HDLR("RegulatoryDomain", s_setCountryCode_pwf),
                   SWLA_DM_PARAM_HDLR("IEEE80211hEnabled", s_set80211hEnable_pwf),
@@ -6123,6 +6148,7 @@ SWLA_DM_HDLRS(sRadioDmHdlrs,
                   SWLA_DM_PARAM_HDLR("PowerType", s_setPowerType_pwf),
                   SWLA_DM_PARAM_HDLR("DiscardAwgnEvent", s_setDiscardAwgnEvent_pwf),
                   SWLA_DM_PARAM_HDLR("AllowScanDfsChan", s_setAllowScanDfsChan_pwf),
+                  SWLA_DM_PARAM_HDLR("PowerSaveEnable", s_setPowerSaveEnable_pwf),
                   ),
               .instAddedCb = s_addInstance_oaf);
 
