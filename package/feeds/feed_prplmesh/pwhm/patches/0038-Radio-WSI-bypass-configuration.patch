diff --git a/include/wld/wld_rad_nl80211.h b/include/wld/wld_rad_nl80211.h
index 6c3cd6d..995bdfc 100644
--- a/include/wld/wld_rad_nl80211.h
+++ b/include/wld/wld_rad_nl80211.h
@@ -546,4 +546,18 @@ swl_rc_ne wld_rad_nl80211_getFirstEnabledVapLinkInfo(T_Radio* pRadio, int32_t* p
  */
 swl_rc_ne wld_rad_nl80211_getFirstActiveIntfLinkInfo(T_Radio* pRadio, int32_t* pIfIndex, int8_t* pLinkId);
 
+/*
+ * @brief Set WSI bypass device state for power save control via NL80211 vendor command.
+ *
+ * Sends vendor command bypass_device (subcmd=505) to the driver:
+ *   enable=true  -> value0=1 (bypass/remove device, Power Save ON)
+ *   enable=false -> value0=2 (re-add device, Power Save OFF)
+ *
+ * @param pRad pointer to radio context
+ * @param enable true to enable power save (bypass device), false to disable (re-add device)
+ *
+ * @return SWL_RC_OK in case of success
+ *         <= SWL_RC_ERROR otherwise
+ */
+swl_rc_ne wld_rad_nl80211_setWsiBypassDevice(T_Radio* pRad, bool enable);
 #endif /* INCLUDE_WLD_WLD_RAD_NL80211_H_ */
