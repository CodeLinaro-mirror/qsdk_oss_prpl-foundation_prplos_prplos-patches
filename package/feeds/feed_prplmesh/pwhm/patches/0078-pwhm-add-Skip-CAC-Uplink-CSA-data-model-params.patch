+static void s_setSkipCac_pwf(void* priv _UNUSED, amxd_object_t* object, amxd_param_t* param _UNUSED, const amxc_var_t* const newValue) {
+    SAH_TRACEZ_IN(ME);
+
+    T_Radio* pR = wld_rad_fromObj(object);
+    ASSERTS_NOT_NULL(pR, , ME, "NULL");
+    bool val = amxc_var_dyncast(bool, newValue);
+    SAH_TRACEZ_INFO(ME, "%s: set Skip_CAC %d", pR->Name, val);
+    pR->skipCac = val;
+    pR->fsmRad.FSM_SyncAll = TRUE;
+    wld_autoCommitMgr_notifyRadEdit(pR);
+
+    SAH_TRACEZ_OUT(ME);
+}
+
+static void s_setUplinkCsaRad_pwf(void* priv _UNUSED, amxd_object_t* object, amxd_param_t* param _UNUSED, const amxc_var_t* const newValue) {
+    SAH_TRACEZ_IN(ME);
+
+    T_Radio* pR = wld_rad_fromObj(object);
+    ASSERTS_NOT_NULL(pR, , ME, "NULL");
+    bool val = amxc_var_dyncast(bool, newValue);
+    SAH_TRACEZ_INFO(ME, "%s: set Radio.Uplink_CSA %d", pR->Name, val);
+    pR->uplinkCsa = val;
+    pR->fsmRad.FSM_SyncAll = TRUE;
+    wld_autoCommitMgr_notifyRadEdit(pR);
+
+    SAH_TRACEZ_OUT(ME);
+}
