     bool isWPSEnrol;                               /* Set WPS Enrollee mode when STA is active! */
 
+    bool skipCac;                                  /* DM: Radio.Skip_CAC -- write skip_cac to hostapd config */
+    bool uplinkCsa;                                /* DM: Radio.Uplink_CSA -- write uplink_csa to hostapd config */
+
