 		/**
 		 * <p> Kick a station, when it roams between AP's of the same radio.
--- a/odl/wld_endpoint.odl	2026-09-21 16:43:52.367432203 +0530
+++ b/odl/wld_endpoint.odl	2026-09-21 16:44:31.621367497 +0530
@@ -169,6 +169,15 @@
 		%persistent bool MultiAPEnable;
 
 		/**
+		 * <p> When true, uplink_csa=1 is written to the wpa_supplicant
