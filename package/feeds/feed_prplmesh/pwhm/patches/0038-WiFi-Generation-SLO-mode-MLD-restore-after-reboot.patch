-static void s_setDisable11ax_pwf(void* priv _UNUSED, amxd_object_t* object,
-                                  amxd_param_t* param _UNUSED,
-                                  const amxc_var_t* const newValue) {
-    SAH_TRACEZ_IN(ME);
-
-    T_AccessPoint* pAP = wld_ap_fromObj(object);
-    ASSERT_NOT_NULL(pAP, , ME, "INVALID");
-
-    bool disable = amxc_var_dyncast(bool, newValue);
-
-    if(!pAP->pSSID) {
-        SAH_TRACEZ_ERROR(ME, "%s: pSSID is NULL - cannot change MLDUnit", pAP->alias);
-        SAH_TRACEZ_OUT(ME);
-        return;
-    }
-
-    if(!pAP->pSSID->pBus) {
-        SAH_TRACEZ_ERROR(ME, "%s: pSSID->pBus is NULL - cannot update DM MLDUnit", pAP->alias);
-        SAH_TRACEZ_OUT(ME);
-        return;
-    }
-
-    if(disable && pAP->pRadio->operatingFrequencyBand == SWL_FREQ_BAND_EXT_6GHZ) {
-        SAH_TRACEZ_WARNING(ME, "%s: Disable11ax=1 ignored on 6GHz BSS "
-                           "(6GHz requires 11ax as minimum standard)", pAP->alias);
-        SAH_TRACEZ_OUT(ME);
-        return;
-    }
-
-    int32_t newMldUnit;
-    if(disable) {
-        pAP->disable11ax = true;
-        if(pAP->pSSID->mldUnit < 0) {
-            SAH_TRACEZ_INFO(ME, "%s: mldUnit=%d already not in MLD, applying disable_11ax flag",
-                            pAP->alias, pAP->pSSID->mldUnit);
-            wld_ap_doSync(pAP);
-            SAH_TRACEZ_OUT(ME);
-            return;
-        }
-        pAP->savedMldUnit11ax = pAP->pSSID->mldUnit;
-        SAH_TRACEZ_INFO(ME, "%s: Disable11ax=1 saving mldUnit=%d, setting SSID.MLDUnit=-1",
-                        pAP->alias, pAP->savedMldUnit11ax);
-        newMldUnit = -1;
-    } else {
-        pAP->disable11ax = false;
-        if(pAP->savedMldUnit11ax < 0) {
-            SAH_TRACEZ_INFO(ME, "%s: no saved mldUnit (savedMldUnit11ax=%d) - clearing disable_11ax flag",
-                            pAP->alias, pAP->savedMldUnit11ax);
-            wld_ap_doSync(pAP);
-            SAH_TRACEZ_OUT(ME);
-            return;
-        }
-        SAH_TRACEZ_INFO(ME, "%s: Disable11ax=0 restoring SSID.MLDUnit=%d",
-                        pAP->alias, pAP->savedMldUnit11ax);
-        newMldUnit = pAP->savedMldUnit11ax;
-        pAP->savedMldUnit11ax = -1;
-    }
-
-    amxd_trans_t trans;
-    ASSERT_TRANSACTION_INIT(pAP->pSSID->pBus, &trans, , ME, "%s: trans init failed", pAP->alias);
-    amxd_trans_set_value(int32_t, &trans, "MLDUnit", newMldUnit);
-    ASSERT_TRANSACTION_LOCAL_DM_END(&trans, , ME, "%s: trans apply failed setting MLDUnit=%d",
-                                    pAP->alias, newMldUnit);
-
-    SAH_TRACEZ_OUT(ME);
-}
