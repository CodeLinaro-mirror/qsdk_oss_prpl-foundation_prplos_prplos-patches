-        newMldUnit = -1;
-    } else {
-        if(pAP->savedMldUnit11be < 0) {
-            SAH_TRACEZ_INFO(ME, "%s: no saved mldUnit (savedMldUnit11be=%d) - nothing to restore",
-                            pAP->alias, pAP->savedMldUnit11be);
-            SAH_TRACEZ_OUT(ME);
-            return;
-        }
-        SAH_TRACEZ_INFO(ME, "%s: Disable11be=0 restoring SSID.MLDUnit=%d",
-                        pAP->alias, pAP->savedMldUnit11be);
-        newMldUnit = pAP->savedMldUnit11be;
-        pAP->savedMldUnit11be = -1;
-    }
-
-    amxd_trans_t trans;
-    ASSERT_TRANSACTION_INIT(pAP->pSSID->pBus, &trans, , ME, "%s: trans init failed", pAP->alias);
-    amxd_trans_set_value(int32_t, &trans, "MLDUnit", newMldUnit);
-    ASSERT_TRANSACTION_LOCAL_DM_END(&trans, , ME, "%s: trans apply failed setting MLDUnit=%d",
-                                    pAP->alias, newMldUnit);
-
-    SAH_TRACEZ_OUT(ME);
-}
