+/* Disable11be: removes BSS from MLD so that cfgFile's existing
+ * "if no MLO, then no 11BE" block writes disable_11be=1.
+ * SavedMLDUnit11be is a persistent companion param (sentinel -2 = not saved)
+ * that preserves the original mldUnit value across reboots. */
+static void s_setDisable11be_pwf(void* priv _UNUSED, amxd_object_t* object,
+                                  amxd_param_t* param _UNUSED,
+                                  const amxc_var_t* const newValue) {
+    SAH_TRACEZ_IN(ME);
+
+    T_AccessPoint* pAP = wld_ap_fromObj(object);
+    ASSERT_NOT_NULL(pAP, , ME, "INVALID");
+
+    bool disable = amxc_var_dyncast(bool, newValue);
+
+    if(!pAP->pSSID) {
+        SAH_TRACEZ_ERROR(ME, "%s: pSSID is NULL - cannot change MLDUnit", pAP->alias);
+        SAH_TRACEZ_OUT(ME);
+        return;
+    }
+
+    if(!pAP->pSSID->pBus) {
+        SAH_TRACEZ_ERROR(ME, "%s: pSSID->pBus is NULL - cannot update DM MLDUnit", pAP->alias);
+        SAH_TRACEZ_OUT(ME);
+        return;
+    }
+
+    amxc_var_t dmVar;
+    amxc_var_init(&dmVar);
+    amxd_param_get_value(amxd_object_get_param_def(object, "SavedMLDUnit11be"), &dmVar);
+    int32_t savedInDM = amxc_var_dyncast(int32_t, &dmVar);
+    amxc_var_clean(&dmVar);
+
+    if(disable) {
+        if(savedInDM != -2) {
+            /* On-boot re-invocation: SavedMLDUnit11be already persisted from
+             * before the reboot - do not overwrite it. */
+            SAH_TRACEZ_INFO(ME, "%s: Disable11be=1 on-boot: SavedMLDUnit11be=%d persisted",
+                            pAP->alias, savedInDM);
+            if(pAP->pSSID->mldUnit >= 0) {
+                amxd_trans_t trans;
+                ASSERT_TRANSACTION_INIT(pAP->pSSID->pBus, &trans, , ME,
+                                        "%s: trans init failed", pAP->alias);
+                amxd_trans_set_value(int32_t, &trans, "MLDUnit", -1);
+                ASSERT_TRANSACTION_LOCAL_DM_END(&trans, , ME,
+                                                "%s: trans failed MLDUnit=-1", pAP->alias);
+            }
+            SAH_TRACEZ_OUT(ME);
+            return;
+        }
+        /* First-time disable: save current mldUnit (including -1 for SLO). */
+        int32_t curMldUnit = pAP->pSSID->mldUnit;
+        pAP->savedMldUnit11be = curMldUnit;
+        SAH_TRACEZ_INFO(ME, "%s: Disable11be=1 saving mldUnit=%d to SavedMLDUnit11be",
+                        pAP->alias, curMldUnit);
+        amxd_trans_t apTrans;
+        ASSERT_TRANSACTION_INIT(object, &apTrans, , ME, "%s: AP trans init failed", pAP->alias);
+        amxd_trans_set_value(int32_t, &apTrans, "SavedMLDUnit11be", curMldUnit);
+        ASSERT_TRANSACTION_LOCAL_DM_END(&apTrans, , ME,
+                                        "%s: AP trans failed SavedMLDUnit11be=%d",
+                                        pAP->alias, curMldUnit);
+        if(curMldUnit >= 0) {
+            amxd_trans_t ssiTrans;
+            ASSERT_TRANSACTION_INIT(pAP->pSSID->pBus, &ssiTrans, , ME,
+                                    "%s: SSID trans init failed", pAP->alias);
+            amxd_trans_set_value(int32_t, &ssiTrans, "MLDUnit", -1);
+            ASSERT_TRANSACTION_LOCAL_DM_END(&ssiTrans, , ME,
+                                            "%s: SSID trans failed MLDUnit=-1", pAP->alias);
+        }
+    } else {
+        if(savedInDM == -2) {
+            SAH_TRACEZ_INFO(ME, "%s: Disable11be=0 no saved mldUnit - nothing to restore",
+                            pAP->alias);
+            SAH_TRACEZ_OUT(ME);
+            return;
+        }
+        SAH_TRACEZ_INFO(ME, "%s: Disable11be=0 restoring SSID.MLDUnit=%d",
+                        pAP->alias, savedInDM);
+        pAP->savedMldUnit11be = -2;
+        amxd_trans_t apTrans;
+        ASSERT_TRANSACTION_INIT(object, &apTrans, , ME, "%s: AP trans init failed", pAP->alias);
+        amxd_trans_set_value(int32_t, &apTrans, "SavedMLDUnit11be", -2);
+        ASSERT_TRANSACTION_LOCAL_DM_END(&apTrans, , ME,
+                                        "%s: AP trans failed resetting SavedMLDUnit11be",
+                                        pAP->alias);
+        amxd_trans_t ssiTrans;
+        ASSERT_TRANSACTION_INIT(pAP->pSSID->pBus, &ssiTrans, , ME,
+                                "%s: SSID trans init failed", pAP->alias);
+        amxd_trans_set_value(int32_t, &ssiTrans, "MLDUnit", savedInDM);
+        ASSERT_TRANSACTION_LOCAL_DM_END(&ssiTrans, , ME,
+                                        "%s: SSID trans failed MLDUnit=%d",
+                                        pAP->alias, savedInDM);
+    }
+
+    SAH_TRACEZ_OUT(ME);
+}
+
+static void s_setDisable11ax_pwf(void* priv _UNUSED, amxd_object_t* object,
+                                  amxd_param_t* param _UNUSED,
+                                  const amxc_var_t* const newValue) {
+    SAH_TRACEZ_IN(ME);
+
+    T_AccessPoint* pAP = wld_ap_fromObj(object);
+    ASSERT_NOT_NULL(pAP, , ME, "INVALID");
+
+    bool disable = amxc_var_dyncast(bool, newValue);
+
+    if(!pAP->pSSID) {
+        SAH_TRACEZ_ERROR(ME, "%s: pSSID is NULL - cannot change MLDUnit", pAP->alias);
+        SAH_TRACEZ_OUT(ME);
+        return;
+    }
+
+    if(!pAP->pSSID->pBus) {
+        SAH_TRACEZ_ERROR(ME, "%s: pSSID->pBus is NULL - cannot update DM MLDUnit", pAP->alias);
+        SAH_TRACEZ_OUT(ME);
+        return;
+    }
+
+    if(disable && pAP->pRadio->operatingFrequencyBand == SWL_FREQ_BAND_EXT_6GHZ) {
+        SAH_TRACEZ_WARNING(ME, "%s: Disable11ax=1 ignored on 6GHz BSS "
+                           "(6GHz requires 11ax as minimum standard)", pAP->alias);
+        SAH_TRACEZ_OUT(ME);
+        return;
+    }
+
+    amxc_var_t dmVar;
+    amxc_var_init(&dmVar);
+    amxd_param_get_value(amxd_object_get_param_def(object, "SavedMLDUnit11ax"), &dmVar);
+    int32_t savedInDM = amxc_var_dyncast(int32_t, &dmVar);
+    amxc_var_clean(&dmVar);
+
+    if(disable) {
+        pAP->disable11ax = true;
+        if(savedInDM != -2) {
+            SAH_TRACEZ_INFO(ME, "%s: Disable11ax=1 on-boot: SavedMLDUnit11ax=%d persisted",
+                            pAP->alias, savedInDM);
+            if(pAP->pSSID->mldUnit >= 0) {
+                amxd_trans_t trans;
+                ASSERT_TRANSACTION_INIT(pAP->pSSID->pBus, &trans, , ME,
+                                        "%s: trans init failed", pAP->alias);
+                amxd_trans_set_value(int32_t, &trans, "MLDUnit", -1);
+                ASSERT_TRANSACTION_LOCAL_DM_END(&trans, , ME,
+                                                "%s: trans failed MLDUnit=-1", pAP->alias);
+            } else {
+                wld_ap_doSync(pAP);
+            }
+            SAH_TRACEZ_OUT(ME);
+            return;
+        }
+        int32_t curMldUnit = pAP->pSSID->mldUnit;
+        pAP->savedMldUnit11ax = curMldUnit;
+        SAH_TRACEZ_INFO(ME, "%s: Disable11ax=1 saving mldUnit=%d to SavedMLDUnit11ax",
+                        pAP->alias, curMldUnit);
+        amxd_trans_t apTrans;
+        ASSERT_TRANSACTION_INIT(object, &apTrans, , ME, "%s: AP trans init failed", pAP->alias);
+        amxd_trans_set_value(int32_t, &apTrans, "SavedMLDUnit11ax", curMldUnit);
+        ASSERT_TRANSACTION_LOCAL_DM_END(&apTrans, , ME,
+                                        "%s: AP trans failed SavedMLDUnit11ax=%d",
+                                        pAP->alias, curMldUnit);
+        if(curMldUnit >= 0) {
+            amxd_trans_t ssiTrans;
+            ASSERT_TRANSACTION_INIT(pAP->pSSID->pBus, &ssiTrans, , ME,
+                                    "%s: SSID trans init failed", pAP->alias);
+            amxd_trans_set_value(int32_t, &ssiTrans, "MLDUnit", -1);
+            ASSERT_TRANSACTION_LOCAL_DM_END(&ssiTrans, , ME,
+                                            "%s: SSID trans failed MLDUnit=-1", pAP->alias);
+        } else {
+            wld_ap_doSync(pAP);
+        }
+    } else {
+        pAP->disable11ax = false;
+        if(savedInDM == -2) {
+            SAH_TRACEZ_INFO(ME, "%s: Disable11ax=0 no saved mldUnit - clearing disable_11ax flag",
+                            pAP->alias);
+            wld_ap_doSync(pAP);
+            SAH_TRACEZ_OUT(ME);
+            return;
+        }
+        SAH_TRACEZ_INFO(ME, "%s: Disable11ax=0 restoring SSID.MLDUnit=%d",
+                        pAP->alias, savedInDM);
+        pAP->savedMldUnit11ax = -2;
+        amxd_trans_t apTrans;
+        ASSERT_TRANSACTION_INIT(object, &apTrans, , ME, "%s: AP trans init failed", pAP->alias);
+        amxd_trans_set_value(int32_t, &apTrans, "SavedMLDUnit11ax", -2);
+        ASSERT_TRANSACTION_LOCAL_DM_END(&apTrans, , ME,
+                                        "%s: AP trans failed resetting SavedMLDUnit11ax",
+                                        pAP->alias);
+        amxd_trans_t ssiTrans;
+        ASSERT_TRANSACTION_INIT(pAP->pSSID->pBus, &ssiTrans, , ME,
+                                "%s: SSID trans init failed", pAP->alias);
+        amxd_trans_set_value(int32_t, &ssiTrans, "MLDUnit", savedInDM);
+        ASSERT_TRANSACTION_LOCAL_DM_END(&ssiTrans, , ME,
+                                        "%s: SSID trans failed MLDUnit=%d",
+                                        pAP->alias, savedInDM);
+    }
+
+    SAH_TRACEZ_OUT(ME);
+}
+
 static void s_setMultiAPType_pwf(void* priv _UNUSED, amxd_object_t* object, amxd_param_t* param _UNUSED, const amxc_var_t* const newValue) {
