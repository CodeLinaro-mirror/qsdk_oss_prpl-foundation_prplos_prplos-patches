index 033ed55..def1234 100644
--- a/odl/wld_accesspoint.odl
+++ b/odl/wld_accesspoint.odl
@@ -376,7 +376,11 @@
 		%persistent bool Disable11be {
 			default false;
 		}

+		%persistent int32 SavedMLDUnit11be {
+			default -2;
+		}
+
 		/**
 		 * Disable IEEE 802.11ax (Wi-Fi 6 / HE) for this BSS.
 		 * Removes BSS from MLD group (saves mldUnit for restore) and writes
@@ -389,7 +393,11 @@
 		%persistent bool Disable11ax {
 			default false;
 		}

+		%persistent int32 SavedMLDUnit11ax {
+			default -2;
+		}
+
 		/**
 		 * Add MBO Assoc Disallow Reason in the MBO IE
 		 * Possible options are : "Off", "Unspecified", "MaxAssocSTA",
diff --git a/src/wld_accesspoint.c b/src/wld_accesspoint.c
index 1c47487..def5678 100644
--- a/src/wld_accesspoint.c
+++ b/src/wld_accesspoint.c
@@ -261,4 +261,6 @@ static void s_setDefaults(T_AccessPoint* pAP, T_Radio* pRad, const char* vapNam
     pAP->wpsRestartOnRequest = false;
     pAP->cfg11u.interworkingEnable = false;
     memset(pAP->cfg11u.qosMapSet, 0, QOS_MAP_SET_MAX_LEN);
+    pAP->savedMldUnit11be = -2;
+    pAP->savedMldUnit11ax = -2;
 }
@@ -1484,125 +1484,200 @@ static void s_setLegacyMode_pwf(void* priv _UNUSED, amxd_object_t* object,

-/* Disable11be: removes BSS from MLD so that
- * cfgFile's existing "if no MLO, then no 11BE" block writes disable_11be=1. */
