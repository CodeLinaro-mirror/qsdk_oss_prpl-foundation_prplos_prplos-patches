+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ */
+%define {
+	select WiFi {
+		/**
+		 * DPP TCP relay listener (127.0.0.1:8908).
+		 * Proxies raw DPP frames between a local hostapd instance (acting as
+		 * an Enrollee-proxy) and the 1905/EasyMesh Controller (acting as
+		 * Configurator). Independent of AccessPoint.{i}.DPP / EndPoint.{i}.DPP,
+		 * which only control local wpa_supplicant/hostapd DPP configurator
+		 * behaviour and the CCE beacon bit - this object never touches them.
+		 * Singleton: there is exactly one relay listener socket for the whole
+		 * device, regardless of AccessPoint count - this is not per-AP.
+		 *
+		 * @version 10.4
+		 */
+		%persistent object DPPRelay {
+			on event "*" call wld_dpp_relay_setConf_ocf;
+
+			/**
+			 * Actual switch for the DPP TCP relay listener socket. Written by
+			 * the prplMesh agent (slave_wlan_hal_whm::init_dpp_relay() /
+			 * stop_dpp_relay()) to reflect whether it currently needs the
+			 * relay running.
+			 *
+			 * Not persistent: the agent re-asserts it every time the relay
+			 * should be up, so a stale value can't survive an agent restart.
+			 */
+			bool RelayEnable {
+				default false;
+			}
+
+			/**
+			 * True while a client (hostapd) is connected to the relay.
+			 */
+			bool ClientConnected {
+				default false;
+			}
+
+			/**
+			 * Notifies a raw DPP frame reception, or a relay client
+			 * connect/disconnect transition.
+			 * - Frame received: htable with 'frame' (hex-encoded string) and
+			 *   'tcpType' (uint8) keys, no 'state' key.
+			 * - Client connect/disconnect: htable with a 'state' key set to
+			 *   "connected" or "disconnected", no 'frame'/'tcpType' keys.
+			 */
+			event 'DppFrameReceived!';
+
+			/**
+			 * Sends a raw DPP frame to the connected hostapd client.
+			 * @param tcpType the raw TCP frame type byte
+			 * @param frame hex-encoded DPP frame bytes
+			 */
+			void SendDppFrame(%in %mandatory uint8 tcpType, %in %mandatory string frame);
+		}
+	}
+}

