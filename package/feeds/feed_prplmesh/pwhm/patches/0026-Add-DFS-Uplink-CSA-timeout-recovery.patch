From e35ffac1c5c1155285373bbcbd51e5d6d8d2ab1a Mon Sep 17 00:00:00 2001
From: Abhi Teja Cholleti <achollet@qti.qualcomm.com>
Date: Thu, 16 Apr 2026 15:18:31 +0530
Subject: [PATCH 1/1] pwhm: Add DFS Uplink CSA timeout recovery

Signed-off-by: Abhi Teja Cholleti <achollet@qti.qualcomm.com>
---
 include/wld/wld_wpaCtrl_events.h   |  2 ++
 src/Plugin/wifiGen_eventHandlers.c | 33 +++++++++++++++++++++++++++++-
 src/nl80211/wld_wpaCtrl_events.c   |  9 ++++++++
 3 files changed, 43 insertions(+), 1 deletion(-)

diff --git a/include/wld/wld_wpaCtrl_events.h b/include/wld/wld_wpaCtrl_events.h
index 41e68cf..c47a6aa 100644
--- a/include/wld/wld_wpaCtrl_events.h
+++ b/include/wld/wld_wpaCtrl_events.h
@@ -226,6 +226,7 @@ typedef void (* wld_wpaCtrl_dfsRadarDetectedCb_f)(void* userData, char* ifName,
 typedef void (* wld_wpaCtrl_dfsNopFinishedCb_f)(void* userData, char* ifName, swl_chanspec_t* chanSpec);
 typedef void (* wld_wpaCtrl_dfsNewChannelCb_f)(void* userData, char* ifName, swl_chanspec_t* chanSpec);
 typedef void (* wld_wpaCtrl_uplinkCsaCb_f)(void* userData, char* ifName, char* params);
+typedef void (* wld_wpaCtrl_uplinkCsaTimeoutCb_f)(void* userData, char* ifName, char* params);
 typedef void (* wld_wpaCtrl_mainApSetupCompletedCb_f)(void* userData, char* ifName);
 typedef void (* wld_wpaCtrl_mainApDisabledCb_f)(void* userData, char* ifName);
 typedef void (* wld_wpaCtrl_syncOnReadyCb_f)(void* userData, char* ifName, bool state);
@@ -254,6 +255,7 @@ typedef struct {
     wld_wpaCtrl_dfsNopFinishedCb_f fDfsNopFinishedCb;
     wld_wpaCtrl_dfsNewChannelCb_f fDfsNewChannelCb; //fallback after dfs radar detection
     wld_wpaCtrl_uplinkCsaCb_f fUplinkCsaCb;
+    wld_wpaCtrl_uplinkCsaTimeoutCb_f fUplinkCsaTimeoutCb;
     wld_wpaCtrl_mainApSetupCompletedCb_f fMainApSetupCompletedCb;
     wld_wpaCtrl_mainApDisabledCb_f fMainApDisabledCb;
 
diff --git a/src/Plugin/wifiGen_eventHandlers.c b/src/Plugin/wifiGen_eventHandlers.c
index 079fddf..3f8ceb0 100644
--- a/src/Plugin/wifiGen_eventHandlers.c
+++ b/src/Plugin/wifiGen_eventHandlers.c
@@ -120,7 +120,8 @@ static const char* s_fwdRadioStdWpaCtrlEventsList[] = {
     "DFS-CAC-COMPLETED",
     "DFS-NOP-FINISHED"
     "DFS-NOP-FINISHED",
-    "DFS-UPLINK-CSA"
+    "DFS-UPLINK-CSA",
+    "DFS-UPLINK-CSA-TIMEOUT"
 };
 
 static void s_notifyWpaCtrlEvent(amxd_object_t* object, char* ifName, char* eventName,
@@ -541,6 +542,35 @@ static void s_uplinkCsaCb(void* userData, char* ifName _UNUSED, char* params) {
     }
 }
 
+static void s_uplinkCsaTimeoutCb(void* userData, char* ifName _UNUSED, char* params _UNUSED) {
+    T_Radio* pRad = (T_Radio*) userData;
+    ASSERT_NOT_NULL(pRad, , ME, "NULL");
+
+    // Forward DFS-UPLINK-CSA-TIMEOUT event to wpa_supplicant endpoint if connected
+    T_EndPoint* pEP = NULL;
+    wld_rad_forEachEp(pEP, pRad) {
+        if((pEP == NULL) || (pEP->wpaCtrlInterface == NULL)) {
+            continue;
+        }
+
+        if(!wld_wpaCtrlInterface_isReady(pEP->wpaCtrlInterface)) {
+            SAH_TRACEZ_WARNING(ME, "%s: wpa_supplicant interface not ready, skip forwarding UPLINK-CSA-TIMEOUT", pEP->Name);
+            continue;
+        }
+
+        // Send DISCONNECT and CONNECT command to wpa_supplicant
+        SAH_TRACEZ_ERROR(ME, "%s: UPLINK-CSA-TIMEOUT : Send DISCONNECT and RECONNECT ", pEP->Name);
+        bool ret = wld_wpaCtrl_sendCmdCheckResponse(pEP->wpaCtrlInterface, "DISCONNECT", "OK");
+        if (ret) {
+            SAH_TRACEZ_ERROR(ME, "%s: DISCONNECT command got failed for UPLINK-CSA-TIMEOUT", pEP->Name);
+        }
+
+        ret = wld_wpaCtrl_sendCmdCheckResponse(pEP->wpaCtrlInterface, "RECONNECT", "OK");
+        if (ret) {
+            SAH_TRACEZ_ERROR(ME, "%s: RECONNECT command got failed for UPLINK-CSA-TIMEOUT", pEP->Name);
+        }
+    }
+}
 
 #define SET_HDLR(tgt, src) {tgt = (tgt ? : src); }
 
@@ -567,6 +597,7 @@ static swl_rc_ne s_setWpaCtrlRadEvtHandlers(wld_wpaCtrlMngr_t* wpaCtrlMngr, T_Ra
     SET_HDLR(wpaCtrlRadEvthandlers.fDfsNewChannelCb, s_dfsNewChannelCb);
     SET_HDLR(wpaCtrlRadEvthandlers.fFetchSockLinkIface, s_fetchSockLinkIface);
     SET_HDLR(wpaCtrlRadEvthandlers.fUplinkCsaCb, s_uplinkCsaCb);
+    SET_HDLR(wpaCtrlRadEvthandlers.fUplinkCsaTimeoutCb, s_uplinkCsaTimeoutCb);
     wld_wpaCtrlMngr_setEvtHandlers(wpaCtrlMngr, pRad, &wpaCtrlRadEvthandlers);
     return SWL_RC_OK;
 }
diff --git a/src/nl80211/wld_wpaCtrl_events.c b/src/nl80211/wld_wpaCtrl_events.c
index dee7295..815a9be 100644
--- a/src/nl80211/wld_wpaCtrl_events.c
+++ b/src/nl80211/wld_wpaCtrl_events.c
@@ -531,6 +531,14 @@ static void s_uplinkCsaEvtCb(wld_wpaCtrlInterface_t* pInterface, char* event _UN
     CALL_MGR_I(pInterface, fUplinkCsaCb, params);
 }
 
+static void s_uplinkCsaTimeoutEvtCb(wld_wpaCtrlInterface_t* pInterface, char* event _UNUSED    , char* params) {
+    // Example: DFS-UPLINK-CSA-TIMEOUT
+
+    SAH_TRACEZ_ERROR(ME, "%s: uplink CSA Timeout %s ", pInterface->name, params);
+
+    CALL_MGR_I(pInterface, fUplinkCsaTimeoutCb, params);
+}
+
 static void s_apEnabledEvt(wld_wpaCtrlInterface_t* pInterface, char* event, char* params _UNUSED) {
     // Example: AP-ENABLED
     // This event notifies that hapd main interface has setup completed
@@ -891,6 +899,7 @@ SWL_TABLE(sWpaCtrlEvents,
               {"CTRL-EVENT-AUTH-REJECT", &s_stationAuthRejected},
               {"BEACON-RESP-RX", &s_beaconResponseEvt},
 	      {"DFS-UPLINK-CSA", &s_uplinkCsaEvtCb},
+	      {"DFS-UPLINK-CSA-TIMEOUT", &s_uplinkCsaTimeoutEvtCb},
               ));
 
 static evtParser_f s_getEventParser(char* eventName) {
