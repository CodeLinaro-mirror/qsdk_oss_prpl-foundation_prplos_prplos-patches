Index: pwhm-v7.21.5/src/nl80211/wld_wpaSupp_cfgFile.c
===================================================================
--- pwhm-v7.21.5.orig/src/nl80211/wld_wpaSupp_cfgFile.c
+++ pwhm-v7.21.5/src/nl80211/wld_wpaSupp_cfgFile.c
@@ -234,14 +234,16 @@ static swl_rc_ne s_setWpaSuppNetworkConf
         swl_mapChar_add(network, "pin", pEP->WPS_ClientPIN);
     }
 
-    if(!swl_str_isEmpty(epProfile->scanFrequency)) {
-        swl_mapChar_add(network, "scan_freq", epProfile->scanFrequency);
-    }
-    if(!swl_str_isEmpty(epProfile->backgroundScan)) {
-        swl_mapChar_add(network, "bgscan", epProfile->backgroundScan);
-    }
-    if(!swl_str_isEmpty(epProfile->backgroundScanFrequency)) {
-        swl_mapChar_add(network, "bgscan_freq", epProfile->backgroundScanFrequency);
+    if(pEP->connectionStatus != EPCS_CONNECTED) {
+        if(!swl_str_isEmpty(epProfile->scanFrequency)) {
+            swl_mapChar_add(network, "scan_freq", epProfile->scanFrequency);
+        }
+        if(!swl_str_isEmpty(epProfile->backgroundScan)) {
+            swl_mapChar_add(network, "bgscan", epProfile->backgroundScan);
+        }
+        if(!swl_str_isEmpty(epProfile->backgroundScanFrequency)) {
+            swl_mapChar_add(network, "bgscan_freq", epProfile->backgroundScanFrequency);
+        }
     }
 
     swl_security_mfpMode_e mfp = swl_security_getTargetMfpMode(epProfile->secModeEnabled, epProfile->mfpConfig);
