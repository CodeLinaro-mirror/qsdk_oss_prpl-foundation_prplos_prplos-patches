+            swl_str_copy(pProfile->backgroundScanFrequency, sizeof(pProfile->backgroundScanFrequency), backgroundScanFrequency);
+        }
+        free(backgroundScanFrequency);
     }
-    free(backgroundScanFrequency);
 
