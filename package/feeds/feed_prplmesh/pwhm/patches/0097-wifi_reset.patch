+/*
+ * s_doReset() stops/reconfigures every radio and can legitimately take
+ * longer than ubus's client-side call timeout, especially on EP/repeater
+ * radios where it races the driver's own async vdev/MLO-peer teardown and
+ * recreate (ath12k) -- seen as repeated "Failed to set wiphy params" while
+ * the forced full FSM resync retries. Running it inline in _Reset() made the
+ * RPC caller (ubus-cli) hit a hard timeout (status 27) even though pwhm was
+ * still working correctly.
+ *
+ * Fix: _Reset() only *accepts* the request and replies immediately; the
+ * actual work runs afterwards, decoupled from the RPC, via a zero-delay
+ * timer. No caller ever waits on s_doReset() to finish, so its duration can
+ * no longer surface as a client-side ubus timeout.
+ */
+static void s_resetTimer_cb(amxp_timer_t* timer, void* priv _UNUSED) {
+    amxp_timer_delete(&timer);
+    s_doReset();
+}

