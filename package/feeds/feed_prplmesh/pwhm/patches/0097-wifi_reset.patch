-            pAP->enable = 0;
-            if(pAP->pSSID) {
-                pAP->pSSID->enable = 0;
-            }
+        if(s_resetRadioCount >= WLD_RESET_MAX_RADIOS) {
+            SAH_TRACEZ_ERROR(ME, "%s: too many radios for reset chain, skipping", tmpRad->Name);
+            continue;
         }
+        s_resetRadios[s_resetRadioCount++] = tmpRad;
+    }

-        /*
-         * Remove EventCounter instances so the ODL parser can re-create
-         * them cleanly. Leaving them causes duplicate-key transaction
-         * failures in wld_rad_init_counters() after the ODL reload.
