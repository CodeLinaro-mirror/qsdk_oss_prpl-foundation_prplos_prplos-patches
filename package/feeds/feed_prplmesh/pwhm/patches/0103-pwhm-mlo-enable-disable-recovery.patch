+/* A missing WLD control client does not mean that hostapd removed the link.
+ * Reconnect only the kernel-verified BSS before applying an MLO disable. */
+static swl_rc_ne s_reconnectMloApForDisable(T_AccessPoint* pAP) {
+    wld_nl80211_ifaceInfo_t info;
+    swl_rc_ne rc = wld_ap_nl80211_getInterfaceInfo(pAP, &info);
+    if(!swl_rc_isOk(rc)) {
+        return rc;
+    }
+    const wld_nl80211_ifaceMloLinkInfo_t* link =
+        wld_nl80211_fetchIfaceMloLinkByFreqBand(&info, pAP->pRadio->operatingFrequencyBand);
+    ASSERT_TRUE(info.isAp && (link != NULL) && (link->link.linkId >= 0) &&
+                (link->chanSpec.ctrlFreq != 0) &&
+                swl_typeMacBin_equals(link->link.linkMac, *wld_ssid_getLinkMac(pAP->pSSID)),
+                SWL_RC_INVALID_STATE, ME, "%s: cannot verify MLO link for disable", pAP->alias);
+    char sockName[128];
+    snprintf(sockName, sizeof(sockName), "%s_link%d", info.name, link->link.linkId);
+    wld_wpaCtrlInterface_t* ctrl = pAP->wpaCtrlInterface;
+    bool enabled = wld_wpaCtrlInterface_isEnabled(ctrl);
+    if(!wld_wpaCtrlInterface_setConnectionInfo(ctrl, pAP->pRadio->hostapd->ctrlIfaceDir, sockName)) {
+        return SWL_RC_ERROR;
+    }
+    wld_wpaCtrlInterface_setEnable(ctrl, true);
+    bool ready = wld_wpaCtrlInterface_open(ctrl);
+    wld_wpaCtrlInterface_setEnable(ctrl, enabled);
+    char runIface[128] = {0};
+    int32_t linkId = NO_LINK_ID;
+    if(!ready || !swl_rc_isOk(wld_ap_hostapd_getRunIface(pAP, runIface, sizeof(runIface))) ||
+       !swl_str_matches(runIface, info.name) ||
+       !swl_rc_isOk(wld_ap_hostapd_getMldLinkId(pAP, &linkId)) || (linkId != link->link.linkId)) {
+        wld_wpaCtrlInterface_close(ctrl);
+        return SWL_RC_ERROR;
+    }
+    SAH_TRACEZ_WARNING(ME, "%s: recovered %s for pending disable", pAP->alias, sockName);
+    return SWL_RC_OK;
 }
 
