+/* A removed primary can still name the kernel MLD netdev while a sibling
+ * carries its remaining link. Identify that netdev by a live enabled link,
+ * not by cached link IDs or a control socket that may now serve the sibling.
+ * A migration must continue through its own teardown/rebuild path. */
+bool wifiGen_mld_getRunningApMldInfo(T_SSID* pSSID, wld_nl80211_ifaceInfo_t* pInfo) {
+    ASSERTS_NOT_NULL(pSSID, false, ME, "NULL");
+    ASSERTS_NOT_NULL(pSSID->pMldLink, false, ME, "NULL");
+    ASSERTS_NOT_NULL(pInfo, false, ME, "NULL");
+    wld_mld_t* pMld = pSSID->pMldLink->pMld;
+    if((pMld == NULL) || (pSSID->mldUnit != pMld->unit) ||
+       pMld->hostapdRebuildPending ||
+       (pMld->pPendingMovedLink != NULL)) {
+        return false;
+    }
+    wld_mldLink_t* pLink = NULL;
+    wld_for_eachNeighMldLink(pLink, pSSID->pMldLink) {
+        T_SSID* pPeerSSID = wld_mld_getLinkSsid(pLink);
+        T_AccessPoint* pPeer = (pPeerSSID != NULL) ? pPeerSSID->AP_HOOK : NULL;
+        if((pPeer == NULL) || (pPeer->pRadio == NULL) ||
+           (pPeerSSID->mldUnit != pMld->unit) || !wld_ap_isEnabledWithRef(pPeer)) {
+            continue;
+        }
+        wld_nl80211_ifaceInfo_t info;
+        memset(&info, 0, sizeof(info));
+        if(!swl_rc_isOk(wld_ap_nl80211_getInterfaceInfo(pPeer, &info)) || !info.isAp) {
+            continue;
+        }
+        T_SSID* pAnchor = wld_ssid_getSsidByIfName(info.name);
+        if((pAnchor == NULL) || (pAnchor->AP_HOOK == NULL) ||
+           (pAnchor->pMldLink == NULL) || (pAnchor->pMldLink->pMld != pMld) ||
+           (pAnchor->mldUnit != pMld->unit)) {
+            continue;
+        }
+        const wld_nl80211_ifaceMloLinkInfo_t* pPeerInfo =
+            wld_nl80211_fetchIfaceMloLinkByFreqBand(&info, pPeer->pRadio->operatingFrequencyBand);
+        if((pPeerInfo == NULL) || (pPeerInfo->link.linkId < 0) ||
+           (pPeerInfo->chanSpec.ctrlFreq == 0) ||
+           !swl_typeMacBin_equals(pPeerInfo->link.linkMac, *wld_ssid_getLinkMac(pPeerSSID))) {
+            continue;
+        }
+        /* A full process/radio-config start can recreate this MLD without
+         * ADD_LINK, which used to be the only path clearing hostapdRemoved.
+         * A matching live kernel link supersedes that historical marker.
+         * Do not clear it on lookup failure or during a pending migration. */
+        if(pMld->hostapdRemoved) {
+            SAH_TRACEZ_WARNING(ME, "%s: MLD unit %d is live on %s; clear stale removal state",
+                               pSSID->Name, pMld->unit, info.name);
+            pMld->hostapdRemoved = false;
+        }
+        *pInfo = info;
+        return true;
+    }
+    return false;
+}
+
 static T_SSID* s_getRunningMldAnchorSSID(T_SSID* pSSID) {
     ASSERTS_NOT_NULL(pSSID, NULL, ME, "NULL");
     ASSERTS_NOT_NULL(pSSID->pMldLink, NULL, ME, "NULL");
+
+    wld_nl80211_ifaceInfo_t info;
+    if(wifiGen_mld_getRunningApMldInfo(pSSID, &info)) {
+        return wld_ssid_getSsidByIfName(info.name);
+    }
 
     wld_mldLink_t* pLink = NULL;
     wld_for_eachNeighMldLink(pLink, pSSID->pMldLink) {
