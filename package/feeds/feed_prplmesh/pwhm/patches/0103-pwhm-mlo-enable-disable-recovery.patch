 static void s_refreshBkhChspec(T_Radio* pRad);
+/* The returning radio is stopped, but its MLD can still run on another
+ * band under the original primary's alias. Never reconfigure that sibling
+ * through the returning AP's retained group control socket. */
+static bool s_isStoppedMloLinkRejoining(T_AccessPoint* pAP) {
+    T_SSID* pSSID = pAP->pSSID;
+    if((pSSID == NULL) || (pSSID->pMldLink == NULL) ||
+       !wld_ap_isEnabledWithRef(pAP) || wifiGen_hapd_isStarted(pAP->pRadio) ||
+       !wld_mld_isLinkUsable(pSSID->pMldLink) || s_hasMovedMloAnchor(pAP)) {
+        return false;
+    }
+    wld_nl80211_ifaceInfo_t info;
+    return wifiGen_mld_getRunningApMldInfo(pSSID, &info) &&
+           (wld_nl80211_fetchIfaceMloLinkByFreqBand(&info, pAP->pRadio->operatingFrequencyBand) == NULL);
+}
+
+static bool s_isStoppedMloRadioRejoining(T_Radio* pRad) {
+    if(wifiGen_hapd_isStarted(pRad) || !s_isLinkRemoveSupported(pRad)) {
+        return false;
+    }
+    bool hasRetainedMld = false;
+    bool hasMissingLink = false;
+    T_AccessPoint* pAP = NULL;
+    wld_rad_forEachAp(pAP, pRad) {
+        if(!wld_ap_isEnabledWithRef(pAP)) {
+            continue;
+        }
+        T_SSID* pSSID = pAP->pSSID;
+        wld_mld_t* pMld = ((pSSID != NULL) && (pSSID->pMldLink != NULL)) ? pSSID->pMldLink->pMld : NULL;
+        if((pMld == NULL) || (pSSID->mldUnit != pMld->unit) ||
+           !wld_mld_isLinkUsable(pSSID->pMldLink) ||
+           pMld->hostapdRebuildPending ||
+           (pMld->pPendingMovedLink != NULL) || s_hasMovedMloAnchor(pAP)) {
+            return false;
+        }
+        wld_nl80211_ifaceInfo_t info;
+        bool hasRunningMld = wifiGen_mld_getRunningApMldInfo(pSSID, &info);
+        hasRetainedMld |= hasRunningMld;
+        hasMissingLink |= !hasRunningMld ||
+                          (wld_nl80211_fetchIfaceMloLinkByFreqBand(&info, pRad->operatingFrequencyBand) == NULL);
+    }
+    /* Mixed existing/missing MLD BSSs must also use per-BSS ADD: the existing
+     * ADD_LINK identity check skips live links without a duplicate ADD.
+     * Cold startup, all-present reconfiguration and migration stay unchanged. */
+    return hasRetainedMld && hasMissingLink;
+}
