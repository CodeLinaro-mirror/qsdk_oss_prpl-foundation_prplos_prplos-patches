+static wld_wpaCtrlInterface_t* s_rad_reg_getFhLinkIface(T_Radio* pRad) {
+    T_AccessPoint* pAP = NULL;
+    wld_rad_forEachAp(pAP, pRad) {
+        if (!pAP->pSSID || pAP->pSSID->mldLinkId < 0 || !pAP->pSSID->pMldLink) continue;
+        int8_t linkId = (int8_t)pAP->pSSID->mldLinkId;
+        T_SSID* pLinkSsid = wld_mld_getLinkSsidByLinkId(pAP->pSSID->pMldLink, linkId);
+        if (!pLinkSsid || !pLinkSsid->AP_HOOK) continue;
+        wld_wpaCtrlInterface_t* pIface = pLinkSsid->AP_HOOK->wpaCtrlInterface;
+        if (pIface && wld_wpaCtrlInterface_isReady(pIface)) return pIface;
+    }
+    return NULL;
+}
+
+static swl_rc_ne s_rad_reg_sendToRadio(T_Radio* pRad, const char* cmd) {
+    wld_wpaCtrlInterface_t* pIface = s_rad_reg_getFhLinkIface(pRad);
+    if (pIface) {
+        char reply[64] = {0};
+        wld_wpaCtrl_sendCmdFmtGetResponse(pIface, reply, sizeof(reply), "%s", cmd);
+        if (strstr(reply, "OK")) return SWL_RC_OK;
+    }
+    T_AccessPoint* pAP = NULL;
+    wld_rad_forEachAp(pAP, pRad) {
+        if (!wld_wpaCtrlInterface_isReady(pAP->wpaCtrlInterface)) continue;
+        if (wld_wpaCtrl_sendCmdCheckResponse(pAP->wpaCtrlInterface, (char*)cmd, "OK"))
+            return SWL_RC_OK;
+    }
+    return SWL_RC_ERROR;
+}
+
+static swl_rc_ne s_rad_reg_getFromRadio(T_Radio* pRad, const char* cmd,
+                                          char* reply, size_t sz) {
+    wld_wpaCtrlInterface_t* pIface = s_rad_reg_getFhLinkIface(pRad);
+    if (pIface && wld_wpaCtrl_sendCmdFmtGetResponse(pIface, reply, sz, "%s", cmd) == SWL_RC_OK)
+        return SWL_RC_OK;
+    T_AccessPoint* pAP = NULL;
+    wld_rad_forEachAp(pAP, pRad) {
+        if (!wld_wpaCtrlInterface_isReady(pAP->wpaCtrlInterface)) continue;
+        if (wld_wpaCtrl_sendCmdFmtGetResponse(pAP->wpaCtrlInterface, reply, sz,
+                                               "%s", cmd) == SWL_RC_OK)
+            return SWL_RC_OK;
+    }
+    return SWL_RC_ERROR;
+}
+
+swl_rc_ne wifiGen_rad_setEhtConfigCcfs0(T_Radio* pRad, int32_t value) {
+    char cmd[64]; snprintf(cmd, sizeof(cmd), "SET_EHT_CONFIG_CCFS0 %d", value);
+    return s_rad_reg_sendToRadio(pRad, cmd);
+}
+swl_rc_ne wifiGen_rad_getEhtConfigCcfs0(T_Radio* pRad, int32_t* value) {
+    char reply[64] = {0};
+    swl_rc_ne rc = s_rad_reg_getFromRadio(pRad, "GET_EHT_CONFIG_CCFS0", reply, sizeof(reply));
+    if ((rc == SWL_RC_OK) && value) { *value = atoi(reply); }
+    return rc;
+}
+swl_rc_ne wifiGen_rad_setTpeCommonPsd(T_Radio* pRad, int32_t value) {
+    char cmd[64]; snprintf(cmd, sizeof(cmd), "SET_TPE_COMMON_PSD %d", value);
+    return s_rad_reg_sendToRadio(pRad, cmd);
+}
+swl_rc_ne wifiGen_rad_getTpeCommonPsd(T_Radio* pRad, int32_t* value) {
+    char reply[64] = {0};
+    swl_rc_ne rc = s_rad_reg_getFromRadio(pRad, "GET_TPE_COMMON_PSD", reply, sizeof(reply));
+    if ((rc == SWL_RC_OK) && value) {
+        const char* p = strstr(reply, "tpe_common_psd");
+        *value = p ? atoi(p + 15) : atoi(reply);
+    }
+    return rc;
+}
+swl_rc_ne wifiGen_rad_setTpePwrUnit(T_Radio* pRad, int32_t value) {
+    char cmd[64]; snprintf(cmd, sizeof(cmd), "SET_TPE_TX_PWR_INTERP %d", value);
+    return s_rad_reg_sendToRadio(pRad, cmd);
+}
+swl_rc_ne wifiGen_rad_getTpePwrUnit(T_Radio* pRad, int32_t* value) {
+    char reply[64] = {0};
+    swl_rc_ne rc = s_rad_reg_getFromRadio(pRad, "GET_TPE_TX_PWR_INTERP", reply, sizeof(reply));
+    if ((rc == SWL_RC_OK) && value) {
+        const char* p = strstr(reply, "tpe_tx_pwr_interp");
+        *value = p ? atoi(p + 18) : atoi(reply);
+    }
+    return rc;
+}
+swl_rc_ne wifiGen_rad_setTpePunctChannelTxPwr(T_Radio* pRad, int32_t value) {
+    char cmd[64]; snprintf(cmd, sizeof(cmd), "SET_TPE_PUNCT_CHANNEL_TX_PWR %d", value);
+    return s_rad_reg_sendToRadio(pRad, cmd);
+}
+swl_rc_ne wifiGen_rad_getTpePunctChannelTxPwr(T_Radio* pRad, int32_t* value) {
+    char reply[64] = {0};
+    swl_rc_ne rc = s_rad_reg_getFromRadio(pRad, "GET_TPE_PUNCT_CHANNEL_TX_PWR", reply, sizeof(reply));
+    if ((rc == SWL_RC_OK) && value) {
+        const char* p = strstr(reply, "tpe_punct_channel_tx_pwr");
+        *value = p ? atoi(p + 25) : atoi(reply);
+    }
+    return rc;
+}
+swl_rc_ne wifiGen_rad_setLpiAntennaOptimize(T_Radio* pRad, bool optimize) {
+    /* dis_lpi_ant_optimize: NL vendor VAP cmd requiring MLO_LINK_ID.
+     * Send via the primary MLD AP (wlan2.1, wDevId=0x4) with link_id=mldLinkId.
+     * Use wld_ap_nl80211_sendVendorSubCmdAttr on the AP with mldLinkId>=0. */
+    T_AccessPoint* pAP = NULL;
+    wld_rad_forEachAp(pAP, pRad) {
+        if (!pAP->pSSID || pAP->pSSID->mldLinkId < 0 || !pAP->pSSID->pMldLink) continue;
+        int8_t linkId = (int8_t)pAP->pSSID->mldLinkId;
+        uint32_t dis = optimize ? 0u : 1u;
+        /* Build vendor data: subcmd 74, param 62, value */
+        NL_ATTR_NESTED(_vdata, NL80211_ATTR_VENDOR_DATA);
+        uint32_t _c = 200u, _p = 62u, _v = dis;
+        NL_ATTRS_SET(&_vdata.data.attribs, ARR(
+            NL_ATTR_VAL(17, _c),
+            NL_ATTR_VAL(18, _p),
+            NL_ATTR_VAL(19, _v)));
+        /* Add MLO_LINK_ID */
+        NL_ATTRS_ADD(&_vdata.data.attribs, NL_ATTR_VAL(NL80211_ATTR_MLO_LINK_ID, linkId));
+        /* Send via primary link AP (which has correct wDevId for wlan2.1) */
+        T_SSID* pPrimSsid = wld_mld_getPrimaryLinkSsid(pAP->pSSID->pMldLink);
+        T_AccessPoint* pPrimAP = (pPrimSsid && pPrimSsid->AP_HOOK) ? pPrimSsid->AP_HOOK : pAP;
+        swl_rc_ne rc = wld_ap_nl80211_sendVendorSubCmdAttr(pPrimAP, 0x001374u, 74,
+            &_vdata, true, true, 0u, NULL, NULL);
+        wld_nl80211_cleanNlAttr(&_vdata);
+        return rc;
+    }
+    return SWL_RC_ERROR;
+}
+swl_rc_ne wifiGen_rad_getLpiAntennaOptimize(T_Radio* pRad _UNUSED, bool* value) {
+    if (value) { *value = true; }
+    return SWL_RC_NOT_IMPLEMENTED;
+}
+
+/* Regulatory Tx power NL vendor cmd (OUI=0x001374, SET=subcmd 505, GET=subcmd 506)
+ * Driver radio_idx matches SWL_FREQ_BAND enum: 2.4GHz=0, 5GHz=1, 6GHz=2
+ * pRad->operatingFrequencyBand gives the correct value directly.
+ */
+static uint8_t s_rad_reg_getDriverRadioIdx(T_Radio* pRad) {
+    return (uint8_t)pRad->operatingFrequencyBand;
+}
+
+#define G2_SET(paramId, val) do { \
+    uint32_t _cmd = 200u, _pid = (uint32_t)(paramId), _val = (uint32_t)(val); \
+    uint8_t _ridx = s_rad_reg_getDriverRadioIdx(pRad); \
+    NL_ATTR_NESTED(_vendorData, NL80211_ATTR_VENDOR_DATA); \
+    NL_ATTRS_SET(&_vendorData.data.attribs, ARR( \
+        NL_ATTR_VAL(17, _cmd), \
+        NL_ATTR_VAL(18, _pid), \
+        NL_ATTR_VAL(19, _val), \
+        NL_ATTR_VAL(150, _ridx))); \
+    swl_rc_ne _rc = wld_rad_nl80211_sendVendorSubCmdAttr(pRad, 0x001374u, 505, &_vendorData, true, true, 0u, NULL, NULL); \
+    wld_nl80211_cleanNlAttr(&_vendorData); \
+    return _rc; \
+} while(0)
+
+#define G2_GET(paramId) do { \
+    uint32_t _cmd = 200u, _pid = (uint32_t)(paramId); \
+    uint8_t _ridx = s_rad_reg_getDriverRadioIdx(pRad); \
+    NL_ATTR_NESTED(_vendorData, NL80211_ATTR_VENDOR_DATA); \
+    NL_ATTRS_SET(&_vendorData.data.attribs, ARR( \
+        NL_ATTR_VAL(17, _cmd), \
+        NL_ATTR_VAL(18, _pid), \
+        NL_ATTR_VAL(150, _ridx))); \
+    swl_rc_ne _rc = wld_rad_nl80211_sendVendorSubCmdAttr(pRad, 0x001374u, 506, &_vendorData, true, false, 0u, NULL, NULL); \
+    wld_nl80211_cleanNlAttr(&_vendorData); \
+    return _rc; \
+} while(0)
+
+
+swl_rc_ne wifiGen_rad_setCtlPowerScale(T_Radio* pRad, int32_t value) { G2_SET(76, value); }
+swl_rc_ne wifiGen_rad_getCtlPowerScale(T_Radio* pRad, int32_t* value) { _UNUSED_(value); G2_GET(76); }
+swl_rc_ne wifiGen_rad_setChannel144Enable(T_Radio* pRad, bool value) { G2_SET(77, value ? 1u : 0u); }
+swl_rc_ne wifiGen_rad_getChannel144Enable(T_Radio* pRad, bool* value) { _UNUSED_(value); G2_GET(77); }
+swl_rc_ne wifiGen_rad_setTxPowerScale(T_Radio* pRad, int32_t value) { G2_SET(43, value); }
+swl_rc_ne wifiGen_rad_getTxPowerScale(T_Radio* pRad, int32_t* value) { _UNUSED_(value); G2_GET(43); }
+swl_rc_ne wifiGen_rad_setTxPowerLimit2G(T_Radio* pRad, int32_t value) { G2_SET(38, value); }
