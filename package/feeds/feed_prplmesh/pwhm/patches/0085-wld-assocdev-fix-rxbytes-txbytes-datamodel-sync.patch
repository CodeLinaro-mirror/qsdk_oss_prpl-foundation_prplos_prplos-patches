From 3c582ae652f99e2f097a4da811e1d33969c7e963 Mon Sep 17 00:00:00 2001
From: deepaku <deepaku@qti.qualcomm.com>
Date: Mon, 12 Oct 2026 18:52:22 +0530
Subject: [PATCH] pwhm: fix for tx/rx byte for airties reduce polling time

Signed-off-by: deepaku <deepaku@qti.qualcomm.com>

--- a/include/wld/wld_assocdev.h
+++ b/include/wld/wld_assocdev.h
@@ -70,6 +70,14 @@
 #include "swl/swl_ieee802_1x_defs.h"
 #include "swl/swl_genericFrameParser.h"
 
+/*
+ * lowest period (ms) since last nl80211 refresh of an AssociatedDevice's info,
+ * to avoid too frequent low level requests. Also used as the per-object
+ * override of the swla datamodel read-throttle (see wld_ad_create_associatedDevice)
+ * so periodic ~1s stats polling never gets skipped by the generic 1000ms default.
+ */
+#define MIN_AD_INFO_REFRESH_PERIOD_MS 250
+
 typedef struct {
     T_Radio* pRad;
     T_AccessPoint* pAP;
--- a/src/wld_assocdev.c
+++ b/src/wld_assocdev.c
@@ -517,6 +517,14 @@
     }
     wld_extMod_initDataList(&pAD->extDataList);
 
+    /*
+     * override the generic 1000ms swla read-throttle (DEFAULT_REFRESH_PERIOD_MS)
+     * for this object only, so periodic ~1s datamodel polling (e.g. throughput
+     * test harnesses) always gets a nl80211-fresh sample instead of occasionally
+     * hitting the throttle and returning a stale/duplicate RxBytes/TxBytes value.
+     */
+    pAD->onActionReadCtx.minRefreshPeriodMs = MIN_AD_INFO_REFRESH_PERIOD_MS;
+
     swl_timeMono_t timeNow = swl_time_getMonoSec();
 
     memcpy(pAD->MACAddress, macAddress->bMac, ETHER_ADDR_LEN);
--- a/src/Plugin/wifiGen_vap.c
+++ b/src/Plugin/wifiGen_vap.c
@@ -324,16 +324,20 @@
         } else if(pStationInfo->flags.authenticated == SWL_TRL_TRUE) {
             wld_ad_add_connection_try(pAP, pAD);
         }
+        /*
+         * s_fillAssocDevInfo() only refreshes the in-memory stats (and
+         * pAD->lastSampleTime). Without this sync, the datamodel stats
+         * (e.g. RxBytes/TxBytes) stay frozen at their last synced value,
+         * while this refreshed lastSampleTime still blocks the on-demand
+         * single-station path (s_isStationInfoOld()) from ever running
+         * long enough to sync them itself.
+         */
+        wld_ad_syncStats(pAD);
     }
     free(pAllStaInfo);
     return nrStations;
 }
 
-/*
- * lowest period since last refresh of assoc dev info in ms
- * to avoid too frequent low level requests
- */
-#define MIN_AD_INFO_REFRESH_PERIOD_MS 500
 static bool s_isStationInfoOld(T_AssociatedDevice* pAD) {
     ASSERTS_NOT_NULL(pAD, false, ME, "NULL");
     swl_timeSpecMono_t now = swl_timespec_getMonoVal();
