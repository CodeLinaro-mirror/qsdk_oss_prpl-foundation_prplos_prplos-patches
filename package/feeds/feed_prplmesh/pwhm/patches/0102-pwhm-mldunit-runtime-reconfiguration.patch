+/* Override only the final parameter of the generated single-BSS file. Do
+ * not parse/re-serialize credentials: their quoting and escapes must remain
+ * byte-for-byte unchanged. Remove only our exact suffix during recovery. */
+static bool s_quietMloAddConfig(const char* path, bool enable) {
+    const char suffix[] = "\n# pwhm temporary MLO link ADD\nbroadcast_deauth=0\n";
+    const size_t size = sizeof(suffix) - 1;
+    FILE* file = fopen(path, "r+");
+    ASSERT_NOT_NULL(file, false, ME, "Cannot open ADD config");
+    bool ok = false;
+    if(fseek(file, 0, SEEK_END) != 0) {
+        goto out;
+    }
+    long end = ftell(file);
+    if(end < 0) {
+        goto out;
+    }
+    bool present = false;
+    if(end >= (long) size) {
+        char tail[sizeof(suffix)];
+        if((fseek(file, end - (long) size, SEEK_SET) != 0) || (fread(tail, 1, size, file) != size)) {
+            goto out;
+        }
+        present = (memcmp(tail, suffix, size) == 0);
+    }
+    if(enable && !present) {
+        if(fseek(file, 0, SEEK_END) != 0) {
+            goto out;
+        }
+        ok = (fwrite(suffix, 1, size, file) == size);
+        ok = (fflush(file) == 0) && ok;
+        if(!ok && (ftruncate(fileno(file), end) != 0)) {
+            SAH_TRACEZ_ERROR(ME, "Cannot undo incomplete MLO ADD config override");
+        }
+    } else {
+        ok = enable || !present || (ftruncate(fileno(file), end - (long) size) == 0);
+    }
+out:
+    ok = (fclose(file) == 0) && ok;
+    return ok;
+}
+
+/* The ADD reply can precede discovery of the new per-link control socket.
+ * Retain the override until that exact BSS is verified; the ADD FSM retries
+ * this SET without removing or adding the already running link again. */
+swl_rc_ne wld_ap_hostapd_restoreMloAddDeauth(T_AccessPoint* pAP) {
+    ASSERT_NOT_NULL(pAP, SWL_RC_INVALID_PARAM, ME, "NULL AP");
+    if(!pAP->mloAddDeauthPending) {
+        return SWL_RC_OK;
+    }
+    ASSERT_TRUE(s_isLiveMbssidMloLink(pAP), SWL_RC_INVALID_STATE, ME,
+                "%s: waiting for added link before restoring deauth policy", pAP->alias);
+    /* A retry may skip an already accepted ADD. Restore its file too. */
+    const char* path = wld_wpaCtrlInterface_getCfgFilePath(pAP->wpaCtrlInterface);
+    ASSERT_TRUE(s_quietMloAddConfig(path, false), SWL_RC_ERROR, ME,
+                "%s: failed to restore ADD file policy", pAP->alias);
+    ASSERT_TRUE(wld_ap_hostapd_setParamValue(pAP, "broadcast_deauth",
+                                           pAP->mloAddDeauthValue ? "1" : "0", "mloAddComplete"),
+                SWL_RC_ERROR, ME, "%s: failed to restore deauth policy", pAP->alias);
+    pAP->mloAddDeauthPending = false;
+    return SWL_RC_OK;
+}
