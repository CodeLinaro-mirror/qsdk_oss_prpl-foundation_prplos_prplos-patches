+static bool s_hasPendingMldUnitChange(T_AccessPoint* pAP) {
+    if((pAP->pSSID == NULL) || !wld_wpaCtrlInterface_isReady(pAP->wpaCtrlInterface)) {
+        return false;
+    }
+    T_Radio* pRad = NULL;
+    wld_for_eachRad(pRad) {
+        T_AccessPoint* pOther = NULL;
+        wld_rad_forEachAp(pOther, pRad) {
+            wld_mld_t* pMld = ((pOther->pSSID != NULL) && (pOther->pSSID->pMldLink != NULL)) ?
+                pOther->pSSID->pMldLink->pMld : NULL;
+            if((pMld != NULL) && (pMld->pPendingMovedLink == pAP->pSSID) &&
+               (pMld->unit != pAP->pSSID->mldUnit)) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
