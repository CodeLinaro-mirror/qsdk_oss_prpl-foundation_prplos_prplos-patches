+/* Match the destination in the ADD file to a verified live partner. WLD
+ * ownership may already have changed, so configured membership alone is
+ * insufficient. Cold starts and whole-MLD rebuilds retain normal cleanup. */
+static bool s_hasLiveMloAddPartner(T_AccessPoint* pAP, const char* iface) {
+    T_SSID* pSSID = pAP->pSSID;
+    if((pSSID == NULL) || (pSSID->pMldLink == NULL) || swl_str_isEmpty(iface)) {
+        return false;
+    }
+    wld_mld_t* pMld = pSSID->pMldLink->pMld;
+    if(pMld == NULL) {
+        return false;
+    }
+    wld_mldLink_t* pLink = NULL;
+    wld_for_eachNeighMldLink(pLink, pSSID->pMldLink) {
+        T_SSID* pPeerSSID = wld_mld_getLinkSsid(pLink);
+        T_AccessPoint* pPeer = (pPeerSSID != NULL) ? pPeerSSID->AP_HOOK : NULL;
+        char runIface[128] = {0};
+        if(!pMld->hostapdRemoved && !pMld->hostapdRebuildPending &&
+           (pPeer != NULL) && (pPeer != pAP) && (pPeerSSID->mldUnit == pSSID->mldUnit) &&
+           wld_ap_isEnabledWithRef(pPeer) && s_isLiveMbssidMloLink(pPeer) &&
+           swl_rc_isOk(wld_ap_hostapd_getRunIface(pPeer, runIface, sizeof(runIface))) &&
+           swl_str_matches(runIface, iface)) {
+            return true;
+        }
+    }
+    /* A move into a new one-link MLD can still have clients on the source
+     * MLD. Its pending-move marker survives until ADD completes. Avoid a
+     * broadcast from the reused link BSSID in this direction as well. */
+    T_Radio* pRad = NULL;
+    wld_for_eachRad(pRad) {
+        T_AccessPoint* pPeer = NULL;
+        wld_rad_forEachAp(pPeer, pRad) {
+            T_SSID* pPeerSSID = pPeer->pSSID;
+            wld_mld_t* pOld = ((pPeerSSID != NULL) && (pPeerSSID->pMldLink != NULL)) ?
+                pPeerSSID->pMldLink->pMld : NULL;
+            if((pPeer != pAP) && (pOld != NULL) && (pOld != pMld) &&
+               (pOld->pPendingMovedLink == pSSID) && (pOld->unit == pPeerSSID->mldUnit) &&
+               !pOld->hostapdRemoved && !pOld->hostapdRebuildPending &&
+               wld_ap_isEnabledWithRef(pPeer) && s_isLiveMbssidMloLink(pPeer)) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
