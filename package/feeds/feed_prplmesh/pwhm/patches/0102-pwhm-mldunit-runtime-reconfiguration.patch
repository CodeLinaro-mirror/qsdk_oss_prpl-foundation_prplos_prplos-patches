+/* A configured primary can already belong to the destination of an MLDUnit
+ * move. Cached link IDs can also have been reused. Match the requested link
+ * MAC and band before accepting any kernel interface. */
+static swl_rc_ne s_matchSsidLink(T_SSID* pSSID, wld_nl80211_ifaceInfo_t* pInfo, int32_t* pLinkId) {
+    if(!s_matchSsidIfType(pSSID, pInfo)) {
+        return SWL_RC_NOT_AVAILABLE;
+    }
+    swl_macBin_t* pMac = (swl_macBin_t*) wld_ssid_getLinkMac(pSSID);
+    int32_t linkId = MLO_LINK_ID_UNKNOWN;
+    if(pInfo->nMloLinks > 0) {
+        const wld_nl80211_ifaceMloLinkInfo_t* pLink = wld_nl80211_fetchIfaceMloLinkByMac(pInfo, pMac);
+        if((pLink == NULL) || (pLink->link.linkId < 0)) {
+            return SWL_RC_NOT_AVAILABLE;
+        }
+        linkId = pLink->link.linkId;
+    }
+    return wld_nl80211_fetchIfaceLinkInfo(pInfo, pSSID->RADIO_PARENT->operatingFrequencyBand,
+                                        pMac, linkId, pLinkId);
+}
+
+static swl_rc_ne s_findSsidLink(T_SSID* pSSID, wld_nl80211_ifaceInfo_t* pInfo, int32_t* pLinkId) {
+    wld_nl80211_ifaceInfo_t* pIfaces = NULL;
+    uint32_t count = 0;
+    swl_rc_ne rc = wld_nl80211_getInterfacesList(wld_nl80211_getSharedState(), &pIfaces, 0, &count);
+    if(swl_rc_isOk(rc)) {
+        rc = SWL_RC_NOT_AVAILABLE;
+        for(uint32_t i = 0; i < count; i++) {
+            int32_t linkId = MLO_LINK_ID_UNKNOWN;
+            /* AP/VLANs mirror their parent's MAC/link table. Continue the
+             * search past them instead of rejecting the last MAC match. */
+            if(!swl_rc_isOk(s_matchSsidLink(pSSID, &pIfaces[i], &linkId))) {
+                continue;
+            }
+            *pInfo = pIfaces[i];
+            *pLinkId = linkId;
+            rc = SWL_RC_OK;
+            if(linkId >= 0) {
+                break;
+            }
+        }
+    }
+    free(pIfaces);
+    return rc;
+}
