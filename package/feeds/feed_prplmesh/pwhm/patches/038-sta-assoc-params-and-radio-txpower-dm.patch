+/* Query hostapd for channel and operating class of a newly associated STA and
+ * write them directly to the AssociatedDevice DM object.
+ *
+ * Sends "STA <mac>" to the AP's wpa_ctrl interface and parses:
+ *   channel=<N>
+ *   Operating_class=<N>
+ *
+ * Silently skips if wpa_ctrl is unavailable or STA is not yet known. */
+static void s_syncStaAssocInfo(T_AccessPoint* pAP, T_AssociatedDevice* pAD) {
+    ASSERT_NOT_NULL(pAP, , ME, "NULL");
+    ASSERT_NOT_NULL(pAD, , ME, "NULL");
+
+    if(!pAD->object) {
+        SAH_TRACEZ_WARNING(ME, "%s: syncStaAssocInfo sta=%s object is NULL, skip",
+            pAP->alias, pAD->Name);
+        return;
+    }
+
+    if(pAP->pRadio && pAP->pRadio->channel > 0) {
+        amxd_object_set_value(uint32_t, pAD->object, "Channel",
+                              (uint32_t)pAP->pRadio->channel);
+    }
+
+    if(pAP->pRadio) {
+        swl_bandwidth_e bw = swl_radBw_toBw[pAP->pRadio->runningChannelBandwidth];
+        if(bw != SWL_BW_AUTO) {
+            amxd_object_set_value(cstring_t, pAD->object, "LinkBandwidth",
+                                  swl_bandwidth_unknown_str[bw]);
+            pAD->assocCaps.linkBandwidth = bw;
+            pAD->assocCaps.linkBandwidthSetByDriver = true;
+        }
+    }
+
+    if(pAP->pRadio && pAP->pRadio->pBus) {
+        const amxc_var_t* oc = amxd_object_get_param_value(pAP->pRadio->pBus, "OperatingClass");
+        if(oc) {
+            uint32_t opclass = amxc_var_dyncast(uint32_t, oc);
+            if(opclass > 0)
+                amxd_object_set_value(uint32_t, pAD->object, "OperatingClass", opclass);
+        }
+    }
+
+    if(!pAP->wpaCtrlInterface || !wld_wpaCtrlInterface_isReady(pAP->wpaCtrlInterface)) {
+        SAH_TRACEZ_WARNING(ME, "%s: syncStaAssocInfo wpaCtrl not ready, skip STA-specific fields",
+            pAP->alias);
+        return;
+    }
+
+    char reply[2048] = {0};
+    swl_rc_ne rc = wld_wpaCtrl_sendCmdFmtGetResponse(
+        pAP->wpaCtrlInterface, reply, sizeof(reply),
+        "STA %02x:%02x:%02x:%02x:%02x:%02x",
+        pAD->MACAddress[0], pAD->MACAddress[1], pAD->MACAddress[2],
+        pAD->MACAddress[3], pAD->MACAddress[4], pAD->MACAddress[5]);
+
+    if(!swl_rc_isOk(rc) || reply[0] == '\0' || reply[0] == 'F') {
+        SAH_TRACEZ_WARNING(ME, "%s: syncStaAssocInfo STA query failed for %s",
+            pAP->alias, pAD->Name);
+        return;
+    }
+
+    uint32_t maxphyrate = 0;
+    int32_t  sig = 0;
+    unsigned int vht_caps_raw = 0;
+    bool has_vht = false;
+    int erp = 0;
+    bool has_erp = false;
+    int min_txpwr = 0;
+    bool has_min_txpwr = false;
+    int max_txpwr = 0;
+    bool has_max_txpwr = false;
+
+    char* line = reply;
+    while(line && *line) {
+        char* nl = strchr(line, '\n');
+        if(nl) *nl = '\0';
+        unsigned int tmp = 0;
+        int stmp = 0;
+        if(sscanf(line, "signal=%d", &stmp) == 1) {
+            sig = stmp;
+            amxd_object_set_value(int32_t, pAD->object, "SignalStrength", sig);
+        } else if(sscanf(line, "maxphyrate=%u", &tmp) == 1) {
+            maxphyrate = tmp;
+            amxd_object_set_value(uint32_t, pAD->object, "MaxDownlinkRateSupported", maxphyrate);
+            amxd_object_set_value(uint32_t, pAD->object, "MaxUplinkRateSupported", maxphyrate);
+        } else if(sscanf(line, "vht_caps_info=0x%x", &tmp) == 1) {
+            vht_caps_raw = tmp;
+            has_vht = true;
+        } else if(sscanf(line, "ERP=%d", &stmp) == 1) {
+            erp = stmp;
+            has_erp = true;
+            amxd_object_set_value(bool, pAD->object, "ERP", (bool)erp);
+        } else if(sscanf(line, "min_txpower=%d", &stmp) == 1) {
+            min_txpwr = stmp;
+            has_min_txpwr = true;
+            amxd_object_set_value(int32_t, pAD->object, "MinTxPower", min_txpwr);
+        } else if(sscanf(line, "max_txpower=%d", &stmp) == 1) {
+            max_txpwr = stmp;
+            has_max_txpwr = true;
+            amxd_object_set_value(int32_t, pAD->object, "MaxTxPower", max_txpwr);
+        }
+        line = nl ? nl + 1 : NULL;
+    }
+
+    if(has_vht) {
+        swl_staCapVht_m vhtMask = 0;
+        if(vht_caps_raw & M_SWL_80211_VHTCAPINFO_SGI_80)  vhtMask |= M_SWL_STACAP_VHT_SGI80;
+        if(vht_caps_raw & M_SWL_80211_VHTCAPINFO_SGI_160) vhtMask |= M_SWL_STACAP_VHT_SGI160;
+        if(vht_caps_raw & M_SWL_80211_VHTCAPINFO_SU_BFR)  vhtMask |= M_SWL_STACAP_VHT_SU_BFR;
+        if(vht_caps_raw & M_SWL_80211_VHTCAPINFO_SU_BFE)  vhtMask |= M_SWL_STACAP_VHT_SU_BFE;
+        if(vht_caps_raw & M_SWL_80211_VHTCAPINFO_MU_BFR)  vhtMask |= M_SWL_STACAP_VHT_MU_BFR;
+        if(vht_caps_raw & M_SWL_80211_VHTCAPINFO_MU_BFE)  vhtMask |= M_SWL_STACAP_VHT_MU_BFE;
+        char vhtStr[64] = {0};
+        swl_conv_maskToChar(vhtStr, sizeof(vhtStr), vhtMask, swl_staCapVht_str, SWL_STACAP_VHT_MAX);
+        amxd_object_set_value(cstring_t, pAD->object, "VhtCapabilities", vhtStr);
+        pAD->assocCaps.vhtCapabilities = vhtMask;
+    }
+
+    SAH_TRACEZ_INFO(ME, "%s: sta %s ch=%d bw=%d sig=%d maxrate=%u vht=0x%x erp=%d mintxpwr=%d maxtxpwr=%d",
+        pAP->alias, pAD->Name,
+        pAP->pRadio ? pAP->pRadio->channel : -1,
+        pAP->pRadio ? (int)pAP->pRadio->runningChannelBandwidth : -1,
+        sig, maxphyrate, vht_caps_raw,
+        has_erp ? erp : -1,
+        has_min_txpwr ? min_txpwr : -1,
+        has_max_txpwr ? max_txpwr : -1);
+}
+
 static void s_commonAssocReqCb(T_AccessPoint* pAP, swl_80211_mgmtFrame_t* frame, size_t frameLen, swl_bit8_t* iesData, size_t iesLen) {
     ASSERT_NOT_NULL(pAP, , ME, "NULL");
     ASSERT_NOT_NULL(pAP->pRadio, , ME, "NULL");

