+static void s_uplinkCsaEvtCb(wld_wpaCtrlInterface_t* pInterface, char* event _UNUSED    , char* params) {
+    // Example: DFS-UPLINK-CSA freq=2427 ht_enabled=0 ch_offset=0 ch_width=20MHz (no HT) cf1=2427 cf2=0 dfs=0
+
+    SAH_TRACEZ_ERROR(ME, "%s: uplink CSA %s ", pInterface->name, params);
+
+    CALL_MGR_I(pInterface, fUplinkCsaCb, params);
+}
