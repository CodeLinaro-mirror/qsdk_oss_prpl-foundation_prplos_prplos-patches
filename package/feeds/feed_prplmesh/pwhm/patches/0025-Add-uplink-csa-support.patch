 static void s_notifyWpaCtrlEvent(amxd_object_t* object, char* ifName, char* eventName,
@@ -514,6 +516,32 @@ static void s_fetchSockLinkIface(void* userData _UNUSED, wld_wpaCtrlMngr_t* pMgr
     swl_str_copyMalloc(ppLinkIfName, pLinkIfName);
 }
 
+static void s_uplinkCsaCb(void* userData, char* ifName _UNUSED, char* params) {
+    T_Radio* pRad = (T_Radio*) userData;
+    ASSERT_NOT_NULL(pRad, , ME, "NULL");
+
+    // Forward DFS-UPLINK-CSA event to wpa_supplicant endpoint if connected
+    T_EndPoint* pEP = NULL;
+    wld_rad_forEachEp(pEP, pRad) {
+        if((pEP == NULL) || (pEP->wpaCtrlInterface == NULL)) {
+            continue;
+        }
+
+        if(!wld_wpaCtrlInterface_isReady(pEP->wpaCtrlInterface)) {
+            SAH_TRACEZ_ERROR(ME, "%s: wpa_supplicant interface not ready, skip for    warding UPLINK-CSA", pEP->Name);
+            continue;
+        }
+
+        // Send UPLINK_CSA command to wpa_supplicant
+        char cmd[256];
+        snprintf(cmd, sizeof(cmd), "UPLINK_CSA %s", params);
+
+        SAH_TRACEZ_ERROR(ME, "%s: forwarding UPLINK-CSA to wpa_supplicant: %s", pEP->Name, cmd);
+        wld_wpaCtrl_sendCmd(pEP->wpaCtrlInterface, cmd);
+    }
+}
+
+
 #define SET_HDLR(tgt, src) {tgt = (tgt ? : src); }
 
 static swl_rc_ne s_setWpaCtrlRadEvtHandlers(wld_wpaCtrlMngr_t* wpaCtrlMngr, T_Radio* pRad) {
@@ -538,6 +566,7 @@ static swl_rc_ne s_setWpaCtrlRadEvtHandlers(wld_wpaCtrlMngr_t* wpaCtrlMngr, T_Ra
     SET_HDLR(wpaCtrlRadEvthandlers.fDfsNopFinishedCb, s_dfsNopFinishedCb);
     SET_HDLR(wpaCtrlRadEvthandlers.fDfsNewChannelCb, s_dfsNewChannelCb);
     SET_HDLR(wpaCtrlRadEvthandlers.fFetchSockLinkIface, s_fetchSockLinkIface);
+    SET_HDLR(wpaCtrlRadEvthandlers.fUplinkCsaCb, s_uplinkCsaCb);
     wld_wpaCtrlMngr_setEvtHandlers(wpaCtrlMngr, pRad, &wpaCtrlRadEvthandlers);
     return SWL_RC_OK;
 }
