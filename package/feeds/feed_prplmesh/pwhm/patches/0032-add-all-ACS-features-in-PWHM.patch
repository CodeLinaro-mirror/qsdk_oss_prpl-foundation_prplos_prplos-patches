+/* --- ACS config-file-only parameter handler ---
+ *
+ * Used for parameters that have no wpa_ctrl runtime command and can only be
+ * applied by rewriting the hostapd config file and triggering RELOAD_CONFIG:
+ *   PcacOnly    → acs_pcaconly    (conf->acs_dfs_available_only)
+ *   ChannelList → chanlist
+ *   MinDwellTime → acsmin_dwell
+ *   MaxDwellTime → acsmax_dwell
+ *
+ * If the radio is not active the new value is already stored in the DM and
+ * will be written to the config file on the next hostapd start.
+ */
+static void s_setAcsConfigFileParam_pwf(void* priv _UNUSED, amxd_object_t* object,
+                                          amxd_param_t* param,
+                                          const amxc_var_t* const newValue _UNUSED) {
+    T_Radio* pRad = wld_rad_fromObj(amxd_object_get_parent(object));
+    ASSERTI_NOT_NULL(pRad, , ME, "NULL");
+    const char* paramName = amxd_param_get_name(param);
+    SAH_TRACEZ_INFO(ME, "%s: ACS.%s changed: rewriting hostapd config file",
+                    pRad->Name, paramName ? paramName : "?");
+    /* Always rewrite the config file so the new value is persisted on disk. */
+    wld_hostapd_cfgFile_createExt(pRad);
+    /* Trigger RELOAD_CONFIG only when hostapd is running so it picks up the
+     * new value immediately without a full restart. */
+    if(wld_rad_isActive(pRad)) {
+        wld_rad_hostapd_reconfigure(pRad);
+    }
+}
+
+/* --- ACS SWLA_DM_HDLRS --- */
+
+SWLA_DM_HDLRS(sRadioAcsDmHdlrs,
+              ARR(SWLA_DM_PARAM_HDLR("DwellTime",           s_setAcsDwellTime_pwf),
+                  SWLA_DM_PARAM_HDLR("DfsExclude",          s_setAcsDfsExclude_pwf),
+                  SWLA_DM_PARAM_HDLR("WeatherRadarExclude", s_setAcsWeatherRadarExclude_pwf),
+                  SWLA_DM_PARAM_HDLR("OnlyPscChannels6G",   s_setAcsOnlyPscChannels6G_pwf),
+                  SWLA_DM_PARAM_HDLR("TxPwrOptimization",   s_setAcsTxPwrOptimization_pwf),
+                  SWLA_DM_PARAM_HDLR("PeriodicInterval",    s_setAcsPeriodicInterval_pwf),
+                  SWLA_DM_PARAM_HDLR("RankEnable",          s_setAcsRankEnable_pwf),
+                  SWLA_DM_PARAM_HDLR("NoScan",              s_setAcsNoScan_pwf),
+                  SWLA_DM_PARAM_HDLR("DebugTrace",          s_setAcsDebugTrace_pwf),
+                  SWLA_DM_PARAM_HDLR("QacsEnable",          s_setAcsQacsEnable_pwf),
+                  SWLA_DM_PARAM_HDLR("BlockChanList",       s_setAcsBlockChanList_pwf),
+                  SWLA_DM_PARAM_HDLR("Scan2GAllChannels",   s_setAcsScan2GAll_pwf),
+                  /* Config-file-only parameters: rewrite config + RELOAD_CONFIG */
+                  SWLA_DM_PARAM_HDLR("PcacOnly",            s_setAcsConfigFileParam_pwf),
+                  SWLA_DM_PARAM_HDLR("ChannelList",         s_setAcsConfigFileParam_pwf),
+                  SWLA_DM_PARAM_HDLR("MinDwellTime",        s_setAcsConfigFileParam_pwf),
+                  SWLA_DM_PARAM_HDLR("MaxDwellTime",        s_setAcsConfigFileParam_pwf),
+                  ));
