+/* ============================================================
+ * WiFi.Radio.{i}.ACS object implementation
+ *
+ * All ACS parameters are per-radio in hostapd (stored in
+ * hostapd_iface->conf_extn, not per-BSS). Commands are sent
+ * via wpa_ctrl to the first active AP on the radio; hostapd
+ * routes them to the correct hostapd_iface (per-radio).
+ *
+ * Confirmed: setting ACS dwelltime on wlan2.2 is visible when
+ * queried on wlan2.1 — both share the same hostapd_iface.
+ * ============================================================ */
+
+/**
+ * @brief Get the first active (or enabled) AP on a radio for ACS wpa_ctrl commands.
+ */
+static T_AccessPoint* s_getAcsAp(T_Radio* pRad) {
+    T_AccessPoint* pAP = wld_rad_getFirstActiveAp(pRad);
+    if(pAP == NULL) {
+        pAP = wld_rad_getFirstEnabledVap(pRad);
+    }
+    return pAP;
+}
