+/* --- ACS.showNeighborReport() function --- */
+
+amxd_status_t _showNeighborReport(amxd_object_t* object,
+                                             amxd_function_t* func _UNUSED,
+                                             amxc_var_t* args _UNUSED,
+                                             amxc_var_t* retval) {
+    T_Radio* pRad = wld_rad_fromObj(amxd_object_get_parent(object));
+    ASSERT_NOT_NULL(pRad, amxd_status_unknown_error, ME, "NULL");
+
+    amxc_var_set(cstring_t, retval, "");
+
+    T_AccessPoint* pAP = s_getAcsAp(pRad);
+    ASSERTI_NOT_NULL(pAP, amxd_status_ok, ME, "%s: ACS.showNeighborReport: no AP available", pRad->Name);
+    ASSERTI_TRUE(wld_rad_isActive(pRad), amxd_status_ok, ME, "%s: ACS.showNeighborReport: radio not active", pRad->Name);
+
+    size_t replySize = wld_wpaCtrl_getMaxMsgLen();
+    char* reply = calloc(1, replySize);
+    ASSERT_NOT_NULL(reply, amxd_status_unknown_error, ME, "alloc failed");
+
+    swl_rc_ne rc = wld_wpaCtrl_sendCmdFmtGetResponse(
+        pAP->wpaCtrlInterface, reply, replySize, "ACS show_neighbor_report");
+
+    if(swl_rc_isOk(rc)) {
+        amxc_var_set(cstring_t, retval, reply);
+    }
+    free(reply);
+    return amxd_status_ok;
+}
