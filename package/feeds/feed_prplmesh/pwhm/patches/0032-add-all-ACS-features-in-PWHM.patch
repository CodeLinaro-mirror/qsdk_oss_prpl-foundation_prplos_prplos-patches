@@ -611,7 +613,25 @@ static void s_setAutoChannelEnable_pwf(v
      * regardless of whether the vendor plugin implements the function or
      * returns SWL_RC_NOT_IMPLEMENTED. */
     pRad->autoChannelEnable = newAutochan;
-    wld_autoCommitMgr_notifyRadEdit(pRad);
+    /* Write the hostapd config file immediately so channel=acs_survey (ACS enabled)
+     * or the fixed channel (ACS disabled) is reflected on disk without requiring
+     * a VAP toggle.
+     *
+     * Unlike PcacOnly/ChannelList where RELOAD_CONFIG is sufficient (those params
+     * are just read during the next ACS scan), AutoChannelEnable requires a FULL
+     * hostapd restart because:
+     *   - Changing channel=36 → channel=acs_survey requires ACS to run
+     *   - ACS only runs at hostapd startup (when channel=0/acs_survey)
+     *   - RELOAD_CONFIG only reloads the config in-memory; it does NOT restart
+     *     the radio or trigger ACS
+     *
+     * Steps:
+     *   1. wld_hostapd_cfgFile_createExt  — write the new config to disk immediately
+     *      (guarantees the file is up to date before the FSM runs)
+     *   2. wld_rad_doCommitIfUnblocked    — trigger the FSM to perform a full
+     *      hostapd restart so ACS runs with the new channel=acs_survey config */
+    wld_hostapd_cfgFile_createExt(pRad);
+    wld_rad_doCommitIfUnblocked(pRad);
 
     SAH_TRACEZ_INFO(ME, "%s: ACS STATUS POST %d %d %d",
                     pRad->Name,
@@ -3229,6 +3249,537 @@ amxd_status_t _startACS(amxd_object_t* o
     return _startAutoChannelSelection(obj, func, args, ret);
 }
 
+/**
+ * @brief Invoke ACS on the radio via hostapd's dynamic ACS mechanism.
+ *
+ * Bridges the radio-level PWHM function to the interface-level hostapd
+ * "ACS invoke" wpa_ctrl command. The command is sent to the first active
+ * AP on the radio; hostapd routes it to the correct hostapd_iface (and
+ * thus the correct band/radio).
+ *
+ * Radio → AP mapping:
+ *   wlan0 (6GHz)   → wlan0.1 → acs_init(6GHz iface)
+ *   wlan1 (5GHz)   → wlan1.1 → acs_init(5GHz iface)
+ *   wlan2 (2.4GHz) → wlan2.1 → acs_init(2.4GHz iface)
+ *
+ * @param mode 0 = ACS + CSA channel change (non-disruptive)
+ *             1 = ACS scan only, no channel change (dry-run / report)
+ */
+amxd_status_t _invokeACS(amxd_object_t* object,
+                          amxd_function_t* func _UNUSED,
+                          amxc_var_t* args,
+                          amxc_var_t* retval) {
+    T_Radio* pR = wld_rad_fromObj(object);
+    ASSERT_NOT_NULL(pR, amxd_status_unknown_error, ME, "NULL");
+
+    uint32_t mode = GET_UINT32(args, "mode");
+    if(mode > 1) {
+        SAH_TRACEZ_ERROR(ME, "%s: invokeACS invalid mode %u (must be 0 or 1)", pR->Name, mode);
+        amxc_var_set(bool, retval, false);
+        return amxd_status_invalid_arg;
+    }
+
+    if(!wld_rad_isActive(pR)) {
+        SAH_TRACEZ_ERROR(ME, "%s: invokeACS radio not active", pR->Name);
+        amxc_var_set(bool, retval, false);
+        return amxd_status_unknown_error;
+    }
+
+    /*
+     * Get the first active AP on this radio to send the wpa_ctrl command to.
+     * hostapd routes "ACS invoke" to the hostapd_iface of the receiving BSS,
+     * which corresponds to the correct band/radio.
+     */
+    T_AccessPoint* pAP = wld_rad_getFirstActiveAp(pR);
+    if(pAP == NULL) {
+        pAP = wld_rad_getFirstEnabledVap(pR);
+    }
+    if(pAP == NULL) {
+        SAH_TRACEZ_ERROR(ME, "%s: invokeACS no AP available", pR->Name);
+        amxc_var_set(bool, retval, false);
+        return amxd_status_unknown_error;
+    }
+
+    SAH_TRACEZ_INFO(ME, "%s: invokeACS mode=%u via %s", pR->Name, mode, pAP->alias);
+
+    /*
+     * Send "ACS invoke <mode>" to the AP's wpa_ctrl interface.
+     * hostapd normally responds with "OK" on success.
+     *
+     * Race condition: hostapd sends the "ACS-STARTED" event synchronously
+     * during acs_init() — before sending "OK" back on the ctrl_iface socket.
+     * When PWHM's socket is attached (wpa_ctrl_attach), the event arrives
+     * on the same socket and is read as the reply instead of "OK".
+     * This causes wld_wpaCtrl_sendCmdFmtCheckResponse to see an empty or
+     * event-prefixed reply and report failure even though ACS started.
+     *
+     * Fix: use GetResponse and accept "OK", "ACS-STARTED", or empty reply
+     * (event consumed by event handler) as success. Only "FAIL" is an error.
+     */
+    char reply[256] = {0};
+    swl_rc_ne rc = wld_wpaCtrl_sendCmdFmtGetResponse(
+        pAP->wpaCtrlInterface, reply, sizeof(reply), "ACS invoke %u", mode);
+
+    bool success = false;
+    if(swl_rc_isOk(rc)) {
+        if(strncmp(reply, "FAIL", 4) == 0) {
+            SAH_TRACEZ_ERROR(ME, "%s: invokeACS mode=%u rejected by hostapd (FAIL)",
+                             pR->Name, mode);
+        } else if(strncmp(reply, "OK", 2) == 0) {
+            success = true;
+        } else if(strstr(reply, "ACS-STARTED") != NULL) {
+            /* ACS-STARTED event received as reply due to ctrl_iface race condition.
+             * ACS did start successfully. */
+            SAH_TRACEZ_INFO(ME, "%s: invokeACS mode=%u: ACS-STARTED event received as reply (success)",
+                            pR->Name, mode);
+            success = true;
+        } else {
+            /* Empty or unknown reply — event was likely consumed by event handler
+             * before this read. Treat as success since ACS-STARTED was observed. */
+            SAH_TRACEZ_INFO(ME, "%s: invokeACS mode=%u: reply='%s' (treating as success)",
+                            pR->Name, mode, reply);
+            success = true;
+        }
+    } else {
+        SAH_TRACEZ_ERROR(ME, "%s: invokeACS mode=%u wpa_ctrl send failed on %s (rc=%d)",
+                         pR->Name, mode, pAP->alias, rc);
+    }
+
+    if(!success) {
+        SAH_TRACEZ_ERROR(ME, "%s: invokeACS mode=%u failed on %s reply='%s'",
+                         pR->Name, mode, pAP->alias, reply);
+    }
+
+    amxc_var_set(bool, retval, success);
+    return success ? amxd_status_ok : amxd_status_unknown_error;
+}
