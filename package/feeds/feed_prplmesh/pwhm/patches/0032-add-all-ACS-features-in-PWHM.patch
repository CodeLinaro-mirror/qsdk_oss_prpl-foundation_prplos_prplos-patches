+static void s_setAcsBlockChanList_pwf(void* priv _UNUSED, amxd_object_t* object,
+                                       amxd_param_t* param _UNUSED,
+                                       const amxc_var_t* const newValue) {
+    T_Radio* pRad = wld_rad_fromObj(amxd_object_get_parent(object));
+    ASSERTI_NOT_NULL(pRad, , ME, "NULL");
+    const char* val = amxc_var_constcast(cstring_t, newValue);
+    if(val == NULL || val[0] == '\0') return; /* empty = no change */
+    ASSERTI_TRUE(wld_rad_isActive(pRad), , ME, "%s: ACS.BlockChanList: radio not active", pRad->Name);
+    T_AccessPoint* pAP = s_getAcsAp(pRad);
+    ASSERTI_NOT_NULL(pAP, , ME, "%s: ACS.BlockChanList: no AP available", pRad->Name);
+
+    /*
+     * hostapd's hostapd_set_block_chanlist() tokenises by space (str_token " "),
+     * not by comma. Convert the comma-separated DM value (e.g. "1,6,11") to
+     * space-separated (e.g. "1 6 11") before sending the wpa_ctrl command.
+     */
+    char spaceSep[256] = {0};
+    swl_str_copy(spaceSep, sizeof(spaceSep), val);
+    for(char* p = spaceSep; *p; p++) {
+        if(*p == ',') {
+            *p = ' ';
+        }
+    }
+
+    wld_wpaCtrl_sendCmdFmtCheckResponse(pAP->wpaCtrlInterface, "OK", "ACS set_block_chan_list %s", spaceSep);
+}
