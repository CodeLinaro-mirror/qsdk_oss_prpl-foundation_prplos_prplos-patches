+/* --- ACS.DebugTrace read action (active read from hostapd) --- */
+
+amxd_status_t _wld_rad_getAcsDebugTrace_prf(amxd_object_t* object,
+                                             amxd_param_t* param,
+                                             amxd_action_t reason,
+                                             const amxc_var_t* const args _UNUSED,
+                                             amxc_var_t* const retval,
+                                             void* priv _UNUSED) {
+    ASSERTS_NOT_NULL(param, amxd_status_unknown_error, ME, "NULL");
+    ASSERTS_EQUALS(reason, action_param_read, amxd_status_function_not_implemented, ME, "not impl");
+
+    /* ACS object is child of Radio instance */
+    T_Radio* pRad = wld_rad_fromObj(amxd_object_get_parent(object));
+    ASSERTS_NOT_NULL(pRad, amxd_status_ok, ME, "no radio mapped");
+
+    /* Default: return the stored/persisted value */
+    uint32_t value = amxc_var_dyncast(uint32_t, &param->value);
+
+    T_AccessPoint* pAP = s_getAcsAp(pRad);
+    if(pAP != NULL && wld_rad_isActive(pRad)) {
+        char reply[256] = {0};
+        swl_rc_ne rc = wld_wpaCtrl_sendCmdFmtGetResponse(
+            pAP->wpaCtrlInterface, reply, sizeof(reply), "ACS get_dbgtrace");
+        if(swl_rc_isOk(rc)) {
+            /*
+             * hostapd response format (from hostapd_acs_get_dbgtrace_extn):
+             * "ACS Debug Trace: module_bitmap=0x%04x, debug_level=%d\n"
+             * Reconstruct combined uint32: (module_bitmap << 8) | debug_level
+             */
+            unsigned int module_bitmap = 0;
+            int debug_level = 0;
+            if(sscanf(reply, "ACS Debug Trace: module_bitmap=0x%x, debug_level=%d",
+                      &module_bitmap, &debug_level) == 2) {
+                value = ((module_bitmap & 0xFF) << 8) | (debug_level & 0xFF);
+                SAH_TRACEZ_INFO(ME, "%s: ACS.DebugTrace read from hostapd: module_bitmap=0x%02x debug_level=%d combined=0x%04x",
+                                pRad->Name, module_bitmap & 0xFF, debug_level, value);
+            }
+        }
+    }
+
+    amxc_var_set(uint32_t, retval, value);
+    return amxd_status_ok;
+}
