From: Atchaya R <ratchaya@qti.qualcomm.com>
Date: Sun, 14 Jun 2026 17:32:10 +0530
Subject: [PATCH] pwhm: add support for ACS features in PWHM

Signed-off-by: Atchaya R <ratchaya@qti.qualcomm.com>
---
 odl/wld_radio.odl                  | 235 ++++++++++
 src/Plugin/wifiGen_eventHandlers.c |  25 ++
 src/nl80211/wld_hostapd_cfgFile.c  | 100 +++++
 src/wld_radio.c                    | 697 +++++++++++++++++++++++++++++
 4 files changed, 1057 insertions(+)

--- a/odl/wld_radio.odl
+++ b/odl/wld_radio.odl
@@ -196,6 +196,27 @@ define probelist_t{
 		 */
 		bool startACS();
 
+		/**
+		 * Invoke ACS on the radio via hostapd's dynamic ACS mechanism.
+		 *
+		 * Unlike startACS() which restarts hostapd (disruptive), this function
+		 * sends the "ACS invoke" command via wpa_ctrl to the first active AP on
+		 * the radio. hostapd triggers ACS without disconnecting stations:
+		 *   - mode 0: run ACS and change channel via CSA (non-disruptive)
+		 *   - mode 1: run ACS only, no channel change (dry-run / report)
+		 *
+		 * The radio must be active (hostapd running and at least one AP up).
+		 * If ACS is already in progress, hostapd will reject the request.
+		 *
+		 * @param mode: 0 = ACS + CSA channel change
+		 *              1 = ACS scan only, no channel change
+		 * @return true on success, false on error
+		 * @error function_exec_error "Invalid mode" if mode is not 0 or 1
+		 * @error function_exec_error "Radio not active" if no AP is available
+		 * @error function_exec_error "ACS invoke failed" if hostapd rejects the command
+		 */
+		bool invokeACS(%in %mandatory uint32 mode);
+
 		/*
 		 * This function will start an automatic channel selection sequence.
 		 * The corresponding configuration must be enabled in the agent config file to use this feature.
@@ -779,6 +800,247 @@ define probelist_t{
 		 */
 		void startAutoChannelSelection();
 
+		/**
+		 * ACS (Automatic Channel Selection) runtime configuration and control.
+		 *
+		 * All parameters are per-radio in hostapd (stored in hostapd_iface->conf_extn,
+		 * not per-BSS). Commands are sent via wpa_ctrl to the first active AP on this
+		 * radio. Setting a parameter via any BSS interface of the radio affects all BSS
+		 * interfaces on the same radio (confirmed: setting on wlan2.2 is visible on wlan2.1).
+		 *
+		 * Persistence semantics — two categories:
+		 *
+		 * 1. Config-file parameters (%persistent): written to hostapd.conf so they
+		 *    survive hostapd restarts. pWHM marks these %persistent to match hostapd.
+		 *    Parameters: MinDwellTime, MaxDwellTime, DfsExclude, PcacOnly,
+		 *                OnlyPscChannels6G, PeriodicInterval, QacsEnable,
+		 *                ChannelList, Scan2GAllChannels.
+		 *
+		 * 2. wpa_ctrl-only parameters (non-persistent): applied at runtime via
+		 *    "ACS <cmd>" wpa_ctrl commands. hostapd resets them to defaults on
+		 *    restart. pWHM does NOT persist these — they reset to defaults on reboot,
+		 *    matching hostapd's own behaviour.
+		 *    Parameters: DwellTime, WeatherRadarExclude, TxPwrOptimization,
+		 *                RankEnable, NoScan, DebugTrace, BlockChanList.
+		 */
+		%persistent object ACS {
+			on event "*" call wld_rad_setAcsConf_ocf;
+
+			/**
+			 * Minimum ACS dwell time in milliseconds.
+			 * hostapd enforces a hard floor of 50 ms (values below 50 are clamped to 50).
+			 * Written to hostapd config as: acsmin_dwell <value>
+			 * Config-file-only parameter (no wpa_ctrl runtime command).
+			 * Takes effect after hostapd restart.
+			 * Reading this parameter actively queries: ACS get_dwell
+			 */
+			%persistent uint32 MinDwellTime {
+				on action validate call check_minimum 50;
+				default 50;
+			}
+
+			/**
+			 * Maximum ACS dwell time in milliseconds.
+			 * Written to hostapd config as: acsmax_dwell <value>
+			 * Config-file-only parameter (no wpa_ctrl runtime command).
+			 * Takes effect after hostapd restart.
+			 * Reading this parameter actively queries: ACS get_dwell
+			 */
+			%persistent uint32 MaxDwellTime {
+				on action validate call check_minimum 50;
+				default 250;
+			}
+
+			/**
+			 * ACS dwell time in milliseconds (time spent scanning each channel).
+			 * Sent as: ACS dwelltime <value>
+			 * hostapd defaults (from hostapd_config_defaults_extn):
+			 *   min_dwell = 50 ms  (hard minimum, enforced in hostapd config parsing)
+			 *   max_dwell = 250 ms
+			 *   dwelltime = 200 ms (default configured dwell time)
+			 * Reading this parameter actively queries: ACS get_dwell
+			 * (in parity with hostapd's actual state when radio is active)
+			 * NOT persistent: wpa_ctrl-only, hostapd resets to default on restart.
+			 */
+			uint32 DwellTime {
+				on action validate call check_range { min = 50, max = 250 };
+				default 200;
+			}
+
+			/**
+			 * Exclude DFS channels from ACS channel selection.
+			 * Sent as: ACS dfs_exclude <0|1>
+			 */
+			%persistent bool DfsExclude {
+				default false;
+			}
+
+			/**
+			 * Restrict ACS DFS channel selection to channels that have already
+			 * completed CAC (pre-CAC done, DFS state = available).
+			 * When enabled, ACS skips DFS channels that still require a fresh CAC
+			 * scan, avoiding the CAC delay on startup.
+			 * Written to hostapd config as: acs_pcaconly <0|1>
+			 * Only written when ACS is active (AutoChannelEnable=true).
+			 * Corresponds to hostapd conf->acs_dfs_available_only.
+			 */
+			%persistent bool PcacOnly {
+				default false;
+			}
+
+			/**
+			 * Exclude weather radar channels from ACS channel selection.
+			 * Sent as: ACS wradar <0|1>
+			 * hostapd default: wradar = 1 (enabled — weather radar channels excluded by default)
+			 * Reading this parameter actively queries: ACS get_wradar
+			 * (in parity with hostapd's actual state when radio is active)
+			 * NOT persistent: wpa_ctrl-only, hostapd resets to default on restart.
+			 */
+			bool WeatherRadarExclude {
+				default true;
+			}
+
+			/**
+			 * Restrict 6GHz ACS to PSC (Preferred Scanning Channels) only.
+			 * Sent as: ACS 6g_only_psc <0|1>
+			 * Only applicable for 6GHz radios; ignored for 2.4GHz and 5GHz.
+			 */
+			%persistent bool OnlyPscChannels6G {
+				default false;
+			}
+
+			/**
+			 * TX power optimization mode for ACS channel ranking.
+			 * 0 = disabled (default)
+			 * 1 = optimize for throughput
+			 * 2 = optimize for range
+			 * Sent as: ACS txpwr_opt <0|1|2>
+			 * NOT persistent: wpa_ctrl-only, hostapd resets to default on restart.
+			 */
+			uint32 TxPwrOptimization {
+				on action validate call check_range { min = 0, max = 2 };
+				default 0;
+			}
+
+			/**
+			 * Periodic ACS interval in seconds (0 = disabled).
+			 * When non-zero, hostapd re-runs ACS every <value> seconds.
+			 * hostapd constraint: 60..86400 seconds (or 0 to disable)
+			 * Sent as: ACS periodic_interval <sec>
+			 */
+			%persistent uint32 PeriodicInterval {
+				default 0;
+			}
+
+			/**
+			 * Enable/disable ACS channel ranking algorithm.
+			 * When enabled, channels are ranked by interference factor.
+			 * Sent as: ACS rank_en <0|1>
+			 * NOT persistent: wpa_ctrl-only, hostapd resets to default on restart.
+			 */
+			bool RankEnable {
+				default true;
+			}
+
+			/**
+			 * Enable/disable ACS noscan mode.
+			 * When enabled, ACS uses cached survey data without performing a new scan.
+			 * Sent as: ACS noscan <0|1>
+			 * NOT persistent: wpa_ctrl-only, hostapd resets to default on restart.
+			 */
+			bool NoScan {
+				default false;
+			}
+
+			/**
+			 * ACS debug trace level (combined value).
+			 * Bits 0x00FF = debug level (0=off, higher=more verbose)
+			 * Bits 0xFF00 = module bitmap (which ACS modules to trace)
+			 * Setting this parameter sends: ACS dbgtrace <value>
+			 * Reading this parameter actively queries: ACS get_dbgtrace
+			 * (in parity with hostapd's actual state when radio is active)
+			 * NOT persistent: wpa_ctrl-only, hostapd resets to default on restart.
+			 */
+			uint32 DebugTrace {
+				on action read call wld_rad_getAcsDebugTrace_prf;
+				default 0;
+			}
+
+			/**
+			 * Enable/disable QACS (Qualcomm ACS) extension algorithm.
+			 * When disabled, the standard hostapd ACS algorithm is used instead.
+			 * Sent as: ACS qacs_enable <0|1>
+			 */
+			%persistent bool QacsEnable {
+				default true;
+			}
+
+			/**
+			 * Comma-separated list of channels to block from ACS selection.
+			 * Setting a non-empty value sends: ACS set_block_chan_list <channels>
+			 * Example: "1,6,11" blocks channels 1, 6, and 11.
+			 * Use clearBlockChanList() to remove all blocked channels.
+			 * NOT persistent: wpa_ctrl-only, hostapd resets to default on restart.
+			 */
+			string BlockChanList {
+				default "";
+			}
+
+			/**
+			 * ACS channel list restriction.
+			 * Restricts ACS to scan only the specified channels or channel ranges.
+			 * Format: comma-separated channels or ranges (e.g., "3-8" or "1,6,11" or "1,6,11-13").
+			 * Written to hostapd config as: chanlist <space-separated channels/ranges>
+			 * Config-file-only parameter (no wpa_ctrl runtime command).
+			 * Written unconditionally (applies to both startup ACS and invokeACS()).
+			 * Empty string = no restriction (all channels allowed, default).
+			 * Corresponds to: uci set wireless.wifiX.channels=3-8
+			 */
+			%persistent string ChannelList {
+				default "";
+			}
+
+			/**
+			 * 2.4 GHz ACS channel scan mode.
+			 * false (0) = scan only non-overlapping channels 1, 6, 11 (default)
+			 * true  (1) = scan all available 2.4 GHz channels
+			 * Sent as: ACS 2g_scan_all <0|1>
+			 */
+			%persistent bool Scan2GAllChannels {
+				default false;
+			}
+
+			/**
+			 * Current ACS status, read from hostapd via "ACS get_status".
+			 * Values: "Inprogress" | "Idle"
+			 */
+			%read-only string Status {
+				on action read call wld_rad_getAcsStatus_prf;
+				default "Idle";
+			}
+
+			/**
+			 * Retrieve the last ACS channel ranking report from hostapd.
+			 * Sends: ACS show_report
+			 * @return string containing the ACS channel report, or empty if unavailable.
+			 */
+			string showReport();
+
+			/**
+			 * Clear the ACS blocked channel list.
+			 * Sends: ACS clear_block_chan_list
+			 * Also resets BlockChanList to empty string.
+			 */
+			void clearBlockChanList();
+
+			/**
+			 * Retrieve the ACS neighbor report (detected neighboring APs from last scan).
+			 * Sends: ACS show_neighbor_report
+			 * @return string containing the neighbor report table, or empty if unavailable.
+			 */
+			string showNeighborReport();
+		}
+
 		/** <p>The current radio channel used by the connection. To
 			 request automatic channel selection, set AutoChannelEnable
 			 to true. Whenever AutoChannelEnable is true, the value of
--- a/src/Plugin/wifiGen_eventHandlers.c
+++ b/src/Plugin/wifiGen_eventHandlers.c
@@ -604,6 +604,31 @@ static void s_awgnInterferenceDetectedCb
     T_Radio* pRad = (T_Radio*) userData;
     ASSERT_NOT_NULL(pRad, , ME, "NULL");
 
+    /*
+     * Explicitly trigger the wpaCtrlEvents AMX signal on the Radio object so that
+     * prplmesh and other bus subscribers receive the INTERFERENCE-DETECTED event.
+     *
+     * Root cause why this is needed:
+     * The INTERFERENCE-DETECTED event is received on a VAP interface (e.g. wlan0.1),
+     * not on the radio interface (e.g. wlan0). The generic forwarding path goes through
+     * s_wpaCtrlRadioStdEvt (registered as fProcStdEvtMsg on the radio manager), but
+     * that function has the guard:
+     *   ASSERTS_TRUE(swl_str_matches(pRad->Name, ifName), ...)
+     * which fails when ifName="wlan0.1" != pRad->Name="wlan0", causing it to return
+     * early without calling s_notifyWpaCtrlEvent / amxd_object_trigger_signal.
+     * We therefore trigger the signal directly here where pRad->pBus is available.
+     */
+    char msgData[512] = {0};
+    snprintf(msgData, sizeof(msgData), "INTERFERENCE-DETECTED %s", params);
+    amxc_var_t eventData;
+    amxc_var_init(&eventData);
+    amxc_var_set_type(&eventData, AMXC_VAR_ID_HTABLE);
+    amxc_var_add_key(cstring_t, &eventData, "ifName", ifName);
+    amxc_var_add_key(cstring_t, &eventData, "eventData", msgData);
+    SAH_TRACEZ_ERROR(ME, "%s: notify wpaCtrlEvents INTERFERENCE-DETECTED eventData=%s", pRad->Name, msgData);
+    amxd_object_trigger_signal(pRad->pBus, "wpaCtrlEvents", &eventData);
+    amxc_var_clean(&eventData);
+
     /* Check if this is a WLAN/CW interference event that will trigger ACS */
     char typeStr[32] = {0};
         if(wld_wpaCtrl_getValueStr(params, "type", typeStr, sizeof(typeStr)) > 0 &&
--- a/src/nl80211/wld_hostapd_cfgFile.c
+++ b/src/nl80211/wld_hostapd_cfgFile.c
@@ -679,6 +679,126 @@ void wld_hostapd_cfgFile_setRadioConfig(
         s_filterEntries(radConfigMap, mbssidKeys, SWL_ARRAY_SIZE(mbssidKeys));
     }
 
+    /*
+     * Write ACS configuration parameters to hostapd config file.
+     *
+     * ALL ACS channel-filtering parameters are written UNCONDITIONALLY so they
+     * persist across hostapd restarts and also apply when invokeACS() triggers
+     * dynamic ACS with AutoChannelEnable=false.
+     *
+     * Cross-reference with hostapd acs.c — each parameter is checked inside
+     * ACS functions (scan/interference/selection phases) that run for both
+     * startup ACS (channel=0) and dynamic ACS (ACS invoke):
+     *
+     *   qacs_enable           → unconditional (persists for next ACS run)
+     *   acs_2g_scan_all       → unconditional (persists for next ACS run)
+     *   acs_periodic_interval → unconditional (persists for next ACS run)
+     *   acsmin_dwell          → unconditional (persists for next ACS run)
+     *   acsmax_dwell          → unconditional (persists for next ACS run)
+     *   acs_exclude_dfs       → unconditional: scan+interference+selection phases
+     *   acs_pcaconly          → unconditional: scan+selection phases (config-file-only)
+     *   acs_exclude_6ghz_non_psc → unconditional: selection phase
+     *   chanlist              → unconditional: scan+interference+selection phases
+     *                           (config-file-only, no wpa_ctrl runtime command)
+     *
+     * All parameters are also applied at runtime via wpa_ctrl (invokeACS /
+     * individual ACS set handlers) so they take effect immediately when the
+     * radio is active.
+     */
+    if(pRad->pBus) {
+        amxd_object_t* acsObj = amxd_object_findf(pRad->pBus, "ACS");
+        if(acsObj != NULL) {
+            /* qacs_enable: written unconditionally — persists for next ACS run.
+             * Corresponds to: uci set wireless.@wifi-iface[1].qacs_enable=<0|1> */
+            bool qacsEnable = amxd_object_get_bool(acsObj, "QacsEnable", NULL);
+            swl_mapCharFmt_addValInt32(radConfigMap, "qacs_enable", qacsEnable ? 1 : 0);
+
+            /* acs_2g_scan_all: written unconditionally — persists for next ACS run.
+             * Corresponds to: uci set wireless.wifiX.acs_2g_scan_all=<0|1> */
+            swl_mapCharFmt_addValInt32(radConfigMap, "acs_2g_scan_all",
+                                       amxd_object_get_bool(acsObj, "Scan2GAllChannels", NULL) ? 1 : 0);
+
+            /* acs_periodic_interval: written unconditionally when in valid range.
+             * Corresponds to: uci set wireless.wifiX.acs_periodic_interval=<sec>
+             * Valid range: 60..86400 seconds (0 = disabled, not written). */
+            uint32_t periodicInterval = amxd_object_get_uint32_t(acsObj, "PeriodicInterval", NULL);
+            if(periodicInterval >= 60 && periodicInterval <= 86400) {
+                swl_mapCharFmt_addValInt32(radConfigMap, "acs_periodic_interval", periodicInterval);
+            }
+
+            /* acsmin_dwell: minimum dwell time in ms.
+             * hostapd enforces a hard floor of 50ms (values below 50 are clamped to 50).
+             * Written unconditionally — persists for next ACS run.
+             * Corresponds to: uci set wireless.wifiX.acsmin_dwell=<ms> */
+            uint32_t minDwellTime = amxd_object_get_uint32_t(acsObj, "MinDwellTime", NULL);
+            if(minDwellTime >= 50) {
+                swl_mapCharFmt_addValInt32(radConfigMap, "acsmin_dwell", minDwellTime);
+            }
+
+            /* acsmax_dwell: maximum dwell time in ms.
+             * Written unconditionally — persists for next ACS run.
+             * Corresponds to: uci set wireless.wifiX.acsmax_dwell=<ms> */
+            uint32_t maxDwellTime = amxd_object_get_uint32_t(acsObj, "MaxDwellTime", NULL);
+            if(maxDwellTime >= 50) {
+                swl_mapCharFmt_addValInt32(radConfigMap, "acsmax_dwell", maxDwellTime);
+            }
+
+            /* acs_exclude_dfs: written unconditionally so it also applies when
+             * invokeACS() triggers dynamic ACS with AutoChannelEnable=false.
+             * acs_exclude_dfs is a config-file-only parameter (no wpa_ctrl command). */
+            if(amxd_object_get_bool(acsObj, "DfsExclude", NULL)) {
+                swl_mapCharFmt_addValInt32(radConfigMap, "acs_exclude_dfs", 1);
+            }
+
+            /* acs_pcaconly: written unconditionally so it also applies when
+             * invokeACS() triggers dynamic ACS with AutoChannelEnable=false.
+             * acs_pcaconly is a config-file-only parameter (no wpa_ctrl command).
+             * Corresponds to hostapd conf->acs_dfs_available_only. */
+            if(amxd_object_get_bool(acsObj, "PcacOnly", NULL)) {
+                swl_mapCharFmt_addValInt32(radConfigMap, "acs_pcaconly", 1);
+            }
+
+            /* acs_exclude_6ghz_non_psc: written unconditionally so it also applies
+             * when invokeACS() triggers dynamic ACS with AutoChannelEnable=false.
+             * Checked in hostapd acs_find_ideal_chan_mode() selection phase.
+             * Also applied at runtime via wpa_ctrl: ACS 6g_only_psc <0|1> */
+            if(amxd_object_get_bool(acsObj, "OnlyPscChannels6G", NULL)) {
+                swl_mapCharFmt_addValInt32(radConfigMap, "acs_exclude_6ghz_non_psc", 1);
+            }
+
+            /* chanlist: written unconditionally so it also applies when
+             * invokeACS() triggers dynamic ACS with AutoChannelEnable=false.
+             * Checked in all three ACS phases (scan, interference, selection).
+             * chanlist is a config-file-only parameter (no wpa_ctrl runtime command).
+             * hostapd format: space-separated channels or ranges (e.g., "1 6 11-13").
+             * DM format: comma-separated (e.g., "1,6,11-13" or "3-8").
+             * Corresponds to: uci set wireless.wifiX.channels=3-8 */
+            char* chanList = amxd_object_get_cstring_t(acsObj, "ChannelList", NULL);
+            if(!swl_str_isEmpty(chanList)) {
+                char spaceSep[256] = {0};
+                swl_str_copy(spaceSep, sizeof(spaceSep), chanList);
+                for(char* p = spaceSep; *p; p++) {
+                    if(*p == ',') {
+                        *p = ' ';
+                    }
+                }
+                swl_mapChar_add(radConfigMap, "chanlist", spaceSep);
+                SAH_TRACEZ_INFO(ME, "%s: ACS chanlist written: '%s'", pRad->Name, spaceSep);
+            }
+            free(chanList);
+
+            SAH_TRACEZ_INFO(ME, "%s: ACS config file params written (qacs_enable=%d, 2g_all=%d, period=%u, "
+                            "dfs_excl=%d, pcaconly=%d, psc6g=%d)",
+                            pRad->Name,
+                            qacsEnable ? 1 : 0,
+                            amxd_object_get_bool(acsObj, "Scan2GAllChannels", NULL) ? 1 : 0,
+                            periodicInterval,
+                            amxd_object_get_bool(acsObj, "DfsExclude", NULL) ? 1 : 0,
+                            amxd_object_get_bool(acsObj, "PcacOnly", NULL) ? 1 : 0,
+                            amxd_object_get_bool(acsObj, "OnlyPscChannels6G", NULL) ? 1 : 0);
+        }
+    }
+
     if(pRad->externalAcsMgmt) {
         SAH_TRACEZ_INFO(ME, "%s: Restore radio channel config due to external ACS mgmt enabled", pRad->Name);
         swl_mapCharFmt_addValInt32(radConfigMap, "channel", tgtChan);
--- a/src/wld_radio.c
