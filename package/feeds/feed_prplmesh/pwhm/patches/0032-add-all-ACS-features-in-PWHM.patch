+/* --- ACS.clearBlockChanList() function --- */
+
+amxd_status_t _clearBlockChanList(amxd_object_t* object,
+                                             amxd_function_t* func _UNUSED,
+                                             amxc_var_t* args _UNUSED,
+                                             amxc_var_t* retval _UNUSED) {
+    T_Radio* pRad = wld_rad_fromObj(amxd_object_get_parent(object));
+    ASSERT_NOT_NULL(pRad, amxd_status_unknown_error, ME, "NULL");
+
+    /* Always reset the BlockChanList DM parameter to empty string.
+     * object IS the ACS object — BlockChanList is a direct child parameter. */
+    swl_typeCharPtr_commitObjectParam(object, "BlockChanList", "");
+
+    /* Send the wpa_ctrl command only if the radio is active.
+     * If the radio is not active, the DM is cleared and we return success —
+     * the cleared value will be applied on the next hostapd restart. */
+    T_AccessPoint* pAP = s_getAcsAp(pRad);
+    if(pAP == NULL || !wld_rad_isActive(pRad)) {
+        SAH_TRACEZ_INFO(ME, "%s: ACS.clearBlockChanList: radio not active, DM cleared only", pRad->Name);
+        return amxd_status_ok;
+    }
+
+    /*
+     * Use GetResponse instead of CheckResponse: hostapd's clear_block_chan_list
+     * may return an empty reply (not "OK") on success. Only treat explicit "FAIL"
+     * as an error. An empty or "OK" reply both indicate success.
+     */
+    char reply[256] = {0};
+    swl_rc_ne rc = wld_wpaCtrl_sendCmdFmtGetResponse(
+        pAP->wpaCtrlInterface, reply, sizeof(reply), "ACS clear_block_chan_list");
+
+    if(!swl_rc_isOk(rc)) {
+        SAH_TRACEZ_ERROR(ME, "%s: ACS.clearBlockChanList: wpa_ctrl send failed", pRad->Name);
+        return amxd_status_unknown_error;
+    }
+
+    if(strncmp(reply, "FAIL", 4) == 0) {
+        SAH_TRACEZ_ERROR(ME, "%s: ACS.clearBlockChanList: hostapd returned FAIL", pRad->Name);
+        return amxd_status_unknown_error;
+    }
+
+    SAH_TRACEZ_INFO(ME, "%s: ACS.clearBlockChanList: cleared (reply='%s')", pRad->Name, reply);
+    return amxd_status_ok;
+}
