+        if(swl_str_matches(configKey, "enable_mscs") && pAP->qosMgmt.MSCSEnable) {
+            return true;
+        }
+        if(swl_str_matches(configKey, "enable_dscp_policy_capa") && pAP->WMMCapability) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static int s_hostapdQosCapaState(T_Radio* pRad, const char* configKey, bool valueMeansCapability) {
+    ASSERTS_NOT_NULL(pRad, -1, ME, "NULL");
+    ASSERTS_STR(configKey, -1, ME, "empty config key");
+    ASSERTS_NOT_NULL(pRad->hostapd, -1, ME, "%s: no hostapd", pRad->Name);
+    ASSERTS_STR(pRad->hostapd->cfgFile, -1, ME, "%s: no hostapd cfg file", pRad->Name);
+
+    wld_hostapd_config_t* config = NULL;
+    bool ret = wld_hostapd_loadConfig(&config, pRad->hostapd->cfgFile);
+    ASSERTS_TRUE(ret, -1, ME, "%s: failed to load hostapd config %s", pRad->Name, pRad->hostapd->cfgFile);
+
+    const char* globalValue = wld_hostapd_getConfigParamValStr(config, NULL, configKey);
+    bool found = (swl_str_len(globalValue) > 0);
+    bool enabled = found && s_hostapdCfgParamToBool(globalValue);
+    T_AccessPoint* pAP = NULL;
+    wld_rad_forEachAp(pAP, pRad) {
+        if((pAP->pSSID == NULL) || swl_mac_binIsNull((swl_macBin_t*) pAP->pSSID->BSSID)) {
+            continue;
+        }
+        const char* bssValue = wld_hostapd_getConfigParamByBssidValStr(config, (swl_macBin_t*) pAP->pSSID->BSSID,
+                                                                        configKey);
+        found |= (swl_str_len(bssValue) > 0);
+        enabled |= s_hostapdCfgParamToBool(bssValue);
+    }
+    wld_hostapd_deleteConfig(config);
+    if(!found) {
+        return -1;
+    }
+    return (valueMeansCapability ? enabled : true) ? 1 : 0;
+}
+
+static bool s_hostapdQosCapaSupported(T_Radio* pRad, const char* configKey, bool valueMeansCapability) {
+    int hostapdState = s_hostapdQosCapaState(pRad, configKey, valueMeansCapability);
+    bool defaultCapa = s_radioQosCapaDefault(pRad, configKey);
+    return (hostapdState >= 0) ? (hostapdState == 1) : defaultCapa;
+}
