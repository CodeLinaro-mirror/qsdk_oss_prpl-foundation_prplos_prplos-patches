+/**
+ * @struct wld_qosMgmtDescriptor_t
+ * @brief Represents a single QoS Management Descriptor entry for a client station.
+ *
+ * This structure holds the configuration for one Stream Classification Service (SCS)
+ * or Mirrored Stream Classification Service (MSCS) descriptor associated with a
+ * specific client MAC address.
