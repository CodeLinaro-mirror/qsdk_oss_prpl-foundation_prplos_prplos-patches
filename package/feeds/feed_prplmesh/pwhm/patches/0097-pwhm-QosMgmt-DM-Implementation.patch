+		/**
+		 * Object encapsulating QoS Management configuration parameters.
+		 * This object manages MSCS (Mirrored Stream Classification Service) and
+		 * SCS (Stream Classification Service) features for QoS traffic management.
+		 */
+		%persistent object QoSMgmt {
+			on event "*" call wld_apQosMgmt_setConf_ocf;
+
+			/**
+			 * Enable or disable Mirrored Stream Classification Service (MSCS) for this VAP.
+			 */
+			%persistent bool MSCSEnable {
+				default true;
+			}
+
+			/**
+			 * Enable or disable Stream Classification Service (SCS) for this VAP.
+			 */
+			%persistent bool SCSEnable {
+				default true;
+			}
+
+			/**
+			 * List of QoS Management Descriptors (MSCS/SCS).
+			 * Each entry is indexed by qmid and MACAddress, and includes the descriptor.
+			 */
+			%persistent object QosMgmtDesc[] {
+				on action destroy call wld_ap_deleteQosMgmtDesc_odf;
+				on event "*" call wld_apQosMgmtDescEntry_setConf_ocf;
+
+				/**
+				 * [Alias] A unique identifier for this QoS Management Descriptor entry.
+				 */
+				%unique %key string Alias;
+
+				/**
+				 * MAC address of the client station for this QoS descriptor.
+				 */
+				%read-only string MACAddress;
+
+				/**
+				 * QoS Management Identifier - unique ID for this descriptor.
+				 */
+				%read-only uint16 qmid;
+
+				/**
+				 * The descriptor content defining QoS classification rules.
+				 */
+				%read-only string Descriptor;
+			}
+
+			/**
+			 * Add/modify/remove QoS Management Descriptor (MSCS/SCS).
+			 * @param qmid: QOS management id
+			 * @param MACAddress: BSTA/associated STA MAC address used as bsta_mac in SCS_CONFIGURE
+			 * @param Descriptor: SCS/MSCS descriptor (hex string)
+			 */
