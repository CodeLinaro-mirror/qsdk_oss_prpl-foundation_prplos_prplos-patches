+static bool s_radioQosCapaDefault(T_Radio* pRad, const char* configKey) {
+    ASSERTS_NOT_NULL(pRad, false, ME, "NULL");
+    ASSERTS_STR(configKey, false, ME, "empty config key");
+
+    T_AccessPoint* pAP = NULL;
+    wld_rad_forEachAp(pAP, pRad) {
+        if(swl_str_matches(configKey, "enable_scs") && pAP->qosMgmt.SCSEnable) {
+            return true;
