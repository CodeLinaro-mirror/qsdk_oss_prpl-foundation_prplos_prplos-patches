+/**
+ * @brief Adds a QoS Management Descriptor for a specific client station.
+ *
+ * Creates a new QosMgmtDesc instance in the data model and instructs the
+ * driver/hostapd to apply the descriptor for traffic classification.
+ * Validates that no duplicate entry exists for the same MAC+QMID combination.
+ *
+ * @param[in] pAP Pointer to the T_AccessPoint structure
+ * @param[in] qmid QoS Management Identifier (0-255), must be unique per client
+ * @param[in] client_mac Client MAC address string (format: xx:xx:xx:xx:xx:xx)
+ * @param[in] descriptor Hex string containing the IEEE 802.11 QoS descriptor
+ *
+ * @return amxd_status_t Status code:
+ *         - amxd_status_ok: Successfully added descriptor
+ *         - amxd_status_unknown_error: Duplicate entry, driver error, or data model error
+ */
+static amxd_status_t s_addQosMgmtDescriptor(T_AccessPoint* pAP, size_t qmid, const char* client_mac, const char* descriptor) {
+    ASSERT_NOT_NULL(pAP, amxd_status_unknown_error, ME, "NULL");
+    ASSERT_NOT_NULL(client_mac, amxd_status_unknown_error, ME, "NULL");
+    ASSERT_NOT_NULL(descriptor, amxd_status_unknown_error, ME, "NULL");
+
+    amxd_object_t* QosObject = amxd_object_get(pAP->pBus, "QoSMgmt");
+    if(!QosObject) {
+        SAH_TRACEZ_ERROR(ME, "QoS object not found");
+        return amxd_status_unknown_error;
+    }
+
+    amxd_object_t* descList = amxd_object_get(QosObject, "QosMgmtDesc");
+    if(!descList) {
+        SAH_TRACEZ_ERROR(ME, "QosMgmtDesc list not found");
+        return amxd_status_unknown_error;
+    }
+
+    // Check if entry already exists
+    amxd_object_for_each(instance, it, descList) {
+        amxd_object_t* entry = amxc_container_of(it, amxd_object_t, it);
+        char* entryMac = amxd_object_get_cstring_t(entry, "MACAddress", NULL);
+        size_t entryQmid = amxd_object_get_uint32_t(entry, "qmid", 0);
+        if(entryMac && (swl_str_matches(entryMac, client_mac)) && (entryQmid == qmid)) {
+            free(entryMac);
+            SAH_TRACEZ_ERROR(ME, "Descriptor already exists for mac=%s qmid=%zu", client_mac, qmid);
+            return amxd_status_unknown_error;
+        }
+        free(entryMac);
+    }
+
+    swl_macBin_t macBin;
+    if(!swl_typeMacBin_fromChar(&macBin, client_mac)) {
+        SAH_TRACEZ_ERROR(ME, "Invalid MAC format: %s", client_mac);
+        return amxd_status_unknown_error;
+    }
+
+    swl_rc_ne ret = pAP->pFA->mfn_wvap_set_qosmgmt_descriptor(pAP, qmid, descriptor, macBin);
+    if(ret != SWL_RC_OK) {
+        SAH_TRACEZ_ERROR(ME, "Failed to set QoS management descriptor: %d", ret);
+        return amxd_status_unknown_error;
+    }
+
+    uint32_t index = 0;
+    amxd_object_t* instance = NULL;
+    amxd_status_t status = amxd_object_new_instance(&instance, descList, NULL, index, NULL);
+    if((status != amxd_status_ok) || !instance) {
+        SAH_TRACEZ_ERROR(ME, "Failed to create QosMgmtDesc instance: %d", status);
+        return status;
+    }
+
+    amxd_trans_t trans;
+    ASSERT_TRANSACTION_INIT(instance, &trans, amxd_status_unknown_error, ME, "trans init failure");
+    // Enable modification of read-only parameters
+    amxd_trans_set_attr(&trans, amxd_tattr_change_ro, true);
+
+    // Set all parameters
+    amxd_trans_set_value(uint32_t, &trans, "qmid", qmid);
+    amxd_trans_set_value(cstring_t, &trans, "MACAddress", client_mac);
+    amxd_trans_set_value(cstring_t, &trans, "Descriptor", descriptor);
+
+    ASSERT_TRANSACTION_LOCAL_DM_END(&trans, amxd_status_unknown_error, ME, "trans apply failure");
+
+    instance->priv = instance;
+
+    s_syncQoSMgmt(pAP->pBus);
+
+    return amxd_status_ok;
+}
+
+/**
+ * @brief Removes a QoS Management Descriptor for a specific client station.
+ *
+ * Deletes the QosMgmtDesc instance from the data model and instructs the
+ * driver/hostapd to stop enforcing the descriptor rules. Searches for the
+ * entry by MAC+QMID combination.
+ *
+ * @param[in] pAP Pointer to the T_AccessPoint structure
+ * @param[in] qmid QoS Management Identifier (0-255) of the descriptor to remove
+ * @param[in] client_mac Client MAC address string (format: xx:xx:xx:xx:xx:xx)
+ * @param[in] descriptor Hex string of the descriptor being removed (for driver notification)
+ *
+ * @return amxd_status_t Status code:
+ *         - amxd_status_ok: Successfully removed descriptor
+ *         - amxd_status_unknown_error: Entry not found, driver error, or deletion failed
+ */
+static amxd_status_t s_removeQosMgmtDescriptor(T_AccessPoint* pAP, size_t qmid, const char* client_mac, const char* descriptor) {
+    ASSERT_NOT_NULL(pAP, amxd_status_unknown_error, ME, "NULL");
+    ASSERT_NOT_NULL(client_mac, amxd_status_unknown_error, ME, "NULL");
+
+    amxd_object_t* QosObject = amxd_object_get(pAP->pBus, "QoSMgmt");
+    if(!QosObject) {
+        SAH_TRACEZ_ERROR(ME, "QoS object not found");
+        return amxd_status_unknown_error;
+    }
+
+    amxd_object_t* descList = amxd_object_get(QosObject, "QosMgmtDesc");
+    if(!descList) {
+        SAH_TRACEZ_ERROR(ME, "QosMgmtDesc list not found");
+        return amxd_status_unknown_error;
+    }
+
+    amxd_object_t* found = NULL;
+    amxd_object_for_each(instance, it, descList) {
+        amxd_object_t* entry = amxc_container_of(it, amxd_object_t, it);
+        char* entryMac = amxd_object_get_cstring_t(entry, "MACAddress", NULL);
+        size_t entryQmid = amxd_object_get_uint32_t(entry, "qmid", 0);
+        if(entryMac && (swl_str_matches(entryMac, client_mac)) && (entryQmid == qmid)) {
+            found = entry;
+            swl_macBin_t macBin;
+            if(!swl_typeMacBin_fromChar(&macBin, client_mac)) {
+                SAH_TRACEZ_ERROR(ME, "Invalid MAC format: %s", client_mac);
+                free(entryMac);
+                return amxd_status_unknown_error;
+            }
+            swl_rc_ne status = pAP->pFA->mfn_wvap_set_qosmgmt_descriptor(pAP, qmid, descriptor, macBin);
+            if(status != SWL_RC_OK) {
+                SAH_TRACEZ_ERROR(ME, "Failed to remove QoS management descriptor: %d", status);
+                free(entryMac);
+                return amxd_status_unknown_error;
+            }
+            free(entryMac);
+            break;
+        }
+        free(entryMac);
+    }
+
+    if(!found) {
+        SAH_TRACEZ_ERROR(ME, "Descriptor not found for mac=%s qmid=%zu", client_mac, qmid);
+        return amxd_status_unknown_error;
+    }
+
+    if(swl_object_delInstWithTransOnLocalDm(found) != amxd_status_ok) {
+        SAH_TRACEZ_ERROR(ME, "Failed to delete QosMgmtDesc instance");
+        return amxd_status_unknown_error;
+    }
+    found = NULL;
+
+    return amxd_status_ok;
+}
+
+amxd_status_t _handleQosMgmtDesc(amxd_object_t* obj, amxd_function_t* func _UNUSED, amxc_var_t* args, amxc_var_t* ret _UNUSED) {
+    SAH_TRACEZ_IN(ME);
+
+    amxd_status_t state = amxd_status_unknown_error;
+    T_AccessPoint* pAP = wld_ap_fromObj(amxd_object_get_parent(obj));
+    ASSERT_NOT_NULL(pAP, state, ME, "NULL");
+
+    const uint16_t qmid = GET_UINT32(args, "qmid");
+    const char* client_mac = GET_CHAR(args, "MACAddress");
+    const char* descriptor = GET_CHAR(args, "Descriptor");
+
+    if((client_mac == NULL) || (descriptor == NULL)) {
+        SAH_TRACEZ_ERROR(ME, "client_mac or Descriptor is NULL");
+        return state;
+    }
+
+    if(!swl_mac_charIsValidStaMac((swl_macChar_t*) client_mac)) {
+        SAH_TRACEZ_ERROR(ME, "Invalid STA MAC address for SCS_CONFIGURE: %s", client_mac);
+        return state;
+    }
+
+    size_t len = strlen(descriptor);
+
+    if((len < 8) || (len % 2 != 0)) {
+        SAH_TRACEZ_ERROR(ME, "Invalid descriptor length");
+        return state;
+    }
+
+    for(size_t i = 0; i < len; i++) {
+        if(!isxdigit((unsigned char) descriptor[i])) {
+            SAH_TRACEZ_ERROR(ME, "Descriptor contains non-hex characters");
+            return state;
+        }
+    }
+
+    /* Extract Element ID */
+    uint8_t elem_id;
+    char tmp_elem[3] = { descriptor[0], descriptor[1], '\0' };
+    elem_id = (uint8_t) strtoul(tmp_elem, NULL, 16);
+
+    /* Extract Ext ID*/
+    uint8_t ext_id;
+    char tmp_ext[3] = { descriptor[4], descriptor[5], '\0' };
+    ext_id = (uint8_t) strtoul(tmp_ext, NULL, 16);
+
+    char desc_type[5] = {0}; // Enough for "MSCS", "SCS", and null terminator
+    if(elem_id == 255) {
+        if(ext_id != 88) {
+            SAH_TRACEZ_ERROR(ME, "Invalid Ext ID for MSCS: %u", ext_id);
+            return state;
+        }
+        swl_str_copy(desc_type, sizeof(desc_type), "MSCS");
+    } else if((elem_id == 185) && (ext_id > 0)) {
+        swl_str_copy(desc_type, sizeof(desc_type), "SCS");
+    } else {
+        SAH_TRACEZ_ERROR(ME, "Invalid Elem ID: %u", elem_id);
+        return state;
+    }
+
+    /* Extract Request Type (byte 3) */
+    uint8_t req_type;
+    char tmp[3] = { descriptor[6], descriptor[7], '\0' };
+    req_type = (uint8_t) strtoul(tmp, NULL, 16);
+
+    // Check if the corresponding feature is enabled before proceeding
+    if(((swl_str_matches(desc_type, "MSCS")) && !pAP->qosMgmt.MSCSEnable) ||
+       ((swl_str_matches(desc_type, "SCS")) && !pAP->qosMgmt.SCSEnable)) {
+        SAH_TRACEZ_ERROR(ME, "%s is disabled, cannot handle descriptor for mac=%s", desc_type, client_mac);
+        return state;
+    }
+
+    swl_macBin_t clientMacBin;
+    if(!swl_typeMacBin_fromChar(&clientMacBin, client_mac)) {
+        SAH_TRACEZ_ERROR(ME, "Invalid MAC format: %s", client_mac);
+        return state;
+    }
+    if((pAP->pSSID != NULL) && SWL_MAC_BIN_MATCHES(&clientMacBin, (swl_macBin_t*) pAP->pSSID->BSSID)) {
+        SAH_TRACEZ_ERROR(ME, "%s: handleQosMgmtDesc MACAddress must be STA MAC, not AP BSSID %s",
+                         pAP->alias, client_mac);
+        return state;
+    }
+
+    switch(req_type) {
+    case 0:
+        state = s_addQosMgmtDescriptor(pAP, qmid, client_mac, descriptor);
+        break;
+    case 1:
+        state = s_removeQosMgmtDescriptor(pAP, qmid, client_mac, descriptor);
+        break;
+    case 2: {
+        /* For modify, set req_type to 1 before remove */
+        char mod_desc[WLD_QOSMGMT_DESCRIPTOR_MAX_LEN];
+        swl_str_copy(mod_desc, sizeof(mod_desc), descriptor);
+        if(strlen(mod_desc) >= 8) {
+            mod_desc[6] = '0';
+            mod_desc[7] = '1';
+        }
+        /* set req_type to 0 before add*/
+        state = s_removeQosMgmtDescriptor(pAP, qmid, client_mac, mod_desc);
+        if(strlen(mod_desc) >= 8) {
+            mod_desc[6] = '0';
+            mod_desc[7] = '0';
+        }
+        state = s_addQosMgmtDescriptor(pAP, qmid, client_mac, mod_desc);
+        break;
+    }
+    default:
+        SAH_TRACEZ_ERROR(ME, "Unknown Request Type: %u", req_type);
+        break;
+    }
+    return state;
+}
+
+amxd_status_t _GetSCSParams(amxd_object_t* obj, amxd_function_t* func _UNUSED, amxc_var_t* args, amxc_var_t* ret) {
+    T_AccessPoint* pAP = wld_ap_fromObj(amxd_object_get_parent(obj));
+    ASSERT_NOT_NULL(pAP, amxd_status_unknown_error, ME, "NULL");
+    ASSERT_NOT_NULL(pAP->wpaCtrlInterface, amxd_status_unknown_error, ME, "%s: no hostapd ctrl iface", pAP->alias);
+
+    const char* clientMac = GET_CHAR(args, "MACAddress");
+    ASSERTS_TRUE(swl_mac_charIsValidStaMac((swl_macChar_t*) clientMac), amxd_status_invalid_arg,
+                 ME, "Invalid client MAC address: %s", clientMac);
+
+    const char* infoType = GET_CHAR(args, "InfoType");
+    if(swl_str_len(infoType) == 0) {
+        infoType = "scs_list";
+    }
+    amxc_var_t* idArg = amxc_var_get_key(args, "ID", AMXC_VAR_FLAG_DEFAULT);
+    uint32_t id = (idArg != NULL) ? amxc_var_dyncast(uint32_t, idArg) : 0;
+
+    char reply[4096] = {0};
+    swl_rc_ne rc = SWL_RC_ERROR;
+    if(swl_str_matches(infoType, "scs_list")) {
+        rc = wld_wpaCtrl_sendCmdFmtGetResponse(pAP->wpaCtrlInterface, reply, sizeof(reply),
+                                                "DUMP_SCS_LIST %s", clientMac);
+    } else if(swl_str_matches(infoType, "scs_info")) {
+        ASSERTS_NOT_NULL(idArg, amxd_status_invalid_arg, ME, "%s: missing ID for DUMP_SCS_INFO %s",
+                         pAP->alias, clientMac);
+        rc = wld_wpaCtrl_sendCmdFmtGetResponse(pAP->wpaCtrlInterface, reply, sizeof(reply),
+                                                "DUMP_SCS_INFO %s %u", clientMac, id);
+    } else if(swl_str_matches(infoType, "qm_info")) {
+        ASSERTS_NOT_NULL(idArg, amxd_status_invalid_arg, ME, "%s: missing ID for DUMP_SCS_QM_INFO %s",
+                         pAP->alias, clientMac);
+        rc = wld_wpaCtrl_sendCmdFmtGetResponse(pAP->wpaCtrlInterface, reply, sizeof(reply),
+                                                "DUMP_SCS_QM_INFO %s %u", clientMac, id);
+    } else {
+        SAH_TRACEZ_ERROR(ME, "%s: invalid DUMP_SCS InfoType %s", pAP->alias, infoType);
+        return amxd_status_invalid_arg;
+    }
+    ASSERT_TRUE(swl_rc_isOk(rc), amxd_status_unknown_error, ME, "%s: DUMP_SCS %s %s failed rc=%d reply=%s",
+                pAP->alias, clientMac, infoType, rc, reply);
+
+    amxc_var_set(cstring_t, ret, reply);
+    return amxd_status_ok;
+}
+
+amxd_status_t _QoSMgmt_GetSCSParams(amxd_object_t* obj, amxd_function_t* func, amxc_var_t* args, amxc_var_t* ret) {
+    return _GetSCSParams(obj, func, args, ret);
+}
