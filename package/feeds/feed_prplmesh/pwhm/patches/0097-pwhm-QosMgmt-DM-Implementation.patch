+static void s_addScsEventParam(amxc_var_t* data, const char* key, const char* val) {
+    ASSERTS_NOT_NULL(data, , ME, "NULL");
+    ASSERTS_STR(key, , ME, "empty key");
+    ASSERTS_STR(val, , ME, "empty val");
+    amxc_var_add_key(cstring_t, data, key, val);
+}
+
+static void s_addScsEventData(amxc_var_t* data, const char* eventName, const char* params) {
+    ASSERTS_NOT_NULL(data, , ME, "NULL");
+    ASSERTS_STR(eventName, , ME, "empty event");
+    ASSERTS_STR(params, , ME, "empty params");
+
+    amxc_var_add_key(cstring_t, data, "params", params);
+
+    char paramsCopy[1024] = {0};
+    swl_str_copy(paramsCopy, sizeof(paramsCopy), params);
+    const char* positionalKeysReq[] = {"client_mac", "bssid", "scs_descriptor"};
+    const char* positionalKeysStatus[] = {"client_mac", "bssid", "qmid", "status"};
+    const char** positionalKeys = swl_str_matches(eventName, "CTRL-EVENT-SCS-REQUEST-NOTIFY") ?
+        positionalKeysReq : positionalKeysStatus;
+    size_t maxPositionalKeys = swl_str_matches(eventName, "CTRL-EVENT-SCS-REQUEST-NOTIFY") ?
+        SWL_ARRAY_SIZE(positionalKeysReq) : SWL_ARRAY_SIZE(positionalKeysStatus);
+
+    char* savePtr = NULL;
+    char* token = strtok_r(paramsCopy, " \t", &savePtr);
+    size_t tokenIndex = 0;
+    while(token != NULL) {
+        char* sep = strchr(token, '=');
+        if(sep != NULL) {
+            *sep = '\0';
+            s_addScsEventParam(data, token, sep + 1);
+        } else if(tokenIndex < maxPositionalKeys) {
+            s_addScsEventParam(data, positionalKeys[tokenIndex], token);
+        }
+        tokenIndex++;
+        token = strtok_r(NULL, " \t", &savePtr);
+    }
+}
