+amxd_status_t _wld_radStaMon_getQosSupport_prf(amxd_object_t* object,
+                                               amxd_param_t* param,
+                                               amxd_action_t reason,
+                                               const amxc_var_t* const args _UNUSED,
+                                               amxc_var_t* const retval,
+                                               void* priv _UNUSED) {
+    ASSERTS_NOT_NULL(param, amxd_status_unknown_error, ME, "NULL");
+    ASSERTS_EQUALS(reason, action_param_read, amxd_status_function_not_implemented, ME, "not impl");
+
+    T_Radio* pRad = wld_rad_fromObj(object);
+    if(pRad == NULL) {
+        pRad = wld_rad_fromObj(amxd_object_get_parent(object));
+    }
+    ASSERTS_NOT_NULL(pRad, amxd_status_ok, ME, "no radio mapped");
+
+    const char* paramName = amxd_param_get_name(param);
+    bool value = false;
+    if((paramName != NULL) && (strcmp(paramName, "MSCSSupport") == 0)) {
+        value = pRad->cap.mscsSupported;
+    } else if((paramName != NULL) && (strcmp(paramName, "SCSSupport") == 0)) {
+        value = pRad->cap.scsSupported || pRad->cap.mscsSupported;
+    } else if((paramName != NULL) && (strcmp(paramName, "QoSMapSupport") == 0)) {
+        value = pRad->cap.qosMapSupported;
+    } else if((paramName != NULL) && (strcmp(paramName, "QMSCSTrafficDescriptionSupport") == 0)) {
+        value = pRad->cap.scsTrafficDescriptionSupported;
+    } else {
+        SAH_TRACEZ_WARNING(ME, "%s: unexpected Radio QoS support param %s",
+                           pRad->Name, paramName ? paramName : "?");
+        return amxd_status_invalid_arg;
+    }
+
+    amxc_var_set(bool, retval, value);
+    return amxd_status_ok;
 }
 
