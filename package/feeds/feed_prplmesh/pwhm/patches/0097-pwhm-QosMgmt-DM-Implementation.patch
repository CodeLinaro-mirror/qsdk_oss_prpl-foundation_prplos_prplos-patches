+/**
+ * @brief Data model parameter write handler for MSCSEnable flag.
+ *
+ * Called when the MSCSEnable parameter changes in the QoSMgmt object.
+ * Updates the internal state and notifies the driver/hostapd to enable/disable
+ * the MSCS feature.
+ */
+static void s_setMSCSEnabled_pwf(void* priv _UNUSED, amxd_object_t* object, amxd_param_t* param _UNUSED, const amxc_var_t* const newValue) {
+    SAH_TRACEZ_IN(ME);
+
+    T_AccessPoint* pAP = wld_ap_fromObj(amxd_object_get_parent(object));
+    ASSERTS_NOT_NULL(pAP, , ME, "pAP NULL");
+
+    bool newEnable = amxc_var_dyncast(bool, newValue);
+    if(newEnable != pAP->qosMgmt.MSCSEnable) {
+        pAP->qosMgmt.MSCSEnable = newEnable;
+        s_updateHostapdCfgParam(pAP, "enable_mscs", pAP->qosMgmt.MSCSEnable);
+        pAP->pFA->mfn_wvap_enable_mscs(pAP, pAP->qosMgmt.MSCSEnable);
+    }
+    SAH_TRACEZ_OUT(ME);
+}
+
+/**
+ * @brief Data model parameter write handler for SCSEnable flag.
+ *
+ * Called when the SCSEnable parameter changes in the QoSMgmt object.
+ * Updates the internal state and notifies the driver/hostapd to enable/disable
+ * the SCS feature.
+ */
+static void s_setSCSEnabled_pwf(void* priv _UNUSED, amxd_object_t* object, amxd_param_t* param _UNUSED, const amxc_var_t* const newValue) {
+    SAH_TRACEZ_IN(ME);
+
+    T_AccessPoint* pAP = wld_ap_fromObj(amxd_object_get_parent(object));
+    ASSERTS_NOT_NULL(pAP, , ME, "pAP NULL");
+
+    bool newEnable = amxc_var_dyncast(bool, newValue);
+    if(newEnable != pAP->qosMgmt.SCSEnable) {
+        pAP->qosMgmt.SCSEnable = newEnable;
+        s_updateHostapdCfgParam(pAP, "enable_scs", pAP->qosMgmt.SCSEnable);
+        s_updateHostapdCfgParam(pAP, "deferred_scs", pAP->qosMgmt.SCSEnable);
+        pAP->pFA->mfn_wvap_enable_scs(pAP, pAP->qosMgmt.SCSEnable);
+    }
+    SAH_TRACEZ_OUT(ME);
+}
+
+SWLA_DM_HDLRS(sApQosDmHdlrs,
+              ARR(SWLA_DM_PARAM_HDLR("MSCSEnable", s_setMSCSEnabled_pwf),
+                  SWLA_DM_PARAM_HDLR("SCSEnable", s_setSCSEnabled_pwf),
+                  ));
+
+void _wld_apQosMgmt_setConf_ocf(const char* const sig_name, const amxc_var_t* const data, void* const priv) {
+    swla_dm_procObjEvtOfLocalDm(&sApQosDmHdlrs, sig_name, data, priv);
+}
