+static void s_updateHostapdCfgParam(T_AccessPoint* pAP, const char* key, bool enable) {
+    ASSERTS_NOT_NULL(pAP, , ME, "NULL");
+    ASSERTS_NOT_NULL(pAP->pRadio, , ME, "%s: no radio", pAP->alias);
+    ASSERTS_NOT_NULL(pAP->pRadio->hostapd, , ME, "%s: no hostapd", pAP->alias);
+    ASSERTS_STR(pAP->pRadio->hostapd->cfgFile, , ME, "%s: no hostapd cfg file", pAP->alias);
+    ASSERTS_STR(key, , ME, "%s: empty hostapd cfg key", pAP->alias);
+
+    const char* value = enable ? "1" : "0";
+    bool updated = wld_hostapd_cfgFile_update(pAP->pRadio->hostapd->cfgFile, pAP->alias, key, value);
+    ASSERTI_TRUE(updated, , ME, "%s: failed to update hostapd cfg %s=%s", pAP->alias, key, value);
+}
+
+/**
+ * @brief Synchronizes QoS descriptor changes from data model to internal state.
+ *
+ * Reads all QosMgmtDesc instances from the data model and updates the internal
+ * descriptor array. Validates that each MAC address has at most 4 descriptors.
+ * Returns whether any changes were detected.
+ *
+ * @param[in] qosMgmt Pointer to the QoSMgmt object in the data model
+ * @param[in,out] descriptors Array of wld_qosMgmtDescriptor_t structures to update
+ * @param[in,out] count Pointer to the total descriptor count
+ * @param[in] maxentries Maximum number of descriptor entries (MAXNROF_DESCENTRIES)
+ *
+ * @return bool Indicates whether changes were detected:
+ *         - true: Changes were found and applied to descriptors/count
+ *         - false: No changes detected or QosMgmtDesc not found
+ *
+ * @note Each MAC address is limited to a maximum of 4 descriptors
+ * @note Descriptors beyond the 4-per-MAC limit are skipped with an error log
+ * @note Only entries with priv != NULL are processed
+ * @note Changes include: qmid, MAC, or descriptor content modifications
+ */
+static bool s_syncDescriptorChanges(amxd_object_t* qosMgmt, wld_qosMgmtDescriptor_t descriptors[], size_t* count, size_t maxentries) {
+    size_t idx = 0;
+    size_t changes = 0;
+    amxd_object_t* templateObj = amxd_object_get(qosMgmt, "QosMgmtDesc");
+
+    if(!templateObj) {
+        SAH_TRACEZ_WARNING(ME, "QosMgmtDesc not found");
+        return false;
+    }
+
+    // Track number of descriptors per MAC
+    size_t mac_desc_count[maxentries];
+    char macs_seen[maxentries][ETHER_ADDR_STR_LEN];
+    memset(mac_desc_count, 0, sizeof(mac_desc_count));
+    memset(macs_seen, 0, sizeof(macs_seen));
+
+    amxd_object_for_each(instance, it, templateObj) {
+        if(idx >= maxentries) {
+            break;
+        }
+        amxd_object_t* entry = amxc_container_of(it, amxd_object_t, it);
+        if(entry->priv == NULL) {
+            continue;
+        }
+
+        const char* macstr = GET_CHAR(amxd_object_get_param_value(entry, "MACAddress"), NULL);
+        const char* descstr = GET_CHAR(amxd_object_get_param_value(entry, "Descriptor"), NULL);
+        uint32_t entryQmid = amxc_var_dyncast(uint32_t, amxd_object_get_param_value(entry, "qmid"));
+
+        if(macstr && descstr) {
+            // Count descriptors for this MAC
+            int found = -1;
+            for(size_t i = 0; i < idx; ++i) {
+                if(SWL_MAC_CHAR_MATCHES(macstr, macs_seen[i])) {
+                    found = i;
+                    break;
+                }
+            }
+            if(found == -1) {
+                // New MAC
+                swl_str_copy(macs_seen[idx], ETHER_ADDR_STR_LEN, macstr);
+                mac_desc_count[idx] = 1;
+            } else {
+                mac_desc_count[found]++;
+                if(mac_desc_count[found] > 4) {
+                    SAH_TRACEZ_ERROR(ME, "More than 4 descriptors for MAC %s, skipping", macstr);
+                    continue;
+                }
+            }
+
+            swl_macBin_t macBin;
+            if(!swl_typeMacBin_fromChar(&macBin, macstr)) {
+                SAH_TRACEZ_ERROR(ME, "Invalid MAC format: %s", macstr);
+                continue;
+            }
+
+            // If qmid and mac are same, only update descriptor if needed
+            if((entryQmid == descriptors[idx].qmid) && SWL_MAC_BIN_MATCHES(&macBin, &descriptors[idx].mac)) {
+                if(!swl_str_matches(descstr, descriptors[idx].descriptor)) {
+                    changes++;
+                    swl_str_copy(descriptors[idx].descriptor, WLD_QOSMGMT_DESCRIPTOR_MAX_LEN, descstr);
+                }
+            } else {
+                // If qmid or mac is different, update all fields
+                changes++;
+                memcpy(descriptors[idx].mac.bMac, macBin.bMac, ETHER_ADDR_LEN);
+                swl_str_copy(descriptors[idx].descriptor, WLD_QOSMGMT_DESCRIPTOR_MAX_LEN, descstr);
+                descriptors[idx].qmid = entryQmid;
+            }
+            idx++;
+        }
+    }
+
+    if(idx != *count) {
+        *count = idx;
+        changes++;
+    }
+    for(; idx < maxentries; idx++) {
+        memset(descriptors[idx].mac.bMac, 0, ETHER_ADDR_LEN);
+        memset(descriptors[idx].descriptor, 0, WLD_QOSMGMT_DESCRIPTOR_MAX_LEN);
+        descriptors[idx].qmid = 0;
+    }
+
+    return changes != 0;
+}
+
+/**
+ * This function syncs the QoS Management configuration for an access point.
+ * @param object The amxd_object_t pointer representing the access point object.
+ */
+static void s_syncQoSMgmt(amxd_object_t* object) {
+    SAH_TRACEZ_IN(ME);
+
+    T_AccessPoint* pAP = wld_ap_fromObj(object);
+    ASSERTS_NOT_NULL(pAP, , ME, "NULL");
+
+    amxd_object_t* qosMgmt = amxd_object_get(object, "QoSMgmt");
+    ASSERTS_NOT_NULL(qosMgmt, , ME, "QoSMgmt not found");
+
+    // Check MSCS Enable
+    bool mscsEnable = amxd_object_get_bool(qosMgmt, "MSCSEnable", NULL);
+    if(mscsEnable != pAP->qosMgmt.MSCSEnable) {
+        SAH_TRACEZ_INFO(ME, "%s: Update MSCS Enable from %u to %u", pAP->alias, pAP->qosMgmt.MSCSEnable, mscsEnable);
+        pAP->qosMgmt.MSCSEnable = mscsEnable;
+    }
+
+    // Check SCS Enable
+    bool scsEnable = amxd_object_get_bool(qosMgmt, "SCSEnable", NULL);
+    if(scsEnable != pAP->qosMgmt.SCSEnable) {
+        SAH_TRACEZ_INFO(ME, "%s: Update SCS Enable from %u to %u", pAP->alias, pAP->qosMgmt.SCSEnable, scsEnable);
+        pAP->qosMgmt.SCSEnable = scsEnable;
+    }
+
+    // Sync descriptors
+    s_syncDescriptorChanges(qosMgmt, pAP->qosMgmt.QosMgmtDescriptors, &pAP->qosMgmt.QosMgmtDescriptorCount, MAXNROF_DESCENTRIES);
+
+    SAH_TRACEZ_OUT(ME);
+}
+
+/**
+ * @brief Data model parameter write handler for QoS descriptor entries.
+ *
+ * Called when qmid or Descriptor parameters change in a QosMgmtDesc instance.
+ * Marks the object as synchronized and triggers s_syncQoSMgmt() to apply changes.
+ *
+ * @param[in] priv Private data (unused)
+ * @param[in] object Pointer to the QosMgmtDesc instance object
+ * @param[in] param Pointer to the parameter being modified
+ * @param[in] newValue New value being set
+ *
+ * @post object->priv is set to object (marks as synchronized)
+ * @post s_syncQoSMgmt() is called to propagate changes
+ *
+ * @note Registered via SWLA_DM_PARAM_HDLR for "qmid" and "Descriptor" parameters
+ */
+static void s_setQosDescEntry_pwf(void* priv _UNUSED, amxd_object_t* object, amxd_param_t* param _UNUSED, const amxc_var_t* const newValue _UNUSED) {
+    SAH_TRACEZ_IN(ME);
+
+    amxd_object_t* categFObj = amxd_object_get_parent(amxd_object_get_parent(object));
+    amxd_object_t* apObj = amxd_object_get_parent(categFObj);
+    object->priv = object;
+
+    s_syncQoSMgmt(apObj);
+
+    SAH_TRACEZ_OUT(ME);
+}
+
+SWLA_DM_HDLRS(sApQosDescEntryDmHdlrs, ARR(SWLA_DM_PARAM_HDLR("qmid", s_setQosDescEntry_pwf),
+                                          SWLA_DM_PARAM_HDLR("Descriptor", s_setQosDescEntry_pwf),));
+
+void _wld_apQosMgmtDescEntry_setConf_ocf(const char* const sig_name, const amxc_var_t* const data, void* const priv) {
+    swla_dm_procObjEvtOfLocalDm(&sApQosDescEntryDmHdlrs, sig_name, data, priv);
+}
