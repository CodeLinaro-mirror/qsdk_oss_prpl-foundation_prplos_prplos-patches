+    swl_macBin_t mac;
+    char descriptor[WLD_QOSMGMT_DESCRIPTOR_MAX_LEN];
+    uint32_t qmid;
+} wld_qosMgmtDescriptor_t;
+
+/**
+ * @struct wld_qosMgmtConfig_t
+ * @brief QoS Management configuration state for an IEEE 802.11 access point.
+ *
+ * This structure maintains the complete QoS Management state including:
+ * - Feature enable/disable flags for SCS and MSCS
+ * - Active QoS descriptors for all connected clients
+ */
+typedef struct {
