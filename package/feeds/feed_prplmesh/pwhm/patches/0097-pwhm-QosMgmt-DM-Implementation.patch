+static const char* s_getHostapdCfgParamForAp(wld_hostapd_config_t* config, T_AccessPoint* pAP, const char* key) {
+    ASSERTS_NOT_NULL(config, NULL, ME, "NULL");
+    ASSERTS_NOT_NULL(pAP, NULL, ME, "NULL");
+    ASSERTS_STR(key, NULL, ME, "empty key");
+
+    const char* value = NULL;
+    if((pAP->pSSID != NULL) && !swl_mac_binIsNull((swl_macBin_t*) pAP->pSSID->BSSID)) {
+        value = wld_hostapd_getConfigParamByBssidValStr(config, (swl_macBin_t*) pAP->pSSID->BSSID, key);
+    }
+    if(swl_str_len(value) == 0) {
+        value = wld_hostapd_getConfigParamValStr(config, NULL, key);
+    }
+    return value;
+}
+
+static void s_initQosMgmtFromHostapdConfig(T_AccessPoint* pAP) {
+    ASSERTS_NOT_NULL(pAP, , ME, "NULL");
+    ASSERTS_FALSE(pAP->qosMgmt.hostapdCfgSynced, , ME, "%s: QoSMgmt already synced from hostapd config", pAP->alias);
+    ASSERTS_NOT_NULL(pAP->pRadio, , ME, "%s: no radio", pAP->alias);
+    ASSERTS_NOT_NULL(pAP->pRadio->hostapd, , ME, "%s: no hostapd", pAP->alias);
+    ASSERTS_STR(pAP->pRadio->hostapd->cfgFile, , ME, "%s: no hostapd cfg file", pAP->alias);
+    ASSERTS_NOT_NULL(pAP->pSSID, , ME, "%s: no SSID", pAP->alias);
+
+    wld_hostapd_config_t* config = NULL;
+    bool ret = wld_hostapd_loadConfig(&config, pAP->pRadio->hostapd->cfgFile);
+    ASSERTS_TRUE(ret, , ME, "%s: failed to load hostapd config %s", pAP->alias, pAP->pRadio->hostapd->cfgFile);
+    pAP->qosMgmt.hostapdCfgSynced = true;
+
+    const char* scs = s_getHostapdCfgParamForAp(config, pAP, "enable_scs");
+    const char* mscs = s_getHostapdCfgParamForAp(config, pAP, "enable_mscs");
+    const char* dscpPolicy = s_getHostapdCfgParamForAp(config, pAP, "enable_dscp_policy_capa");
+    if(swl_str_len(scs) > 0) {
+        pAP->qosMgmt.SCSEnable = s_hostapdCfgParamToBool(scs);
+    }
+    if(swl_str_len(mscs) > 0) {
+        pAP->qosMgmt.MSCSEnable = s_hostapdCfgParamToBool(mscs);
+    }
+    if((swl_str_len(dscpPolicy) > 0) && s_hostapdCfgParamToBool(dscpPolicy)) {
+        pAP->pRadio->cap.dscpPolicySupported = true;
+    }
+    wld_hostapd_deleteConfig(config);
+}
