+    bool MSCSEnable;  /**< Enable Mirrored Stream Classification Service feature on this AP */
+    bool hostapdCfgSynced; /**< Initial enable flags have been read from saved hostapd config */
+
+    /* QoS Management descriptors */
+    wld_qosMgmtDescriptor_t QosMgmtDescriptors[MAXNROF_DESCENTRIES];
+    size_t QosMgmtDescriptorCount;
+
