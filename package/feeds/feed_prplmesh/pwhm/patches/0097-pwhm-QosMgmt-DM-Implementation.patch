+static bool s_hostapdCfgParamToBool(const char* value) {
+    return (swl_str_matches(value, "1") ||
+            swl_str_matches(value, "true") ||
+            swl_str_matches(value, "TRUE") ||
+            swl_str_matches(value, "on") ||
