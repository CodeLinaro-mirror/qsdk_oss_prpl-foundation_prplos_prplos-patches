+
+/**
+ * @def MAXNROF_STA_FOR_MSCS_SCS
+ * @brief Maximum number of stations that can have active MSCS or SCS descriptors.
+ */
+#define MAXNROF_STA_FOR_MSCS_SCS    (256)
+
+/**
+ * @def MAXNROF_DESCENTRIES
+ * @brief Maximum number of QoS descriptor entries across all clients.
+ *
+ * Each client can have up to 4 QoS Management descriptors (Stream Classification Service
+ * or Mirrored Stream Classification Service rules). This limit is calculated as:
+ * MAXNROF_STA_FOR_MSCS_SCS * 4
+ */
+#define MAXNROF_DESCENTRIES      (MAXNROF_STA_FOR_MSCS_SCS * 4)
+
+/**
+ * @def WLD_QOSMGMT_DESCRIPTOR_MAX_LEN
+ * @brief Maximum length of a QoS Management descriptor hex string (including null terminator).
+ *
+ * The descriptor is a hex-encoded string representing the IEEE 802.11 QoS Management
+ * frame body. This must be an even-length hex string with minimum 8 characters.
+ */
+#define WLD_QOSMGMT_DESCRIPTOR_MAX_LEN 256
+
 #define NR_OF_STICKY_UNAUTHORIZED_STATIONS 1
 #define MAXNROF_STAENTRY (wld_getMaxNrSta() + NR_OF_STICKY_UNAUTHORIZED_STATIONS)
 
