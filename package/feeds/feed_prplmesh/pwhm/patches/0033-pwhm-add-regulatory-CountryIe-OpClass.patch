+    SAH_TRACEZ_INFO(ME, "%s: opclassTbl %u via %s", pR->Name, tableIdx, pAP->alias);
+    swl_rc_ne rc = wld_wpaCtrl_sendCmdFmtCheckResponse(
+        pAP->wpaCtrlInterface, "OK", "SET_OPCLASS_TBL_IDX %u", tableIdx);
