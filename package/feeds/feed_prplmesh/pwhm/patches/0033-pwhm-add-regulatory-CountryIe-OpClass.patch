+/* ---- disableOpclassChans ---- */
+amxd_status_t _disableOpclassChans(amxd_object_t* object,
+                                    amxd_function_t* func _UNUSED,
+                                    amxc_var_t* args,
+                                    amxc_var_t* retval) {
+    T_Radio* pR = wld_rad_fromObj(object);
+    ASSERT_NOT_NULL(pR, amxd_status_unknown_error, ME, "NULL");
+
+    bool disable     = GET_BOOL(args, "disable");
+    uint32_t opclass = GET_UINT32(args, "opclass");
+    char* channels   = amxc_var_dyncast(cstring_t, GET_ARG(args, "channels"));
+
+    if(!channels || channels[0] == '\0') {
+        SAH_TRACEZ_ERROR(ME, "%s: disableOpclassChans: channels must not be empty", pR->Name);
+        amxc_var_set(bool, retval, false);
+        return amxd_status_invalid_arg;
+    }
+
+    T_AccessPoint* pAP = s_getCtrlAp(pR);
+    if(pAP == NULL) {
+        SAH_TRACEZ_ERROR(ME, "%s: disableOpclassChans: no AP available", pR->Name);
+        amxc_var_set(bool, retval, false);
+        return amxd_status_unknown_error;
+    }
+
+    /* Build "DISABLE_OPCLASS_CHANS <0|1> <opclass> <ch1> [<ch2> ...]"
+     * Input channels is comma-separated; replace commas with spaces. */
+    char chanBuf[256];
+    snprintf(chanBuf, sizeof(chanBuf), "%s", channels);
+    for(char* p = chanBuf; *p; p++) {
+        if(*p == ',') *p = ' ';
+    }
+
+    SAH_TRACEZ_INFO(ME, "%s: disableOpclassChans disable=%d opclass=%u chans='%s' via %s",
+                    pR->Name, disable ? 1 : 0, opclass, chanBuf, pAP->alias);
+    swl_rc_ne rc = wld_wpaCtrl_sendCmdFmtCheckResponse(
+        pAP->wpaCtrlInterface, "OK",
+        "DISABLE_OPCLASS_CHANS %d %u %s", disable ? 1 : 0, opclass, chanBuf);
+
+    bool success = swl_rc_isOk(rc);
+    if(!success) {
+        SAH_TRACEZ_ERROR(ME, "%s: disableOpclassChans failed (rc=%d)", pR->Name, rc);
+    }
+    amxc_var_set(bool, retval, success);
+    return success ? amxd_status_ok : amxd_status_unknown_error;
+}
