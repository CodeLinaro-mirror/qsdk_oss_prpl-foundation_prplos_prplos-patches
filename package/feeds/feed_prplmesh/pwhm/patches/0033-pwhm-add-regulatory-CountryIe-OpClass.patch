+/* ============================================================
+ * Regulatory / operating-class / pure-N / band helpers
+ *
+ * All hostapd-ctrl commands follow the invokeACS pattern:
+ *   - get first active (or enabled) AP on this radio
+ *   - send command via wpa_ctrl
+ *   - return result via amxc_var retval
+ *
+ * cfg80211tool commands use popen() to query the driver directly.
+ * ============================================================ */
+
+/* Maximum reply buffer for wpa_ctrl responses */
+#define QCA_CTRL_REPLY_MAX 1024
+/* Maximum output buffer for popen-based cfg80211tool queries */
+#define QCA_POPEN_OUT_MAX  4096
+
+/* Helper: get the first usable AP for wpa_ctrl commands on pRad. */
+static T_AccessPoint* s_getCtrlAp(T_Radio* pRad) {
+    T_AccessPoint* pAP = wld_rad_getFirstActiveAp(pRad);
+    if(pAP == NULL) {
+        pAP = wld_rad_getFirstEnabledVap(pRad);
+    }
+    return pAP;
+}
+
+/* Helper: run a cfg80211tool command via popen() and store stdout in outBuf.
+ * outBuf must be at least outBufSize bytes; always NUL-terminated.
+ * Returns SWL_RC_OK on success, SWL_RC_ERROR on popen failure. */
+static swl_rc_ne s_cfg80211tool_run(const char* cmd, char* outBuf, size_t outBufSize) {
+    FILE* fp = popen(cmd, "r");
+    if(fp == NULL) {
+        SAH_TRACEZ_ERROR(ME, "popen failed for: %s", cmd);
+        if(outBufSize > 0) outBuf[0] = '\0';
+        return SWL_RC_ERROR;
+    }
+    size_t total = 0;
+    size_t capacity = outBufSize > 0 ? outBufSize - 1 : 0;
+    while(total < capacity) {
+        size_t nr = fread(outBuf + total, 1, capacity - total, fp);
+        if(nr == 0) break;
+        total += nr;
+    }
+    if(outBufSize > 0) outBuf[total] = '\0';
+    pclose(fp);
+    return SWL_RC_OK;
+}
+
+/* Helper: resolve the nl80211 phy name (e.g. "phy2") for a wlan interface.
+ * Reads /sys/class/net/<wlan>/phy80211/name; falls back to wlanName on error. */
+static void s_get_phy_name(const char* wlanName, char* phyBuf, size_t phyBufSize) {
+    char path[128];
+    snprintf(path, sizeof(path), "/sys/class/net/%s/phy80211/name", wlanName);
+    FILE* fp = fopen(path, "r");
+    if(!fp) {
+        snprintf(phyBuf, phyBufSize, "%s", wlanName);
+        return;
+    }
+    size_t n = fread(phyBuf, 1, phyBufSize - 1, fp);
+    fclose(fp);
+    phyBuf[n] = '\0';
+    while(n > 0 && (phyBuf[n - 1] == '\n' || phyBuf[n - 1] == '\r'))
+        phyBuf[--n] = '\0';
+}
+
+/* ---- setCountryId ---- */
+amxd_status_t _setCountryId(amxd_object_t* object,
+                             amxd_function_t* func _UNUSED,
+                             amxc_var_t* args,
+                             amxc_var_t* retval) {
+    T_Radio* pR = wld_rad_fromObj(object);
+    ASSERT_NOT_NULL(pR, amxd_status_unknown_error, ME, "NULL");
+
+    uint32_t countryId = GET_UINT32(args, "countryId");
+
+    char phyName[IFNAMSIZ];
+    s_get_phy_name(pR->wiphyName, phyName, sizeof(phyName));
+
+    char cmd[256];
+    char out[QCA_POPEN_OUT_MAX];
+    /* cfg80211tool requires: phyX radio_idx <idx> <cmd> [value]
+     * radio_idx must immediately follow the phy interface name. */
+    snprintf(cmd, sizeof(cmd),
+             "cfg80211tool %s radio_idx 0 set_country_id %u 2>&1",
+             phyName, countryId);
+
+    SAH_TRACEZ_INFO(ME, "%s: setCountryId %u cmd='%s'", pR->Name, countryId, cmd);
+    bool success = (s_cfg80211tool_run(cmd, out, sizeof(out)) == SWL_RC_OK);
+
+    amxc_var_set(bool, retval, success);
+    return success ? amxd_status_ok : amxd_status_unknown_error;
+}
+
+/* ---- getCountryId ---- */
+amxd_status_t _getCountryId(amxd_object_t* object,
+                             amxd_function_t* func _UNUSED,
+                             amxc_var_t* args _UNUSED,
+                             amxc_var_t* retval) {
+    T_Radio* pR = wld_rad_fromObj(object);
+    ASSERT_NOT_NULL(pR, amxd_status_unknown_error, ME, "NULL");
+
+    char cmd[256];
+    char out[QCA_POPEN_OUT_MAX];
+    char phyName[IFNAMSIZ];
+    s_get_phy_name(pR->wiphyName, phyName, sizeof(phyName));
+    snprintf(cmd, sizeof(cmd),
+             "cfg80211tool %s radio_idx 0 get_country_id 2>&1",
+             phyName);
+
+    SAH_TRACEZ_INFO(ME, "%s: getCountryId cmd='%s'", pR->Name, cmd);
+    if(s_cfg80211tool_run(cmd, out, sizeof(out)) != SWL_RC_OK) {
+        SAH_TRACEZ_ERROR(ME, "%s: getCountryId: popen failed", pR->Name);
+        amxc_var_set(cstring_t, retval, "");
+        return amxd_status_unknown_error;
+    }
+    size_t len = strlen(out);
+    while(len > 0 && (out[len - 1] == '\n' || out[len - 1] == '\r')) {
+        out[--len] = '\0';
+    }
+    amxc_var_set(cstring_t, retval, out);
+    return amxd_status_ok;
+}
+
+/* ---- countryIe (set) ---- */
+amxd_status_t _countryIe(amxd_object_t* object,
+                          amxd_function_t* func _UNUSED,
+                          amxc_var_t* args,
+                          amxc_var_t* retval) {
+    T_Radio* pR = wld_rad_fromObj(object);
+    ASSERT_NOT_NULL(pR, amxd_status_unknown_error, ME, "NULL");
+
+    bool enable = GET_BOOL(args, "enable");
+
+    T_AccessPoint* pAP = s_getCtrlAp(pR);
+    if(pAP == NULL) {
+        SAH_TRACEZ_ERROR(ME, "%s: countryIe: no AP available", pR->Name);
+        amxc_var_set(bool, retval, false);
+        return amxd_status_unknown_error;
+    }
+
+    SAH_TRACEZ_INFO(ME, "%s: countryIe %d via %s", pR->Name, enable ? 1 : 0, pAP->alias);
+    swl_rc_ne rc = wld_wpaCtrl_sendCmdFmtCheckResponse(
+        pAP->wpaCtrlInterface, "OK", "COUNTRY_IE %d", enable ? 1 : 0);
+
+    bool success = swl_rc_isOk(rc);
+    if(!success) {
+        SAH_TRACEZ_ERROR(ME, "%s: countryIe %d failed (rc=%d)", pR->Name, enable ? 1 : 0, rc);
+    }
+    amxc_var_set(bool, retval, success);
+    return success ? amxd_status_ok : amxd_status_unknown_error;
+}
+
+/* ---- getCountryIe ---- */
+amxd_status_t _getCountryIe(amxd_object_t* object,
+                             amxd_function_t* func _UNUSED,
+                             amxc_var_t* args _UNUSED,
+                             amxc_var_t* retval) {
