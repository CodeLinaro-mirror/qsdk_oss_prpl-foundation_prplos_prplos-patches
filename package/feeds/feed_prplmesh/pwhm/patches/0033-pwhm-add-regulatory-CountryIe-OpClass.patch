+
+    if(!swl_rc_isOk(rc)) {
+        SAH_TRACEZ_ERROR(ME, "%s: getCountryIe failed (rc=%d)", pR->Name, rc);
+        amxc_var_set(cstring_t, retval, "");
+        return amxd_status_unknown_error;
+    }
+    size_t len = strlen(reply);
+    while(len > 0 && (reply[len - 1] == '\n' || reply[len - 1] == '\r' || reply[len - 1] == ' ')) {
+        reply[--len] = '\0';
+    }
+    amxc_var_set(cstring_t, retval, reply);
+    return amxd_status_ok;
+}
