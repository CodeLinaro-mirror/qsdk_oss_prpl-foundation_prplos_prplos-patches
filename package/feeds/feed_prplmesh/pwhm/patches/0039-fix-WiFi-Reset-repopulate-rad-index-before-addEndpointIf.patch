From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Abhi Teja Cholleti <achollet@qti.qualcomm.com>
Date: Wed, 25 Jun 2026 00:00:00 +0000
Subject: [PATCH] pwhm: fix WiFi.Reset() Nth call, reboot, and guest VAP
 factory reset

Signed-off-by: Abhi Teja Cholleti <achollet@qti.qualcomm.com>
---
diff --git a/src/Plugin/wifiGen_radIfMgt.c b/src/Plugin/wifiGen_radIfMgt.c
--- a/src/Plugin/wifiGen_radIfMgt.c
+++ b/src/Plugin/wifiGen_radIfMgt.c
@@ -404,20 +404,51 @@
     wld_ssid_generateMac(pRad, pSSID, 0, &epMacAddr);
     bool use4Mac = (pEP != NULL) ? pEP->multiAPEnable : true;
     wld_linuxIfUtils_setState(wld_rad_getSocket(pRad), pRad->Name, false);
+    uint32_t wiphyIfIdx = (uint32_t) pRad->index;
     if((pRad->isSTA) && (swl_str_matches(pRad->Name, epIfname))) {
-        wld_nl80211_getInterfaceInfo(wld_nl80211_getSharedState(), pRad->index, &ifaceInfo);
-        if(ifaceInfo.use4Mac && ifaceInfo.isSta) {
-            goto End;
+        if(wiphyIfIdx > 0) {
+            wld_nl80211_getInterfaceInfo(wld_nl80211_getSharedState(), wiphyIfIdx, &ifaceInfo);
+            if(ifaceInfo.use4Mac && ifaceInfo.isSta) {
+                goto End;
+            }
+            /* The 'managed'/'4addr' modes cannot be set if the interface is already in a bridge */
+            wld_nl80211_delInterface(wld_nl80211_getSharedState(), wiphyIfIdx);
         }
-        /* The 'managed'/'4addr' modes cannot be set if the interface is already in a bridge */
-        wld_nl80211_delInterface(wld_nl80211_getSharedState(), pRad->index);
     }
     wld_nl80211_newIfaceConf_t newIfaceConf = {
         .type = NL80211_IFTYPE_STATION,
         .mac = epMacAddr,
         .use4Mac = use4Mac,
     };
-    swl_rc_ne rc = wld_nl80211_newInterfaceExt(wld_nl80211_getSharedState(), pRad->index, epIfname, &newIfaceConf, &ifaceInfo);
+    swl_rc_ne rc;
+    if(wiphyIfIdx > 0) {
+        rc = wld_nl80211_newInterfaceExt(wld_nl80211_getSharedState(), wiphyIfIdx, epIfname, &newIfaceConf, &ifaceInfo);
+    } else {
+        /* pRad->index was zeroed by s_delInterfaceCb after the FSM teardown deleted
+         * the STA interface.  Before falling back to wiphy-based creation, check
+         * whether the interface already exists under its name (e.g. created by
+         * addDefaultWiphyInterfaces after wifiGen_rad_supports ran with index=0).
+         * If so, recover the real ifIndex so we use the correct wiphy. */
+        uint32_t recoveredIdx = (uint32_t) if_nametoindex(pRad->Name);
+        if(recoveredIdx > 0) {
+            SAH_TRACEZ_WARNING(ME, "%s: rad ifIndex was 0, recovered ifIndex %u via if_nametoindex",
+                               pRad->Name, recoveredIdx);
+            pRad->index = (int) recoveredIdx;
+            rc = wld_nl80211_newInterfaceExt(wld_nl80211_getSharedState(), recoveredIdx, epIfname, &newIfaceConf, &ifaceInfo);
+        } else {
+            /* Interface truly does not exist — recreate via wiphy (set at startup,
+             * never cleared by FSM teardown). */
+            SAH_TRACEZ_WARNING(ME, "%s: rad ifIndex is 0, creating ep iface %s via wiphy %u",
+                               pRad->Name, epIfname, pRad->wiphy);
+            rc = wld_nl80211_newWiphyInterface(wld_nl80211_getSharedState(), pRad->wiphy, epIfname, &newIfaceConf, &ifaceInfo);
+        }
+        if(swl_rc_isOk(rc) && (ifaceInfo.ifIndex > 0)) {
+            SAH_TRACEZ_WARNING(ME, "%s: updating rad ifIndex to %d after ep iface creation",
+                               pRad->Name, ifaceInfo.ifIndex);
+            pRad->index = ifaceInfo.ifIndex;
+            pRad->wDevId = ifaceInfo.wDevId;
+        }
+    }
     ASSERT_TRUE(swl_rc_isOk(rc), rc, ME, "%s: fail to create new ep iface %s", pRad->Name, epIfname);
     wld_linuxIfUtils_setMac(wld_rad_getSocket(pRad), epIfname, &epMacAddr);
 
diff --git a/src/Features/persist/wld_persist_on.c b/src/Features/persist/wld_persist_on.c
--- a/src/Features/persist/wld_persist_on.c
+++ b/src/Features/persist/wld_persist_on.c
@@ -115,6 +115,18 @@
     amxd_object_t* rootObj = amxd_dm_get_root(get_wld_plugin_dm());
     amxo_parser_t* parser = get_wld_plugin_parser();
     if(s_getSavedConfPath(&confPath) && swl_fileUtils_existsFile(amxc_string_get(&confPath, 0))) {
+        /* Load the factory defaults first so nrDefaultAps reflects the
+         * baseline AP count (before any user-added guest VAPs). Then load
+         * the saved conf on top to restore the full saved configuration.
+         * Without this, nrDefaultAps would include user-created APs and
+         * WiFi.Reset() would fail to delete them. */
+        amxo_parser_parse_string(parser, "include '${odl.dm-defaults}';", rootObj);
+        while(amxp_signal_read() == 0) {
+        }
+        T_Radio* pDefaultRad = NULL;
+        wld_for_eachRad(pDefaultRad) {
+            pDefaultRad->nrDefaultAps = (uint32_t) amxc_llist_size(&pDefaultRad->llAP);
+        }
         rv = amxo_parser_parse_file(parser, amxc_string_get(&confPath, 0), rootObj);
     } else {
         rv = amxo_parser_parse_string(parser, "include '${odl.dm-defaults}';", rootObj);
@@ -135,9 +147,15 @@
      * identify user-created APs (those added beyond this baseline count)
      * and delete them to achieve a true factory reset.
      */
+    /*
+     * Record the default AP count per radio (defaults-only path). The
+     * saved-conf path already recorded this before loading the saved conf.
+     */
     T_Radio* pRad = NULL;
     wld_for_eachRad(pRad) {
-        pRad->nrDefaultAps = (uint32_t) amxc_llist_size(&pRad->llAP);
+        if(pRad->nrDefaultAps == 0) {
+            pRad->nrDefaultAps = (uint32_t) amxc_llist_size(&pRad->llAP);
+        }
     }
     SAH_TRACEZ_OUT(ME);
     return true;
diff --git a/src/wld.c b/src/wld.c
--- a/src/wld.c
+++ b/src/wld.c
@@ -1059,11 +1059,36 @@
      * addVAPIntf) are user-created. We delete them in reverse order so that
      * llAP list iteration remains stable.
      */
+    /*
+     * Pre-pass: unregister MLD links for ALL guest VAPs across ALL radios
+     * before any DM deletion transaction fires. Guest VAPs sharing an MLD
+     * group cause s_takeLink to corrupt surviving neighbors when deleted
+     * sequentially. Unregistering all MLD links first fully dissolves the
+     * MLD group before any DM transaction runs, preventing cascade corruption.
+     */
     T_Radio* tmpRad = NULL;
     wld_for_eachRad(tmpRad) {
         if(tmpRad->nrDefaultAps == 0) {
             continue;
         }
+        amxc_llist_it_t* mldIt = amxc_llist_get_last(&tmpRad->llAP);
+        uint32_t mldIdx = (uint32_t) amxc_llist_size(&tmpRad->llAP);
+        while(mldIt != NULL && mldIdx > tmpRad->nrDefaultAps) {
+            T_AccessPoint* pExtraAP = amxc_container_of(mldIt, T_AccessPoint, it);
+            mldIt = amxc_llist_it_get_previous(mldIt);
+            mldIdx--;
+            if(pExtraAP->pSSID != NULL) {
+                SAH_TRACEZ_WARNING(ME, "%s: pre-unregister MLD link for guest VAP %s",
+                                   tmpRad->Name, pExtraAP->name);
+                wld_mld_unregisterLink(pExtraAP->pSSID);
+            }
+        }
+    }
+
+    wld_for_eachRad(tmpRad) {
+        if(tmpRad->nrDefaultAps == 0) {
+            continue;
+        }
         amxd_object_t* apTmpl = amxd_object_findf(get_wld_object(), "AccessPoint");
         amxd_object_t* ssidTmpl = amxd_object_findf(get_wld_object(), "SSID");
         if(apTmpl == NULL || ssidTmpl == NULL) {
@@ -1157,7 +1182,22 @@
      * The EP-linked SSID instances (ep2g0/ep5g0/ep6g0) are NOT deleted: they
      * are standalone SSID objects that _wld_ep_addInstance_oaf links to after
      * creation, and they are not re-created by the static ODL parser.
+     *
+     * Zero pEP->index on every EP before deleting DM instances. On the 2nd+
+     * reset the EP iface is the main radio interface (same name and ifIndex
+     * as pRad->Name / pRad->index). wld_endpoint_destroy() -> s_deinitEP()
+     * calls mfn_wrad_delendpointif(pR, pEP->Name) when pEP->index > 0.
+     * wifiGen_rad_delendpointif() asserts pRad->index != ifIndex, which fails
+     * because the EP iface IS the main radio iface. The radio FSM teardown
+     * has already handled interface state, so clearing pEP->index here
+     * suppresses the redundant and incorrect kernel-interface deletion.
      */
+    wld_for_eachRad(tmpRad) {
+        T_EndPoint* pEP = NULL;
+        wld_rad_forEachEp(pEP, tmpRad) {
+            pEP->index = 0;
+        }
+    }
     s_deleteAllInstances(amxd_object_findf(get_wld_object(), "EndPoint"));
 
     /*
