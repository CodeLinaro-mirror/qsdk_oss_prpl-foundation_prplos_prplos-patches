+/*
+ * A link can remain configured in WLD as an MLO member while hostapd is
+ * running it as a standalone BSS during an MLD-unit transition.  LINK_REMOVE
+ * is only valid for a running multi-link hostapd interface; remove the
+ * standalone BSS directly so the next link-add can join the existing MLD.
+ */
+static bool s_removeDetachedMloLink(T_AccessPoint* pAP, T_Radio* pRad) {
+    ASSERTS_NOT_NULL(pAP, true, ME, "NULL pAP");
+    ASSERTS_NOT_NULL(pRad, true, ME, "NULL pRad");
+    if(!wld_secDmn_hasReadyGlobalCtrlIface(pRad->hostapd)) {
+        SAH_TRACEZ_WARNING(ME, "%s: detached MLO link has no global ctrl iface, scheduling restart",
+                           pAP->alias);
+        s_schedNextAction(SECDMN_ACTION_OK_NEED_RESTART, pAP, pRad);
+        return true;
+    }
+
+    SAH_TRACEZ_INFO(ME, "%s: removing detached standalone MLO BSS before re-add", pAP->alias);
+    swl_rc_ne rc = wld_ap_hostapd_removeBss(pAP);
+    if(!swl_rc_isOk(rc)) {
+        SAH_TRACEZ_ERROR(ME, "%s: detached standalone MLO BSS removal failed", pAP->alias);
+        s_schedNextAction(SECDMN_ACTION_OK_NEED_RE_ADD_LINK, pAP, pRad);
+        return true;
+    }
+    pRad->fsmRad.timeout_msec = 500;
+    return true;
+}
