+static void s_promotePrimaryLinkForReconfig(T_SSID* pSSID) {
+    ASSERTS_NOT_NULL(pSSID, , ME, "NULL");
+    ASSERTS_NOT_NULL(pSSID->pMldLink, , ME, "NULL");
+
+    wld_mldLink_t* pLink = pSSID->pMldLink;
+    wld_mld_t* pMld = pLink->pMld;
+    ASSERTS_NOT_NULL(pMld, , ME, "NULL MLD");
+    wld_mldLink_t* pCurPrimLink = wld_mld_getPrimaryLink(pLink);
+    /* MLDUnit is updated before the old group's UPDATE event. The moving
+     * link can still be enabled and active here; it is no longer a candidate
+     * for the old group's primary, regardless of its runtime link ID. */
+    if(s_isRemainingActiveLink(pCurPrimLink, pMld)) {
+        return;
+    }
+
+    wld_mldLink_t* pNewPrimLink = NULL;
+    wld_mldLink_t* pCandidate = NULL;
+    wld_for_eachNeighMldLink(pCandidate, pLink) {
+        if(!s_isRemainingActiveLink(pCandidate, pMld)) {
+            continue;
+        }
+        T_Radio* pRad = wld_mld_getLinkSsid(pCandidate)->RADIO_PARENT;
+        if((pRad == NULL) || (pRad->operatingFrequencyBand >= SWL_FREQ_BAND_EXT_NONE)) {
+            continue;
+        }
+        if((pNewPrimLink == NULL) ||
+           (pRad->operatingFrequencyBand <
+            wld_mld_getLinkSsid(pNewPrimLink)->RADIO_PARENT->operatingFrequencyBand)) {
+            pNewPrimLink = pCandidate;
+        }
+    }
+    if(pNewPrimLink == NULL) {
+        return;
+    }
+    if(swl_rc_isOk(wld_mld_setPrimaryLink(pNewPrimLink))) {
+        SAH_TRACEZ_INFO(ME, "SSID %s promotes MLD primary link to %s",
+                        pSSID->Name, wld_mld_getLinkName(pNewPrimLink));
+    }
 }
 
