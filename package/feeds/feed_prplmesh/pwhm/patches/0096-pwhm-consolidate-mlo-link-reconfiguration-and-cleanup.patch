+static void s_resetMloRuntimeState(T_SSID* pSSID) {
+    ASSERTS_NOT_NULL(pSSID, , ME, "NULL pSSID");
+    ASSERTS_NOT_NULL(pSSID->pMldLink, , ME, "NULL MLD link");
+    wld_mld_t* pMld = pSSID->pMldLink->pMld;
+    ASSERTS_NOT_NULL(pMld, , ME, "NULL MLD");
+
+    wld_mldLink_t* pLink = NULL;
+    wld_for_eachNeighMldLink_safe(pLink, pSSID->pMldLink) {
+        wld_mld_resetLinkId(pLink);
+        if(wld_mld_isLinkConfigured(pLink)) {
+            wld_mld_saveLinkConfigured(pLink, false);
+        }
+    }
+    pMld->hostapdRemoved = true;
+    pMld->pHostapdAnchorSSID = NULL;
+    memset(pMld->hostapdAnchorIface, 0, sizeof(pMld->hostapdAnchorIface));
+}
