+static bool s_removeLastMloLink(T_AccessPoint* pAP, T_Radio* pRad) {
+    ASSERTS_NOT_NULL(pAP, true, ME, "NULL pAP");
+    ASSERTS_NOT_NULL(pRad, true, ME, "NULL pRad");
+    T_SSID* pSSID = pAP->pSSID;
+    ASSERTS_NOT_NULL(pSSID, true, ME, "NULL SSID");
+    ASSERTS_NOT_NULL(pSSID->pMldLink, true, ME, "NULL MLD link");
+
+    wld_mld_t* pMld = pSSID->pMldLink->pMld;
+    T_AccessPoint* pAnchorAP = s_getRunningMloAnchorAp(pAP);
+    swl_rc_ne rc = SWL_RC_OK;
+    if(pAnchorAP != NULL) {
+        SAH_TRACEZ_INFO(ME, "%s: removing empty MLD anchor %s", pAP->alias, pAnchorAP->alias);
+        rc = wld_ap_hostapd_removeBss(pAnchorAP);
+        if(!swl_rc_isOk(rc)) {
+            SAH_TRACEZ_ERROR(ME, "%s: failed to remove empty MLD anchor %s", pAP->alias, pAnchorAP->alias);
+            s_schedNextAction(SECDMN_ACTION_OK_NEED_RE_ADD_LINK, pAP, pRad);
+            return true;
+        }
+    } else if((pMld != NULL) && !swl_str_isEmpty(pMld->hostapdAnchorIface)) {
+        wld_wpaCtrlInterface_t* pGlobal = wld_secDmn_getGlobalCtrlIface(pRad->hostapd);
+        if((pGlobal == NULL) || !wld_wpaCtrlInterface_isReady(pGlobal)) {
+            SAH_TRACEZ_ERROR(ME, "%s: global hostapd control interface is not ready for MLD anchor %s",
+                             pAP->alias, pMld->hostapdAnchorIface);
+            s_schedNextAction(SECDMN_ACTION_OK_NEED_RE_ADD_LINK, pAP, pRad);
+            return true;
+        }
+        SAH_TRACEZ_WARNING(ME, "%s: removing cached logical MLD anchor %s",
+                           pAP->alias, pMld->hostapdAnchorIface);
+        rc = wld_wpaCtrl_sendCmdFmtCheckResponse(pGlobal, "OK", "REMOVE %s",
+                                                  pMld->hostapdAnchorIface);
+        if(!swl_rc_isOk(rc)) {
+            SAH_TRACEZ_ERROR(ME, "%s: failed to remove cached logical MLD anchor %s",
+                             pAP->alias, pMld->hostapdAnchorIface);
+            s_schedNextAction(SECDMN_ACTION_OK_NEED_RE_ADD_LINK, pAP, pRad);
+            return true;
+        }
+    } else {
+        SAH_TRACEZ_WARNING(ME, "%s: empty MLD anchor already absent", pAP->alias);
+    }
+
+    s_resetMloRuntimeState(pSSID);
+    pRad->fsmRad.timeout_msec = 500;
+    return true;
+}
