+/* Removing an MBSSID transmitter also removes its non-transmitted BSSs in
+ * hostapd. Never use that path to recover an edit of an independent MLD. */
+static bool s_hasForeignMldOnRadio(T_AccessPoint* pAP, T_Radio* pRad) {
+    wld_mld_t* pMld = ((pAP->pSSID != NULL) && (pAP->pSSID->pMldLink != NULL)) ?
+        pAP->pSSID->pMldLink->pMld : NULL;
+    T_AccessPoint* pOther = NULL;
+    wld_rad_forEachAp(pOther, pRad) {
+        if((pOther == pAP) || !wld_wpaCtrlInterface_isReady(pOther->wpaCtrlInterface)) {
+            continue;
+        }
+        wld_mld_t* pOtherMld = ((pOther->pSSID != NULL) && (pOther->pSSID->pMldLink != NULL)) ?
+            pOther->pSSID->pMldLink->pMld : NULL;
+        if((pMld == NULL) || (pOtherMld != pMld)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool s_isUnsafeMbssidRemoval(T_AccessPoint* pAP, T_Radio* pRad) {
+    if(!wld_rad_hasMbssidAds(pRad) || !s_hasForeignMldOnRadio(pAP, pRad)) {
+        return false;
+    }
+    T_AccessPoint* pTxAP = wld_rad_hostapd_getRunMainVap(pRad);
+    return (pTxAP == NULL) || (pTxAP == pAP);
+}
+
+static bool s_hasForeignMldInDaemon(T_AccessPoint* pAP, T_Radio* pRad) {
+    wld_secDmnGrp_t* pGroup = wld_secDmn_getGrp(pRad->hostapd);
+    T_Radio* pOtherRad = NULL;
+    wld_for_eachRad(pOtherRad) {
+        if((pOtherRad != pRad) &&
+           ((pGroup == NULL) || (pOtherRad->hostapd == NULL) ||
+            (wld_secDmn_getGrp(pOtherRad->hostapd) != pGroup))) {
+            continue;
+        }
+        if(s_hasForeignMldOnRadio(pAP, pOtherRad)) {
+            return true;
+        }
+    }
+    return false;
+}
