+static T_AccessPoint* s_findRunningMloAnchorAp(T_AccessPoint* pAPContext) {
+    ASSERTS_NOT_NULL(pAPContext, NULL, ME, "NULL pAP context");
+    T_SSID* pSSID = pAPContext->pSSID;
+    if((pSSID == NULL) || (pSSID->pMldLink == NULL)) {
+        return NULL;
+    }
+
+    /* The link can already have MLDLinkID -1 when final-link cleanup runs.
+     * Query the AP being removed directly before filtering on WLD state. */
+    if((pAPContext->wpaCtrlInterface != NULL) &&
+       wld_wpaCtrlInterface_isReady(pAPContext->wpaCtrlInterface)) {
+        char runIface[128] = {0};
+        if(swl_rc_isOk(wld_ap_hostapd_getRunIface(pAPContext, runIface, sizeof(runIface)))) {
+            T_SSID* pAnchorSSID = wld_ssid_getSsidByIfName(runIface);
+            if((pAnchorSSID != NULL) && (pAnchorSSID->pMldLink == pSSID->pMldLink) &&
+               (pAnchorSSID->AP_HOOK != NULL)) {
+                return pAnchorSSID->AP_HOOK;
+            }
+        }
+    }
+
+    wld_mldLink_t* pLink = NULL;
+    wld_for_eachNeighMldLink(pLink, pSSID->pMldLink) {
+        T_SSID* pLinkSSID = wld_mld_getLinkSsid(pLink);
+        T_AccessPoint* pLinkAP = (pLinkSSID != NULL) ? pLinkSSID->AP_HOOK : NULL;
+        if((pLinkAP == NULL) || (pLinkAP->wpaCtrlInterface == NULL) ||
+           !wld_wpaCtrlInterface_isReady(pLinkAP->wpaCtrlInterface)) {
+            continue;
+        }
+
+        char runIface[128] = {0};
+        if(!swl_rc_isOk(wld_ap_hostapd_getRunIface(pLinkAP, runIface, sizeof(runIface)))) {
+            continue;
+        }
+
+        T_SSID* pAnchorSSID = wld_ssid_getSsidByIfName(runIface);
+        if((pAnchorSSID != NULL) && (pAnchorSSID->pMldLink == pSSID->pMldLink) &&
+           (pAnchorSSID->AP_HOOK != NULL)) {
+            return pAnchorSSID->AP_HOOK;
+        }
+    }
+    return NULL;
+}
