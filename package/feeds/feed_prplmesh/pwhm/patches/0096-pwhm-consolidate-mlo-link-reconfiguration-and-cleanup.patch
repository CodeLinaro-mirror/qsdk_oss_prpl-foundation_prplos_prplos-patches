 }
 
+static void s_cacheMloAnchor(T_SSID* pSSID);
+
+static T_AccessPoint* s_findRunningMloAnchorAp(T_AccessPoint* pAPContext) {
+    ASSERTS_NOT_NULL(pAPContext, NULL, ME, "NULL pAP context");
+    T_SSID* pSSID = pAPContext->pSSID;
+    if((pSSID == NULL) || (pSSID->pMldLink == NULL)) {
+        return NULL;
+    }
+
+    /* The link can already have MLDLinkID -1 when final-link cleanup runs.
+     * Query the AP being removed directly before filtering on WLD state. */
+    if((pAPContext->wpaCtrlInterface != NULL) &&
+       wld_wpaCtrlInterface_isReady(pAPContext->wpaCtrlInterface)) {
+        char runIface[128] = {0};
+        if(swl_rc_isOk(wld_ap_hostapd_getRunIface(pAPContext, runIface, sizeof(runIface)))) {
+            T_SSID* pAnchorSSID = wld_ssid_getSsidByIfName(runIface);
+            if((pAnchorSSID != NULL) && (pAnchorSSID->pMldLink == pSSID->pMldLink) &&
+               (pAnchorSSID->AP_HOOK != NULL)) {
+                return pAnchorSSID->AP_HOOK;
+            }
+        }
+    }
+
+    wld_mldLink_t* pLink = NULL;
+    wld_for_eachNeighMldLink(pLink, pSSID->pMldLink) {
+        T_SSID* pLinkSSID = wld_mld_getLinkSsid(pLink);
+        T_AccessPoint* pLinkAP = (pLinkSSID != NULL) ? pLinkSSID->AP_HOOK : NULL;
+        if((pLinkAP == NULL) || (pLinkAP->wpaCtrlInterface == NULL) ||
+           !wld_wpaCtrlInterface_isReady(pLinkAP->wpaCtrlInterface)) {
+            continue;
+        }
+
+        char runIface[128] = {0};
+        if(!swl_rc_isOk(wld_ap_hostapd_getRunIface(pLinkAP, runIface, sizeof(runIface)))) {
+            continue;
+        }
+
+        T_SSID* pAnchorSSID = wld_ssid_getSsidByIfName(runIface);
+        if((pAnchorSSID != NULL) && (pAnchorSSID->pMldLink == pSSID->pMldLink) &&
+           (pAnchorSSID->AP_HOOK != NULL)) {
+            return pAnchorSSID->AP_HOOK;
+        }
+    }
+    return NULL;
+}
+
+static T_AccessPoint* s_getRunningMloAnchorAp(T_AccessPoint* pAP) {
+    ASSERTS_NOT_NULL(pAP, NULL, ME, "NULL pAP");
+    T_SSID* pSSID = pAP->pSSID;
+    if((pSSID == NULL) || (pSSID->pMldLink == NULL)) {
+        return NULL;
+    }
+
+    /* The running hostapd MLD name takes precedence over a WLD primary
+     * link, which may now refer to a different physical radio. */
+    T_AccessPoint* pRunningAnchorAP = s_findRunningMloAnchorAp(pAP);
+    if(pRunningAnchorAP != NULL) {
+        return pRunningAnchorAP;
+    }
+
+    wld_mld_t* pMld = pSSID->pMldLink->pMld;
+    if((pMld != NULL) && (pMld->pHostapdAnchorSSID == NULL)) {
+        s_cacheMloAnchor(pSSID);
+    }
+    if((pMld != NULL) && (pMld->pHostapdAnchorSSID != NULL) &&
+       (pMld->pHostapdAnchorSSID->pMldLink == pSSID->pMldLink) &&
+       (pMld->pHostapdAnchorSSID->AP_HOOK != NULL)) {
+        return pMld->pHostapdAnchorSSID->AP_HOOK;
+    }
+
+    wld_mldLink_t* pLink = NULL;
+    wld_for_eachNeighMldLink(pLink, pSSID->pMldLink) {
+        T_SSID* pLinkSSID = wld_mld_getLinkSsid(pLink);
+        T_AccessPoint* pLinkAP = (pLinkSSID != NULL) ? pLinkSSID->AP_HOOK : NULL;
+        if((pLinkAP == NULL) || (pLinkAP->wpaCtrlInterface == NULL) ||
+           !wld_wpaCtrlInterface_isReady(pLinkAP->wpaCtrlInterface)) {
+            continue;
+        }
+
+        char runIface[128] = {0};
+        if(!swl_rc_isOk(wld_ap_hostapd_getRunIface(pLinkAP, runIface, sizeof(runIface)))) {
+            continue;
+        }
+
+        T_SSID* pAnchorSSID = wld_ssid_getSsidByIfName(runIface);
+        if((pAnchorSSID != NULL) && (pAnchorSSID->pMldLink == pSSID->pMldLink) &&
+           (pAnchorSSID->AP_HOOK != NULL)) {
+            return pAnchorSSID->AP_HOOK;
+        }
+    }
+    return NULL;
+}
+
+static void s_cacheMloAnchor(T_SSID* pSSID) {
+    ASSERTS_NOT_NULL(pSSID, , ME, "NULL pSSID");
+    ASSERTS_NOT_NULL(pSSID->pMldLink, , ME, "NULL MLD link");
+    wld_mld_t* pMld = pSSID->pMldLink->pMld;
+    ASSERTS_NOT_NULL(pMld, , ME, "NULL MLD");
+
+    /* The running MLD interface (for example wlan2.1) is a hostapd logical
+     * interface and is not represented by a WLD AP object. Keep its name so
+     * final-link cleanup can remove it even after WLD clears the link ID. */
+    if(swl_str_isEmpty(pMld->hostapdAnchorIface)) {
+        T_AccessPoint* pAP = pSSID->AP_HOOK;
+        if((pAP != NULL) && (pAP->wpaCtrlInterface != NULL) &&
+           wld_wpaCtrlInterface_isReady(pAP->wpaCtrlInterface)) {
+            char runIface[sizeof(pMld->hostapdAnchorIface)] = {0};
+            if(swl_rc_isOk(wld_ap_hostapd_getRunIface(pAP, runIface, sizeof(runIface))) &&
+               !swl_str_isEmpty(runIface)) {
+                swl_str_copy(pMld->hostapdAnchorIface,
+                             sizeof(pMld->hostapdAnchorIface), runIface);
+                SAH_TRACEZ_INFO(ME, "%s: cached running MLD anchor iface %s",
+                                pSSID->Name, pMld->hostapdAnchorIface);
+            }
+        }
+    }
+    T_AccessPoint* pRunningAnchorAP = s_findRunningMloAnchorAp(pSSID->AP_HOOK);
+    if((pRunningAnchorAP != NULL) && (pRunningAnchorAP->pSSID != NULL) &&
+       (pRunningAnchorAP->pSSID->pMldLink == pSSID->pMldLink) &&
+       ((pMld->pHostapdAnchorSSID == NULL) ||
+        (wld_mld_countNeighActiveLinks(pSSID->pMldLink) <= 1))) {
+        pMld->pHostapdAnchorSSID = pRunningAnchorAP->pSSID;
+        SAH_TRACEZ_INFO(ME, "%s: preserve running MLD anchor %s (active links:%u)",
+                        pSSID->Name, pRunningAnchorAP->alias,
+                        wld_mld_countNeighActiveLinks(pSSID->pMldLink));
+        return;
+    }
+    if(pMld->pHostapdAnchorSSID != NULL) {
+        return;
+    }
+
+    T_SSID* pMainAnchorSSID = NULL;
+    T_SSID* pPrimSSID = wld_mld_getPrimaryLinkSsid(pSSID->pMldLink);
+    if((pPrimSSID != NULL) && (pPrimSSID->pMldLink == pSSID->pMldLink) &&
+       (pPrimSSID->RADIO_PARENT != NULL)) {
+        T_AccessPoint* pMainAP = wld_rad_hostapd_getCfgMainVap(pPrimSSID->RADIO_PARENT);
+        if((pMainAP != NULL) && (pMainAP->pSSID != NULL) &&
+           (pMainAP->pSSID->pMldLink == pSSID->pMldLink) &&
+           (pMainAP->pSSID->AP_HOOK != NULL)) {
+            pMainAnchorSSID = pMainAP->pSSID;
+        }
+    }
+
+    wld_mldLink_t* pLink = NULL;
+    T_SSID* pSameLinkAnchorSSID = NULL;
+    wld_for_eachNeighMldLink(pLink, pSSID->pMldLink) {
+        T_SSID* pLinkSSID = wld_mld_getLinkSsid(pLink);
+        if((pLinkSSID == NULL) || (pLinkSSID->AP_HOOK == NULL)) {
+            continue;
+        }
+
+        char cfgIface[128] = {0};
+        if(!swl_rc_isOk(wld_ap_hostapd_getCfgInterface(pLinkSSID->AP_HOOK,
+                                                       cfgIface, sizeof(cfgIface)))) {
+            continue;
+        }
+
+        T_SSID* pAnchorSSID = wld_ssid_getSsidByIfName(cfgIface);
+        if((pAnchorSSID == NULL) || (pAnchorSSID->pMldLink != pSSID->pMldLink) ||
+           (pAnchorSSID->AP_HOOK == NULL)) {
+            continue;
+        }
+        if(pAnchorSSID != pLinkSSID) {
+            pMld->pHostapdAnchorSSID = pAnchorSSID;
+            return;
+        }
+        if(pSameLinkAnchorSSID == NULL) {
+            pSameLinkAnchorSSID = pAnchorSSID;
+        }
+    }
+
+    if(pMainAnchorSSID != NULL) {
+        pMld->pHostapdAnchorSSID = pMainAnchorSSID;
+    } else if(pSameLinkAnchorSSID != NULL) {
+        pMld->pHostapdAnchorSSID = pSameLinkAnchorSSID;
+    }
+}
+
+static void s_resetMloRuntimeState(T_SSID* pSSID) {
+    ASSERTS_NOT_NULL(pSSID, , ME, "NULL pSSID");
+    ASSERTS_NOT_NULL(pSSID->pMldLink, , ME, "NULL MLD link");
+    wld_mld_t* pMld = pSSID->pMldLink->pMld;
+    ASSERTS_NOT_NULL(pMld, , ME, "NULL MLD");
+
+    wld_mldLink_t* pLink = NULL;
+    wld_for_eachNeighMldLink_safe(pLink, pSSID->pMldLink) {
+        wld_mld_resetLinkId(pLink);
+        if(wld_mld_isLinkConfigured(pLink)) {
+            wld_mld_saveLinkConfigured(pLink, false);
+        }
+    }
+    pMld->hostapdRemoved = true;
+    pMld->pHostapdAnchorSSID = NULL;
+    memset(pMld->hostapdAnchorIface, 0, sizeof(pMld->hostapdAnchorIface));
+}
+
+/*
+ * A link removed with LINK_REMOVE is still present in the WLD MLD model, but
+ * its runtime MLDLinkID is reset to NO_LINK_ID. If the link is enabled again
+ * while another link of the same MLD is running, it must be added to that
+ * existing MLD before the regular VAP enable path is executed.
+ */
+static bool s_isEnabledMloLinkMissing(T_AccessPoint* pAP, T_Radio* pRad) {
+    ASSERTS_NOT_NULL(pAP, false, ME, "NULL pAP");
+    ASSERTS_NOT_NULL(pRad, false, ME, "NULL pRad");
+    T_SSID* pSSID = pAP->pSSID;
+    if((pSSID == NULL) || (pSSID->pMldLink == NULL) ||
+       !wld_mld_isLinkEnabled(pSSID->pMldLink) ||
+       wld_mld_isLinkActive(pSSID->pMldLink) ||
+       !s_isLinkRemoveSupported(pRad)) {
+        return false;
+    }
+    if(wld_mld_countNeighActiveLinks(pSSID->pMldLink) > 0) {
+        return true;
+    }
+    return (pSSID->pMldLink->pMld != NULL) &&
+           pSSID->pMldLink->pMld->hostapdRemoved;
+}
