+    }
+
+    pSource->hostapdRebuildPending = false;
+    pSource->hostapdRemoved = true;
+    pSource->pHostapdAnchorSSID = NULL;
+    pSource->hostapdAnchorIface[0] = '\0';
+    T_AccessPoint* restore[16];
+    size_t nRestore = 0;
+    wld_mldLink_t* pLink = NULL;
+    wld_for_eachNeighMldLink(pLink, wld_mld_firstLink(pSource)) {
+        T_SSID* pSSID = wld_mld_getLinkSsid(pLink);
+        if((pSSID == NULL) || (pSSID->AP_HOOK == NULL) || !wld_mld_isLinkUsable(pLink)) {
