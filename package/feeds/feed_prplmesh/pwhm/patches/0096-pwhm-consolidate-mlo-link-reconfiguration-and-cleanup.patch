+ * letting independent radio FSMs remove/add the same anchor concurrently.
+ * DONE means no migration; OK means removed; errors retain REMOVE_LINK. */
+static swl_rc_ne s_removeMovedMloAnchor(T_AccessPoint* pAP, T_Radio* pRad) {
+    struct {
+        T_AccessPoint* ap;
+        int32_t linkId;
