+amxd_status_t _configureDPP(amxd_object_t* obj,
+                                 amxd_function_t* func _UNUSED,
+                                 amxc_var_t* args,
+                                 amxc_var_t* retMap) {
+    SAH_TRACEZ_IN(ME);
+    
+    T_AccessPoint* pAP = wld_ap_fromObj(amxd_object_get_parent(obj));
+    ASSERT_NOT_NULL(pAP, amxd_status_ok, ME, "No AP Ctx");
+
+    const char* curve = GET_CHAR(args, "curve");
+    const char* qr = GET_CHAR(args, "QR");
+
+    if (swl_str_isEmpty(curve)) {
+        curve = "P-256";
+    }
+
+    if (swl_str_isEmpty(qr)) {
+        SAH_TRACEZ_ERROR(ME, "QR parameter is mandatory");
+        return amxd_status_invalid_arg;
+    }
+
+    char cmd[1024] = {0};
+    
+    char reply[128] = {0};
+    
+    // 1. dpp_configurator_add
+    snprintf(cmd, sizeof(cmd), "DPP_CONFIGURATOR_ADD curve=%s", curve);
+    swl_rc_ne ret = wld_wpaCtrl_sendCmdFmtGetResponse(pAP->wpaCtrlInterface, reply, sizeof(reply), "%s", cmd);
+    if (ret != SWL_RC_OK || swl_str_isEmpty(reply) || swl_str_matches(reply, "FAIL")) {
+        SAH_TRACEZ_ERROR(ME, "DPP_CONFIGURATOR_ADD failed");
+        return amxd_status_unknown_error;
+    }
+    
+    // Parse the returned id
+    int configuratorId = atoi(reply);
+
+    // Helper to format string to hex
+    char ssidHex[128] = {0};
+    swl_hex_fromBytesSep(ssidHex, sizeof(ssidHex), (swl_bit8_t*)pAP->pSSID->SSID, swl_str_len(pAP->pSSID->SSID), false, 0, NULL);
+    
+    char passHex[256] = {0};
+    swl_hex_fromBytesSep(passHex, sizeof(passHex), (swl_bit8_t*)pAP->keyPassPhrase, swl_str_len(pAP->keyPassPhrase), false, 0, NULL);
+
+    const char* confStr = "";
+    if (pAP->secModeEnabled == SWL_SECURITY_APMODE_WPA3_P || pAP->secModeEnabled == SWL_SECURITY_APMODE_WPA2_WPA3_P) {
+         confStr = "sae";
+    } else if (pAP->secModeEnabled == SWL_SECURITY_APMODE_WPA2_P) {
+         confStr = "psk";
+    }
+
+    // 2. dpp_qr_code
+    snprintf(cmd, sizeof(cmd), "DPP_QR_CODE %s", qr);
+    memset(reply, 0, sizeof(reply));
+    ret = wld_wpaCtrl_sendCmdFmtGetResponse(pAP->wpaCtrlInterface, reply, sizeof(reply), "%s", cmd);
+    if (ret != SWL_RC_OK || swl_str_isEmpty(reply) || swl_str_matches(reply, "FAIL")) {
+        SAH_TRACEZ_ERROR(ME, "DPP_QR_CODE failed, ret: %d, reply: %s", ret, reply);
+        return amxd_status_unknown_error;
+    }
+
+    int peerId = atoi(reply);
+
+    // 3. dpp_auth_init
+    int len = snprintf(cmd, sizeof(cmd), "DPP_AUTH_INIT peer=%d conf=sta-%s configurator=%d ssid=%s", peerId, confStr, configuratorId, ssidHex);
+    if (!swl_str_isEmpty(passHex)) {
+        snprintf(cmd + len, sizeof(cmd) - len, " pass=%s", passHex);
+    }
+    
+    bool bRet = wld_wpaCtrl_sendCmdCheckResponse(pAP->wpaCtrlInterface, cmd, "OK");
+    if (!bRet) {
+        SAH_TRACEZ_ERROR(ME, "DPP_AUTH_INIT failed, cmd: %s", cmd);
+        return amxd_status_unknown_error;
+    }
+
+    amxc_var_set(cstring_t, retMap, "OK");
+
+    SAH_TRACEZ_OUT(ME);
+    return amxd_status_ok;
+}
