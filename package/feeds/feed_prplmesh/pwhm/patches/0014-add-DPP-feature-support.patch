+amxd_status_t _dpp_bootstrap_gen(amxd_object_t* obj,
+                                 amxd_function_t* func _UNUSED,
+                                 amxc_var_t* args,
+                                 amxc_var_t* retMap) {
+    SAH_TRACEZ_IN(ME);
+    
+    T_EndPoint* pEP = wld_ep_fromObj(amxd_object_get_parent(obj));
+    ASSERT_NOT_NULL(pEP, amxd_status_ok, ME, "No EP Ctx");
+
+    const char* curve = GET_CHAR(args, "curve");
+    uint32_t chan = GET_UINT32(args, "chan");
+    uint32_t operatingclass = GET_UINT32(args, "operatingclass");
+
+    if (swl_str_isEmpty(curve)) {
+        curve = "P-256";
+    }
+
+    char cmd[1024] = {0};
+    char reply[1024] = {0};
+    
+    int len = snprintf(cmd, sizeof(cmd), "DPP_BOOTSTRAP_GEN type=qrcode curve=%s", curve);
+    
+    if (chan != 0 && operatingclass != 0) {
+        snprintf(cmd + len, sizeof(cmd) - len, " chan=%u/%u", operatingclass, chan);
+    }
+    
+    swl_rc_ne ret = wld_wpaCtrl_sendCmdFmtGetResponse(pEP->wpaCtrlInterface, reply, sizeof(reply), "%s", cmd);
+    if (ret != SWL_RC_OK || swl_str_isEmpty(reply) || swl_str_matches(reply, "FAIL")) {
+        SAH_TRACEZ_ERROR(ME, "DPP_BOOTSTRAP_GEN failed");
+        return amxd_status_unknown_error;
+    }
+
+    uint32_t id = atoi(reply);
+
+    // get URI
+    snprintf(cmd, sizeof(cmd), "DPP_BOOTSTRAP_GET_URI %u", id);
+    memset(reply, 0, sizeof(reply));
+    ret = wld_wpaCtrl_sendCmdFmtGetResponse(pEP->wpaCtrlInterface, reply, sizeof(reply), "%s", cmd);
+    if (ret != SWL_RC_OK || swl_str_isEmpty(reply) || swl_str_matches(reply, "FAIL")) {
+        SAH_TRACEZ_ERROR(ME, "DPP_BOOTSTRAP_GET_URI failed");
+        return amxd_status_unknown_error;
+    }
+
+    // Add to generated QR list
+    amxd_object_t* qrListObj = amxd_object_findf(obj, "GeneratedQR");
+    if (qrListObj) {
+        amxd_trans_t trans;
+        ASSERT_TRANSACTION_INIT(qrListObj, &trans, amxd_status_unknown_error, ME, "trans init failure");
+        amxd_trans_add_inst(&trans, 0, NULL);
+        amxd_trans_set_uint32_t(&trans, "ID", id);
+        amxd_trans_set_cstring_t(&trans, "URI", reply);
+        ASSERT_TRANSACTION_LOCAL_DM_END(&trans, amxd_status_unknown_error, ME, "trans apply failure");
+    }
+
+    amxc_var_set(cstring_t, retMap, reply);
+
+    SAH_TRACEZ_OUT(ME);
+    return amxd_status_ok;
+}
+
+amxd_status_t _chirp(amxd_object_t* obj,
+                     amxd_function_t* func _UNUSED,
+                     amxc_var_t* args,
+                     amxc_var_t* retMap) {
+    SAH_TRACEZ_IN(ME);
+    
+    T_EndPoint* pEP = wld_ep_fromObj(amxd_object_get_parent(obj));
+    ASSERT_NOT_NULL(pEP, amxd_status_ok, ME, "No EP Ctx");
+
+    uint32_t id = GET_UINT32(args, "id");
+    char cmd[128] = {0};
+    
+    snprintf(cmd, sizeof(cmd), "DPP_CHIRP own=%u", id);
+    bool bRet = wld_wpaCtrl_sendCmdCheckResponse(pEP->wpaCtrlInterface, cmd, "OK");
+    if (!bRet) {
+        SAH_TRACEZ_ERROR(ME, "DPP_CHIRP failed");
+        amxc_var_set(bool, retMap, false);
+        return amxd_status_unknown_error;
+    }
+
+    amxc_var_set(bool, retMap, true);
+
+    SAH_TRACEZ_OUT(ME);
+    return amxd_status_ok;
+}
+
+void _wld_ep_setDppConf_ocf(const char* const sig_name,
+                                const amxc_var_t* const data,
+                                void* const priv) {
+    swla_dm_procObjEvtOfLocalDm(&sEpDppDmHdlrs, sig_name, data, priv);
+}
