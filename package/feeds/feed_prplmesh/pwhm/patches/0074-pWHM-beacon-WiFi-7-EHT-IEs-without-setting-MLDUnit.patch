+/**
+ * Callback invoked for events "*" on Radio.IEEE80211be.MLDUnitSeting
+ * if new value is valid and different from current value, trigger appropriate reconfiguration
+ *
+ * @param object - datamodel object Radio.i.IEEE80211be; parent_of(object) == radio instance
+ * @param newValue - amxc variant holding new value of MLDUnitSetting child field of IEEE80211be, in string representation
+ */
+static void s_setMLDUnitSetting_pwf(void* priv _UNUSED, amxd_object_t* object, amxd_param_t* param _UNUSED, const amxc_var_t* const newValue) {
+    SAH_TRACEZ_IN(ME);
+    T_Radio* pR = wld_rad_fromObj(amxd_object_get_parent(object));
+    ASSERT_NOT_NULL(pR, , ME, "NULL");
+
+    const char* newValStr = GET_CHAR(newValue, NULL);
+
+    wld_rad_mld_unit_setting_e newVal = swl_conv_charToEnum(newValStr, wld_rad_mldUnitSetting_str, RAD_MLDUNIT_SETTING_MAX, RAD_MLDUNIT_SETTING_MAX);
+
+    ASSERT_TRUE((newVal < RAD_MLDUNIT_SETTING_MAX), , ME, "Invalid value");
+
+    SAH_TRACEZ_INFO(ME, "%s: MLDUnitSetting oldValue:[%s] newValue:[%s]",
+                    pR->Name, wld_rad_mldUnitSetting_str[pR->mldUnitSetting],
+                    wld_rad_mldUnitSetting_str[newVal]);
+
+    if(pR->mldUnitSetting != newVal) {
+        pR->mldUnitSetting = newVal;
+        wld_rad_doSync(pR);
+        wld_rad_setAllMldLinksUnconfigured(pR);
+    }
+}
