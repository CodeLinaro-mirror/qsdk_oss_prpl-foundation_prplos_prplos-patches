+			/**
+			 * Configuration pertaining to the WiFi7 behavior, with respect to available SSID.MLDUnit values
+			 * EHT-only means only EHT Capabilities and EHT Operation Information Elements are added to beacons
+			 * Full WiFi7 means both EHT and Multi-link IEs are added to beacons; WFA interpretation of WiFi7;
+			 * Expected Behaviors are:
+			 *  Required : WiFi6 if MLDUnit is not configured; Full WiFi7 if MLDUnit is configured;
+			 *  NotRequired : EHT-only if MLDUnit is not configured; Full WiFi7 if MLDUnit is configured;
+			 *  Assumed : Full WiFi7 if driver supports MLO; WiFi6 otherwise;
+			 */
+			%persistent string MLDUnitSetting {
+				on action validate call check_enum ["Required", "NotRequired", "Assumed"];
+				default "Assumed";
+			}
 		}
  
