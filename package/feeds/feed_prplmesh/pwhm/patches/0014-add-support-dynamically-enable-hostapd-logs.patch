From 8b90a66c76d87b8bdd2c5d2261ac1440df39f145 Mon Sep 17 00:00:00 2001
From: Atchaya R <ratchaya@qti.qualcomm.com>
Date: Wed, 25 Mar 2026 12:12:17 +0530
Subject: [PATCH] pwhm: add support to dynamically enable hostapd logs in
 runtime for host related issues

Change-Id: I9a0e9f691355b5b57b7d50904cf49f5e7c1e62d8
Signed-off-by: Atchaya R <ratchaya@qti.qualcomm.com>
---
 ...port-dynamically-enable-hostapd-logs.patch | 50 +++++++++++++++++++
 1 file changed, 50 insertions(+)
 create mode 100644 package/feeds/feed_prplmesh/pwhm/patches/0014-add-support-dynamically-enable-hostapd-logs.patch

--- a/src/Plugin/wifiGen_hapd.c
+++ b/src/Plugin/wifiGen_hapd.c
@@ -77,10 +77,15 @@
 #include "wifiGen_fsm.h"
 #include "wifiGen_rad.h"
 #include "wld/wld_common.h"
+#include <unistd.h>
+#include <errno.h>
+#include <string.h>
 
 #define ME "genHapd"
 #define HOSTAPD_CONF_FILE_PATH_FORMAT "/tmp/%s_hapd.conf"
 #define HOSTAPD_ARGS_FORMAT "-dddt"
+#define HOSTAPD_ARGS_DEBUG_FORMAT "-dddts -f /tmp/hapd.log"
+#define DEBUG_HOSTAPD_FILE "/etc/debug_hostapd"
 
 #define HOSTAPD_EXIT_REASON_SUCCESS 0
 /*
@@ -326,7 +331,14 @@ static char* s_getHapdArgsCb(wld_secDmn_
     ASSERT_NOT_NULL(pSecDmn, args, ME, "NULL");
     char startArgs[256] = {0};
     //set default start args
-    swl_str_copy(startArgs, sizeof(startArgs), HOSTAPD_ARGS_FORMAT);
+    if(access(DEBUG_HOSTAPD_FILE, F_OK) == 0) {
+        swl_str_copy(startArgs, sizeof(startArgs), HOSTAPD_ARGS_DEBUG_FORMAT);
+    } else {
+        if(errno != ENOENT) {
+            SAH_TRACEZ_WARNING(ME, "Failed to access debug file %s: %s", DEBUG_HOSTAPD_FILE, strerror(errno));
+        }
+        swl_str_copy(startArgs, sizeof(startArgs), HOSTAPD_ARGS_FORMAT);
+    }
     const char* gSockPath = wld_wpaCtrlGSock_getGIfacePath(pSecDmn->glSk);
     if(!swl_str_isEmpty(gSockPath)) {
         swl_strlst_catFormat(startArgs, sizeof(startArgs), " ", "-g %s", gSockPath);
@@ -622,7 +634,14 @@ static char* s_getGlobHapdArgsCb(wld_sec
     ASSERT_NOT_NULL(pSecDmnGrp, args, ME, "NULL");
     char startArgs[256] = {0};
     //set default start args
-    swl_str_copy(startArgs, sizeof(startArgs), HOSTAPD_ARGS_FORMAT);
+    if(access(DEBUG_HOSTAPD_FILE, F_OK) == 0) {
+        swl_str_copy(startArgs, sizeof(startArgs), HOSTAPD_ARGS_DEBUG_FORMAT);
+    } else {
+        if(errno != ENOENT) {
+            SAH_TRACEZ_WARNING(ME, "Failed to access debug file %s: %s", DEBUG_HOSTAPD_FILE, strerror(errno));
+        }
+        swl_str_copy(startArgs, sizeof(startArgs), HOSTAPD_ARGS_FORMAT);
+    }
     wld_secDmn_t* grpMembers[wld_secDmnGrp_getMembersCount(pSecDmnGrp) + 1];
     uint32_t nGrpMembers = 0;
     for(uint32_t i = 0; i < wld_secDmnGrp_getMembersCount(pSecDmnGrp); i++) {
