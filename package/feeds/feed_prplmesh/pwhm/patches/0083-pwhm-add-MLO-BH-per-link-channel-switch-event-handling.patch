+static void s_bStaMloLinkChanSwitchStartedEvtCb(wld_wpaCtrlInterface_t* pInterface, char* event _UNUSED, char* params) {
+    /**
+     * Example:
+     * CTRL-EVENT-STARTED-LINK-CHANNEL-SWITCH freq=5220 link_id=1 ht_enabled=1 ch_offset=1 ch_width=80 MHz cf1=5210 cf2=0
+     *
+     * puncturing_bitmap is not yet defined in wpactlr msg but checked by anticipation
+     */
+    swl_chanspec_t chanSpec = SWL_CHANSPEC_EMPTY;
+    ASSERT_FALSE(s_freqParamToChanSpec(params, "freq", &chanSpec) < SWL_RC_OK, , ME, "fail to get freq");
+    s_chWidthDescToChanSpec(params, "ch_width", &chanSpec);
+    s_punctBitmapDescToChanSpec(params, "puncturing_bitmap", &chanSpec);
+    int32_t linkId = -1;
+    ASSERTS_TRUE(wld_wpaCtrl_getValueIntExt(params, "link_id", &linkId), , ME, "fail to get link_id");
+    ASSERT_TRUE(wld_mld_isLinkIdValid(linkId), , ME, "invalid link id value %d", linkId);
+
+    SAH_TRACEZ_INFO(ME, "%s: linkId=%d channel=%d width=%d band=%d", pInterface->name, linkId,
+                    chanSpec.channel, chanSpec.bandwidth, chanSpec.band);
+
+    CALL_INTF(pInterface, fBStaMloLinkChanSwitchStartedCb, &chanSpec, linkId);
+}
+
+static void s_bStaMloLinkChanSwitchEvtCb(wld_wpaCtrlInterface_t* pInterface, char* event _UNUSED, char* params) {
+    /**
+     * Example:
+     * CTRL-EVENT-LINK-CHANNEL-SWITCH freq=5220 link_id=1 ht_enabled=1 ch_offset=1 ch_width=80 MHz cf1=5210 cf2=0
+     *
+     * puncturing_bitmap is not yet defined in wpactlr msg but checked by anticipation
+     */
+    swl_chanspec_t chanSpec = SWL_CHANSPEC_EMPTY;
+    ASSERT_FALSE(s_freqParamToChanSpec(params, "freq", &chanSpec) < SWL_RC_OK, , ME, "fail to get freq");
+    s_chWidthDescToChanSpec(params, "ch_width", &chanSpec);
+    s_punctBitmapDescToChanSpec(params, "puncturing_bitmap", &chanSpec);
+    int32_t linkId = -1;
+    ASSERTS_TRUE(wld_wpaCtrl_getValueIntExt(params, "link_id", &linkId), , ME, "fail to get link_id");
+    ASSERT_TRUE(wld_mld_isLinkIdValid(linkId), , ME, "invalid link id value %d", linkId);
+
+    SAH_TRACEZ_INFO(ME, "%s: linkId=%d channel=%d width=%d band=%d", pInterface->name, linkId,
+                    chanSpec.channel, chanSpec.bandwidth, chanSpec.band);
+
+    CALL_INTF(pInterface, fBStaMloLinkChanSwitchCb, &chanSpec, linkId);
+}
