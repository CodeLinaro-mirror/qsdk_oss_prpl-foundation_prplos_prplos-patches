+static void s_stationLinkChanSwitchStartedCb(void* userData, char* ifName _UNUSED, swl_chanspec_t* chanSpec, int8_t linkId) {
+    T_EndPoint* pEP = (T_EndPoint*) userData;
+    ASSERTS_NOT_NULL(pEP, , ME, "NULL");
+    ASSERTS_NOT_NULL(chanSpec, , ME, "No chanspec");
+    T_SSID* pSSID = pEP->pSSID;
+    ASSERTS_NOT_NULL(pSSID, , ME, "No mapped ssid");
+    T_SSID* pLinkSsid = wld_mld_getLinkSsidByLinkId(pSSID->pMldLink, linkId);
+    if(pLinkSsid && pLinkSsid->ENDP_HOOK &&
+       wld_rad_matchRadioWithChanInfo(pLinkSsid->RADIO_PARENT, chanSpec->band, chanSpec->channel)) {
+        T_EndPoint* pLinkEP = pLinkSsid->ENDP_HOOK;
+        T_Radio* pLinkRadio = pLinkSsid->RADIO_PARENT;
+        SAH_TRACEZ_INFO(ME, "%s: forward linkChSwStarted event to link(%d) %s radio %s", ifName, linkId, pLinkEP->Name, pLinkRadio->Name);
+        CALL_MGR_I_EXT(pLinkEP->wpaCtrlInterface, fChanSwitchStartedCb, chanSpec);
+    }
+}
+
+static void s_stationLinkChanSwitchCb(void* userData, char* ifName _UNUSED, swl_chanspec_t* chanSpec, int8_t linkId) {
+    T_EndPoint* pEP = (T_EndPoint*) userData;
+    ASSERTS_NOT_NULL(pEP, , ME, "NULL");
+    ASSERTS_NOT_NULL(chanSpec, , ME, "No chanspec");
+    T_SSID* pSSID = pEP->pSSID;
+    ASSERTS_NOT_NULL(pSSID, , ME, "No mapped ssid");
+    T_SSID* pLinkSsid = wld_mld_getLinkSsidByLinkId(pSSID->pMldLink, linkId);
+    if(pLinkSsid && pLinkSsid->ENDP_HOOK &&
+       wld_rad_matchRadioWithChanInfo(pLinkSsid->RADIO_PARENT, chanSpec->band, chanSpec->channel)) {
+        T_EndPoint* pLinkEP = pLinkSsid->ENDP_HOOK;
+        T_Radio* pLinkRadio = pLinkSsid->RADIO_PARENT;
+        SAH_TRACEZ_INFO(ME, "%s: forward linkChSw event to link(%d) %s radio %s", ifName, linkId, pLinkEP->Name, pLinkRadio->Name);
+        CALL_MGR_I_EXT(pLinkEP->wpaCtrlInterface, fChanSwitchCb, chanSpec);
+    }
+}
