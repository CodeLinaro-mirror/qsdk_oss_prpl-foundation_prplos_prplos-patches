From 6e9eb694eb5da732aa6d254ab7862b0aca5927d1 Mon Sep 17 00:00:00 2001
From: Atchaya R <ratchaya@qti.qualcomm.com>
Date: Thu, 6 Aug 2026 16:31:17 +0530
Subject: [PATCH] pwhm: add support for block_chan_list config to get added in
 conf file

Signed-off-by: Atchaya R <ratchaya@qti.qualcomm.com>
---
 odl/wld_radio.odl                 | 13 ++++++++-----
 src/nl80211/wld_hostapd_cfgFile.c | 27 +++++++++++++++++++++++++--
 src/wld_radio.c                   | 17 +++++++++++++++--
 3 files changed, 48 insertions(+), 9 deletions(-)

diff --git a/odl/wld_radio.odl b/odl/wld_radio.odl
index 0da9816..35342b8 100644
--- a/odl/wld_radio.odl
+++ b/odl/wld_radio.odl
@@ -914,14 +914,14 @@ define probelist_t{
 		 *    survive hostapd restarts. pWHM marks these %persistent to match hostapd.
 		 *    Parameters: MinDwellTime, MaxDwellTime, DfsExclude, PcacOnly,
 		 *                OnlyPscChannels6G, PeriodicInterval, QacsEnable,
-		 *                ChannelList, Scan2GAllChannels.
+		 *                ChannelList, Scan2GAllChannels, BlockChanList.
 		 *
 		 * 2. wpa_ctrl-only parameters (non-persistent): applied at runtime via
 		 *    "ACS <cmd>" wpa_ctrl commands. hostapd resets them to defaults on
 		 *    restart. pWHM does NOT persist these — they reset to defaults on reboot,
 		 *    matching hostapd's own behaviour.
 		 *    Parameters: DwellTime, WeatherRadarExclude, TxPwrOptimization,
-		 *                RankEnable, NoScan, DebugTrace, BlockChanList.
+		 *                RankEnable, NoScan, DebugTrace.
 		 */
 		%persistent object ACS {
 			on event "*" call wld_rad_setAcsConf_ocf;
@@ -1077,12 +1077,15 @@ define probelist_t{
 
 			/**
 			 * Comma-separated list of channels to block from ACS selection.
-			 * Setting a non-empty value sends: ACS set_block_chan_list <channels>
+			 * Written to hostapd config as: acs_block_chan_list <space-separated channels>
+			 * Also applied at runtime via wpa_ctrl: ACS set_block_chan_list <channels>
 			 * Example: "1,6,11" blocks channels 1, 6, and 11.
 			 * Use clearBlockChanList() to remove all blocked channels.
-			 * NOT persistent: wpa_ctrl-only, hostapd resets to default on restart.
+			 * Written unconditionally (applies to both startup ACS and invokeACS()).
+			 * Empty string = no blocked channels (default).
+			 * Corresponds to: uci set wireless.wifiX.acs_block_chan_list=1,6,11
 			 */
-			string BlockChanList {
+			%persistent string BlockChanList {
 				default "";
 			}
 
diff --git a/src/nl80211/wld_hostapd_cfgFile.c b/src/nl80211/wld_hostapd_cfgFile.c
index a2ee252..18deb55 100644
--- a/src/nl80211/wld_hostapd_cfgFile.c
+++ b/src/nl80211/wld_hostapd_cfgFile.c
@@ -721,6 +721,8 @@ void wld_hostapd_cfgFile_setRadioConfig(T_Radio* pRad, swl_mapChar_t* radConfigM
      *   acs_exclude_6ghz_non_psc → unconditional: selection phase
      *   chanlist              → unconditional: scan+interference+selection phases
      *                           (config-file-only, no wpa_ctrl runtime command)
+     *   acs_block_chan_list   → unconditional: blocks specific channels from ACS
+     *                           (QCN extension; also applied via ACS set_block_chan_list)
      *
      * All parameters are also applied at runtime via wpa_ctrl (invokeACS /
      * individual ACS set handlers) so they take effect immediately when the
@@ -808,15 +810,36 @@ void wld_hostapd_cfgFile_setRadioConfig(T_Radio* pRad, swl_mapChar_t* radConfigM
             }
             free(chanList);
 
+            /* acs_block_chan_list: written unconditionally so it also applies when
+             * invokeACS() triggers dynamic ACS with AutoChannelEnable=false.
+             * acs_block_chan_list is a QCN extension config-file parameter that
+             * blocks specific channels from ACS selection (blacklist).
+             * hostapd format: space-separated channels (e.g., "1 6 11").
+             * DM format: comma-separated (e.g., "1,6,11").
+             * Corresponds to: uci set wireless.wifiX.acs_block_chan_list=1,6,11 */
+            char* blockChanList = amxd_object_get_cstring_t(acsObj, "BlockChanList", NULL);
+            if(!swl_str_isEmpty(blockChanList)) {
+                char spaceSepBlock[256] = {0};
+                swl_str_copy(spaceSepBlock, sizeof(spaceSepBlock), blockChanList);
+                for(char* p = spaceSepBlock; *p; p++) {
+                    if(*p == ',') {
+                        *p = ' ';
+                    }
+                }
+                swl_mapChar_add(radConfigMap, "acs_block_chan_list", spaceSepBlock);
+                SAH_TRACEZ_INFO(ME, "%s: ACS acs_block_chan_list written: '%s'", pRad->Name, spaceSepBlock);
+            }
             SAH_TRACEZ_INFO(ME, "%s: ACS config file params written (qacs_enable=%d, 2g_all=%d, period=%u, "
-                            "dfs_excl=%d, pcaconly=%d, psc6g=%d)",
+                            "dfs_excl=%d, pcaconly=%d, psc6g=%d, block_chan_list='%s')",
                             pRad->Name,
                             qacsEnable ? 1 : 0,
                             amxd_object_get_bool(acsObj, "Scan2GAllChannels", NULL) ? 1 : 0,
                             periodicInterval,
                             amxd_object_get_bool(acsObj, "DfsExclude", NULL) ? 1 : 0,
                             amxd_object_get_bool(acsObj, "PcacOnly", NULL) ? 1 : 0,
-                            amxd_object_get_bool(acsObj, "OnlyPscChannels6G", NULL) ? 1 : 0);
+                            amxd_object_get_bool(acsObj, "OnlyPscChannels6G", NULL) ? 1 : 0,
+                            blockChanList ? blockChanList : "");
+            free(blockChanList);
         }
     }
 
diff --git a/src/wld_radio.c b/src/wld_radio.c
index 42677f1..ad6d12d 100644
--- a/src/wld_radio.c
+++ b/src/wld_radio.c
@@ -3605,7 +3605,15 @@ static void s_setAcsBlockChanList_pwf(void* priv _UNUSED, amxd_object_t* object,
     T_Radio* pRad = wld_rad_fromObj(amxd_object_get_parent(object));
     ASSERTI_NOT_NULL(pRad, , ME, "NULL");
     const char* val = amxc_var_constcast(cstring_t, newValue);
-    if(val == NULL || val[0] == '\0') return; /* empty = no change */
+
+    /* Always rewrite the config file so acs_block_chan_list persists across restarts.
+     * If the radio is not active the new value is stored in the DM and will be written
+     * to the config file on the next hostapd start. */
+    wld_hostapd_cfgFile_createExt(pRad);
+
+    /* Also send the targeted wpa_ctrl command for immediate effect (no full RELOAD_CONFIG
+     * needed — ACS set_block_chan_list updates only the block list in-memory). */
+    if(val == NULL || val[0] == '\0') return; /* empty = no wpa_ctrl command */
     ASSERTI_TRUE(wld_rad_isActive(pRad), , ME, "%s: ACS.BlockChanList: radio not active", pRad->Name);
     T_AccessPoint* pAP = s_getAcsAp(pRad);
     ASSERTI_NOT_NULL(pAP, , ME, "%s: ACS.BlockChanList: no AP available", pRad->Name);
@@ -3827,6 +3835,10 @@ amxd_status_t _showNeighborReport(amxd_object_t* object,
  *
  * If the radio is not active the new value is already stored in the DM and
  * will be written to the config file on the next hostapd start.
+ *
+ * Note: BlockChanList uses s_setAcsBlockChanList_pwf instead (combined:
+ * config file write for persistence + direct ACS set_block_chan_list for
+ * immediate effect without a full RELOAD_CONFIG).
  */
 static void s_setAcsConfigFileParam_pwf(void* priv _UNUSED, amxd_object_t* object,
                                           amxd_param_t* param,
@@ -3858,8 +3870,9 @@ SWLA_DM_HDLRS(sRadioAcsDmHdlrs,
                   SWLA_DM_PARAM_HDLR("NoScan",              s_setAcsNoScan_pwf),
                   SWLA_DM_PARAM_HDLR("DebugTrace",          s_setAcsDebugTrace_pwf),
                   SWLA_DM_PARAM_HDLR("QacsEnable",          s_setAcsQacsEnable_pwf),
-                  SWLA_DM_PARAM_HDLR("BlockChanList",       s_setAcsBlockChanList_pwf),
                   SWLA_DM_PARAM_HDLR("Scan2GAllChannels",   s_setAcsScan2GAll_pwf),
+                  /* Config-file + wpa_ctrl: rewrite config (persistence) + direct ACS command (immediate) */
+                  SWLA_DM_PARAM_HDLR("BlockChanList",       s_setAcsBlockChanList_pwf),
                   /* Config-file-only parameters: rewrite config + RELOAD_CONFIG */
                   SWLA_DM_PARAM_HDLR("PcacOnly",            s_setAcsConfigFileParam_pwf),
                   SWLA_DM_PARAM_HDLR("ChannelList",         s_setAcsConfigFileParam_pwf),
-- 
2.34.1

