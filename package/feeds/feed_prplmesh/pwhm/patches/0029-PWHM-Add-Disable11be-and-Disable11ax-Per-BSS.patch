diff --git a/odl/wld_accesspoint.odl b/odl/wld_accesspoint.odl
index cfa0aeb..033ed55 100644
--- a/odl/wld_accesspoint.odl
+++ b/odl/wld_accesspoint.odl
@@ -365,6 +365,31 @@ define rrm_t{
 			default false;
 		}
 
+		/**
+		 * Disable IEEE 802.11be (Wi-Fi 7 / EHT) for this BSS.
+		 * Identical to LegacyMode: removes this BSS from its MLD group
+		 * (saves mldUnit for restore) by setting SSID.MLDUnit=-1.
+		 * The existing cfgFile logic then writes disable_11be=1 and mld_ap=0
+		 * automatically when the BSS has no MLO link.
+		 * Default is false (802.11be enabled per radio capability).
+		 */
+		%persistent bool Disable11be {
+			default false;
+		}
+
+		/**
+		 * Disable IEEE 802.11ax (Wi-Fi 6 / HE) for this BSS.
+		 * Removes BSS from MLD group (saves mldUnit for restore) and writes
+		 * disable_11ax=1 to the hostapd BSS configuration.
+		 * NOTE: Only effective on 2.4GHz and 5GHz radios. On 6GHz this
+		 * parameter is silently ignored because 6GHz requires 802.11ax as
+		 * its minimum standard.
+		 * Default is false (802.11ax enabled per radio capability).
+		 */
+		%persistent bool Disable11ax {
+			default false;
+		}
+
 		/**
 		 * Add MBO Assoc Disallow Reason in the MBO IE
 		 * Possible options are : "Off", "Unspecified", "MaxAssocSTA",
diff --git a/src/nl80211/wld_hostapd_cfgFile.c b/src/nl80211/wld_hostapd_cfgFile.c
index d663225..9c1aacf 100644
--- a/src/nl80211/wld_hostapd_cfgFile.c
+++ b/src/nl80211/wld_hostapd_cfgFile.c
@@ -1020,6 +1020,12 @@ static bool s_setVapCommonConfig(T_AccessPoint* pAP, swl_mapChar_t* vapConfigMap
 
     bool enableRad11be = wld_rad_is11beUsable(pRad);
     bool enableVap11be = enableRad11be;
