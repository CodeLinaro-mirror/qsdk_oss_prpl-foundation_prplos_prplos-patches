 /**
@@ -1481,6 +1483,130 @@ static void s_setLegacyMode_pwf(void* priv _UNUSED, amxd_object_t* object,
     SAH_TRACEZ_OUT(ME);
 }
 
+/* Disable11be: removes BSS from MLD so that
+ * cfgFile's existing "if no MLO, then no 11BE" block writes disable_11be=1. */
+static void s_setDisable11be_pwf(void* priv _UNUSED, amxd_object_t* object,
+                                  amxd_param_t* param _UNUSED,
+                                  const amxc_var_t* const newValue) {
+    SAH_TRACEZ_IN(ME);
+
+    T_AccessPoint* pAP = wld_ap_fromObj(object);
+    ASSERT_NOT_NULL(pAP, , ME, "INVALID");
+
+    bool disable = amxc_var_dyncast(bool, newValue);
+
+    if(!pAP->pSSID) {
+        SAH_TRACEZ_ERROR(ME, "%s: pSSID is NULL - cannot change MLDUnit", pAP->alias);
+        SAH_TRACEZ_OUT(ME);
+        return;
+    }
+
+    if(!pAP->pSSID->pBus) {
+        SAH_TRACEZ_ERROR(ME, "%s: pSSID->pBus is NULL - cannot update DM MLDUnit", pAP->alias);
+        SAH_TRACEZ_OUT(ME);
+        return;
+    }
+
+    int32_t newMldUnit;
+    if(disable) {
+        if(pAP->pSSID->mldUnit < 0) {
+            SAH_TRACEZ_INFO(ME, "%s: mldUnit=%d already not in MLD - no action", pAP->alias, pAP->pSSID->mldUnit);
+            SAH_TRACEZ_OUT(ME);
+            return;
+        }
+        pAP->savedMldUnit11be = pAP->pSSID->mldUnit;
+        SAH_TRACEZ_INFO(ME, "%s: Disable11be=1 saving mldUnit=%d, setting SSID.MLDUnit=-1",
+                        pAP->alias, pAP->savedMldUnit11be);
+        newMldUnit = -1;
+    } else {
+        if(pAP->savedMldUnit11be < 0) {
+            SAH_TRACEZ_INFO(ME, "%s: no saved mldUnit (savedMldUnit11be=%d) - nothing to restore",
+                            pAP->alias, pAP->savedMldUnit11be);
+            SAH_TRACEZ_OUT(ME);
+            return;
+        }
+        SAH_TRACEZ_INFO(ME, "%s: Disable11be=0 restoring SSID.MLDUnit=%d",
+                        pAP->alias, pAP->savedMldUnit11be);
+        newMldUnit = pAP->savedMldUnit11be;
+        pAP->savedMldUnit11be = -1;
+    }
+
+    amxd_trans_t trans;
+    ASSERT_TRANSACTION_INIT(pAP->pSSID->pBus, &trans, , ME, "%s: trans init failed", pAP->alias);
+    amxd_trans_set_value(int32_t, &trans, "MLDUnit", newMldUnit);
+    ASSERT_TRANSACTION_LOCAL_DM_END(&trans, , ME, "%s: trans apply failed setting MLDUnit=%d",
+                                    pAP->alias, newMldUnit);
+
+    SAH_TRACEZ_OUT(ME);
+}
+
+static void s_setDisable11ax_pwf(void* priv _UNUSED, amxd_object_t* object,
+                                  amxd_param_t* param _UNUSED,
+                                  const amxc_var_t* const newValue) {
+    SAH_TRACEZ_IN(ME);
+
+    T_AccessPoint* pAP = wld_ap_fromObj(object);
+    ASSERT_NOT_NULL(pAP, , ME, "INVALID");
+
+    bool disable = amxc_var_dyncast(bool, newValue);
+
+    if(!pAP->pSSID) {
+        SAH_TRACEZ_ERROR(ME, "%s: pSSID is NULL - cannot change MLDUnit", pAP->alias);
+        SAH_TRACEZ_OUT(ME);
+        return;
+    }
+
+    if(!pAP->pSSID->pBus) {
+        SAH_TRACEZ_ERROR(ME, "%s: pSSID->pBus is NULL - cannot update DM MLDUnit", pAP->alias);
+        SAH_TRACEZ_OUT(ME);
+        return;
+    }
+
+    if(disable && pAP->pRadio->operatingFrequencyBand == SWL_FREQ_BAND_EXT_6GHZ) {
+        SAH_TRACEZ_WARNING(ME, "%s: Disable11ax=1 ignored on 6GHz BSS "
+                           "(6GHz requires 11ax as minimum standard)", pAP->alias);
+        SAH_TRACEZ_OUT(ME);
+        return;
+    }
+
+    int32_t newMldUnit;
+    if(disable) {
+        pAP->disable11ax = true;
+        if(pAP->pSSID->mldUnit < 0) {
+            SAH_TRACEZ_INFO(ME, "%s: mldUnit=%d already not in MLD, applying disable_11ax flag",
+                            pAP->alias, pAP->pSSID->mldUnit);
+            wld_ap_doSync(pAP);
+            SAH_TRACEZ_OUT(ME);
+            return;
+        }
+        pAP->savedMldUnit11ax = pAP->pSSID->mldUnit;
+        SAH_TRACEZ_INFO(ME, "%s: Disable11ax=1 saving mldUnit=%d, setting SSID.MLDUnit=-1",
+                        pAP->alias, pAP->savedMldUnit11ax);
+        newMldUnit = -1;
+    } else {
+        pAP->disable11ax = false;
+        if(pAP->savedMldUnit11ax < 0) {
+            SAH_TRACEZ_INFO(ME, "%s: no saved mldUnit (savedMldUnit11ax=%d) - clearing disable_11ax flag",
+                            pAP->alias, pAP->savedMldUnit11ax);
+            wld_ap_doSync(pAP);
+            SAH_TRACEZ_OUT(ME);
+            return;
+        }
+        SAH_TRACEZ_INFO(ME, "%s: Disable11ax=0 restoring SSID.MLDUnit=%d",
+                        pAP->alias, pAP->savedMldUnit11ax);
+        newMldUnit = pAP->savedMldUnit11ax;
+        pAP->savedMldUnit11ax = -1;
+    }
+
+    amxd_trans_t trans;
+    ASSERT_TRANSACTION_INIT(pAP->pSSID->pBus, &trans, , ME, "%s: trans init failed", pAP->alias);
+    amxd_trans_set_value(int32_t, &trans, "MLDUnit", newMldUnit);
+    ASSERT_TRANSACTION_LOCAL_DM_END(&trans, , ME, "%s: trans apply failed setting MLDUnit=%d",
+                                    pAP->alias, newMldUnit);
+
+    SAH_TRACEZ_OUT(ME);
+}
+
 static void s_setMultiAPType_pwf(void* priv _UNUSED, amxd_object_t* object, amxd_param_t* param _UNUSED, const amxc_var_t* const newValue) {
     SAH_TRACEZ_IN(ME);
 
@@ -3824,6 +3950,8 @@ SWLA_DM_HDLRS(sApDmHdlrs,
                   SWLA_DM_PARAM_HDLR("WDSEnable", s_setWDSEnable_pwf),
                   SWLA_DM_PARAM_HDLR("MBOEnable", s_setMBOEnable_pwf),
                   SWLA_DM_PARAM_HDLR("LegacyMode", s_setLegacyMode_pwf),
+                  SWLA_DM_PARAM_HDLR("Disable11be", s_setDisable11be_pwf),
+                  SWLA_DM_PARAM_HDLR("Disable11ax", s_setDisable11ax_pwf),
                   SWLA_DM_PARAM_HDLR("HtMcsNssSet",  s_setHtMcsNssSet_pwf),
                   SWLA_DM_PARAM_HDLR("VhtMcsNssSet", s_setVhtMcsNssSet_pwf),
                   SWLA_DM_PARAM_HDLR("MBOAssocDisallowReason", s_setMBOAssocDisallowReason_pwf),
