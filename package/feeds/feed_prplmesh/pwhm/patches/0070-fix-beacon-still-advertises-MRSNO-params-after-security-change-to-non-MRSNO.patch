From: Kartheek E <karte@qti.qualcomm.com>
Date: Wed, 26 Aug 2026
Subject: [PATCH] pwhm: fix beacon still advertises MRSNO/RSN Override params after security change to non-MRSNO

for MLO APs, use RE_ADD_LINK instead of SIGHUP (RELOAD_CONFIG).
RE_ADD_LINK removes and re-adds only the specific BSS link from the
updated config file. This properly applies security config changes
including rsn_override_* activation (TO MRSNO) and removal (FROM MRSNO)
in beacons, without affecting other radios or breaking MLO. Other MLO
links remain active during the brief re-add.

Signed-off-by: Kartheek E <karte@qti.qualcomm.com>
---
 src/Plugin/wifiGen_fsm.c | 18 ++++++++++++------
 1 file changed, 5 insertions(+), 6 deletions(-)

--- a/src/Plugin/wifiGen_fsm.c
+++ b/src/Plugin/wifiGen_fsm.c
@@ -1385,14 +1385,13 @@
-static bool s_doSetApSec(T_AccessPoint* pAP, T_Radio* pRad _UNUSED) {
+static bool s_doSetApSec(T_AccessPoint* pAP, T_Radio* pRad) {
     ASSERTS_NOT_NULL(pAP, true, ME, "NULL");
     ASSERTI_TRUE(wld_wpaCtrlInterface_isReady(pAP->wpaCtrlInterface), true, ME, "%s: wpaCtrl disconnected", pAP->alias);
     wld_ap_hostapd_sendCommand(pAP, "PMKSA_FLUSH", "refreshConfig");
     wld_secDmn_action_rc_ne rc = wld_ap_hostapd_setSecParams(pAP);
     ASSERT_FALSE(rc < SECDMN_ACTION_OK_DONE, true, ME, "%s: fail to set secret key", pAP->alias);
-    // Force RELOAD_SECKEY for security changes to avoid warm apply issue on RE_ADD_LINK/RE_ADD operations
-    if(rc > SECDMN_ACTION_OK_DONE && pAP->secModeEnabled != SWL_SECURITY_APMODE_WPA3_P_CM) {
-        SAH_TRACEZ_WARNING(ME, "Forcing security change to use RELOAD_SECKEY (was action=%d) - AP=%s", rc, pAP->alias);
-        rc = SECDMN_ACTION_OK_NEED_RELOAD_SECKEY;
-    }
+    if(rc >= SECDMN_ACTION_OK_NEED_SIGHUP && s_hasMultiLinkApMld(pRad)) {
+        SAH_TRACEZ_WARNING(ME, "%s: MLO sec change, use RE_ADD_LINK (action=%d)", pAP->alias, rc);
+        rc = SECDMN_ACTION_OK_NEED_RE_ADD_LINK;
+    }
     s_schedNextAction(rc, pAP, pRad);
     return true;
 }
