+
+			/**
+			 * Enable EPPKE (Enhanced Privacy Protection Key Exchange) AKM in AP mode.
+			 * When set to true, the AP includes EPPKE AKM in RSNE of beacons and probe responses,
+			 * enabling clients to perform encrypted (re)association per IEEE 802.11bi.
+			 * @version 11.0
+			 */
+			%persistent bool EPPKE {
+				default false;
+			}
+
+			/**
+			 * Enable (Re)Association frame encryption.
+			 * When set, the AP advertises support for encrypted (Re)Association frames per IEEE 802.11bi,
+			 * preventing passive observers from fingerprinting devices through association frame contents.
+			 * Requires EPPKE to be enabled.
+			 * @version 11.0
+			 */
+			%persistent bool AssocFrameEncryption {
+				default false;
+			}
+
+			/**
+			 * Enable PMKID Caching Privacy.
+			 * Prevents PMKID-based device tracking by anonymizing PMKID values in association frames.
+			 * Requires AssocFrameEncryption to be enabled.
+			 * @version 11.0
+			 */
+			%persistent bool PMKSACachingPrivacy {
+				default false;
+			}
+
+			/**
+			 * Enable Unauthenticated EPPKE.
+			 * Allows EPPKE without a base AKM (no mutual authentication).
+			 * The PTK is derived using PMK set to "PMKz" as per IEEE 802.11bi clause 12.13.8.
+			 * @version 11.0
+			 */
+			%persistent bool KEKInPASN {
+				default false;
+			}
+
+			/**
+			 * Enable EAP using Authentication Frames.
+			 * Enables IEEE 802.1X authentication utilizing 802.11 authentication frames
+			 * instead of EAPOL over data frames (IEEE 802.11bi enterprise mode).
+			 * Applicable when ModeEnabled is an Enterprise type.
+			 * @version 11.0
+			 */
+			%persistent bool EAPUsingAuthenticationFrames {
+				default false;
+			}
+
+			/**
+			 * SAE Password Identifier change count.
+			 * Specifies the number of alternative single-use SAE password identifiers to generate
+			 * and distribute to clients during the 4-Way Handshake, preventing passive observers
+			 * from correlating reconnections via static password identifiers.
+			 * Set to 0 to disable SAE Password Identifier changing.
+			 * @version 11.0
+			 */
+			%persistent uint32 SAEPwIdNum {
+				default 0;
+			}
+
+			/**
+			 * SAE Password Identifier AES-SIV encryption key.
+			 * A 256-bit key expressed as a 64-character hexadecimal string, used to generate
+			 * encrypted alternative SAE password identifiers. Required when SAEPwIdNum > 0.
+			 * <i>When read, this parameter returns an empty string, regardless of the actual value.</i>
+			 * @version 11.0
+			 */
+			%persistent string SAEPwIdKey {
+				default "";
+			}
+
+			/**
+			 * PASN elliptic curve groups for EPPKE authentication.
+			 * Space-separated list of DH group identifiers (e.g. "19 20 21").
+			 * Specifies supported elliptic curve groups for PASN-based EPPKE authentication.
+			 * Leave empty to use hostapd defaults.
+			 * @version 11.0
+			 */
+			%persistent string PASNGroups {
+				default "";
+			}
+
+			/**
+			 * Enable RADSec (RADIUS over TLS, RFC 6614).
+			 * When enabled, RADIUS authentication traffic is transported over a TLS-protected
+			 * TCP connection to the AAA server, providing confidentiality and certificate-based
+			 * server authentication. Applicable when ModeEnabled is an Enterprise type.
+			 * Requires RadiusServerPort set to 2083 and certificate paths configured.
+			 * @version 11.0
+			 */
+			%persistent bool RadSecEnable {
+				default false;
+			}
+
+			/**
+			 * RADSec CA certificate file path.
+			 * Absolute path to the CA certificate used to validate the RADIUS/TLS server certificate.
+			 * Required when RadSecEnable is true.
+			 * @version 11.0
+			 */
+			%persistent string RadSecCACert {
+				default "";
+			}
+
+			/**
+			 * RADSec client certificate file path.
+			 * Absolute path to the client certificate used for mutual TLS authentication
+			 * with the RADIUS server. Required when RadSecEnable is true.
+			 * @version 11.0
+			 */
+			%persistent string RadSecClientCert {
+				default "";
+			}
+
+			/**
+			 * RADSec private key file path.
+			 * Absolute path to the private key corresponding to RadSecClientCert.
+			 * Required when RadSecEnable is true.
+			 * @version 11.0
+			 */
+			%persistent string RadSecPrivateKey {
+				default "";
+			}
 		}
 
 		/** This object contains parameters related to MAC-address based filtering for this access point.  */
