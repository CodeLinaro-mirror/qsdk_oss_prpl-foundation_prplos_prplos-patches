+            valStr = amxc_var_dyncast(cstring_t, newValue);
+            swl_str_copy(pAP->radSecClientCert, sizeof(pAP->radSecClientCert), valStr);
+        } else if(swl_str_matches(pname, "RadSecPrivateKey")) {
+            valStr = amxc_var_dyncast(cstring_t, newValue);
+            swl_str_copy(pAP->radSecPrivateKey, sizeof(pAP->radSecPrivateKey), valStr);
         } else {
             continue;
         }
