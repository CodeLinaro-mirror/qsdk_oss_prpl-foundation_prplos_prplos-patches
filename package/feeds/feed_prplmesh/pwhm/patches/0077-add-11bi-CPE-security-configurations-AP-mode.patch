+    bool pmksaCachingPrivacy;               /* PMKID Caching privacy support */
+    bool kekInPasn;                         /* Derive KEK in PASN */
+    bool eapUsingAuthFrames;                /* EAP using 802.11 authentication frames (enterprise) */
+    uint32_t saePwIdNum;                    /* SAE Password Identifier change count */
