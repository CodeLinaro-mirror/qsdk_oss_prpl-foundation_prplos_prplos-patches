From f916e86559a8eb5efd0ed1b1477a651811e7c253 Mon Sep 17 00:00:00 2001
From: Harini Pavithra Elangovan <helangov@qti.qualcomm.com>
Date: Thu, 4 Sep 2025 22:38:39 +0530
Subject: [PATCH 1/1] Enable PLOAM,PHY,OMCI datamodels in ubus-cli

Signed-off-by: Harini Pavithra Elangovan <helangov@qti.qualcomm.com>
---
 include_priv/dm_info.h |  6 +++---
 src/dm_info.c          | 24 ++++++++++++------------
 2 files changed, 15 insertions(+), 15 deletions(-)

diff --git a/include_priv/dm_info.h b/include_priv/dm_info.h
index df8baac..dbe97ac 100644
--- a/include_priv/dm_info.h
+++ b/include_priv/dm_info.h
@@ -85,10 +85,10 @@ typedef enum _xpon_object_id {
     obj_id_ani_tc_alarms,
     obj_id_ani_stats,
     obj_id_eth_stats,
-    obj_id_ani_tc_pm_omci,
-    obj_id_ani_tc_pm_phy,
+    obj_id_tc_pm_omci,
+    obj_id_tc_pm_phy,
     obj_id_ani_tc_pm_gem,
-    obj_id_ani_tc_pm_ploam,
+    obj_id_tc_pm_ploam,
     obj_id_ani_tc_gem_port_pm,
     obj_id_nbr,
     obj_id_unknown = obj_id_nbr
diff --git a/src/dm_info.c b/src/dm_info.c
index dcfb9a8..87fca90 100644
--- a/src/dm_info.c
+++ b/src/dm_info.c
@@ -136,13 +136,13 @@ static const param_info_t PERFORMANCE_THRESHOLDS_PARAMS[] = {
     { .bbf_name = "SignalDegrade", .prpl_name = "signal_degrade", .type = AMXC_VAR_ID_UINT32 }
 };
 
-static const param_info_t PM_OMCI_PARAMS[] = {
+static const param_info_t TC_PM_OMCI[] = {
     { .bbf_name = "BaselineMessagesReceived", .prpl_name = "baseline_messages_received", .type = AMXC_VAR_ID_UINT64 },
     { .bbf_name = "ExtendedMessagesReceived", .prpl_name = "extended_messages_received", .type = AMXC_VAR_ID_UINT64 },
     { .bbf_name = "MICErrors", .prpl_name = "mic_errors", .type = AMXC_VAR_ID_UINT32 }
 };
 
-static const param_info_t PM_PHY_PARAMS[] = {
+static const param_info_t TC_PM_PHY[] = {
     { .bbf_name = "CorrectedFECBytes", .prpl_name = "corrected_fec_bytes", .type = AMXC_VAR_ID_UINT64 },
     { .bbf_name = "CorrectedFECCodewords", .prpl_name = "corrected_fec_codewords", .type = AMXC_VAR_ID_UINT64 },
     { .bbf_name = "UncorrectableFECCodewords", .prpl_name = "uncorrectable_fec_codewords", .type = AMXC_VAR_ID_UINT64 },
@@ -159,7 +159,7 @@ static const param_info_t PM_GEM_PARAMS[] = {
     { .bbf_name = "KeyErrors", .prpl_name = "key_errors", .type = AMXC_VAR_ID_UINT32 }
 };
 
-static const param_info_t PM_PLOAM_PARAMS[] = {
+static const param_info_t TC_PM_PLOAM[] = {
     { .bbf_name = "MICErrors", .prpl_name = "mic_errors", .type = AMXC_VAR_ID_UINT32 },
     { .bbf_name = "DownstreamMessageCount", .prpl_name = "downstream_message_count", .type = AMXC_VAR_ID_UINT64 },
     { .bbf_name = "RangingTime", .prpl_name = "ranging_time", .type = AMXC_VAR_ID_UINT64 },
@@ -315,22 +315,22 @@ static const object_info_t OBJECT_INFO[obj_id_nbr] = {
         .n_params = ARRAY_SIZE(STATS_PARAMS)
     },
     {
-        .id = obj_id_ani_tc_pm_omci,
+        .id = obj_id_tc_pm_omci,
         .bbf_path = "XPON.ONU.x.ANI.x.TC.PM.OMCI",
         .prpl_path = "xpon_onu.x.ani.x.tc.pm.omci",
         .bbf_key_name = NULL,
         .prpl_key_name = NULL,
-        .params = PM_OMCI_PARAMS,
-        .n_params = ARRAY_SIZE(PM_OMCI_PARAMS)
+        .params = TC_PM_OMCI,
+        .n_params = ARRAY_SIZE(TC_PM_OMCI)
     },
     {
-        .id = obj_id_ani_tc_pm_phy,
+        .id = obj_id_tc_pm_phy,
         .bbf_path = "XPON.ONU.x.ANI.x.TC.PM.PHY",
         .prpl_path = "xpon_onu.x.ani.x.tc.pm.phy",
         .bbf_key_name = NULL,
         .prpl_key_name = NULL,
-        .params = PM_PHY_PARAMS,
-        .n_params = ARRAY_SIZE(PM_PHY_PARAMS)
+        .params = TC_PM_PHY,
+        .n_params = ARRAY_SIZE(TC_PM_PHY)
     },
     {
         .id = obj_id_ani_tc_pm_gem,
@@ -342,13 +342,13 @@ static const object_info_t OBJECT_INFO[obj_id_nbr] = {
         .n_params = ARRAY_SIZE(PM_GEM_PARAMS)
     },
     {
-        .id = obj_id_ani_tc_pm_ploam,
+        .id = obj_id_tc_pm_ploam,
         .bbf_path = "XPON.ONU.x.ANI.x.TC.PM.PLOAM",
         .prpl_path = "xpon_onu.x.ani.x.tc.pm.ploam",
         .bbf_key_name = NULL,
         .prpl_key_name = NULL,
-        .params = PM_PLOAM_PARAMS,
-        .n_params = ARRAY_SIZE(PM_PLOAM_PARAMS)
+        .params = TC_PM_PLOAM,
+        .n_params = ARRAY_SIZE(TC_PM_PLOAM)
     },
     {
         .id = obj_id_ani_tc_gem_port_pm,
-- 
