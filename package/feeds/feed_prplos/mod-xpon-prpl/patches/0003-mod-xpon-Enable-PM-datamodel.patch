From 09a5910b82bffe0b3c234d1ecf1809d865e9d390 Mon Sep 17 00:00:00 2001
From: Harini Pavithra Elangovan <helangov@qti.qualcomm.com>
Date: Fri, 5 Sep 2025 10:23:32 +0530
Subject: [PATCH 1/1] Enable PM datamodel in ubus-cli

Signed-off-by: Harini Pavithra Elangovan <helangov@qti.qualcomm.com>
---
 include_priv/dm_info.h | 2 +-
 src/dm_info.c          | 8 ++++----
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/include_priv/dm_info.h b/include_priv/dm_info.h
index dbe97ac..b7a8d30 100644
--- a/include_priv/dm_info.h
+++ b/include_priv/dm_info.h
@@ -87,7 +87,7 @@ typedef enum _xpon_object_id {
     obj_id_eth_stats,
     obj_id_tc_pm_omci,
     obj_id_tc_pm_phy,
-    obj_id_ani_tc_pm_gem,
+    obj_id_tc_pm_gem,
     obj_id_tc_pm_ploam,
     obj_id_ani_tc_gem_port_pm,
     obj_id_nbr,
diff --git a/src/dm_info.c b/src/dm_info.c
index 87fca90..e3119b9 100644
--- a/src/dm_info.c
+++ b/src/dm_info.c
@@ -152,7 +152,7 @@ static const param_info_t TC_PM_PHY[] = {
     { .bbf_name = "UnknownProfile", .prpl_name = "unknown_profile", .type = AMXC_VAR_ID_UINT32 }
 };
 
-static const param_info_t PM_GEM_PARAMS[] = {
+static const param_info_t TC_PM_GEM[] = {
     { .bbf_name = "FramesSent", .prpl_name = "frames_sent", .type = AMXC_VAR_ID_UINT64 },
     { .bbf_name = "FramesReceived", .prpl_name = "frames_received", .type = AMXC_VAR_ID_UINT64 },
     { .bbf_name = "FrameHeaderHECErrors", .prpl_name = "frame_header_hec_errors", .type = AMXC_VAR_ID_UINT32 },
@@ -333,13 +333,13 @@ static const object_info_t OBJECT_INFO[obj_id_nbr] = {
         .n_params = ARRAY_SIZE(TC_PM_PHY)
     },
     {
-        .id = obj_id_ani_tc_pm_gem,
+        .id = obj_id_tc_pm_gem,
         .bbf_path = "XPON.ONU.x.ANI.x.TC.PM.GEM",
         .prpl_path = "xpon_onu.x.ani.x.tc.pm.gem",
         .bbf_key_name = NULL,
         .prpl_key_name = NULL,
-        .params = PM_GEM_PARAMS,
-        .n_params = ARRAY_SIZE(PM_GEM_PARAMS)
+        .params = TC_PM_GEM,
+        .n_params = ARRAY_SIZE(TC_PM_GEM)
     },
     {
         .id = obj_id_tc_pm_ploam,
-- 
