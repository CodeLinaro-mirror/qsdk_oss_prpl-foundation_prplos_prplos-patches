diff --git a/src/dm_ethernet_actions.c b/src/dm_ethernet_actions.c
index 3005682..9432998 100644
--- a/src/dm_ethernet_actions.c
+++ b/src/dm_ethernet_actions.c
@@ -70,6 +70,7 @@
 #include "ethernet_utils.h"
 #include "ethernet_soc_utils.h"
 #include "ethernet_actions.h"
+#include "ethernet_ethtool_utils.h"
 
 #define ME "actions"
 
@@ -481,4 +482,34 @@ amxd_status_t _return_false(UNUSED amxd_object_t* object,
     return amxd_status_ok;
 }
 
+amxd_status_t _flowcontrol_on_read(amxd_object_t* const object,
+                                   UNUSED amxd_param_t* const param,
+                                   amxd_action_t reason,
+                                   UNUSED const amxc_var_t* const args,
+                                   amxc_var_t* const retval,
+                                   UNUSED void* priv) {
+    SAH_TRACEZ_IN(ME);
+    amxd_status_t rv = amxd_status_unknown_error;
+    ethernet_info_t* ethernet = NULL;
+
+    if(reason != action_param_read) {
+        SAH_TRACEZ_NOTICE(ME, "wrong reason, expected action_param_read(%d) got %d", action_param_read, reason);
+        rv = amxd_status_invalid_action;
+        goto exit;
+    }
+
+    when_null_trace(object, exit, ERROR, "object can not be NULL");
+    when_null(object->priv, exit);
+
+    ethernet = (ethernet_info_t*) object->priv;
+
+    // Update FlowControl status from driver
+    dm_ethernet_ethtool_update_flowcontrol(ethernet);
 
+    // Read the updated value from the data model
+    rv = amxd_action_param_read(object, param, reason, args, retval, priv);
+
+exit:
+    SAH_TRACEZ_OUT(ME);
+    return rv;
+}
diff --git a/src/ethernet_ethtool_utils.c b/src/ethernet_ethtool_utils.c
index 84f3d81..a3e25bf 100644
--- a/src/ethernet_ethtool_utils.c
+++ b/src/ethernet_ethtool_utils.c
@@ -339,4 +339,59 @@ exit:
     amxc_var_clean(&ret);
     SAH_TRACEZ_OUT(ME);
     return rv;
-}
\ No newline at end of file
+}
+
+int dm_ethernet_ethtool_update_flowcontrol(ethernet_info_t* ethernet) {
+    SAH_TRACEZ_IN(ME);
+    int rv = -1;
+    amxd_dm_t* dm = ethernet_get_dm();
+    amxd_trans_t trans;
+    const char* ctrl = NULL;
+    bool enabled = false;
+    bool rx_negotiated = false;
+    bool tx_negotiated = false;
+    amxc_var_t data;
+    amxc_var_t ret;
+
+    amxd_trans_init(&trans);
+    amxc_var_init(&data);
+    amxc_var_init(&ret);
+
+    when_null_trace(ethernet, exit, ERROR, "ethernet object is NULL");
+    when_null_trace(ethernet->object, exit, ERROR, "ethernet->object is NULL");
+    when_str_empty_trace(ethernet->netdev_intf, exit, ERROR, "netdev_intf is empty");
+
+    amxc_var_set_type(&data, AMXC_VAR_ID_HTABLE);
+    amxc_var_add_key(cstring_t, &data, "intf_name", ethernet->netdev_intf);
+
+    ctrl = mod_ctrl_get(ethernet->object, ETH_LLA_CTRL);
+    SAH_TRACEZ_INFO(ME, "Calling link-flowcontrol-get for interface '%s' (controller='%s')", ethernet->netdev_intf, ctrl);
+    rv = amxm_execute_function(ctrl, MOD_ETH_LLA_CTRL, "link-flowcontrol-get", &data, &ret);
+    when_failed_trace(rv, exit, ERROR, "Failed to call link-flowcontrol-get, return '%d'", rv);
+
+    // Prefer rx_negotiated and tx_negotiated over enabled field
+    // These fields accurately reflect the hardware negotiation state
+    if(GET_ARG(&ret, "rx_negotiated") != NULL && GET_ARG(&ret, "tx_negotiated") != NULL) {
+        rx_negotiated = GET_BOOL(&ret, "rx_negotiated");
+        tx_negotiated = GET_BOOL(&ret, "tx_negotiated");
+        enabled = rx_negotiated || tx_negotiated;
+    } else if(GET_ARG(&ret, "enabled") != NULL) {
+        enabled = GET_BOOL(&ret, "enabled");
+    } else {
+        SAH_TRACEZ_ERROR(ME, "No flow control fields found in return data");
+        goto exit;
+    }
+
+    amxd_trans_set_attr(&trans, amxd_tattr_change_ro, true);
+    amxd_trans_select_object(&trans, ethernet->object);
+    amxd_trans_set_value(bool, &trans, "FlowControl", enabled);
+    rv = amxd_trans_apply(&trans, dm);
+    when_failed_trace(rv, exit, ERROR, "Failed to update FlowControl parameter");
+
+exit:
+    amxd_trans_clean(&trans);
+    amxc_var_clean(&data);
+    amxc_var_clean(&ret);
+    SAH_TRACEZ_OUT(ME);
+    return rv;
+}
