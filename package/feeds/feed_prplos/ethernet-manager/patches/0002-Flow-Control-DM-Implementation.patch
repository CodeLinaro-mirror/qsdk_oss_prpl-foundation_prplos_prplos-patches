diff --git a/mod-eth-lla/src/mod_eth_ethtool.c b/mod-eth-lla/src/mod_eth_ethtool.c
index 845835a..9a0a028 100644
--- a/mod-eth-lla/src/mod_eth_ethtool.c
+++ b/mod-eth-lla/src/mod_eth_ethtool.c
@@ -810,4 +810,86 @@ int link_edpd_set(UNUSED const char* function_name,
 exit:
     SAH_TRACEZ_OUT(ME);
     return rv;
-}
\ No newline at end of file
+}
+
+#if defined ETHTOOL_GPAUSEPARAM
+static int ethernet_ethtool_pauseparam_get(const char* name, bool* rx_negotiated, bool* tx_negotiated) {
+    SAH_TRACEZ_IN(ME);
+    int rv = -1;
+    int fd = -1;
+    struct ifreq ifr;
+    struct ethtool_pauseparam pauseparam;
+
+    when_null_trace(rx_negotiated, exit, ERROR, "rx_negotiated pointer can not be NULL");
+    when_null_trace(tx_negotiated, exit, ERROR, "tx_negotiated pointer can not be NULL");
+    when_str_empty_trace(name, exit, ERROR, "Interface name is required");
+
+    memset(&ifr, 0, sizeof(ifr));
+    memset(&pauseparam, 0, sizeof(pauseparam));
+    strlcpy(ifr.ifr_name, name, IF_NAMESIZE);
+
+    fd = ioctl_fd_get();
+    when_false_trace(fd >= 0, exit, ERROR, "No valid file descriptor");
+
+    pauseparam.cmd = ETHTOOL_GPAUSEPARAM;
+    ifr.ifr_data = (char*) &pauseparam;
+
+    if(ioctl(fd, SIOCETHTOOL, &ifr) < 0) {
+        when_true_trace(errno != EOPNOTSUPP, exit, ERROR, "ioctl call ETHTOOL_GPAUSEPARAM failed, %s - for device name %s", strerror(errno), ifr.ifr_name);
+        *rx_negotiated = false;
+        *tx_negotiated = false;
+    } else {
+        // When autonegotiate is enabled, flow control is negotiated with link partner
+        // If autoneg is on, both RX and TX are negotiated (ethtool shows "RX negotiated: on, TX negotiated: on")
+        if(pauseparam.autoneg) {
+            // When autoneg is on, assume both RX and TX are negotiated
+            *rx_negotiated = true;
+            *tx_negotiated = true;
+        } else {
+            // When autonegotiate is off, use the configured values
+            *rx_negotiated = pauseparam.rx_pause;
+            *tx_negotiated = pauseparam.tx_pause;
+        }
+    }
+
+    rv = 0;
+exit:
+    SAH_TRACEZ_OUT(ME);
+    return rv;
+}
+#endif
+
+int link_flowcontrol_get(UNUSED const char* function_name,
+                         amxc_var_t* args,
+                         amxc_var_t* ret) {
+    SAH_TRACEZ_IN(ME);
+    int rv = -1;
+    const char* intf_name = GET_CHAR(args, "intf_name");
+    bool rx_negotiated = false;
+    bool tx_negotiated = false;
+    bool enabled = false;
+
+    when_str_empty_trace(intf_name, exit, ERROR, "Interface name is required to read flow control settings");
+    amxc_var_set_type(ret, AMXC_VAR_ID_HTABLE);
+
+#if defined ETHTOOL_GPAUSEPARAM
+    when_failed_trace(ethernet_ethtool_pauseparam_get(intf_name, &rx_negotiated, &tx_negotiated), exit, ERROR, "Failed to get flow control status for device name %s", intf_name);
+
+    // FlowControl is enabled if either RX or TX negotiated is on
+    enabled = rx_negotiated || tx_negotiated;
+
+    SAH_TRACEZ_INFO(ME, "Flow control for %s: RX negotiated=%d, TX negotiated=%d, enabled=%d",
+                    intf_name, rx_negotiated, tx_negotiated, enabled);
+#else
+    SAH_TRACEZ_ERROR(ME, "Getting flow control status via ethtool is not supported on this kernel version");
+#endif
+
+    amxc_var_add_key(bool, ret, "enabled", enabled);
+    amxc_var_add_key(bool, ret, "rx_negotiated", rx_negotiated);
+    amxc_var_add_key(bool, ret, "tx_negotiated", tx_negotiated);
+
+    rv = 0;
+exit:
+    SAH_TRACEZ_OUT(ME);
+    return rv;
+}
