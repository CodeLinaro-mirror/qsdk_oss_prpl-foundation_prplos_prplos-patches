From 4058c17a3424161e2d616455451173371f6109a0 Mon Sep 17 00:00:00 2001
From: Harini Pavithra Elangovan <helangov@qti.qualcomm.com>
Date: Tue, 29 Jul 2025 23:20:31 +0530
Subject: [PATCH 1/1] tr181-xpon: Enable UNI and ANI Statistics for XGS-PON

Signed-off-by: Harini Pavithra Elangovan <helangov@qti.qualcomm.com>
---
 include_priv/dm_info.h            |  2 ++
 odl/tr181-xpon_ANI.odl.m4         | 17 +++++++++++
 odl/tr181-xpon_EthernetUNI.odl.m4 | 17 +++++++++++
 src/dm_info.c                     | 47 +++++++++++++++++++++++++++++--
 4 files changed, 80 insertions(+), 3 deletions(-)

--- a/include_priv/dm_info.h
+++ b/include_priv/dm_info.h
@@ -87,6 +87,8 @@ typedef enum _xpon_object_id {
     obj_id_ani_tc_authentication,
     obj_id_ani_tc_performance_thresholds,
     obj_id_ani_tc_alarms,
+    obj_id_ani_stats,
+    obj_id_eth_stats,
     obj_id_ani_tc_pm_omci,
     obj_id_ani_tc_pm_phy,
     obj_id_ani_tc_pm_gem,
--- a/odl/tr181-xpon_ANI.odl.m4
+++ b/odl/tr181-xpon_ANI.odl.m4
@@ -176,6 +176,23 @@
             on action validate call check_enum
                 ["Unknown", "G-PON", "XG-PON", "NG-PON2", "XGS-PON" ];
         }
+        object Stats {
+	    %read-only uint32 BytesSent;
+	    %read-only uint32 BytesReceived;
+	    %read-only uint32 PacketsSent;
+	    %read-only uint32 PacketsReceived;
+	    %read-only uint32 ErrorsSent;
+	    %read-only uint32 ErrorsReceived;
+	    %read-only uint32 UnicastPacketsSent;
+	    %read-only uint32 UnicastPacketsReceived;
+	    %read-only uint32 DiscardPacketsSent;
+	    %read-only uint32 DiscardPacketsReceived;
+	    %read-only uint32 MulticastPacketsSent;
+	    %read-only uint32 MulticastPacketsReceived;
+	    %read-only uint32 BroadcastPacketsSent;
+	    %read-only uint32 BroadcastPacketsReceived;
+	    %read-only uint32 UnknownProtoPacketsReceived;
+	}
 
         /**
             This object represents an ITU-T PON TC layer device.
--- a/odl/tr181-xpon_EthernetUNI.odl.m4
+++ b/odl/tr181-xpon_EthernetUNI.odl.m4
@@ -231,6 +231,23 @@
         %read-only string InterdomainName {
             on action validate call check_maximum_length 25;
         }
+	object Stats {
+	    %read-only uint32 BytesSent;
+	    %read-only uint32 BytesReceived;
+	    %read-only uint32 PacketsSent;
+	    %read-only uint32 PacketsReceived;
+	    %read-only uint32 ErrorsSent;
+	    %read-only uint32 ErrorsReceived;
+	    %read-only uint32 UnicastPacketsSent;
+	    %read-only uint32 UnicastPacketsReceived;
+	    %read-only uint32 DiscardPacketsSent;
+	    %read-only uint32 DiscardPacketsReceived;
+	    %read-only uint32 MulticastPacketsSent;
+	    %read-only uint32 MulticastPacketsReceived;
+	    %read-only uint32 BroadcastPacketsSent;
+	    %read-only uint32 BroadcastPacketsReceived;
+	    %read-only uint32 UnknownProtoPacketsReceived;
+	}
 
         ifdef(`CONFIG_SAH_AMX_TR181_XPON_USE_NETDEV_COUNTERS', /**
         * Throughput statistics for this interface.
--- a/src/dm_info.c
+++ b/src/dm_info.c
@@ -198,6 +198,24 @@ static const param_info_t TC_ALARMS_PARA
     { .name = "ROGUE", .type = AMXC_VAR_ID_BOOL }
 };
 
+static const param_info_t STATS_PARAMS[] = {
+    { .name = "BytesSent", .type = AMXC_VAR_ID_UINT32 },
+    { .name = "BytesReceived", .type = AMXC_VAR_ID_UINT32 },
+    { .name = "PacketsSent", .type = AMXC_VAR_ID_UINT32 },
+    { .name = "PacketsReceived", .type = AMXC_VAR_ID_UINT32 },
+    { .name = "ErrorsSent", .type = AMXC_VAR_ID_UINT32 },
+    { .name = "ErrorsReceived", .type = AMXC_VAR_ID_UINT32 },
+    { .name = "UnicastPacketsSent", .type = AMXC_VAR_ID_UINT32 },
+    { .name = "UnicastPacketsReceived", .type = AMXC_VAR_ID_UINT32 },
+    { .name = "DiscardPacketsSent", .type = AMXC_VAR_ID_UINT32 },
+    { .name = "DiscardPacketsReceived", .type = AMXC_VAR_ID_UINT32 },
+    { .name = "MulticastPacketsSent", .type = AMXC_VAR_ID_UINT32 },
+    { .name = "MulticastPacketsReceived", .type = AMXC_VAR_ID_UINT32 },
+    { .name = "BroadcastPacketsSent", .type = AMXC_VAR_ID_UINT32 },
+    { .name = "BroadcastPacketsReceived", .type = AMXC_VAR_ID_UINT32 },
+    { .name = "UnknownProtoPacketsReceived", .type = AMXC_VAR_ID_UINT32 },
+};
+
 /**
  * Array with info about objects in the XPON DM.
  *
@@ -232,7 +250,7 @@ const object_info_t OBJECT_INFO[obj_id_n
         .name = "EthernetUNI",
         .generic_path = "XPON.ONU.x.EthernetUNI",
         .key_name = NAME_PARAM,
-        .singletons = NULL,
+        .singletons = "Stats",
         .templates = NULL,
         .params = ETHERNET_UNI_PARAMS,
         .n_params = ARRAY_SIZE(ETHERNET_UNI_PARAMS),
@@ -243,7 +261,7 @@ const object_info_t OBJECT_INFO[obj_id_n
         .name = "ANI",
         .generic_path = "XPON.ONU.x.ANI",
         .key_name = NAME_PARAM,
-        .singletons = "TC.ONUActivation,TC.PerformanceThresholds,TC.Alarms",
+        .singletons = "TC.ONUActivation,TC.PerformanceThresholds,TC.Alarms,Stats",
         .templates = "TC.GEM.Port,Transceiver",
         .params = ANI_PARAMS,
         .n_params = ARRAY_SIZE(ANI_PARAMS),
@@ -371,7 +389,30 @@ const object_info_t OBJECT_INFO[obj_id_n
         .params = PM_GEM_PORT_PARAMS,
         .n_params = ARRAY_SIZE(PM_GEM_PORT_PARAMS),
         .has_rw_enable = false
-    }
+    },
+    {
+       .id = obj_id_ani_stats,
+       .name = "Stats",
+       .generic_path = "XPON.ONU.x.ANI.x.Stats",
+       .key_name = NULL,
+       .singletons = NULL,
+       .templates = NULL,
+       .params = STATS_PARAMS,
+       .n_params = ARRAY_SIZE(STATS_PARAMS),
+       .has_rw_enable = false
+   },
+   {
+       .id = obj_id_eth_stats,
+       .name = "Stats",
+       .generic_path = "XPON.ONU.x.EthernetUNI.x.Stats",
+       .key_name = NULL,
+       .singletons = NULL,
+       .templates = NULL,
+       .params = STATS_PARAMS,
+       .n_params = ARRAY_SIZE(STATS_PARAMS),
+       .has_rw_enable = false
