From 9299f4cc3fa67fd7d724e69dc2626ad121c27ef8 Mon Sep 17 00:00:00 2001
From: Harini Pavithra Elangovan <helangov@qti.qualcomm.com>
Date: Thu, 4 Sep 2025 22:05:02 +0530
Subject: [PATCH 1/1] Enable PLOAM,PHY,OMCI datamodels in ubus-cli

Signed-off-by: Harini Pavithra Elangovan <helangov@qti.qualcomm.com>
---
 include_priv/dm_info.h |  6 +++---
 src/dm_actions.c       |  6 +++---
 src/dm_info.c          | 26 +++++++++++++-------------
 3 files changed, 19 insertions(+), 19 deletions(-)

diff --git a/include_priv/dm_info.h b/include_priv/dm_info.h
index beef3ff..dde1039 100644
--- a/include_priv/dm_info.h
+++ b/include_priv/dm_info.h
@@ -89,10 +89,10 @@ typedef enum _xpon_object_id {
     obj_id_ani_tc_alarms,
     obj_id_ani_stats,
     obj_id_eth_stats,
-    obj_id_ani_tc_pm_omci,
-    obj_id_ani_tc_pm_phy,
+    obj_id_tc_pm_omci,
+    obj_id_tc_pm_phy,
     obj_id_ani_tc_pm_gem,
-    obj_id_ani_tc_pm_ploam,
+    obj_id_tc_pm_ploam,
     obj_id_ani_tc_gem_port_pm,
     obj_id_nbr,
     obj_id_unknown = obj_id_nbr
diff --git a/src/dm_actions.c b/src/dm_actions.c
index aed89d3..1803866 100644
--- a/src/dm_actions.c
+++ b/src/dm_actions.c
@@ -204,10 +204,10 @@ amxd_status_t _read_param(amxd_object_t* object,
 
 #if !defined(SUPPORT_PM_OBJECTS)
     /* Do not query the parameters of the PM objects */
-    if((obj_id_ani_tc_pm_omci == obj_id) ||
-       (obj_id_ani_tc_pm_phy == obj_id) ||
+    if((obj_id_tc_pm_omci == obj_id) ||
+       (obj_id_tc_pm_phy == obj_id) ||
        (obj_id_ani_tc_pm_gem == obj_id) ||
-       (obj_id_ani_tc_pm_ploam == obj_id) ||
+       (obj_id_tc_pm_ploam == obj_id) ||
        (obj_id_ani_tc_gem_port_pm == obj_id)) {
         SAH_TRACEZ_DEBUG(ME, "%s: this PM object is not supported", path);
         rv = 0; /* success */
diff --git a/src/dm_info.c b/src/dm_info.c
index d49b65c..0eedc53 100644
--- a/src/dm_info.c
+++ b/src/dm_info.c
@@ -145,13 +145,13 @@ static const param_info_t PERFORMANCE_THRESHOLDS_PARAMS[] = {
     { .name = "SignalDegrade", .type = AMXC_VAR_ID_UINT32 }
 };
 
-static const param_info_t PM_OMCI_PARAMS[] = {
+static const param_info_t TC_PM_OMCI[] = {
     { .name = "BaselineMessagesReceived", .type = AMXC_VAR_ID_UINT64 },
     { .name = "ExtendedMessagesReceived", .type = AMXC_VAR_ID_UINT64 },
     { .name = "MICErrors", .type = AMXC_VAR_ID_UINT32 }
 };
 
-static const param_info_t PM_PHY_PARAMS[] = {
+static const param_info_t TC_PM_PHY[] = {
     { .name = "CorrectedFECBytes", .type = AMXC_VAR_ID_UINT64 },
     { .name = "CorrectedFECCodewords", .type = AMXC_VAR_ID_UINT64 },
     { .name = "UncorrectableFECCodewords", .type = AMXC_VAR_ID_UINT64 },
@@ -168,7 +168,7 @@ static const param_info_t PM_GEM_PARAMS[] = {
     { .name = "KeyErrors", .type = AMXC_VAR_ID_UINT32 }
 };
 
-static const param_info_t PM_PLOAM_PARAMS[] = {
+static const param_info_t TC_PM_PLOAM[] = {
     { .name = "MICErrors", .type = AMXC_VAR_ID_UINT32 },
     { .name = "DownstreamMessageCount", .type = AMXC_VAR_ID_UINT64 },
     { .name = "RangingTime", .type = AMXC_VAR_ID_UINT64 },
@@ -261,7 +261,7 @@ const object_info_t OBJECT_INFO[obj_id_nbr] = {
         .name = "ANI",
         .generic_path = "XPON.ONU.x.ANI",
         .key_name = NAME_PARAM,
-        .singletons = "TC.ONUActivation,TC.PerformanceThresholds,TC.Alarms,Stats",
+        .singletons = "TC.ONUActivation,TC.PerformanceThresholds,TC.Alarms,Stats,TC.PM.PLOAM,TC.PM.PHY,TC.PM.OMCI",
         .templates = "TC.GEM.Port,Transceiver",
         .params = ANI_PARAMS,
         .n_params = ARRAY_SIZE(ANI_PARAMS),
@@ -358,25 +358,25 @@ const object_info_t OBJECT_INFO[obj_id_nbr] = {
         .has_rw_enable = false
     },
     {
-        .id = obj_id_ani_tc_pm_omci,
+        .id = obj_id_tc_pm_omci,
         .name = "TC.PM.OMCI",
         .generic_path = "XPON.ONU.x.ANI.x.TC.PM.OMCI",
         .key_name = NULL,
         .singletons = NULL,
         .templates = NULL,
-        .params = PM_OMCI_PARAMS,
-        .n_params = ARRAY_SIZE(PM_OMCI_PARAMS),
+        .params = TC_PM_OMCI,
+        .n_params = ARRAY_SIZE(TC_PM_OMCI),
         .has_rw_enable = false
     },
     {
-        .id = obj_id_ani_tc_pm_phy,
+        .id = obj_id_tc_pm_phy,
         .name = "TC.PM.PHY",
         .generic_path = "XPON.ONU.x.ANI.x.TC.PM.PHY",
         .key_name = NULL,
         .singletons = NULL,
         .templates = NULL,
-        .params = PM_PHY_PARAMS,
-        .n_params = ARRAY_SIZE(PM_PHY_PARAMS),
+        .params = TC_PM_PHY,
+        .n_params = ARRAY_SIZE(TC_PM_PHY),
         .has_rw_enable = false
     },
     {
@@ -391,14 +391,14 @@ const object_info_t OBJECT_INFO[obj_id_nbr] = {
         .has_rw_enable = false
     },
     {
-        .id = obj_id_ani_tc_pm_ploam,
+        .id = obj_id_tc_pm_ploam,
         .name = "TC.PM.PLOAM",
         .generic_path = "XPON.ONU.x.ANI.x.TC.PM.PLOAM",
         .key_name = NULL,
         .singletons = NULL,
         .templates = NULL,
-        .params = PM_PLOAM_PARAMS,
-        .n_params = ARRAY_SIZE(PM_PLOAM_PARAMS),
+        .params = TC_PM_PLOAM,
+        .n_params = ARRAY_SIZE(TC_PM_PLOAM),
         .has_rw_enable = false
     },
     {
-- 
