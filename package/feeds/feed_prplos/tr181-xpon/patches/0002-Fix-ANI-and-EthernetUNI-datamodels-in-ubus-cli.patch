+/**
+ * Called if a LastChange parameter is read for EthernetUNI objects.
+ *
+ * For now, this simply returns 0 since the HAL doesn't properly support
+ * last_change for EthernetUNI objects.
+ *
+ * @return amxd_status_ok (=0) upon success
+ */
+amxd_status_t _ethernetuni_lastchange_on_read(UNUSED amxd_object_t* const object,
+                                              UNUSED amxd_param_t* const param,
+                                              amxd_action_t reason,
+                                              UNUSED const amxc_var_t* const args,
+                                              amxc_var_t* const retval,
+                                              UNUSED void* priv_unused) {
+    amxd_status_t rv = amxd_status_unknown_error;
+
+    if(reason != action_param_read) {
+       SAH_TRACEZ_WARNING(ME, "wrong reason, expected action_param_read(%d) got %d",
+                           action_param_read, reason);
+        rv = amxd_status_invalid_action;
+        goto exit;
+    }
+
+    /* For EthernetUNI, always return 0 */
+    rv = amxd_status_ok;
+    when_failed_trace(amxc_var_set_uint32_t(retval, 0),
+                      exit, ERROR, "Failed to set parameter LastChange");
+exit:
+    return rv;
+}
+
+/**
+  * Called if a LastChange parameter is read for ANI objects.
+  *
+  * This mimics the HAL logic: reads the state timestamp from /proc/trex/gpon/onu
+  *
+  * @return amxd_status_ok (=0) upon success
+*/
+amxd_status_t _ani_lastchange_on_read(UNUSED amxd_object_t* const object,
+                                       UNUSED amxd_param_t* const param,
+                                       amxd_action_t reason,
+                                       UNUSED const amxc_var_t* const args,
+                                       amxc_var_t* const retval,
+                                       UNUSED void* priv_unused) {
+     amxd_status_t rv = amxd_status_unknown_error;
+     uint32_t last_change_value = 0;
+     FILE* fp = NULL;
+     char line[512] = {0};
+
+     if(reason != action_param_read) {
+         SAH_TRACEZ_WARNING(ME, "wrong reason, expected action_param_read(%d) got %d",
+                            action_param_read, reason);
+         rv = amxd_status_invalid_action;
+     }
+
+    fp = fopen("/proc/trex/gpon/onu", "r");
+    if(fp != NULL) {
+        while(fgets(line, sizeof(line), fp) != NULL) {
+            const char* key = "state:";
+            char* pos = strstr(line, key);
+            if(pos != NULL) {
+                pos += strlen(key);
+                while(*pos == ' ' || *pos == '\t') {
+                    pos++;
+                }
+                char token[64] = {0};
+                size_t i = 0;
+                while(*pos != '\0' && *pos != ' ' && *pos != '\t' && *pos != '\n' && i + 1 < sizeof(token)) {
+                    token[i++] = *pos++;
+                }
+                token[i] = '\0';
+                char* dot = strchr(token, '.');
+                if(dot != NULL) {
+                    *dot = '\0';
+                }
+                last_change_value = (uint32_t) atoi(token);
+                SAH_TRACEZ_DEBUG(ME, "ANI last_change from /proc = %u", last_change_value);
+                break;
+             }
+        }
+        fclose(fp);
+    } else {
+        SAH_TRACEZ_WARNING(ME, "Failed to open /proc/trex/gpon/onu");
+    }
+
+     rv = amxd_status_ok;
+     when_failed_trace(amxc_var_set_uint32_t(retval, last_change_value),
+                       exit, ERROR, "Failed to set parameter LastChange");
+exit:
+    return rv;
+}
